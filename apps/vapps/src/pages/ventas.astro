---
import Stats from '../components/Stats.astro';
import VapListItem from '../components/VapListItem.astro';
import { imageMap } from '../data/maps/img';
import { translateItem } from '../data/maps/spanish';
import { SELL } from '../data/SELL';
import CustomLayout from '../layouts/CustomLayout.astro';
---

<CustomLayout>
	<!-- <Modal /> -->

	<main class="">
		<Stats
			items={[
				{
					label: 'Calculo Total',
					value: SELL.reduce((total, item) => total + item.price, 0) + '€',
					icon: 'ri-shopping-cart-line',
					color: 'bg-blue-500',
				},
				{
					label: 'Cobrado Total',
					value: SELL.reduce((total, item) => total + item.received, 0) + '€',
					icon: 'ri-money-euro-circle-line',
					color: 'bg-green-500',
				},
			]}
		/>

		<div class="p-5">
			<h2 class="mb-4 text-xl font-semibold">Ventas</h2>
		</div>
		<!-- TODO: hacer un comp de vapslit generico -->
		<!-- <VapList /> -->

		<ul class="space-y-6">
			{
				SELL.map((buy) => (
					<li class="rounded-lg bg-white p-4 shadow-md">
						<div class="mb-3">
							<h3 class="text-lg font-bold text-teal-700">Fecha: {buy.data}</h3>
							<p class="text-gray-600">
								Precio: <span class="font-semibold">{buy.price} €</span>
							</p>
							<p class="text-gray-600">
								Cantidad: <span class="font-semibold">{buy.quantity}</span>
							</p>
						</div>
						<div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
							{buy.items.map((item) => (
								<VapListItem
									src={imageMap[item.name]}
									title={translateItem(item.name)}
									amount={item.amount}
								/>
							))}
						</div>
					</li>
				))
			}
		</ul>
	</main>
</CustomLayout>
