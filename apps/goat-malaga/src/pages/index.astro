---
import { Image } from 'astro:assets';
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import bolsa from '../assets/fotos/goat-malaga-vertical-06.jpg';
import entrada from '../assets/fotos/goat-malaga-apaisada-01.jpg';
import promo from '../assets/fotos/goat-malaga-apaisada-03.jpg';
import mesa from '../assets/fotos/goat-malaga-apaisada-04.jpg';
import bandeja from '../assets/fotos/goat-malaga-vertical-07.jpg';
import carta from '../assets/fotos/goat-malaga-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU,
	MENU_NOTE,
	SERVICIOS,
} from '../data/site';

const title = 'GOAT Málaga · hamburguesas y pollo frito en Carretera de Cádiz';
const description =
	'GOAT Málaga, en C. Héroe de Sostoa, 142 (Carretera de Cádiz, 29003 Málaga). Hamburguesas de vacuno, pollo frito, opciones veganas y comida a domicilio. Abierto de 13:00 a 15:45 y de 20:00 a 23:45; cierra martes y miércoles. 4,3/5 con 528 reseñas.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': ['HamburgerRestaurant', 'FastFoodRestaurant'],
	'@id': `${BUSINESS.siteUrl}/#goat`,
	name: BUSINESS.name,
	alternateName: ['GOAT', 'Goat Málaga', 'GOAT Burger Málaga'],
	description:
		'Hamburguesería y pollo frito en la calle Héroe de Sostoa, 142 (Carretera de Cádiz, 29003 Málaga).',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	servesCuisine: ['Hamburguesas', 'Americana', 'Pollo frito'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.png`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '15:45',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:45',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Horario', href: '#visitanos' },
];

const galeria = [
	{
		src: entrada,
		alt: 'Entrada de GOAT con el rótulo sobre azulejo negro y el local sin gente en la acera',
	},
	{
		src: promo,
		alt: 'Hamburguesa doble con bacon y queso sostenida en la mano, sobre fondo gris con el texto Greatest of all time',
	},
	{
		src: mesa,
		alt: 'Cuatro hamburguesas en cajas de cartón sobre la mesa, con papel de marca Greatest of all time',
	},
	{
		src: bandeja,
		alt: 'Hamburguesa con queso fundido sobre papel de la marca, en bandeja metálica',
	},
	{
		src: carta,
		alt: 'Pizarra de la carta de GOAT con la lista de burgers, pollo frito, sides y bebidas',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#0d0d0d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="GOAT Málaga, hamburguesería Málaga, pollo frito Málaga, Carretera de Cádiz, Héroe de Sostoa 142, 29003, smash burger, comida a domicilio"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Hamburguesas, pollo frito y opciones veganas en Héroe de Sostoa, 142. De 13:00 a 15:45 y de 20:00 a 23:45; cierra martes y miércoles. 4,3 sobre 5 con 528 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.png`}
			ogImageAlt="Hamburguesa de GOAT Málaga con la bolsa de la marca"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#0d0d0d"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[bolsa]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="GOAT"
			subtitle="Burgers · Pollo frito · Málaga"
			cta={{ label: 'Cómo llegar', href: MAPS.directions, external: true }}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<section class="hero wrap" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Carretera de Cádiz · 29003 Málaga</p>
					<h1 id="hero-title">GOAT <br /><em>Málaga.</em></h1>
					<p class="hero-sub">Burgers · Pollo frito · Para llevar</p>
					<p class="hero-lede">
						Hamburguesería de la calle Héroe de Sostoa, 142, con pan de masa madre,
						carne de vacuno, pollo rebozado y opciones veganas. Abre para comer y para
						cenar de lunes y de jueves a domingo; martes y miércoles descansa. Google la
						puntúa con {BUSINESS.rating.toString().replace('.', ',')} sobre 5 y
						{BUSINESS.reviewsCount} reseñas. La ficha no publica teléfono.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href={MAPS.directions}>Cómo llegar</a>
						<a class="button button-ghost" href="#carta">Ver la carta</a>
					</div>
					<ul class="hero-facts">
						<li><b>{BUSINESS.street}</b> · {BUSINESS.district} · {BUSINESS.postalCode} {BUSINESS.city}</li>
						<li><b>Comida</b> 13:00–15:45 · <b>Cena</b> 20:00–23:45</li>
						<li><b>Martes y miércoles</b> cerrado</li>
					</ul>
				</div>

				<figure class="hero-figure">
					<Image
						src={bolsa}
						alt="Bolsa de papel de GOAT con el lema Take the flavours to the G.O.A.T level, una hamburguesa y un vaso de patatas"
						widths={[420, 640, 900]}
						sizes="(max-width: 980px) 92vw, 44vw"
						format="avif"
						quality={68}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<span class="hero-badge">{BUSINESS.reviewsCount} reseñas · 4,3</span>
					<figcaption class="hero-caption">Pedido para llevar. Foto de la galería de Google.</figcaption>
				</figure>
			</section>

			<LocalChips label="Lo que consta en la ficha" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Smash, pollo <br /><em>y para llevar.</em>"
				paragraphs={[
					'GOAT se presenta como hamburguesería, restaurante americano y restaurante de pollo frito para llevar: son las cuatro categorías con las que Google la etiqueta, incluida la de comida a domicilio. Está en el número 142 de la calle Héroe de Sostoa, en la Carretera de Cádiz (29003 Málaga).',
					'La carta está escrita en una pizarra que se ve en las fotos de la ficha. Ahí están las burgers de vacuno con pan de masa madre (Classic, Goat Signature, Royal Cheese, Truffle, La Bacon), el pollo frito (Chicken Signature, Nashville, Chicken Mayo) y varias opciones veganas, además de patatas cargadas y tenders.',
					'El horario es de dos turnos: comida de 13:00 a 15:45 y cena de 20:00 a 23:45, de lunes y de jueves a domingo. Los martes y miércoles no abre, algo que conviene mirar antes de cruzar la ciudad.',
					'La ficha no publica teléfono ni web propia, así que esta página no ofrece ni número ni formulario de pedido, aunque una de las categorías sea comida a domicilio. Tampoco copia los precios de la pizarra: cambian y no están publicados digitalmente.',
				]}
				note="Sin teléfono publicado no hay manera de llamar ni de encargar desde aquí. Esta web no inventa un número ni un formulario: recoge la carta, el horario y la dirección, nada más."
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
				]}
			/>

			<section class="menu-section section-pad" id="carta" aria-labelledby="carta-title">
				<div class="wrap">
					<div class="menu-head">
						<div>
							<p class="eyebrow"><span aria-hidden="true"></span> La carta</p>
							<h2 id="carta-title">Pizarra <br /><em>de la casa.</em></h2>
						</div>
						<p>
							Transcripción de la pizarra que aparece en la galería de la ficha. Hay
							burgers de vacuno, pollo frito, opciones veganas y patatas cargadas.
						</p>
					</div>
					<div class="menu-grid">
						{
							MENU.map((group) => (
								<article class="menu-card">
									<h3>{group.title}</h3>
									<ul>
										{group.items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
									<p>{group.note}</p>
								</article>
							))
						}
					</div>
					<p class="menu-note">{MENU_NOTE}</p>
				</div>
			</section>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow"><span aria-hidden="true"></span> Tres cosas de la casa</p>
						<h2 id="three-title">Sabor, turnos <br /><em>y pedidos.</em></h2>
					</div>
					<div class="three-grid">
						{
							HIGHLIGHTS.map((item, index) => (
								<article class="three-card">
									<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos"
				title="La entrada, la mesa <br /><em>y la pizarra.</em>"
				description="Seis de las diez fotos de la ficha: el pedido para llevar en la portada y aquí la entrada, dos vistas de las burgers y la carta completa colgada en la pared."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026. La ficha tiene diez fotos; las otras cuatro se han dejado fuera por tener personal o clientes identificables, una marca de agua de un tercero o una fachada con un número que no coincide con la dirección publicada."
			/>

			<section class="rating-band" aria-labelledby="rating-title">
				<div class="wrap rating-inner">
					<div class="rating-score">
						<strong>4,3</strong>
						<div>
							<span class="rating-stars" role="img" aria-label="4,3 de 5 estrellas">4,3 / 5</span>
							<p id="rating-title" style="margin:0;font-size:.74rem">{BUSINESS.reviewsCount} reseñas en Google Maps</p>
						</div>
					</div>
					<p class="rating-copy">
						La media de la ficha es 4,3 sobre 5 con 528 reseñas: una muestra amplia, con
						opiniones variadas. Esta página no selecciona ni reproduce sus textos; se
						leen todas en Google.
					</p>
					<a class="rating-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
						Leer las reseñas ↗
					</a>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En la Carretera <br /><em>de Cádiz.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de GOAT Málaga en la calle Héroe de Sostoa, 142, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="GOAT · Carretera de Cádiz"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Reseñas', href: MAPS.reviews, external: true },
				]}
				contactLink={{ label: 'Abrir la ficha en Google Maps', href: MAPS.place, external: true }}
				reserveNote="La ficha de Google no publica teléfono ni web propia, y de accesibilidad indica acceso y aseo adaptados, sin aparcamiento adaptado, sin asientos para sillas de ruedas y sin bucle magnético. Esta página no gestiona pedidos ni reservas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone=""
			phoneHref=""
			legal="Datos, reseñas, carta y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. La ficha no publica teléfono ni precios. Horario y carta pueden cambiar: no hay canal publicado para confirmarlos."
			ctaLabel="Cómo llegar"
			navAriaLabel="Enlaces de GOAT Málaga"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
