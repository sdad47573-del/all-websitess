---
import '../styles/global.css';
import {
  business,
  directionsUrl,
  faqs,
  faqSchema,
  hours,
  hoursSummary,
  mapEmbedUrl,
  mapsUrl,
  phoneHref,
  restaurantSchema,
  reviewsUrl,
  site,
} from '../data/site';

const title = 'Tapería Estribillo · Calle Sacramento 75, Cádiz';
const description =
  'Restaurante Tapería Estribillo en Calle Sacramento 75, 11003 Cádiz. Teléfono 856 52 35 53, cómo llegar, mapa y preguntas frecuentes. Web informativa no oficial.';
const keywords = 'Tapería Estribillo, tapería Cádiz, Sacramento Cádiz';
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e4b57" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={business.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="geo.region" content="ES-CA" />
    <meta name="geo.placename" content={business.city} />
    <meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
    <meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
    <link rel="canonical" href={`${site.siteUrl}/`} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={business.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site.siteUrl}/`} />
    <meta property="og:image" content={`${site.siteUrl}/og.jpg`} />
    <meta property="place:location:latitude" content={String(business.latitude)} />
    <meta property="place:location:longitude" content={String(business.longitude)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.siteUrl}/og.jpg`} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="topbar">
      <a class="brand" href="#inicio" aria-label={`${business.shortName}, inicio`}>
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        <span class="brand-text">Estribillo<small>Sacramento 75 · Cádiz</small></span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="#local">El local</a>
        <a href="#fotos">Fotos</a>
        <a href="#horario">Horario</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a class="topbar-phone" href={phoneHref}><span aria-hidden="true">☎</span>{business.phone}</a>
    </header>

    <main id="contenido">
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Cádiz · Calle Sacramento 75</p>
            <h1 id="hero-title" set:html={piezas.portada.titulo} />
            <p class="hero-lede">
              {business.name} está en {business.streetAddress}, {business.postalCode} {business.city}.
              Web informativa no oficial: teléfono, cómo llegar, mapa y preguntas frecuentes.
              Las fotos de Google Maps no se copian aquí por derechos de autor: esta web usa
              marcadores propios hasta tener fotos con permiso.
            </p>
            <div class="hero-actions">
              <a class="btn btn-solid" href={phoneHref}>Llamar al {business.phone}</a>
              <a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener noreferrer">
                Cómo llegar <span aria-hidden="true">↗</span>
              </a>
            </div>
            <ul class="hero-facts">
              <li><small>Dirección</small><strong>{business.streetAddress} · {business.postalCode} {business.city}</strong></li>
              <li><small>Horario</small><strong>{hoursSummary}</strong></li>
              <li><small>Contacto</small><strong>{business.phone}</strong></li>
            </ul>
          </div>

          <div class="hero-media">
            <div class="hero-collage hero-collage--sin-fotos" role="img" aria-label="Ilustración de Tapería Estribillo, sin fotografías">
              <div class="collage-item collage-item-main foto-ph">
                <span class="foto-ph-mark" aria-hidden="true">C</span>
                <span class="foto-ph-text">Foto propia pendiente</span>
                <small>Sacramento 75</small>
              </div>
              <div class="collage-item collage-item-top foto-ph foto-ph--alt">
                <span class="foto-ph-text">Salón</span><small>pendiente</small>
              </div>
              <div class="collage-item collage-item-bottom foto-ph">
                <span class="foto-ph-text">Terraza / barra</span><small>pendiente</small>
              </div>
            </div>
            <p class="hero-stamp" aria-hidden="true"><span>Tapería</span><strong>Estribillo</strong><span>Cádiz</span></p>
          </div>
        </div>
      </section>

      <div class="band">
        <span>{business.streetAddress} · {business.postalCode} {business.city}</span>
        <span>{hoursSummary}</span>
        <span>Teléfono {business.phone}</span>
      </div>

      <section class="section local" id="local" aria-labelledby="local-title">
        <div class="wrap local-grid">
          <div class="local-text">
            <p class="kicker">El local</p>
            <h2 class="title" id="local-title">Buffet libre<br /><em>en Cáceres.</em></h2>
            <p>
              {business.name} está en {business.streetAddress} ({business.postalCode} {business.city},
              {business.region}), en las coordenadas {business.latitude}, {business.longitude}.
              Los directorios públicos lo listan como buffet / restaurante con teléfono {business.phone}.
            </p>
            <ul class="category-list" aria-label="Categorías">
              {business.categories.map((c) => <li>{c}</li>)}
            </ul>
            <p class="local-note">
              Esta web no copia fotos, reseñas literales, horarios ni valoraciones de Google Maps.
              Para ver opiniones y fotos de clientes, usa la
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer"> ficha en Google Maps ↗</a>.
              Si eres el titular y quieres fotos propias aquí, escríbenos y las publicamos con tu permiso.
            </p>
          </div>
          <div class="quote-row">
            <div class="quote-score">
              <strong>{business.phone}</strong>
              <span>Llama para reservar y confirmar horario</span>
              <a href={reviewsUrl} target="_blank" rel="noopener noreferrer">Ver en Maps ↗</a>
            </div>
            <blockquote class="quote">
              <p>Sin horario verificado: confirma por teléfono antes de salir.</p>
              <footer><strong>Aviso</strong><span>Web no oficial</span></footer>
            </blockquote>
          </div>
        </div>
      </section>

      <section class="section fotos" id="fotos" aria-labelledby="fotos-title">
        <div class="wrap">
          <p class="kicker">Las fotos</p>
          <h2 class="title" id="fotos-title">Fotos <em>propias.</em></h2>
          <p class="lead">
            De momento no hay galería: las imágenes de Google Maps pertenecen a sus autores y sus
            condiciones prohíben descargarlas automáticamente. Cuando tengas fotos propias (hechas por
            ti o con permiso escrito del autor), guárdalas en <code>src/assets/fotos/</code> y aparecerán aquí.
          </p>
          <div class="fotos-grid">
            {[1, 2, 3].map((n) => (
              <figure class="foto-item foto-ph foto-ph--galeria">
                <span class="foto-ph-text">Espacio para foto {n}</span>
                <small>1200 × 800 · JPG</small>
              </figure>
            ))}
          </div>
          <p class="fotos-note">
            ¿Quieres ver cómo es por dentro? Mira la
            <a href={mapsUrl} target="_blank" rel="noopener noreferrer">ficha con fotos en Google Maps ↗</a>
            o <a href={phoneHref}>llama al {business.phone}</a>.
          </p>
        </div>
      </section>

      <section class="section horario" id="horario" aria-labelledby="horario-title">
        <div class="wrap horario-grid">
          <div>
            <p class="kicker">Horario y ubicación</p>
            <h2 class="title" id="horario-title">Sacramento 75,<br /><em>11003 Cádiz.</em></h2>
            <address>{business.streetAddress}<br />{business.postalCode} {business.city}<br />{business.province} · España</address>
            <table class="hours-table">
              <caption>Horario pendiente de confirmar con el local</caption>
              <tbody>
                {hours.map((item) => (
                  <tr><th scope="row">{item.day}</th><td>{item.service}</td></tr>
                ))}
              </tbody>
            </table>
            <p class="hours-note">Llama al {business.phone} para confirmar apertura, festivos y reservas.</p>
            <a class="contact-line" href={phoneHref}><small>Teléfono</small><strong>{business.phone}</strong></a>
            <div class="place-actions">
              <a class="btn btn-solid" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a>
              <a class="btn btn-ghost" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver la ficha en Maps ↗</a>
            </div>
          </div>
          <div class="map-card">
            <iframe title={`Mapa de ${business.name} en ${business.city}`} src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            <div class="map-tag">
              <div><strong>{business.shortName}</strong><small>{business.streetAddress} · {business.postalCode} {business.city}</small></div>
              <a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section faq" id="preguntas" aria-labelledby="faq-title">
        <div class="wrap">
          <p class="kicker">Preguntas frecuentes</p>
          <h2 class="title" id="faq-title">Antes de <em>venir.</em></h2>
          <div class="faq-list">
            {faqs.map((faq) => (
              <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-top">
        <a class="footer-brand" href="#inicio" aria-label={`${business.shortName}, volver al inicio`}>
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <span>{business.name}<small>{business.streetAddress} · {business.postalCode} {business.city}</small></span>
        </a>
        <nav class="footer-nav" aria-label="Contacto y ficha del local">
          <a href={phoneHref}>Llamar al {business.phone}</a>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Ficha en Google Maps ↗</a>
        </nav>
        <small class="footer-note">
          © {new Date().getFullYear()} {business.name} · {business.streetAddress} ({business.postalCode} {business.city}).
          Web informativa no oficial con datos públicos de ubicación y contacto. Confirma horario por teléfono.
        </small>
      </div>
      <p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
    <nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
    	<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
    	<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
    	<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
    </nav>
    </footer>

    <a class="mobile-call" href={phoneHref}>Llamar a Estribillo <span>{business.phone}</span></a>

    <nav class="legal-links" aria-label="Información legal">
      <a href="/aviso-legal">Aviso legal</a>
      <a href="/aviso-legal#privacidad">Privacidad</a>
      <a href="/aviso-legal#cookies">Cookies</a>
    </nav>
  <!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34856523553?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20Taper%C3%ADa%20Estribillo." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante Tapería Estribillo"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
