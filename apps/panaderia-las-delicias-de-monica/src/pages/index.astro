---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import puesto from '../assets/fotos/panaderia-las-delicias-de-monica-apaisada-01.jpg';
import eclairs from '../assets/fotos/panaderia-las-delicias-de-monica-vertical-02.jpg';
import rosas from '../assets/fotos/panaderia-las-delicias-de-monica-vertical-03.jpg';
import tartaRafa from '../assets/fotos/panaderia-las-delicias-de-monica-apaisada-04.jpg';
import troncos from '../assets/fotos/panaderia-las-delicias-de-monica-vertical-05.jpg';
import croissants from '../assets/fotos/panaderia-las-delicias-de-monica-vertical-06.jpg';
import tartaletas from '../assets/fotos/panaderia-las-delicias-de-monica-vertical-07.jpg';
import tartasFruta from '../assets/fotos/panaderia-las-delicias-de-monica-vertical-08.jpg';
import cuadrados from '../assets/fotos/panaderia-las-delicias-de-monica-vertical-09.jpg';
import almendras from '../assets/fotos/panaderia-las-delicias-de-monica-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Las Delicias de Mónica · Panadería en Huelin';
const description =
	'Panadería Las Delicias de Mónica, en el Mercado de Huelin (C. la Hoz, 29002 Málaga). Pan, bollería, tartas de fruta y dulces por encargo. Teléfono 600 25 89 07.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#las-delicias-de-monica`,
	name: BUSINESS.name,
	alternateName: ['Las Delicias de Mónica', 'Panadería Las Delicias', 'Las Delicias Huelin'],
	description:
		'Puesto de panadería, pastelería y bollería en el Mercado de Huelin (C. la Hoz, 29002 Málaga). Pan, bollería, tartas de fruta y dulces por encargo.',
	slogan: 'Sabores tradicionales con un toque de innovación',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34600258907',
	servesCuisine: ['Panadería', 'Pastelería', 'Bollería'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google feature id', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '15:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: eclairs,
		alt: 'Éclairs bañados en chocolate rellenos de nata sobre una bandeja dorada, junto a croissants rellenos',
	},
	{
		src: rosas,
		alt: 'Pasteles rosas con glaseado y líneas de azúcar apilados en una bandeja',
	},
	{
		src: tartaRafa,
		alt: 'Tarta de fruta con fresa, kiwi y mandarina y una placa que dice «Feliz Cumple Rafa»',
	},
	{
		src: troncos,
		alt: 'Troncos de chocolate con nata envueltos en papel vegetal sobre bandejas doradas',
	},
	{
		src: croissants,
		alt: 'Croissants rellenos de crema pastelera cubiertos con caramelos de colores',
	},
	{
		src: tartaletas,
		alt: 'Tartaletas de fruta con kiwi y mandarina sobre nata',
	},
	{
		src: tartasFruta,
		alt: 'Tartas rectangulares de fruta con fresa, melocotón y kiwi, con hilo de fresa',
	},
	{
		src: cuadrados,
		alt: 'Cuadrados de chocolate con líneas de azúcar sobre una bandeja',
	},
	{
		src: almendras,
		alt: 'Triángulos de almendra con láminas tostadas en una bandeja',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"panaderia-las-delicias-de-monica-apaisada-01.jpg": puesto,
	"panaderia-las-delicias-de-monica-vertical-02.jpg": eclairs,
	"panaderia-las-delicias-de-monica-vertical-03.jpg": rosas,
	"panaderia-las-delicias-de-monica-apaisada-04.jpg": tartaRafa,
	"panaderia-las-delicias-de-monica-vertical-05.jpg": troncos,
	"panaderia-las-delicias-de-monica-vertical-06.jpg": croissants,
	"panaderia-las-delicias-de-monica-vertical-07.jpg": tartaletas,
	"panaderia-las-delicias-de-monica-vertical-08.jpg": tartasFruta,
	"panaderia-las-delicias-de-monica-vertical-09.jpg": cuadrados,
	"panaderia-las-delicias-de-monica-vertical-10.jpg": almendras,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#fdf6e8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@300..700&family=Prata&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Las Delicias de Mónica, panadería Mercado de Huelin, pastelería Huelin Málaga, bollería Málaga, tartas por encargo, tronco de navidad, C. la Hoz, 29002"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Las Delicias de Mónica · Panadería en el Mercado de Huelin"
			ogDescription="Pan, bollería, tartas de fruta y dulces por encargo en el Mercado de Huelin. Abre de lunes a sábado de 8:00 a 15:00. 5 sobre 5 con 7 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Puesto de Las Delicias de Mónica en el Mercado de Huelin, con el rótulo de Panadería"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#fdf6e8"
			phone="+34600258907"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[puesto]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Las Delicias"
			subtitle="Panadería · Pastelería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, descripción, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y disponibilidad pueden cambiar; confírmalos antes de ir."
			ctaLabel="Llamar a Las Delicias"
			navAriaLabel="Enlaces de Las Delicias de Mónica"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
