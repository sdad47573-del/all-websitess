---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/cinecom-santa-ines-apaisada-08.jpg';
import interior from '../assets/fotos/cinecom-santa-ines-apaisada-01.jpg';
import desayuno from '../assets/fotos/cinecom-santa-ines-apaisada-04.jpg';
import papaAsada from '../assets/fotos/cinecom-santa-ines-apaisada-05.jpg';
import tortilla from '../assets/fotos/cinecom-santa-ines-apaisada-10.jpg';
import campero from '../assets/fotos/cinecom-santa-ines-vertical-02.jpg';
import bocadillos from '../assets/fotos/cinecom-santa-ines-vertical-03.jpg';
import cabina from '../assets/fotos/cinecom-santa-ines-vertical-06.jpg';
import sala from '../assets/fotos/cinecom-santa-ines-vertical-07.jpg';
import mural from '../assets/fotos/cinecom-santa-ines-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'Cinecom Santa Inés · Hamburguesas, camperos y pizzas en Málaga';
const description =
	'Cinecom Santa Inés, en la calle Tamayo y Baus, 20 (Teatinos-Universidad, 29010 Málaga). Hamburguesas, camperos, pizzas artesanas, papas asadas y desayunos, de lunes a domingo.';

const galeria = [
	{
		src: interior,
		alt: 'Interior de Cinecom Santa Inés con mesas y sillas verdes, la barra y un osito gigante',
	},
	{
		src: mural,
		alt: 'Pizarra de Cinecom con camperos, shawarma, pizzas artesanas, hamburguesas, pepitos y papas asadas',
	},
	{
		src: campero,
		alt: 'Campero a la plancha con jamón, queso, lechuga y huevo, cortado por la mitad',
	},
	{
		src: desayuno,
		alt: 'Tostada con tomate y un vaso de café con leche sobre una mesa verde',
	},
	{
		src: papaAsada,
		alt: 'Patata asada con jamón, maíz, aceitunas y salsa de tomate en papel de aluminio',
	},
	{
		src: tortilla,
		alt: 'Tortilla de patatas gruesa y dorada en un plato blanco',
	},
	{
		src: bocadillos,
		alt: 'Dos bocadillos a la plancha con jamón servidos en platos blancos',
	},
	{
		src: sala,
		alt: 'Sala de Cinecom con la máquina de bolas, las neveras y las mesas verdes',
	},
	{
		src: cabina,
		alt: 'Cabina telefónica roja llena de bolas de chicle en el interior de Cinecom',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Cinecom Santa Inés',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#cinecom`,
	name: BUSINESS.name,
	alternateName: ['Cinecom', 'Cinecom Santa Inés Málaga', 'Cafetería Cinecom'],
	description:
		'Hamburguesería, cafetería y pizzería en la calle Tamayo y Baus, 20, Teatinos-Universidad (29010 Málaga). Camperos, shawarma, pizzas artesanas, papas asadas y desayunos.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34951024484',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Hamburguesas', 'Comida americana', 'Pizza', 'Comida rápida', 'Desayunos'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday'],
			opens: '08:00',
			closes: '12:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:00',
			closes: '12:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"cinecom-santa-ines-apaisada-08.jpg": fachada,
	"cinecom-santa-ines-apaisada-01.jpg": interior,
	"cinecom-santa-ines-vertical-09.jpg": mural,
	"cinecom-santa-ines-vertical-02.jpg": campero,
	"cinecom-santa-ines-apaisada-04.jpg": desayuno,
	"cinecom-santa-ines-apaisada-05.jpg": papaAsada,
	"cinecom-santa-ines-apaisada-10.jpg": tortilla,
	"cinecom-santa-ines-vertical-03.jpg": bocadillos,
	"cinecom-santa-ines-vertical-07.jpg": sala,
	"cinecom-santa-ines-vertical-06.jpg": cabina,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#141210" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Cinecom Santa Inés, hamburguesería Málaga, camperos Teatinos, pizzas artesanas Málaga, papas asadas, shawarma Teatinos, desayunos Málaga, Tamayo y Baus"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Hamburguesas, camperos, pizzas artesanas y desayunos en la calle Tamayo y Baus, 20. De lunes a domingo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Cinecom Santa Inés, cafetería y hamburguesería en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#141210"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Cinecom"
			subtitle="Cafetería · Hamburguesería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Cinecom"
			navAriaLabel="Enlaces de Cinecom Santa Inés"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
