---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/cinecom-santa-ines-apaisada-08.jpg';
import interior from '../assets/fotos/cinecom-santa-ines-apaisada-01.jpg';
import desayuno from '../assets/fotos/cinecom-santa-ines-apaisada-04.jpg';
import papaAsada from '../assets/fotos/cinecom-santa-ines-apaisada-05.jpg';
import tortilla from '../assets/fotos/cinecom-santa-ines-apaisada-10.jpg';
import campero from '../assets/fotos/cinecom-santa-ines-vertical-02.jpg';
import bocadillos from '../assets/fotos/cinecom-santa-ines-vertical-03.jpg';
import cabina from '../assets/fotos/cinecom-santa-ines-vertical-06.jpg';
import sala from '../assets/fotos/cinecom-santa-ines-vertical-07.jpg';
import mural from '../assets/fotos/cinecom-santa-ines-vertical-09.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Cinecom Santa Inés · Hamburguesas, camperos y pizzas en Málaga';
const description =
	'Cinecom Santa Inés, en la calle Tamayo y Baus, 20 (Teatinos-Universidad, 29010 Málaga). Hamburguesas, camperos, pizzas artesanas, papas asadas y desayunos, de lunes a domingo.';

const galeria = [
	{
		src: interior,
		alt: 'Interior de Cinecom Santa Inés con mesas y sillas verdes, la barra y un osito gigante',
	},
	{
		src: mural,
		alt: 'Pizarra de Cinecom con camperos, shawarma, pizzas artesanas, hamburguesas, pepitos y papas asadas',
	},
	{
		src: campero,
		alt: 'Campero a la plancha con jamón, queso, lechuga y huevo, cortado por la mitad',
	},
	{
		src: desayuno,
		alt: 'Tostada con tomate y un vaso de café con leche sobre una mesa verde',
	},
	{
		src: papaAsada,
		alt: 'Patata asada con jamón, maíz, aceitunas y salsa de tomate en papel de aluminio',
	},
	{
		src: tortilla,
		alt: 'Tortilla de patatas gruesa y dorada en un plato blanco',
	},
	{
		src: bocadillos,
		alt: 'Dos bocadillos a la plancha con jamón servidos en platos blancos',
	},
	{
		src: sala,
		alt: 'Sala de Cinecom con la máquina de bolas, las neveras y las mesas verdes',
	},
	{
		src: cabina,
		alt: 'Cabina telefónica roja llena de bolas de chicle en el interior de Cinecom',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Cinecom Santa Inés',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#cinecom`,
	name: BUSINESS.name,
	alternateName: ['Cinecom', 'Cinecom Santa Inés Málaga', 'Cafetería Cinecom'],
	description:
		'Hamburguesería, cafetería y pizzería en la calle Tamayo y Baus, 20, Teatinos-Universidad (29010 Málaga). Camperos, shawarma, pizzas artesanas, papas asadas y desayunos.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34951024484',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Hamburguesas', 'Comida americana', 'Pizza', 'Comida rápida', 'Desayunos'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday'],
			opens: '08:00',
			closes: '12:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '08:00',
			closes: '12:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '20:00',
			closes: '23:59',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#141210" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Cinecom Santa Inés, hamburguesería Málaga, camperos Teatinos, pizzas artesanas Málaga, papas asadas, shawarma Teatinos, desayunos Málaga, Tamayo y Baus"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Hamburguesas, camperos, pizzas artesanas y desayunos en la calle Tamayo y Baus, 20. De lunes a domingo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Cinecom Santa Inés, cafetería y hamburguesería en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#141210"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Cinecom"
			subtitle="Cafetería · Hamburguesería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Tamayo y Baus, 20 · Teatinos"
				title="Hamburguesas <br />de cine, <em>en Teatinos.</em>"
				lede={`Cinecom Santa Inés es la cafetería-hamburguesería de la calle Tamayo y Baus. La pizarra del local anuncia camperos, shawarma, pizzas artesanas, pepitos, papas asadas y platos combinados; las reseñas destacan las raciones, las pizzas y los desayunos. Abre todos los días de 8:00 a 12:00 y, de miércoles a domingo, también de 20:00 a 24:00. Tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="Fachada de Cinecom Santa Inés con el cartel de cafetería y hamburguesería y la terraza de la calle Tamayo y Baus"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>8:00–12:00</b> · y noches de miércoles a domingo' },
					{ label: 'La casa', html: '<b>Hamburguesas</b> · camperos · pizzas' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Cafetería · Hamburguesería"
			/>

			<LocalChips label="Lo que ofrece Cinecom Santa Inés" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una cafetería de barrio <br /><em>con nombre de cine.</em>"
				paragraphs={[
					'Cinecom Santa Inés está en la calle Tamayo y Baus, 20, en Teatinos-Universidad. La fachada lo anuncia como «Cafetería · Hamburguesería», y la ficha de Google lo clasifica además como restaurante americano, restaurante de comida rápida, pizzería y restaurante.',
					'Sentado en una de sus mesas verdes, lo primero que llama la atención es la pizarra del fondo: camperos, shawarma, delicias para compartir, pizzas artesanas, hamburguesas, combinaos, pepitos, papas asadas, platos combinados e infantiles. También hay un osito gigante, fotos de cine y una cabina telefónica roja llena de bolas.',
					'La ficha de Google le da 4,2 sobre 5 con 870 reseñas. Una destaca las «raciones abundantes y ricas» y las «pizzas muy buenas y cargadas de contenido»; otra cuenta que «además de camperos, hamburguesas y kebabs ponen desayunos muy baratos».',
					'El local abre todos los días de 8:00 a 12:00 para desayunar. De miércoles a domingo vuelve a abrir de 20:00 a 24:00. El teléfono que publica la ficha es el 951 02 44 84. Google marca acceso, aseo y asientos adaptados, pero no aparcamiento adaptado.',
				]}
				note="La ficha no publica carta, precios ni página web. Los platos que se citan aquí son los que anuncia la pizarra del local en las fotos del perfil de Google, consultado en octubre de 2026, y los que nombran las reseñas."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que hay en la pizarra</p>
					<h2 id="highlights-title">Camperos, pizzas <br /><em>y desayunos.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item) => (
								<li>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="La cartelera <br /><em>de la casa.</em>"
				description="La ficha de Google no publica carta ni precios. Esta lista reúne lo que anuncia la pizarra del local en las fotos y lo que nombran las reseñas."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La ficha no publica precios. Los platos de esta lista son los que aparecen en la pizarra del local en la galería del perfil de Google, consultada en octubre de 2026, y los que nombran las reseñas. La disponibilidad y el precio se consultan en el local o por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Fotogramas <br /><em>del local.</em>"
				description="Nueve fotografías del perfil de Cinecom Santa Inés en Google Maps: la fachada, el interior, la pizarra de la carta, los camperos, la tortilla, las papas asadas y la cabina de las bolas."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,2 sobre 5, <em>con 870 reseñas.</em></h2>
						<p>
							La valoración que publica Google en octubre de 2026 es de 4,2 con 870 opiniones.
							Las reseñas destacadas hablan de las raciones, las pizzas y los desayunos; aquí se
							reproducen tal como aparecen en la ficha.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,2</strong>
						<span>★★★★★</span>
						<small>870 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Tamayo y Baus, 20, <br /><em>Teatinos.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: todos los días de 8:00 a 12:00; de miércoles a domingo también de 20:00 a 24:00. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Cinecom Santa Inés en la calle Tamayo y Baus, 20, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. Tamayo y Baus, 20"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos y consultas por teléfono: la ficha no publica reservas ni pedidos online. Google marca el acceso, el aseo y los asientos adaptados, pero no el aparcamiento adaptado."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Cinecom"
			navAriaLabel="Enlaces de Cinecom Santa Inés"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
