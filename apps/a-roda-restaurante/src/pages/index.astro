---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/a-roda-restaurante-apaisada-01.jpg';
import mariscada from '../assets/fotos/a-roda-restaurante-vertical-03.jpg';
import pulpo from '../assets/fotos/a-roda-restaurante-vertical-04.jpg';
import zamburinas from '../assets/fotos/a-roda-restaurante-vertical-05.jpg';
import paella from '../assets/fotos/a-roda-restaurante-vertical-09.jpg';
import chuleton from '../assets/fotos/a-roda-restaurante-apaisada-02.jpg';
import entrecot from '../assets/fotos/a-roda-restaurante-apaisada-06.jpg';
import lubina from '../assets/fotos/a-roda-restaurante-apaisada-07.jpg';
import merluza from '../assets/fotos/a-roda-restaurante-apaisada-08.jpg';
import carajillo from '../assets/fotos/a-roda-restaurante-apaisada-10.jpg';

const business = {
	name: 'A Roda - Restaurante',
	brand: 'A Roda',
	tagline: 'Cocina mediterránea y brasa en Oropesa del Mar',
	street: 'Carrer de Goya, 29',
	city: 'Oropesa del Mar',
	region: 'Comunitat Valenciana',
	postalCode: '12594',
	phone: '964 31 14 45',
	latitude: 40.0915694,
	longitude: 0.1364655,
	rating: 4.5,
	reviewsCount: 979,
	site: 'https://a-roda-restaurante.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0x12a004c489bfac2d:0x7970e9841b1e2dca';
const cidDecimal = '8750750829580791242';
const placeId = 'ChIJLay_icQEoBIRyi0eG4TpcHk';

const mapsUrl =
	'https://www.google.com/maps/place/A+Roda+-+Restaurante/@40.0915694,0.1364655,17z/data=!3m1!4b1!4m6!3m5!1s0x12a004c489bfac2d:0x7970e9841b1e2dca!8m2!3d40.0915694!4d0.1364655!16s%2Fg%2F11b867x636?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=A+Roda+Restaurante+Oropesa&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34964311445';

const description =
	'Restaurante mediterráneo con terraza en Carrer de Goya 29 (Oropesa del Mar): menú del día, marisco, brasa y postres caseros. Lunes cerrado.';

const servicios = [
	'Restaurante mediterráneo',
	'Menú del día',
	'Terraza',
	'Marisco y pescado',
	'Carnes a la brasa',
	'Arroces y paellas',
	'Postres caseros',
	'Desayunos y brunch',
	'Comidas y cenas',
	'Acceso para sillas de ruedas',
];

const grupos = [
	{
		title: 'Para picar',
		items: [
			{
				name: 'Croquetas de bienvenida',
				note: 'las que llegan con la primera cerveza, según cuentan las reseñas',
			},
			{
				name: 'Pulpo a la gallega',
				note: 'sobre tabla, con patata y pimentón',
			},
			{
				name: 'Zamburiñas a la plancha',
				note: 'en su concha, con limón',
			},
			{
				name: 'Calamares y mariscada',
				note: 'gambas, cigalas y mejillones para compartir',
			},
		],
	},
	{
		title: 'De la brasa',
		items: [
			{ name: 'Chuletón', note: 'a la parrilla, para dos o para compartir' },
			{ name: 'Entrecot y solomillo', note: 'con patatas y pimientos del padrón' },
			{ name: 'Morcilla', note: 'a la plancha, entre los entrantes que citan los clientes' },
		],
	},
	{
		title: 'Del mar y arroces',
		items: [
			{ name: 'Paella de marisco', note: 'con cigalas y gambas, en paellera' },
			{ name: 'Lubina a la plancha', note: 'con patatas panadera y limón' },
			{
				name: 'Merluza en salsa',
				note: 'con mejillones, gambas y patata',
			},
		],
	},
	{
		title: 'Menú del día y postres',
		items: [
			{
				name: 'Menú del día en pizarra',
				note: 'la pizarra de la entrada anuncia primero, segundo, ensalada y postre; cambia cada día',
			},
			{
				name: 'Postres caseros',
				note: 'los clientes los califican de «espectaculares» en las reseñas',
			},
			{ name: 'Café y carajillo', note: 'para cerrar la comida en la terraza' },
		],
	},
];

const galeria = [
	{
		src: mariscada,
		alt: 'Mariscada de gambas, cigalas y mejillones con salsas en A Roda, Oropesa del Mar',
	},
	{
		src: pulpo,
		alt: 'Pulpo a la gallega con patata y pimentón servido en tabla en A Roda, Oropesa del Mar',
	},
	{
		src: zamburinas,
		alt: 'Zamburiñas a la plancha en su concha con limón en A Roda, Oropesa del Mar',
	},
	{
		src: paella,
		alt: 'Paella de marisco con cigalas y gambas en A Roda, Oropesa del Mar',
	},
	{
		src: chuleton,
		alt: 'Chuletón a la brasa en plato de pizarra en A Roda, Oropesa del Mar',
	},
	{
		src: entrecot,
		alt: 'Entrecot a la parrilla con patatas y pimientos del padrón en A Roda, Oropesa del Mar',
	},
	{
		src: lubina,
		alt: 'Lubina a la plancha con patatas panadera y limón en A Roda, Oropesa del Mar',
	},
	{
		src: merluza,
		alt: 'Merluza en salsa con mejillones, gambas y patata en A Roda, Oropesa del Mar',
	},
	{
		src: carajillo,
		alt: 'Carajillo servido en vaso con cuchara en A Roda, restaurante en Oropesa del Mar',
	},
];

const faqs = [
	{
		q: '¿Dónde está A Roda?',
		a: 'En el Carrer de Goya, 29, 12594 Oropesa del Mar (Castellón), con terraza en la misma acera. Desde esta página puedes abrir Google Maps y trazar la ruta hasta la puerta con el botón «Cómo llegar».',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De martes a sábado abre de 9:00 a 17:00 y vuelve por la noche de 19:00 a 23:30. Los domingos solo sirve de 9:00 a 17:00, y los lunes permanece cerrado. Al ser un horario amplio, conviene confirmarlo por teléfono en festivos.',
	},
	{
		q: '¿Hay menú del día?',
		a: 'Sí. La pizarra de la entrada anuncia menú del día con primero, segundo, ensalada y postre, y cambia cada jornada: en una de las fotos de la ficha aparecen crema de verduras, lasaña de carne, ensalada, filete de lubina y postre de la casa. Esta web no publica el precio; se consulta en la pizarra o por teléfono.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Cocina mediterránea con marisco y brasa: pulpo a la gallega, zamburiñas, calamares, mariscada, paella de marisco, lubina a la plancha, merluza en salsa, chuletón, entrecot, solomillo, morcilla y postres caseros. Los clientes destacan el pulpo, las zamburiñas, los calamares y el solomillo en las reseñas de Google.',
	},
	{
		q: '¿Tiene terraza y se puede reservar?',
		a: 'Sí, el local tiene terraza con mesas en la acera, además del comedor. Las reservas se hacen por teléfono en el 964 31 14 45; no hay reserva online en esta web. En fin de semana y en temporada alta conviene llamar con antelación.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha de Google indica que A Roda tiene acceso para sillas de ruedas, aseo adaptado y asientos adaptados. Si necesitas una mesa concreta, en el comedor o en la terraza, avisa al reservar por teléfono.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: 'A Roda - Restaurante',
	alternateName: ['A Roda', 'Cafetería A Roda', 'Restaurante A Roda Oropesa'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 964 31 14 45',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Mediterránea', 'Marisco', 'Carnes a la brasa', 'Cocina valenciana'],
	areaServed: [
		{ '@type': 'City', name: 'Oropesa del Mar' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '09:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '19:00',
			closes: '23:30',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Sunday'], opens: '09:00', closes: '17:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Menú del día', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Qué pedir', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>A Roda · Restaurante mediterráneo en Oropesa</title>
		<meta name="theme-color" content="#b8503a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,600&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="A Roda Restaurante, A Roda Oropesa del Mar, restaurante mediterráneo Oropesa, menú del día Oropesa, marisco Castellón, carnes a la brasa Oropesa, terraza Castellón, Carrer de Goya 29, comer en Oropesa del Mar, restaurante Plana Alta"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="A Roda · Restaurante mediterráneo con terraza en Oropesa"
			ogDescription="Menú del día, marisco, carnes a la brasa y postres caseros en Carrer de Goya, 29. Terraza en la acera y cocina de 9:00 a 23:30, lunes cerrado. 4,5 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Mariscada de gambas, cigalas y mejillones de A Roda, restaurante en Oropesa del Mar"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#b8503a"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Oropesa del Mar, Castellón"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="R"
			name={business.brand}
			subtitle="Restaurante · Oropesa del Mar"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer de Goya · Oropesa del Mar"
				title="Terraza,<br />menú del día<br /><em>y brasa.</em>"
				lede="A Roda es el restaurante de siempre en el Carrer de Goya, 29, con terraza en la acera y cocina mediterránea todo el día: desayuno desde las 9:00, menú del día en la pizarra, marisco de la lonja, carnes a la brasa y postres caseros. Por la noche vuelve a abrir de martes a sábado."
				image={heroImage}
				imageAlt="Fachada y terraza de A Roda con el rótulo de la cafetería y la pizarra del menú, Oropesa del Mar"
				primaryCta={{ label: 'Llamar 964 31 14 45', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google (979 reseñas)' },
					{ label: 'Menú', html: 'Menú del día en pizarra' },
					{ label: 'Horario', html: 'De 9:00 a 17:00 y cenas de martes a sábado' },
					{ label: 'Extra', html: 'Terraza en la acera' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece A Roda" items={servicios} />

			<LocalAbout
				label="Cocina mediterránea todo el día"
				title="De la terraza<br />a la brasa,<br /><em>sin prisa.</em>"
				paragraphs={[
					'A Roda está en el Carrer de Goya, 29, en Oropesa del Mar, con las mesas de la terraza sobre la acera y una pizarra en la puerta que anuncia el menú del día. Es un restaurante de barrio y de paso: por la mañana funciona como cafetería, al mediodía se llena de menús y por la noche vuelve a abrir para cenar.',
					'La cocina es mediterránea y sin adornos: marisco de la lonja —gambas, cigalas, mejillones, zamburiñas—, pulpo a la gallega sobre tabla, calamares, paellas de marisco y pescado a la plancha con patatas panadera. En las fotos de la ficha también aparecen la merluza en salsa con patatas y mejillones y una buena mariscada para compartir.',
					'Y luego la brasa, que es lo que muchos vienen a buscar: chuletón a la pizarra, entrecot y solomillo con patatas y pimientos del padrón. Para terminar, postres caseros —los clientes los describen como «espectaculares»— y un carajillo en la terraza.',
				]}
				note="La ficha de Google reúne 979 opiniones con una nota media de 4,5. Lo que más se repite: el pulpo, las zamburiñas, los calamares, la morcilla, el solomillo y el arroz, además de las croquetas que llegan con la primera cerveza. También figura la etiqueta de brunch y que el local es accesible."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Qué pedir"
				title="Marisco, brasa<br /><em>y menú del día.</em>"
				description="Selección hecha a partir de los platos que aparecen en las fotos de la ficha de Google, incluida la pizarra del menú del día, y de los que citan los clientes en las reseñas."
				cta={{ label: 'Reservar por teléfono', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: el menú del día se anuncia en la pizarra de la entrada y la carta se consulta en el local. No se inventan importes ni platos."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La mesa,<br /><em>servida.</em>"
				description="Estas fotografías proceden del perfil de A Roda en Google Maps, con imágenes de la ficha y de sus clientes: la mariscada, el pulpo a la gallega, las zamburiñas, la paella de marisco, el chuletón, el entrecot, la lubina, la merluza en salsa y el carajillo."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer de Goya, 29 · 12594 Oropesa del Mar"
				title="Nos vemos<br /><em>en la terraza.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} ${business.city}`,
					'Castellón, España',
				]}
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '9:00 – 17:00 · 19:00 – 23:30' },
					{ day: 'Miércoles', value: '9:00 – 17:00 · 19:00 – 23:30' },
					{ day: 'Jueves', value: '9:00 – 17:00 · 19:00 – 23:30' },
					{ day: 'Viernes', value: '9:00 – 17:00 · 19:00 – 23:30' },
					{ day: 'Sábado', value: '9:00 – 17:00 · 19:00 – 23:30' },
					{ day: 'Domingo', value: '9:00 – 17:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google. Abre de martes a sábado todo el día, con servicio de cenas, y los domingos solo hasta las 17:00. Los lunes cierra. En festivos y temporada alta puede cambiar, así que llama al 964 31 14 45 antes de ir."
				mapTitle="Mapa de A Roda en el Carrer de Goya, 29, Oropesa del Mar"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="A Roda · Oropesa del Mar"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Reservas por teléfono, en el 964 31 14 45. No hay reserva online ni formulario en esta web. La ficha de Google indica acceso para sillas de ruedas, aseo adaptado y asientos adaptados; si quieres mesa en la terraza, pídela al reservar."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="R"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a A Roda"
		/>
	</body>
</html>
