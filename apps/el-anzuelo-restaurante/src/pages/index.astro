---
import '../styles/global.css';
import {
	business,
	directionsUrl,
	facebookUrl,
	faqSchema,
	faqs,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneHref,
	restaurantSchema,
	specialties,
} from '../lib/business';

const title = 'El Anzuelo Restaurante | Pescado fresco y marisco en Córdoba';
const description =
	'El Anzuelo Restaurante en Córdoba: pescado fresco, atún, marisco y cocina con sabor a costa. Descubre sus especialidades y reserva mesa: 661 73 79 22.';
const keywords =
	'El Anzuelo Restaurante Córdoba, restaurante pescado Córdoba, marisco Córdoba, atún fresco Córdoba, pescado fresco, Calle Policía Local María de los Ángeles García, reservar El Anzuelo';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#172d30" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de pescado para El Anzuelo Restaurante; no es una fotografía del local" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="El Anzuelo Restaurante, inicio">
				<span class="brand-mark" aria-hidden="true">A</span>
				<span class="brand-copy">El Anzuelo <small>Pescado fresco · Córdoba</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#restaurante">El restaurante</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 661 73 79 22</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> El mar llega a Córdoba</p>
					<h1 id="hero-title">Pescado fresco,<br /><em>mesa con sabor.</em></h1>
					<p class="hero-intro">En El Anzuelo, el producto del mar se disfruta en buena compañía. Atún, pescado fresco y marisco se encuentran con recetas tradicionales y un toque creativo, en pleno Córdoba.</p>
					<div class="hero-actions">
						<a class="button button-coral" href={phoneHref}>Llamar y reservar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Estamos en</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración vectorial original de pescado fresco, no es una fotografía del restaurante">
					<span class="plate-dot" aria-hidden="true"></span><div class="plate" aria-hidden="true"><div class="fish"></div><span class="lemon"></span><span class="herb"></span></div>
					<div class="art-caption"><strong>Del mar a la mesa</strong>Pescado fresco · producto</div>
				</div>
			</section>

			<div class="promise" aria-label="Especialidades de El Anzuelo Restaurante">
				<span>Pescado fresco</span><span>Atún de calidad</span><span>Marisco</span><span>Opciones sin gluten</span>
			</div>

			<section class="section intro" id="restaurante" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Restaurante en Córdoba</p>
					<h2 id="intro-title">Sabor a costa<br /><em>en cada bocado.</em></h2>
				</div>
				<div class="intro-copy">
					<p>El Anzuelo Restaurante acerca a Córdoba el pescado fresco y el marisco de calidad con una carta que combina clásicos del mar y elaboraciones creativas. El atún ocupa un lugar protagonista, con opciones que cambian según el mercado y las sugerencias del día.</p>
					<p>En su mesa puedes encontrar desde frituras y marisco hasta platos de atún y propuestas para compartir. Consulta las opciones disponibles al reservar; al trabajar con producto fresco, algunos platos pueden variar.</p>
					<p class="source-note">El perfil oficial menciona opciones sin gluten. Si tienes alergias o necesidades alimentarias, informa al equipo y confirma ingredientes y posibles trazas antes de pedir.</p>
				</div>
			</section>

			<section class="section menu-section" id="cocina" aria-labelledby="menu-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Frescura · mar · creatividad</p>
						<h2 id="menu-title">Un anzuelo para<br /><em>cada paladar.</em></h2>
					</div>
					<p>Una selección orientativa basada en publicaciones del restaurante y referencias gastronómicas locales. No es una carta oficial; consulta disponibilidad, precios y alérgenos.</p>
				</div>
				<div class="menu-grid">
					{specialties.map((dish, index) => (
						<article class="menu-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<p class="menu-note">La oferta cambia según el producto fresco del día. <a href={phoneHref}>Llama para reservar y preguntar</a>.</p>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<p class="section-label"><span aria-hidden="true"></span> El Anzuelo en imágenes</p>
				<h2 id="gallery-title">Asómate a<br /><em>la galería.</em></h2>
				<p class="gallery-copy">La URL de Google Maps abre la ficha del establecimiento pero no incluye URLs directas de las fotografías. Desde aquí puedes acceder a las galerías reales de Maps y a las redes oficiales.</p>
				<div class="gallery-grid">
					<a class="gallery-card" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de El Anzuelo Restaurante en Google Maps">
						<span class="gallery-tag">Fotos de la ficha</span><span class="gallery-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos y vídeos del Instagram oficial de El Anzuelo Restaurante">
						<span class="gallery-tag">Pescado y novedades</span><span class="gallery-title">Instagram <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={facebookUrl} target="_blank" rel="noreferrer" aria-label="Abrir la página oficial de Facebook de El Anzuelo Restaurante">
						<span class="gallery-tag">Perfil del negocio</span><span class="gallery-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">La ilustración de portada y las tarjetas son gráficos vectoriales originales, no fotografías del local. Las imágenes reales se abren desde Maps y los perfiles sociales.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14011 · Córdoba</p>
					<h2 id="visit-title">Tu mesa<br /><em>junto al mar.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.city}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir ficha en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Canales oficiales</small><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> · <a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar para reservar</a>
					</div>
					<p class="menu-note">El horario puede variar. Confirma el servicio y la disponibilidad por teléfono.</p>
				</div>
				<div class="map-card">
					<iframe title="Mapa de El Anzuelo Restaurante en Córdoba, calle Policía Local María de los Ángeles García" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<div class="map-label"><div><strong>El Anzuelo Restaurante</strong><small>Córdoba · 14011</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="El Anzuelo Restaurante, volver al inicio">
				<span class="brand-mark" aria-hidden="true">A</span><span class="brand-copy">El Anzuelo Restaurante <small>Pescado fresco · Córdoba</small></span>
			</a>
			<nav class="footer-nav" aria-label="Redes y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} El Anzuelo Restaurante · Córdoba. Consulta carta y horarios con el establecimiento.</small>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar para reservar <span>661 73 79 22</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>
