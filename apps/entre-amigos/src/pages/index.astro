---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import terraza from '../assets/fotos/entre-amigos-vertical-01.jpg';
import parrillada from '../assets/fotos/entre-amigos-vertical-02.jpg';
import bocadillo from '../assets/fotos/entre-amigos-vertical-03.jpg';
import comedor from '../assets/fotos/entre-amigos-vertical-07.jpg';
import llegada from '../assets/fotos/entre-amigos-vertical-08.jpg';
import arroz from '../assets/fotos/entre-amigos-vertical-09.jpg';
import postre from '../assets/fotos/entre-amigos-vertical-10.jpg';

const business = {
	name: 'Entre Amigos Bar Restaurante',
	brand: 'Entre Amigos',
	street: 'Carrer Peri 15, núm. 8',
	neighbourhood: 'Polígono Industrial Autopista Sur',
	city: 'Castellón de la Plana',
	region: 'Castelló',
	postalCode: '12006',
	phone: '619 60 75 91',
	latitude: 39.9758999,
	longitude: -0.064094,
	rating: 4.4,
	reviewsCount: 233,
	site: 'https://entre-amigos.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd60014fccb5b311:0x4e2606df3402823e';
const cidDecimal = '5631195939793437246';
const placeId = 'ChIJEbO1zE8BYA0RPoICNN8GJk4';

const mapsUrl =
	'https://www.google.com/maps/place/Entre+Amigos+Bar+Restaurante/@39.9758999,-0.064094,17z/data=!3m1!4b1!4m6!3m5!1s0xd60014fccb5b311:0x4e2606df3402823e!8m2!3d39.9758999!4d-0.064094!16s%2Fg%2F11k3xqgyj5?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34619607591';

const description =
	'Entre Amigos Bar Restaurante, en el polígono Autopista Sur de Castellón: desayunos desde las 7:00, bocadillos y menú del día por 18,50 € con primero, segundo, postre y bebida.';

const servicios = [
	'Bar restaurante',
	'Desayunos',
	'Bocadillos',
	'Menú del día',
	'Parrilla',
	'Arroces',
	'Terraza',
	'Comidas de empresa',
	'Acceso adaptado',
	'Reservas por teléfono',
];

const grupos = [
	{
		title: 'Para empezar',
		items: [
			{
				name: 'Pan con tomate y ali oli',
				note: 'el entrante que abre el menú, para la mesa',
			},
			{
				name: 'Ensalada de brotes',
				note: 'con tomate, rulo de cabra, bacon, frutos secos y vinagre balsámico',
			},
			{
				name: 'Huevos rotos con chorizo',
				note: 'el tercer entrante de la carta del día',
			},
		],
	},
	{
		title: 'Segundos a elegir',
		items: [
			{
				name: 'Parrillada de carne a la brasa',
				note: 'surtido de carnes con patatas y verduras a la plancha',
			},
			{
				name: 'Presa a la brasa con Pedro Ximénez',
				note: 'carne de cerdo con reducción de vino dulce',
			},
			{
				name: 'Muslo de pollo al horno',
				note: 'asado, con guarnición',
			},
			{
				name: 'Bacalao gratinado con ajoaceite',
				note: 'gratinado al horno',
			},
			{
				name: 'Chuletas de cordero a la brasa',
				note: 'suplemento de +4 €',
			},
			{
				name: 'Entrecot de ternera a la brasa',
				note: 'suplemento de +6 €',
			},
		],
	},
	{
		title: 'Para terminar',
		items: [
			{
				name: 'Postre o café',
				note: 'a elegir al final del menú',
			},
			{
				name: 'Primera bebida incluida',
				note: 'agua, refresco o cerveza, dentro de los 18,50 €',
			},
		],
	},
];

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de Entre Amigos Bar Restaurante con mesas de madera y la barra al fondo, en el polígono Autopista Sur',
	},
	{
		src: parrillada,
		alt: 'Parrillada de carne a la brasa con patatas y verduras en Entre Amigos Bar Restaurante',
	},
	{
		src: bocadillo,
		alt: 'Bocadillo de panceta a la brasa con aceitunas en Entre Amigos Bar Restaurante',
	},
	{
		src: arroz,
		alt: 'Arroz con verduras y limón en Entre Amigos Bar Restaurante',
	},
	{
		src: postre,
		alt: 'Postre de tarta con mermelada y nata en Entre Amigos Bar Restaurante',
	},
	{
		src: llegada,
		alt: 'Exterior de Entre Amigos Bar Restaurante desde la calle, con la terraza bajo sombrillas',
	},
];

const faqs = [
	{
		q: '¿Dónde está Entre Amigos?',
		a: "En el Carrer Peri 15, núm. 8, 12006 Castellón de la Plana, dentro del Polígono Industrial Autopista Sur, al sur de la ciudad. Es una nave esquinera con terraza delante y se aparca en la calle, junto al local. El botón «Cómo llegar» abre la ruta exacta en Google Maps.",
	},
	{
		q: '¿Qué horario tiene?',
		a: 'De lunes a viernes abre de 7:00 a 18:00, sin cerrar a mediodía, y los sábados de 8:00 a 16:00. Los domingos está cerrado. Es el horario de un bar de polígono: desayunos desde primera hora y comidas hasta media tarde.',
	},
	{
		q: '¿Cuánto cuesta el menú del día y qué incluye?',
		a: 'La carta fotografiada en su ficha de Google marca 18,50 € con IVA incluido. Incluye pan con tomate y ali oli, un entrante (ensalada de brotes o huevos rotos con chorizo), segundo a elegir entre parrillada, presa al Pedro Ximénez, muslo de pollo al horno, bacalao gratinado, chuletas de cordero (+4 €) o entrecot (+6 €), y postre o café con la primera bebida. Precio y platos pueden cambiar de un día para otro.',
	},
	{
		q: '¿Se puede desayunar?',
		a: 'Sí. Abren a las 7:00 y en la barra hay café y bocadillos, como el de panceta a la brasa que aparece en sus fotos. Es el desayuno del turno de mañana del polígono.',
	},
	{
		q: '¿Hay terraza?',
		a: 'Sí, delante del local, con sombrillas y sillas azules, y con las mesas de fuera a la vista desde la calle. Es una terraza de polígono: práctica, para el café y para comer si hace bueno.',
	},
	{
		q: '¿Hay carta aparte del menú del día?',
		a: 'La ficha de Google no publica una carta de barra con precios, así que esta web no la inventa: lo que se ve en «La mesa» es el menú del día tal como está fotografiado en el perfil, más los platos que aparecen en sus fotos (bocadillos, parrillada, arroces y postres). Para lo que haya cada día, se pregunta en la barra o por teléfono.',
	},
	{
		q: '¿Se puede reservar? ¿Y venir en grupo?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 619 60 75 91. Con el comedor grande y el menú del día, es un sitio habitual para comidas de empresa y de cuadrilla; para grupos conviene llamar con antelación.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca entrada, aseo y asientos adaptados para sillas de ruedas. No marca plaza de aparcamiento adaptada.',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Menú del día',
	description:
		'Menú del día con pan con tomate y ali oli, entrante, segundo a elegir, postre o café y primera bebida.',
	hasMenuSection: [
		{
			'@type': 'MenuSection',
			name: 'Para empezar',
			hasMenuItem: [
				{ '@type': 'MenuItem', name: 'Pan con tomate y ali oli' },
				{
					'@type': 'MenuItem',
					name: 'Ensalada de brotes con tomate, rulo de cabra, bacon, frutos secos y balsámico',
				},
				{ '@type': 'MenuItem', name: 'Huevos rotos con chorizo' },
			],
		},
		{
			'@type': 'MenuSection',
			name: 'Segundos a elegir',
			hasMenuItem: [
				{ '@type': 'MenuItem', name: 'Parrillada de carne a la brasa' },
				{ '@type': 'MenuItem', name: 'Presa a la brasa con Pedro Ximénez' },
				{ '@type': 'MenuItem', name: 'Muslo de pollo al horno' },
				{ '@type': 'MenuItem', name: 'Bacalao gratinado con ajoaceite' },
				{ '@type': 'MenuItem', name: 'Chuletas de cordero a la brasa', offers: { '@type': 'Offer', price: '4', priceCurrency: 'EUR', description: 'Suplemento' } },
				{ '@type': 'MenuItem', name: 'Entrecot de ternera a la brasa', offers: { '@type': 'Offer', price: '6', priceCurrency: 'EUR', description: 'Suplemento' } },
			],
		},
		{
			'@type': 'MenuSection',
			name: 'Para terminar',
			hasMenuItem: [
				{ '@type': 'MenuItem', name: 'Postre o café' },
				{ '@type': 'MenuItem', name: 'Primera bebida incluida' },
			],
		},
	],
	offers: { '@type': 'Offer', price: '18.50', priceCurrency: 'EUR', description: 'IVA incluido' },
};

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['Entre Amigos', 'Bar Entre Amigos', 'Entre Amigos Castellón'],
	slogan: 'Menú del día y terraza en el polígono Autopista Sur',
	description,
	url: `${business.site}/`,
	telephone: '+34 619 60 75 91',
	priceRange: '€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Cocina española', 'Menú del día', 'Parrilla', 'Bocadillos'],
	areaServed: [
		{ '@type': 'City', name: 'Castellón de la Plana' },
		{ '@type': 'Place', name: 'Polígono Industrial Autopista Sur' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:00',
			closes: '18:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '08:00',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
	],
	hasMenu: menuSchema,
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El menú', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>Entre Amigos · Menú del día en Castellón (Autopista Sur)</title>
		<meta name="theme-color" content="#1f5c8b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Chivo:ital,wght@0,400;0,600;0,700;1,600&family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Entre Amigos, Bar Entre Amigos, Entre Amigos Castellón, menú del día Castellón, bar restaurante polígono Autopista Sur, bocadillos Castellón, parrillada, comer en el polígono, Carrer Peri, Castellón de la Plana"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Entre Amigos · Menú del día en Castellón"
			ogDescription="Menú del día por 18,50 € con primero, segundo, postre y bebida en el polígono Autopista Sur. Desayunos desde las 7:00. 4,4 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Terraza con sombrillas de Entre Amigos Bar Restaurante en Castellón"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#1f5c8b"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Castellón de la Plana, Castellón"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[terraza]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="EA"
			name={business.brand}
			subtitle="Bar restaurante · Castellón"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Pol. Ind. Autopista Sur · Carrer Peri 15"
				title="Entre amigos,<br /><em>a la mesa.</em>"
				lede="Entre Amigos es el bar restaurante del polígono Autopista Sur, en Castellón. Abre a las 7:00 para desayunar, sirve bocadillos en la barra y pone un menú del día completo —primero, segundo, postre y bebida— por 18,50 €."
				image={terraza}
				imageAlt="Terraza de Entre Amigos Bar Restaurante con sombrillas y sillas azules, en el polígono Autopista Sur"
				primaryCta={{ label: 'Llamar 619 60 75 91', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google (233 reseñas)' },
					{ label: 'De lunes a viernes', html: '<b>7:00 – 18:00</b>' },
					{ label: 'Menú del día', html: '<b>18,50 €</b> con bebida' },
					{ label: 'Domingo', html: '<b>Cerrado</b>' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Entre Amigos" items={servicios} />

			<LocalAbout
				label="El bar del polígono Autopista Sur"
				title="Café a las 7,<br />menú a las <em>dos.</em>"
				paragraphs={[
					'Entre Amigos ocupa una nave esquinera del Polígono Industrial Autopista Sur, en el Carrer Peri 15, núm. 8, al sur de Castellón. Delante está la terraza con sombrillas y sillas azules; dentro, un comedor amplio con mesas de madera, la barra con vitrina y la tele al fondo.',
					'El día empieza a las 7:00 con cafés y bocadillos para el turno de mañana, y sigue con el menú del día a la hora de comer: pan con tomate y ali oli, entrante, segundo a elegir entre parrillada, presa al Pedro Ximénez, pollo al horno, bacalao gratinado, cordero o entrecot, y postre o café con la primera bebida. La carta que tienen fotografiada en Google marca 18,50 € con IVA incluido.',
					'El horario es el de un bar de polígono: de lunes a viernes de 7:00 a 18:00 y los sábados de 8:00 a 16:00, con el domingo cerrado. La ficha reúne 233 opiniones con un 4,4, y una de las últimas reseñas habla del relevo al frente del local.',
				]}
				note="«Llegamos y vimos que cambiaron de dueños, una pareja joven muy simpáticos», dice una reseña reciente."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="El menú del día"
				title="18,50 €<br /><em>completos.</em>"
				description="18,50 € con IVA incluido: pan con tomate y ali oli, entrante, segundo a elegir, postre o café y primera bebida. Es la carta del menú que el propio restaurante tiene fotografiada en su ficha de Google."
				cta={{ label: 'Preguntar el menú de hoy', href: phoneHref }}
				groups={grupos}
				note="Los suplementos de la carta son de +4 € por las chuletas de cordero y +6 € por el entrecot. El precio y los platos cambian de un día para otro, así que conviene confirmarlo al llamar. Esta web no publica carta de barra porque no está en la ficha."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La terraza,<br />el plato<br /><em>y el comedor.</em>"
				description="Estas fotografías proceden del perfil de Entre Amigos Bar Restaurante en Google Maps: el comedor con las mesas de madera, la parrillada a la brasa, el bocadillo de panceta, el arroz, el postre y la llegada al local desde la calle."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer Peri 15, núm. 8 · 12006 Castellón"
				title="Comer bien<br /><em>en el polígono.</em>"
				addressLines={[
					business.street,
					business.neighbourhood,
					`${business.postalCode} ${business.city}`,
					'Castelló, España',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={[
					{ day: 'Lunes', value: '7:00 – 18:00' },
					{ day: 'Martes', value: '7:00 – 18:00' },
					{ day: 'Miércoles', value: '7:00 – 18:00' },
					{ day: 'Jueves', value: '7:00 – 18:00' },
					{ day: 'Viernes', value: '7:00 – 18:00' },
					{ day: 'Sábado', value: '8:00 – 16:00' },
					{ day: 'Domingo', value: 'Cerrado', closed: true },
				]}
				hoursNote="Horario publicado en la ficha de Google: de 7:00 a 18:00 de lunes a viernes, sin cierre a mediodía, y sábados de 8:00 a 16:00. Domingo cerrado. En festivos y en agosto suele cambiar: llama antes al 619 60 75 91."
				mapTitle="Mapa de Entre Amigos Bar Restaurante en el polígono Autopista Sur, Castellón"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Entre Amigos · Castellón"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Las reservas se hacen por teléfono, llamando al 619 60 75 91: no hay reserva online ni formulario en esta web. Hay aparcamiento en la calle, delante del local, y el comedor es amplio para grupos y comidas de empresa."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="EA"
			name="Entre Amigos Bar Restaurante"
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma precio, platos y horario antes de la visita."
			ctaLabel="Llamar a Entre Amigos"
		/>
	</body>
</html>
