		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="AM Industria del Estilo" />
		<meta property="og:title" content="Aviso legal y privacidad | AM Industria del Estilo" />
		<meta property="og:description" content="Aviso legal, política de privacidad y política de cookies de AM Industria del Estilo." />
		<meta property="og:url" content="https://am-industria-del-estilo-malaga.vercel.app/aviso-legal/" />
		<meta property="og:image" content="https://am-industria-del-estilo-malaga.vercel.app/og.jpg" />
