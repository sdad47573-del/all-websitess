<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Aviso legal y privacidad | AM Industria del Estilo</title>
		<meta name="description" content="Aviso legal, política de privacidad y política de cookies de AM Industria del Estilo." />
		<meta name="robots" content="index, follow" />
