---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import { Image } from 'astro:assets';
import {
	business,
	directionsUrl,
	emailHref,
	facebookUrl,
	galleryPhotos,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	photoUrl,
	phoneHrefs,
	structuredData,
} from '../lib/business';

const title = 'AM Industria del Estilo | Peluquería en Teatinos, Málaga';
const description =
	'AM Industria del Estilo, peluquería en Avenida de Gregorio Prieto, 3 (Teatinos), Málaga. Corte, color y tratamientos. Llama al 744 61 08 81 o consulta cómo llegar.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#191713" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Málaga" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={photoUrl} />
		<meta property="og:image:alt" content="Fotografía de AM Industria del Estilo compartida en Google Maps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={photoUrl} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="AM Industria del Estilo, inicio"><span class="brand-mark" aria-hidden="true">AM</span><span class="brand-label">INDUSTRIA DEL ESTILO <small>PELUQUERÍA · TEATINOS</small></span></a>
			<nav aria-label="Navegación principal"><a href="#estudio">El estudio</a><a href="#contacto">Contacto</a></nav>
			<a class="header-phone" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> {business.phones[0]}</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-content">
					<p class="eyebrow"><span></span> PELUQUERÍA · COLOR · TRATAMIENTOS</p>
					<h1 id="hero-title">Tu estilo,<br /><em>nuestra industria.</em></h1>
					<p class="hero-intro">AM Industria del Estilo es tu peluquería en Teatinos, Málaga. Corte, color y cuidado del cabello con trato cercano y asesoramiento a medida.</p>
					<div class="hero-actions"><a class="button button-clay" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar al salón</a><a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-location"><span class="location-rule" aria-hidden="true"></span><p>{business.district}<br /><strong>{business.city} · Andalucía</strong></p></div>
				</div>
				<figure class="hero-photo">
					<div class="photo-label"><span>AM / 01</span><span>ESTUDIO DE ESTILISMO · MÁLAGA</span></div>
					<a href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver la foto de AM Industria del Estilo y su galería en Google Maps"><img src={photoUrl} alt="Fotografía de AM Industria del Estilo publicada en Google Maps" width="1200" height="624" fetchpriority="high" decoding="async" /><span class="photo-open" aria-hidden="true">↗</span></a>
					<figcaption><span>FOTO DE LA FICHA DE GOOGLE MAPS</span><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha ↗</a></figcaption>
					<span class="photo-stamp" aria-hidden="true">AM<br /><i>✳</i><br />MÁLAGA</span>
				</figure>
				<span class="hero-flower" aria-hidden="true">✳</span>
			</section>

			<section class="salon-strip" id="estudio" aria-label="AM Industria del Estilo, servicios de peluquería">
				<p class="strip-title"><span>01 /</span> LO QUE HACEMOS</p>
				<div><span>01</span><strong>Corte y peinado</strong></div>
				<div><span>02</span><strong>Color y mechas</strong></div>
				<div><span>03</span><strong>Tratamientos</strong></div>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>02 /</span> AM INDUSTRIA DEL ESTILO · TEATINOS</p>
				<div class="about-content"><h2 id="about-title">Cabello cuidado,<br /><em>estilo a tu medida.</em></h2><div><p>Trabajamos cada melena como una pieza única: escuchamos lo que buscas y proponemos el corte, el color o el tratamiento que mejor encaja contigo. Pásate por el estudio y descubre hasta dónde podemos llevar tu look.</p><a class="social-link" href={instagramUrl} target="_blank" rel="noreferrer">Síguenos en Instagram <span aria-hidden="true">↗</span></a></div></div>
				<div class="about-footer"><span>PELUQUERÍA TEATINOS</span><span>MÁLAGA</span><span>✳</span></div>
			</section>

			<section class="gallery-section" id="galeria" aria-labelledby="gallery-title">
				<p class="section-label"><span>03 /</span> GALERÍA</p>
				<div class="gallery-content"><h2 id="gallery-title">Momentos<br /><em>del estudio.</em></h2><p>Algunas imágenes de AM Industria del Estilo. Toca cualquiera para ver la galería completa en Google Maps.</p></div>
				<div class="gallery-grid">{galleryPhotos.map((photo, index) => <a class="gallery-photo" href={mapsUrl} target="_blank" rel="noreferrer" aria-label={`Ver la foto ${index + 1} de AM Industria del Estilo en Google Maps`}><Image src={photo.src} alt={photo.alt} widths={[320, 480, 640]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw" format="avif" quality={65} loading="lazy" decoding="async" /></a>)}</div>
				<div class="gallery-footer"><span>IMÁGENES DE LA FICHA DE GOOGLE MAPS</span><a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a></div>
			</section>

			<section class="contact-section" id="contacto" aria-labelledby="contact-title">
				<p class="section-label"><span>04 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy"><p class="contact-kicker">ESTAMOS EN TEATINOS</p><h2 id="contact-title">Pide tu<br /><em>cita.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-row"><span aria-hidden="true">☎</span><div><small>LLÁMANOS</small><a href={phoneHrefs[0]}>{business.phones[0]}</a></div></div>
							<div class="contact-row"><span aria-hidden="true">✉</span><div><small>ESCRÍBENOS</small><a href={emailHref}>{business.email}</a></div></div>
						</div>
						<a class="button button-dark" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-card"><div class="map-header"><span><i></i> GREGORIO PRIETO · MÁLAGA</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div><div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
							<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
							<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
							<small style="opacity:0.65;">Se carga solo al pulsar</small>
						</button>
<iframe title="Mapa de AM Industria del Estilo en Avenida de Gregorio Prieto, Málaga" data-src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div><div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar a AM Industria del Estilo">↗</a></div></div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a><a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a></div>
			</section>
		</main>

		<footer class="site-footer"><a class="brand footer-brand" href="#inicio" aria-label="AM Industria del Estilo, volver al inicio"><span class="brand-mark">AM</span><span class="brand-label">INDUSTRIA DEL ESTILO <small>PELUQUERÍA · TEATINOS</small></span></a><p>{business.streetAddress}, {business.city}<br /><a href={phoneHrefs[0]}>{business.phones[0]}</a></p><a class="footer-social" href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a><small>© {new Date().getFullYear()} AM Industria del Estilo · Málaga</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>
		<a class="phone-cta" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> Llamar a AM Industria del Estilo <strong>{business.phones[0]}</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						<WhatsappFab phone={datos.phoneHrefs[0]} name={datos.business?.name} />
						</body>
</html>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
