---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import tartar from '../assets/fotos/restaurante-pedro-marco-apaisada-03.jpg';
import langostinos from '../assets/fotos/restaurante-pedro-marco-apaisada-05.jpg';
import timbalAguacate from '../assets/fotos/restaurante-pedro-marco-apaisada-08.jpg';
import carpaccio from '../assets/fotos/restaurante-pedro-marco-apaisada-09.jpg';
import jamonHigos from '../assets/fotos/restaurante-pedro-marco-vertical-04.jpg';
import mejillones from '../assets/fotos/restaurante-pedro-marco-vertical-10.jpg';
import vieiras from '../assets/fotos/restaurante-pedro-marco-vista-7-07.jpg';

const business = {
	name: 'Restaurante Pedro Marco',
	brand: 'Pedro Marco',
	street: 'Carrer de Taixida, 10',
	city: 'Castelló de la Plana',
	region: 'Castellón',
	postalCode: '12003',
	phone: '661 38 87 95',
	latitude: 39.9894509,
	longitude: -0.0318146,
	rating: 4.5,
	reviewsCount: 772,
	site: 'https://restaurante-pedro-marco.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0x406ffac825144ebb:0x9817f19a9a5c8b5c';
const cidDecimal = '10959493864546405212';
const placeId = 'ChIJu04UJcj6b0ARXItcmprxF5g';

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Pedro+Marco/@39.9894509,-0.0318146,17z/data=!3m1!4b1!4m6!3m5!1s0x406ffac825144ebb:0x9817f19a9a5c8b5c!8m2!3d39.9894509!4d-0.0318146!16s%2Fg%2F11b6g96rv_?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude},${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34661388795';

const description =
	'Restaurante mediterráneo en la calle Taixida, 10 (Castelló de la Plana): cocina cuidada al mediodía, de 13:30 a 16:00, de martes a domingo.';

const servicios = [
	'Cocina mediterránea',
	'Servicio de mediodía',
	'Pescado y marisco',
	'Tartar de salmón',
	'Vieiras',
	'Langostinos',
	'Mejillones',
	'Jamón con higos',
	'Carpaccio',
	'Platos para compartir',
	'Reserva por teléfono',
	'Acceso adaptado',
];

const grupos = [
	{
		title: 'Para empezar',
		items: [
			{
				name: 'Tartar de salmón con mango',
				note: 'en timbal, con alcaparras y un toque de lima sobre plato azul',
			},
			{
				name: 'Timbal de aguacate y salmón',
				note: 'puré de aguacate sobre salmón en dados y alcaparras',
			},
			{
				name: 'Carpaccio con lima y alcaparras',
				note: 'láminas finas sobre pizarra, con aceite y lima',
			},
			{
				name: 'Jamón con higos y melón',
				note: 'con queso rallado por encima, servido en plato azul',
			},
		],
	},
	{
		title: 'Del mar',
		items: [
			{
				name: 'Langostinos a la plancha',
				note: 'sobre un lecho de verdes, con la cabeza para chupar',
			},
			{
				name: 'Vieiras en su concha',
				note: 'con una salsa cremosa de la casa y su coral',
			},
			{
				name: 'Mejillones al vapor',
				note: 'en bol de cristal, con su caldo y una cuchara para repartir',
			},
		],
	},
];

const galeria = [
	{
		src: tartar,
		alt: 'Tartar de salmón con mango y alcaparras en Restaurante Pedro Marco, Castelló de la Plana',
	},
	{
		src: jamonHigos,
		alt: 'Jamón con higos, melón y queso rallado en un plato azul de Pedro Marco',
	},
	{
		src: mejillones,
		alt: 'Mejillones al vapor en un bol de cristal en Restaurante Pedro Marco',
	},
	{
		src: langostinos,
		alt: 'Langostinos a la plancha sobre verduras en Restaurante Pedro Marco, Castelló',
	},
	{
		src: vieiras,
		alt: 'Vieiras en su concha con salsa cremosa en Restaurante Pedro Marco',
	},
	{
		src: carpaccio,
		alt: 'Carpaccio con lima y alcaparras sobre pizarra en Restaurante Pedro Marco',
	},
	{
		src: timbalAguacate,
		alt: 'Timbal de aguacate con salmón y alcaparras en un plato azul de Pedro Marco',
	},
];

const faqs = [
	{
		q: '¿Dónde está el Restaurante Pedro Marco?',
		a: 'En el número 10 de la calle Taixida, 12003 Castellón de la Plana. Se llega andando desde la zona centro y hay aparcamiento en las calles del entorno. Desde esta página puedes abrir el mapa y trazar la ruta con el botón «Cómo llegar».',
	},
	{
		q: '¿Qué horario tiene?',
		a: 'Abre solo al mediodía: de 13:30 a 16:00, de martes a domingo. Los lunes permanece cerrado. Es un horario corto y de servicio único, así que si vienes de fuera conviene llamar al 661 38 87 95 antes de desplazarte, sobre todo en festivos.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'No hay reserva online ni formulario en esta web: se reserva llamando al 661 38 87 95. Al ser un servicio de mediodía con pocas horas, es la forma de asegurar mesa para el día que quieras ir.',
	},
	{
		q: '¿Qué se come?',
		a: 'Cocina mediterránea, con el pescado y el marisco como protagonistas. En las fotos de la ficha aparecen el tartar de salmón con mango, un timbal de aguacate y salmón, carpaccio con lima, jamón con higos y melón, langostinos a la plancha, vieiras en su concha y mejillones al vapor. No hay carta publicada en Google: los platos del día se preguntan en el local o por teléfono.',
	},
	{
		q: '¿Es accesible para sillas de ruedas?',
		a: 'La ficha de Google marca entrada, aseo y asientos adaptados para sillas de ruedas. No marca plaza de aparcamiento adaptada, así que el aparcamiento es el de la calle.',
	},
	{
		q: '¿Se puede aparcar por la zona?',
		a: 'La ficha no anuncia aparcamiento propio ni adaptado. La calle Taixida está en la zona centro de Castellón, con aparcamiento en superficie en las calles cercanas y parkings públicos a poca distancia, así que lo más cómodo es ir con tiempo o dejar el coche en un parking.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['Pedro Marco', 'Pedro Marco Castelló', 'Restaurante Pedro Marco Castellón'],
	slogan: 'Cocina mediterránea al mediodía en Castelló de la Plana',
	description,
	url: `${business.site}/`,
	telephone: '+34 661 38 87 95',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Mediterránea', 'Pescado y marisco', 'Cocina de temporada'],
	areaServed: [
		{ '@type': 'City', name: 'Castelló de la Plana' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:30',
			closes: '16:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"restaurante-pedro-marco-vertical-04.jpg": jamonHigos,
	"restaurante-pedro-marco-apaisada-03.jpg": tartar,
	"restaurante-pedro-marco-vertical-10.jpg": mejillones,
	"restaurante-pedro-marco-apaisada-05.jpg": langostinos,
	"restaurante-pedro-marco-vista-7-07.jpg": vieiras,
	"restaurante-pedro-marco-apaisada-09.jpg": carpaccio,
	"restaurante-pedro-marco-apaisada-08.jpg": timbalAguacate,
};

const horas = [
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: '13:30 – 16:00' },
					{ day: 'Miércoles', value: '13:30 – 16:00' },
					{ day: 'Jueves', value: '13:30 – 16:00' },
					{ day: 'Viernes', value: '13:30 – 16:00' },
					{ day: 'Sábado', value: '13:30 – 16:00' },
					{ day: 'Domingo', value: '13:30 – 16:00' },
				];
const mapasPagina = {
	place: cidUrl,
	directions: cidUrl,
	streetView: cidUrl,
	embed: mapEmbedUrl,
};---

<!doctype html>
<html lang="es">
	<head>
		<title>Restaurante Pedro Marco · Cocina mediterránea en Castellón</title>
		<meta name="theme-color" content="#10343d" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Restaurante Pedro Marco, Pedro Marco Castelló, restaurante Castelló de la Plana, cocina mediterránea Castellón, comer en Castellón, tartar de salmón Castelló, vieiras Castellón, langostinos a la plancha, Carrer de Taixida 10, restaurante centro Castellón, reserva restaurante Castellón"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Restaurante Pedro Marco · Cocina mediterránea en Castellón"
			ogDescription="Tartar de salmón con mango, vieiras, langostinos y mejillones en la calle Taixida, 10. 4,5 en Google con 772 reseñas."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Tartar de salmón con mango y alcaparras del Restaurante Pedro Marco"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#10343d"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Castelló de la Plana, Castellón"
			contact={{
				street: business.street,
				locality: business.city,
				region: business.region,
				postalCode: business.postalCode,
				country: 'España',
				phone: business.phone,
				latitude: business.latitude,
				longitude: business.longitude,
			}}
			preload={[jamonHigos]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="PM"
			name={business.name}
			subtitle="Cocina mediterránea · Castelló"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: business.name,
					street: business.street,
					district: business.district ?? '',
					postalCode: business.postalCode,
					city: business.city,
				}}
								horario={horas}
								mapas={mapasPagina}
			/>
		</main>

		<LocalFooter
			mark="PM"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Pedro Marco"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34661388795?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20pedro%20marco." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante pedro marco"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
