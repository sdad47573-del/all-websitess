---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/tasca-la-caseta-dell-italiano-apaisada-06.jpg';
import interior from '../assets/fotos/tasca-la-caseta-dell-italiano-cuadrada-01.jpg';
import tagliatelle from '../assets/fotos/tasca-la-caseta-dell-italiano-apaisada-03.jpg';
import tostas from '../assets/fotos/tasca-la-caseta-dell-italiano-apaisada-04.jpg';
import carbonara from '../assets/fotos/tasca-la-caseta-dell-italiano-apaisada-05.jpg';
import penne from '../assets/fotos/tasca-la-caseta-dell-italiano-apaisada-10.jpg';
import pistacho from '../assets/fotos/tasca-la-caseta-dell-italiano-vertical-02.jpg';
import tabla from '../assets/fotos/tasca-la-caseta-dell-italiano-vertical-07.jpg';
import antipasto from '../assets/fotos/tasca-la-caseta-dell-italiano-vertical-08.jpg';
import tiramisu from '../assets/fotos/tasca-la-caseta-dell-italiano-vertical-09.jpg';

const business = {
	name: "Tasca La Caseta dell'Italiano",
	brand: "La Caseta dell'Italiano",
	tagline: 'Trattoria italiana con pasta fresca, sin pizza',
	street: 'Carrer de Navarra, 15',
	city: 'Castelló de la Plana',
	region: 'Comunitat Valenciana',
	postalCode: '12002',
	phone: '641 32 07 47',
	latitude: 39.9839958,
	longitude: -0.0400226,
	rating: 4.8,
	reviewsCount: 2451,
	site: 'https://tasca-la-caseta-dell-italiano.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0xd5fffd4c10b5511:0x9cc3691fd6625cc5';
const cidDecimal = '11295987875837009093';
const placeId = 'ChIJEVULwdT_Xw0RxVxi1h9pw5w';

const mapsUrl =
	'https://www.google.com/maps/place/TASCA+LA+CASETA+DELL+ITALIANO+TRATTORIA/@39.9839958,-0.0400226,17z/data=!3m1!4b1!4m6!3m5!1s0xd5fffd4c10b5511:0x9cc3691fd6625cc5!8m2!3d39.9839958!4d-0.0400226!16s%2Fg%2F12qh1gtbg?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=La+Caseta+dell+Italiano&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34641320747';

const description =
	"Trattoria italiana en Carrer de Navarra 15 (Castelló de la Plana): pasta fresca, antipasti, carnes y dolci. Sin pizza. Comidas y cenas, con lunes y martes cerrado.";

const servicios = [
	'Trattoria italiana',
	'Pasta fresca',
	'Antipasti',
	'Tabla de embutidos y quesos',
	'Carnes y pescado a la brasa',
	'Postres caseros',
	'Comidas y cenas',
	'Aseo adaptado',
	'Para grupos',
	'Sin pizza',
];

const grupos = [
	{
		title: 'Antipasti',
		items: [
			{
				name: 'Tabla de antipasti',
				note: 'burrata, prosciutto cotto y crudo, salame y pan de la casa con pesto',
			},
			{
				name: 'Burrata con pesto y tomate',
				note: 'servida con pan tostado y aceite de albahaca',
			},
			{
				name: 'Tostas de prosciutto',
				note: 'con queso fundido y nueces, sobre pan crujiente',
			},
		],
	},
	{
		title: 'Pasta',
		items: [
			{ name: 'Spaghetti alla carbonara', note: 'con parmesano recién rallado y pimienta' },
			{ name: 'Tagliatelle al pomodoro', note: 'salsa de tomate cocinada despacio' },
			{ name: 'Penne al ragú', note: 'con ragú de carne y parmesano' },
			{
				name: 'Tagliolini neri con marisco',
				note: 'pasta negra con mejillones, almejas y gambas',
			},
		],
	},
	{
		title: 'Secondi',
		items: [
			{ name: 'Pulpo a la brasa', note: 'uno de los platos que más se piden en las reseñas' },
			{ name: 'Pulpo parmentier', note: 'con puré de patata, entre los favoritos de la casa' },
			{ name: 'Lasaña', note: 'al horno, de la carta de siempre' },
			{ name: 'Boquerones', note: 'frescos, adobados y fritos' },
		],
	},
	{
		title: 'Dolci',
		items: [
			{ name: 'Tiramisú', note: 'en copa, con cacao espolvoreado al momento' },
			{ name: 'Tarta de pistacho', note: 'con crema y nata montada' },
			{ name: 'Postres caseros', note: 'cambian según el día; pregúntalos' },
		],
	},
];

const galeria = [
	{
		src: interior,
		alt: "Interior de La Caseta dell'Italiano con las paredes de madera, el póster de Turín y la barra, Castelló de la Plana",
	},
	{
		src: carbonara,
		alt: "Spaghetti alla carbonara con parmesano rallado de La Caseta dell'Italiano, Castelló de la Plana",
	},
	{
		src: tagliatelle,
		alt: "Tagliatelle al pomodoro de La Caseta dell'Italiano, trattoria italiana en Castelló de la Plana",
	},
	{
		src: penne,
		alt: "Penne al ragú con parmesano de La Caseta dell'Italiano, Castelló de la Plana",
	},
	{
		src: tabla,
		alt: "Tabla de antipasti con burrata, prosciutto y salame de La Caseta dell'Italiano, Castelló de la Plana",
	},
	{
		src: antipasto,
		alt: "Burrata con pesto sobre tabla de embutidos de La Caseta dell'Italiano, Castelló de la Plana",
	},
	{
		src: tostas,
		alt: "Tostas de prosciutto con queso fundido y nueces de La Caseta dell'Italiano, Castelló de la Plana",
	},
	{
		src: tiramisu,
		alt: "Tiramisú en copa con cacao de La Caseta dell'Italiano, Castelló de la Plana",
	},
	{
		src: pistacho,
		alt: "Tarta de pistacho con nata de La Caseta dell'Italiano, Castelló de la Plana",
	},
];

const faqs = [
	{
		q: "¿Dónde está La Caseta dell'Italiano?",
		a: 'En el Carrer de Navarra, 15, 12002 Castelló de la Plana, en la zona centro de la ciudad. Desde esta página puedes abrir Google Maps y trazar la ruta hasta la puerta con el botón «Cómo llegar».',
	},
	{
		q: '¿Hacen pizza?',
		a: 'No. El propio nombre de la casa lo avisa: «no trabajamos con pizza». Es una trattoria de cocina italiana con pasta fresca, antipasti, secondi y dolci; si buscas pizza, este no es el sitio.',
	},
	{
		q: '¿Qué horario tiene?',
		a: 'Sirve comidas y cenas de miércoles a domingo. De domingo a miércoles el mediodía es de 13:30 a 16:00 y la cena de 20:00 a 23:00; los jueves abre el mediodía a las 13:00 y los viernes y sábados la cena se alarga hasta las 23:30. Lunes y martes permanece cerrado.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'La carta gira en torno a la cocina italiana: antipasti como la tabla de embutidos con burrata o las tostas de prosciutto, pasta fresca (carbonara, tagliatelle al pomodoro, penne al ragú, tagliolini neri con marisco), platos como el pulpo a la brasa o el pulpo parmentier y postres caseros como el tiramisú o la tarta de pistacho.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'Con más de 2.400 reseñas y una nota de 4,8 en Google, el local es muy conocido en Castelló, así que reservar es lo más cómodo, sobre todo para cenar el fin de semana. El teléfono publicado en su ficha es el 641 32 07 47; no hay reserva online en esta web.',
	},
	{
		q: '¿El local es accesible?',
		a: 'La ficha de Google indica que tiene acceso para sillas de ruedas y aseo adaptado, pero no aparcamiento adaptado. Si necesitas una mesa concreta o más espacio, avisa al reservar por teléfono.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	alternateName: ['La Caseta', "La Caseta dell'Italiano", 'Tasca La Caseta dell Italiano Trattoria'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 641 32 07 47',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Italiana', 'Trattoria', 'Pasta fresca', 'Cocina italiana'],
	areaServed: [
		{ '@type': 'City', name: 'Castelló de la Plana' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Wednesday'],
			opens: '13:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday', 'Wednesday'],
			opens: '20:00',
			closes: '23:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday'], opens: '13:00', closes: '16:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Thursday'], opens: '20:00', closes: '23:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday'], opens: '13:30', closes: '16:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday'], opens: '20:00', closes: '23:30' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reservas por teléfono', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Cocina italiana sin pizza', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'Carta', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>La Caseta dell'Italiano · Trattoria en Castelló</title>
		<meta name="theme-color" content="#b1382c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,600&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="La Caseta dell'Italiano, trattoria Castelló, restaurante italiano Castellón, pasta fresca Castelló de la Plana, La Caseta italiana Navarra 15, comer italiano Castellón, cenar Castelló, tiramisú Castellón, sin pizza Castelló"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="La Caseta dell'Italiano · Trattoria sin pizza en Castelló"
			ogDescription="Trattoria italiana en el centro de Castelló de la Plana: pasta fresca, antipasti, pulpo a la brasa y postres caseros. Sin pizza. Carrer de Navarra, 15. 4,8 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Tagliolini neri con marisco de La Caseta dell'Italiano, trattoria italiana en Castelló de la Plana"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#b1382c"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Castelló de la Plana, Castellón"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="LC"
			name="La Caseta"
			subtitle="Trattoria italiana · Castelló"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Carrer de Navarra · Castelló"
				title="Pasta fresca,<br />antipasti<br /><em>y ninguna pizza.</em>"
				lede="La Caseta dell'Italiano es una trattoria italiana en el Carrer de Navarra, 15, en el centro de Castelló de la Plana. Pasta hecha cada día, antipasti para compartir, pulpo a la brasa y dolci caseros como el tiramisú. Aquí no hay pizza, y lo avisan desde el nombre."
				image={heroImage}
				imageAlt="Tagliolini neri con marisco servidos en La Caseta dell'Italiano, Castelló de la Plana"
				primaryCta={{ label: 'Llamar 641 32 07 47', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,8</b> en Google (2.451 reseñas)' },
					{ label: 'Cocina', html: 'Trattoria italiana' },
					{ label: 'Horario', html: 'Comidas y cenas, miércoles a domingo' },
					{ label: 'Aviso', html: 'No trabajamos con pizza' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece La Caseta dell'Italiano" items={servicios} />

			<LocalAbout
				label="Una trattoria de barrio en el centro"
				title="Madera, mantel<br />de cuadros<br /><em>y pasta al dente.</em>"
				paragraphs={[
					"Tasca La Caseta dell'Italiano ocupa un local de madera y manteles de cuadros a pocos metros del centro de Castelló de la Plana. En las paredes conviven el póster de Turín, un cartel de «spaghetti» y las botellas de la barra; en la sala, mesas de mármol y un fondo de cocina a la vista.",
					'La cocina es italiana de verdad y sin atajos: pasta fresca servida al dente —carbonara, tagliatelle al pomodoro, penne al ragú, tagliolini negros con marisco—, antipasti con burrata, prosciutto y salame, y platos de brasa como el pulpo, que es el que más aplausos se lleva en las reseñas.',
					'La casa lo dice claro en su propio nombre: «no trabajamos con pizza». Lo que sí hay es una carta larga de pasta, carnes y pescado, y una vitrina de postres caseros con tiramisú y tarta de pistacho. Ideal para una comida de grupo o una cena tranquila entre semana.',
				]}
				note="La ficha de Google suma 2.451 opiniones con una nota media de 4,8, una de las más altas de la ciudad. Los clientes repiten con la pasta («excelente pasta, mucha variedad, buen servicio, para repetir sin duda»), el pulpo parmentier, la lasaña y los boquerones. Los lunes y martes cierra."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Antipasti,<br /><em>pasta y dolci.</em>"
				description="Selección hecha a partir de los platos que aparecen en las fotos de la ficha de Google y de los que citan los clientes en las reseñas. La carta cambia, así que pregunta al reservar."
				cta={{ label: 'Reservar por teléfono', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: no hay carta oficial publicada y no se inventan importes. La carta del día y los precios se confirman en el local o por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La sala,<br /><em>la pasta y los dolci.</em>"
				description="Estas fotografías proceden del perfil de Tasca La Caseta dell'Italiano en Google Maps, con imágenes de la ficha y de sus clientes: el comedor de madera, la carbonara, los tagliolini negros, las tablas de antipasti, el tiramisú y la tarta de pistacho."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer de Navarra, 15 · 12002 Castelló"
				title="Nos vemos<br /><em>en La Caseta.</em>"
				addressLines={[
					business.street,
					`${business.postalCode} ${business.city}`,
					'Castellón, España',
				]}
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: 'Cerrado', closed: true },
					{ day: 'Miércoles', value: '13:30 – 16:00 · 20:00 – 23:00' },
					{ day: 'Jueves', value: '13:00 – 16:00 · 20:00 – 23:00' },
					{ day: 'Viernes', value: '13:30 – 16:00 · 20:00 – 23:30' },
					{ day: 'Sábado', value: '13:30 – 16:00 · 20:00 – 23:30' },
					{ day: 'Domingo', value: '13:30 – 16:00 · 20:00 – 23:00' },
				]}
				hoursNote="Horario publicado en la ficha de Google. Abre de miércoles a domingo con servicio de mediodía y de noche, y cierra lunes y martes. En festivos puede cambiar, así que llama al 641 32 07 47 antes de ir."
				mapTitle="Mapa de Tasca La Caseta dell'Italiano en el Carrer de Navarra, 15, Castelló de la Plana"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="La Caseta dell'Italiano · Castelló"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Reservas por teléfono, en el 641 32 07 47. No hay reserva online ni formulario en esta web. La ficha de Google indica acceso para sillas de ruedas y aseo adaptado, pero no aparcamiento adaptado; si necesitas una mesa concreta, avisa al reservar."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="LC"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a La Caseta"
		/>
	</body>
</html>
