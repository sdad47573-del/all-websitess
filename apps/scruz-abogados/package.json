{
  "name": "scruz-abogados",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "devh": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "bun astro check && bun typecheck && bun lint",
    "coverage": "vitest run --coverage",
    "demo": "bun run dev:mock && bun run test && bun run coverage",
    "gen:cmp": "plop component",
    "lint": "eslint . --ext .ts,.tsx,.astro",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "animate.css": "^4.1.1",
    "astro": "^5.16.5",
    "remixicon": "^4.7.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astro-components": "workspace:*",
    "@astro-icons": "workspace:*",
    "@astro-config": "workspace:*",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/check": "0.9.6",
    "@types/masonry-layout": "^4.2.8",
    "typescript": "^5.9.3",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.2",
    "@vitest/coverage-v8": "^4.0.15",
    "daisyui": "^5.5.14",
    "plop": "^4.0.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  }
}