{
  "name": "scruz-abogados",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "node scripts/clean.mjs && astro dev",
    "devh": "astro dev --host",
    "clean": "node scripts/clean.mjs",
    "clean:hard": "node scripts/clean.mjs --hard",
    "fix:cache": "node scripts/clean.mjs",
    "build": "astro build && bun scripts/prune-assets.mjs",
    "qa": "bun run check:texto && bun run build && bun scripts/check-links.mjs && bun scripts/check-link-graph.mjs && bun scripts/check-titles.mjs && bun scripts/check-city-similarity.mjs && bun scripts/audit-perf.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "bun astro check && bun typecheck && bun lint && bun run check:texto",
    "coverage": "vitest run --coverage",
    "demo": "bun run dev:mock && bun run test && bun run coverage",
    "gen:cmp": "plop component",
    "lint": "eslint .",
    "check:texto": "bun scripts/check-texto.mjs",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "indexnow": "bun scripts/indexnow.mjs",
    "indexnow:dry": "bun scripts/indexnow.mjs --dry-run",
    "indexnow:live": "bun scripts/indexnow.mjs --if-live",
    "notify": "bun run build && bun scripts/indexnow.mjs --if-live",
    "search-console:auth": "bun scripts/search-console-client.ts auth",
    "search-console:performance": "bun scripts/search-console-client.ts performance",
    "search-console:inspect": "bun scripts/search-console-client.ts inspect",
    "search-console:inspect-new": "bun scripts/search-console-client.ts inspect https://sergiocruzchacon.vercel.app/empresas/constitucion-sociedades/ https://sergiocruzchacon.vercel.app/blog/cuanto-cuesta-constituir-sl-2026/ https://sergiocruzchacon.vercel.app/blog/pactos-de-socios-sl/ https://sergiocruzchacon.vercel.app/blog/impagos-entre-empresas/ https://sergiocruzchacon.vercel.app/blog/alquilar-local-comercial-contrato/ https://sergiocruzchacon.vercel.app/blog/traspaso-de-bar-paso-a-paso/ https://sergiocruzchacon.vercel.app/blog/obra-sin-licencia-prescripcion/ https://sergiocruzchacon.vercel.app/blog/suelo-rustico-cordoba/ https://sergiocruzchacon.vercel.app/blog/categoria/urbanismo/",
    "search-console:sitemaps": "bun scripts/search-console-client.ts sitemaps"
  },
  "dependencies": {
    "@lucide/astro": "^1.45.0",
    "astro": "^7.3.2",
    "sharp": "^0.35.4",
    "simple-icons": "^16.30.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/masonry-layout": "^4.2.8",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^5.0.0",
    "daisyui": "^5.7.37",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "plop": "^4.0.5",
    "remixicon": "^4.9.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
