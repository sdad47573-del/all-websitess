---
import { ClientRouter, fade } from 'astro:transitions';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import QR from './QR.astro';
import SkipLink from '../../components/SkipLink.astro';

// Props tipados: al llamarse `Props`, astro check los usa para inferir
// Astro.props sin necesidad de casts.
interface Props {
	QRProps?: { src: unknown; alt: string; label: string };
	schemaData?: Record<string, unknown> | null;
	additionalSchemas?: Record<string, unknown>[];
	Fab?: AstroComponentFactory;
	Topbar?: AstroComponentFactory;
	Footer?: AstroComponentFactory;
	Favicon: AstroComponentFactory;
	title: string;
	description: string;
	keywords: string;
	canonical: string;
	ogTitle: string;
	ogUrl: string;
	ogImage: string;
	ogImageAlt?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogSitename: string;
	ogDescription: string;
	ogType?: string;
	articlePublishedTime?: string;
	articleModifiedTime?: string;
	articleAuthor?: string;
	twitterHandle?: string;
	author?: string;
	themeColor?: string;
	geoRegion?: string;
	geoPlacename?: string;
	robotsContent?: string;
	dataTheme?: string;
	JSONLD?: unknown;
}

const {
	QRProps,
	schemaData,
	additionalSchemas = [],
	Fab,
	Topbar,
	Footer,
	JSONLD: _JSONLD,
	Favicon,
	title,
	description,
	dataTheme,
	keywords,
	canonical,
	ogTitle,
	ogUrl,
	ogImage,
	ogImageAlt,
	ogImageWidth = 1200,
	ogImageHeight = 630,
	ogSitename,
	ogDescription,
	ogType = 'website',
	articlePublishedTime,
	articleModifiedTime,
	articleAuthor,
	twitterHandle,
	author = 'Sergio Cruz Chacón',
	themeColor = '#1e293b',
	geoRegion = 'ES-AN',
	geoPlacename = 'Lucena',
	robotsContent = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;

// og:image:type real (deducido de la extensión de la URL) — evita declarar
// webp para og:images en jpg/png.
const ogImageType = ogImage.toLowerCase().endsWith('.jpg') || ogImage.toLowerCase().endsWith('.jpeg')
	? 'image/jpeg'
	: ogImage.toLowerCase().endsWith('.png')
		? 'image/png'
		: 'image/webp';

// Robots secondary token (Google honours max-* only; fall back to plain)
const googlebotContent = robotsContent.split(',')[0].trim();

// Empaqueta schemaData + additionalSchemas en un único bloque @graph
// para máxima compatibilidad con Google Rich Results.
const combinedSchema = (() => {
	if (!schemaData && additionalSchemas.length === 0) return null;
	if (additionalSchemas.length === 0) return schemaData;
	if (!schemaData) {
		return additionalSchemas.length === 1
			? additionalSchemas[0]
			: { '@context': 'https://schema.org', '@graph': additionalSchemas };
	}
	// schemaData puede ser ya un objeto con @graph o no
	if (Array.isArray(schemaData['@graph'])) {
		return {
			...schemaData,
			'@graph': [...schemaData['@graph'], ...additionalSchemas],
		};
	}
	return {
		'@context': 'https://schema.org',
		'@graph': [schemaData, ...additionalSchemas],
	};
})();
---

<!doctype html>
<html lang="es" data-theme={dataTheme}>
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, viewport-fit=cover"
		/>

		<!-- Sin preconnect a terceros: las fuentes (Merriweather/Lato) están
		     autoalojadas en /fonts/ (ver src/styles/fonts/*.css), así que no hay
		     ningún origen externo que necesite conexión temprana.

		     El iframe de Google Maps del bloque de contacto es `loading="lazy"` y
		     queda por debajo del pliegue, de modo que un preconnect a google.com
		     aquí solo abriría una conexión en cada carga que Lighthouse marcaba
		     como "establecida previamente pero no usada". -->

		<!--
			Preload de las fuentes de la primera pantalla.

			Las fuentes se declaran con @font-face dentro de la hoja de estilos, así
			que el navegador no las descubre hasta haber descargado Y parseado el CSS:
			en la ruta crítica eso encadenaba CSS (191 ms) → fuentes (~496 ms). Con el
			preload arrancan en paralelo al CSS.

			`crossorigin` es obligatorio en preloads de fuentes (se piden en modo CORS),
			si falta el navegador descarga el archivo dos veces.

			Solo las dos de la primera pantalla: Merriweather (títulos h1-h4) y Lato
			400 (cuerpo). Lato 700 llega con font-display: swap y no se precarga para
			no competir por el ancho de banda con la imagen LCP del hero.

			Fuentes autoalojadas en /public/fonts (ver src/styles/fonts/*.css).
		-->
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="/fonts/merriweather/latin-400-700.woff2"
			crossorigin
		/>
		<link
			rel="preload"
			as="font"
			type="font/woff2"
			href="/fonts/lato/latin-400.woff2"
			crossorigin
		/>

		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Guías estructuradas para LLMs (estándar llmstxt.org). El <link>
		     permite a los crawlers de IA (GPTBot, PerplexityBot, Claude, etc.)
		     descubrir los archivos sin depender solo de robots.txt. -->
		<link rel="alternate" type="text/plain" title="LLMs.txt" href="/llms.txt" />
		<link
			rel="alternate"
			type="text/plain"
			title="LLMs.txt (contenido completo)"
			href="/llms-full.txt"
		/>
		<Favicon />

		<!--
			View Transitions de Astro 6. Habilita navegación SPA-style:
			- Topbar/Footer/Fab persistentes (no parpadean entre páginas)
			- Hero, breadcrumb y contenido principal con animación fluida
			- <script data-astro-rerun> para re-vincular listeners del mobile menu tras cada navegación
		-->
		<ClientRouter />

		<!-- Apple / PWA hints -->
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="Scruz Abogados" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="application-name" content="Scruz Abogados" />

		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={author} />
		<meta name="theme-color" content={themeColor} />

		<!-- Dublin Core (mejor indexación por bibliotecas/archivos digitales) -->
		<meta name="DC.title" content={title} />
		<meta name="DC.description" content={description} />
		<meta name="DC.language" content="es-ES" />

		<!-- SEO local geo-meta -->
		<meta name="geo.region" content={geoRegion} />
		<meta name="geo.placename" content={geoPlacename} />
		<meta name="geo.position" content="37.4075406;-4.4874247" />
		<meta name="ICBM" content="37.4075406, -4.4874247" />

		<!-- Robots (prop controlado por CustomLayout para soportar noindex) -->
		<meta name="robots" content={robotsContent} />
		<meta name="googlebot" content={googlebotContent} />
		<link rel="canonical" href={canonical} />

		<!-- hreflang (sitio sólo en español por ahora) -->
		<link
			rel="alternate"
			hreflang="es-ES"
			href={canonical}
		/>
		<link
			rel="alternate"
			hreflang="x-default"
			href={canonical}
		/>

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:url" content={ogUrl} />
		<meta property="og:site_name" content={ogSitename} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content={ogImageType} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

		{ogType === 'article' && (
			<>
				{articlePublishedTime && (
					<meta property="article:published_time" content={articlePublishedTime} />
				)}
				{articleModifiedTime && (
					<meta property="article:modified_time" content={articleModifiedTime} />
				)}
				{articleAuthor && <meta property="article:author" content={articleAuthor} />}
			</>
		)}

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		{twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
		{twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImage} />
		{ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

		<!-- JSON-LD unificado -->
		{combinedSchema && (
			<script
				is:inline
				type="application/ld+json"
				set:html={JSON.stringify(combinedSchema).replace(/</g, '\\u003c')}
			/>
		)}

		<slot name="head" />
	</head>
	<body>
		<!-- WCAG 2.4.1 skip-to-content, primer hijo interactivo del body -->
		<SkipLink transition:persist />

		{QRProps && <QR {...QRProps} transition:persist />}
		{Topbar && <Topbar />}

		<!--
			Contenido principal: fade-in entre páginas.
			Hero, breadcrumb, sections — todos comparten la misma <main> y animan juntos.

			Se usa `fade()` en lugar de `"fade"` para acortar el fundido por defecto de
			Astro (180 ms → 150 ms). La curva (cubic-bezier(0.76, 0, 0.24, 1)) es fija
			en esta versión de Astro: `fade()` solo admite `duration`, así que no se
			puede tocar desde aquí. La contrapartida importante de la duración está en
			index.css: el hero con `transition:name` (Hero.astro) sale de este grupo y
			usa el fundido por defecto del navegador, más largo; allí se iguala.
		-->
		<main id="main" transition:animate={fade({ duration: '0.15s' })}>
			<slot />
		</main>

		{Fab && <Fab transition:persist />}
		{Footer && <Footer transition:persist />}
	</body>
</html>
