---
import { Layout } from '@astro-components';
import Favicon from './Favicon.astro';

import 'remixicon/fonts/remixicon.css';
import 'animate.css';
import '../styles/index.css';
import QRImg from '@assets/QR/scruz.svg';
import Fab from '../components/Fab.astro';
import Footer3 from '../components/Footer3.astro';
import Topbar from '../components/Topbar1.astro';

const { title, description } = Astro.props;
---

<!-- <meta
			property="og:description"
			content="Especialistas en Derecho Civil, Penal, Laboral y de Familia. Más de 20 años defendiendo tus derechos en Lucena y Córdoba."
		/> -->
<Layout
	QRProps={{
		src: QRImg,
		alt: 'Código QR para compartir el sitio web de abogados Sergio Cruz Chacon',
		label: 'Escanea para compartir',
	}}
	Fab={Fab}
	JSONLD
	keywords="abogado Lucena, abogados Córdoba, despacho jurídico, asesoría legal, defensa legal, representación legal, derecho civil, derecho penal, derecho laboral, derecho familiar, derecho mercantil, derecho corporativo, contratos, litigios, servicios legales, consultoría jurídica"
	canonical="https://sergiocruzchacon.vercel.app/"
	ogTitle="Scruz Abogados | Despacho Jurídico en Lucena y Córdoba"
	ogUrl="https://sergiocruzchacon.vercel.app/"
	ogSitename="Forja Francisco Javier e Hijos"
	ogImage="https://sergiocruzchacon.vercel.app/_astro/Recurso-2@0.5x.DmAfa87E_2wstaX.webp"
	ogDescription="Abogados en Lucena y Córdoba con experiencia en Derecho Civil, Penal y Laboral."
	author="Jose Aguilar - linkedin.com/in/jose-antonio-aguilar-granados"
	themeColor="#1e293b"
	title={title}
	description={description}
	dataTheme="scruz"
	Favicon={Favicon}
	Topbar={Topbar}
	Footer={Footer3}
	schemaData={{
		'@context': 'https://schema.org',
		'@type': 'LegalService',
		name: 'Jose Aguilar',
		image: 'https://sergiocruzchacon.vercel.app/_astro/Recurso-2@0.5x.DmAfa87E_2wstaX.webp',
		'@id': 'https://sergiocruzchacon.vercel.app/',
		url: 'https://sergiocruzchacon.vercel.app/',
		telephone: '+34 666 329 155',
		address: {
			'@type': 'PostalAddress',
			streetAddress: 'Calle Principal 123',
			addressLocality: 'Lucena',
			addressRegion: 'Córdoba',
			postalCode: '14900',
			addressCountry: 'ES',
		},
		openingHours: 'Mo-Fr 09:00-18:00',
		areaServed: ['Lucena', 'Córdoba'],
		sameAs: [
			'https://www.facebook.com/scruzabogados',
			'https://www.linkedin.com/company/scruzabogados',
		],
	}}><slot /></Layout
>
