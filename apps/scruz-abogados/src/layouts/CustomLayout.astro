---
import { Layout } from '@astro-components';
import Favicon from './Favicon.astro';

import '../styles/index.css';
import QRImg from '@assets/QR/scruz.svg';
import Fab from '../components/Fab.astro';
import Footer3 from '../components/Footer3.astro';
import Topbar from '../components/Topbar1.astro';
import {
	SITE_NAME,
	SITE_TAGLINE,
	OG_IMAGE_DEFAULT,
	OG_IMAGE_WIDTH,
	OG_IMAGE_HEIGHT,
	OG_IMAGE_ALT,
	routeDefaults,
	buildBaseGraph,
	absUrl,
	canonicalFor,
	buildBreadcrumb,
} from '../data/seo';

interface CustomLayoutProps {
	title?: string;
	description?: string;
	keywords?: string;
	noindex?: boolean;
	ogImage?: string;
	ogImageAlt?: string;
	ogType?: string;
	articlePublishedTime?: string;
	articleModifiedTime?: string;
	additionalSchemas?: Record<string, unknown>[];
	offerCatalog?: import('../data/seo').OfferCatalogEntry[];
	breadcrumb?: { name: string; url: string }[];
	author?: string;
}

const {
	title,
	description,
	keywords,
	noindex = false,
	ogImage: ogImageProp,
	ogImageAlt,
	ogType = 'website',
	articlePublishedTime,
	articleModifiedTime,
	additionalSchemas = [],
	offerCatalog,
	breadcrumb,
} = Astro.props as CustomLayoutProps;

// Defensive normalisation — Astro JSX prop type for `breadcrumb` is `any`.
const breadcrumbList: { name: string; url: string }[] = Array.isArray(breadcrumb)
	? breadcrumb
	: [];

// Resolve route-aware defaults so every page always has sensible SEO,
// even if the dev forgets to pass title/description.
const currentPath = Astro.url.pathname;
const defaults = routeDefaults(currentPath);
const finalTitle = title ?? defaults.title;
const finalDescription = description ?? defaults.description;
const finalKeywords = keywords ?? defaults.keywords;

// Canonical URL — single source via canonicalFor() (slash + host normalizados)
const canonicalURL = canonicalFor(currentPath);
const ogImageURL = absUrl(ogImageProp ?? OG_IMAGE_DEFAULT);
const ogImageAltText = ogImageAlt ?? OG_IMAGE_ALT;

// Graph de Schema base + esquemas adicionales de página.
// WebPage usa title/description reales de esta página (no del sitio).
const baseGraph = buildBaseGraph(
	canonicalURL,
	ogImageURL,
	finalTitle,
	finalDescription,
	offerCatalog,
);

// Breadcrumb JSON-LD — usa helper centralizado (absUrl sobre cada item)
const extra: Record<string, unknown>[] = [];
if (breadcrumbList.length > 0) {
	extra.push(buildBreadcrumb(breadcrumbList.map((it) => ({ name: it.name, url: absUrl(it.url) }))));
}

const finalAdditionalSchemas = [...extra, ...additionalSchemas];

// Robots meta — respeta noindex explícito por página
const robotsContent = noindex
	? 'noindex, nofollow'
	: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<Layout
	QRProps={{
		src: QRImg,
		alt: 'Código QR para compartir el sitio web de abogados Scruz Abogados',
		label: 'Escanea para compartir',
	}}
	Fab={Fab}
	JSONLD
	keywords={finalKeywords}
	canonical={canonicalURL}
	ogTitle={finalTitle}
	ogUrl={canonicalURL}
	ogSitename={`${SITE_NAME} – ${SITE_TAGLINE}`}
	ogImage={ogImageURL}
	ogImageAlt={ogImageAltText}
	ogImageWidth={OG_IMAGE_WIDTH}
	ogImageHeight={OG_IMAGE_HEIGHT}
	ogDescription={finalDescription}
	ogType={ogType}
	articlePublishedTime={articlePublishedTime}
	articleModifiedTime={articleModifiedTime}
	author={Astro.props.author ?? 'Sergio Cruz Chacón'}
	themeColor="#4b6e9f"
	title={finalTitle}
	description={finalDescription}
	dataTheme="theme"
	Favicon={Favicon}
	Topbar={Topbar}
	Footer={Footer3}
	schemaData={baseGraph}
	additionalSchemas={finalAdditionalSchemas}
	robotsContent={robotsContent}
>
	<slot name="head" slot="head" />
	<!--
		Tema claro/oscuro decidido ANTES del primer pintado (sin flash blanco).
		El HTML se sirve con data-theme="theme" (claro), así que sin JavaScript la
		web se ve igual que siempre; con JS se aplica la preferencia guardada o, si
		no hay ninguna, la del sistema. Se sincroniza también el theme-color para
		que la barra del navegador móvil acompañe al tema.
	-->
	<script is:inline slot="head">
		(() => {
			const KEY = 'scruz-theme';

			const apply = (dark) => {
				document.documentElement.dataset.theme = dark ? 'theme-dark' : 'theme';
				document
					.querySelector('meta[name="theme-color"]')
					?.setAttribute('content', dark ? '#0e1620' : '#4b6e9f');
			};

			const resolve = () => {
				let stored = null;
				try {
					stored = localStorage.getItem(KEY);
				} catch {
					/* almacenamiento bloqueado (modo privado): tiramos del sistema */
				}
				return (
					stored === 'dark' ||
					(stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches)
				);
			};

			apply(resolve());

			/* ClientRouter reemplaza los atributos de <html> por los del documento
			 * entrante (servido siempre en claro), así que el tema se perdería en cada
			 * navegación SPA. Se reaplica tras el swap; el listener vive en `document`,
			 * que no se reemplaza nunca, así que basta con registrarlo una vez. */
			if (!window.__scruzThemeSync) {
				window.__scruzThemeSync = true;
				document.addEventListener('astro:after-swap', () => apply(resolve()));
			}
		})();
	</script>
	<noscript>
		{/* Sin JS el IntersectionObserver no existe: mostramos todo el contenido
		 * revelable directamente para que la página nunca dependa de JavaScript.
		 * is:inline: sin él Astro scopería el CSS y no afectaría a los elementos
		 * .reveal que viven en los componentes de página. */}
		<style is:inline>
			.reveal,
			.reveal-pop {
				opacity: 1;
				transform: none;
			}
		</style>
	</noscript>
	<slot />
	<script is:inline data-astro-rerun>
		(() => {
			/*
			 * Las animaciones de entrada (el fundido de los héroes y el reveal de scroll)
			 * corren en TODAS las cargas, incluidas las navegaciones SPA: llegar a una
			 * página desde un enlace tiene que verse igual que llegar con F5.
			 *
			 * Aquí hubo un bloque que en las navegaciones SPA quitaba las clases
			 * `.animate-fade-in-up` y marcaba como visibles de golpe los `.reveal` que ya
			 * asomaban en pantalla, buscando que el contenido apareciera "instantáneo".
			 * Salió lo contrario: al cambiar de página no se animaba nada y con F5 sí, o
			 * sea la web parecía rota. Este script se re-ejecuta en cada navegación
			 * (`data-astro-rerun`), así que basta con dejarlo trabajar igual que en la
			 * carga inicial; el observer se recrea sobre el DOM nuevo.
			 *
			 * La única excepción que se mantiene es el header: ver Topbar1.astro.
			 *
			 * BUG DEL FOOTER (arreglado con el defer de más abajo): este script vive en el
			 * slot por defecto, que el Layout pinta al final de <main> y ANTES de {Fab} y
			 * {Footer}. Al ser `is:inline`, en la carga inicial el navegador lo ejecuta
			 * durante el parseo, cuando <footer> aún no existe: querySelectorAll
			 * encontraba los .reveal del contenido (44) pero NO el del footer, que se
			 * quedaba sin observar y sin revelarse para siempre (opacity 0) en cuanto
			 * bajabas al final de la página. En SPA no pasaba nada porque data-astro-rerun
			 * re-ejecuta el script DESPUÉS del swap, con el footer ya en el DOM.
			 */
			const init = () => {
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			const revealAll = () => {
				document
					.querySelectorAll('.reveal:not(.is-visible), .reveal-pop:not(.is-visible)')
					.forEach((el) => el.classList.add('is-visible'));
			};

			// Con `prefers-reduced-motion` el CSS ya deja todo visible sin transición.
			if (prefersReducedMotion) return;

			// Red de seguridad: el reveal es decorativo, así que si no podemos observar
			// (o algo falla al montarlo) se muestra todo AL INSTANTE en lugar de dejar
			// trozos de página recortados.
			//
			// Antes había aquí un temporizador que a los 1,5 s marcaba como visibles
			// TODOS los .reveal de la página. Eso era el problema: pintaba de golpe
			// también el contenido que aún está fuera del viewport (de ahí la
			// sensación de "la página carga lenta al entrar") y, peor, desactivaba el
			// reveal al bajar, porque ya no quedaba nada por revelar.
			if (!('IntersectionObserver' in window)) {
				revealAll();
				return;
			}

			let observer;
			try {
				observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						}
					},
					// `threshold: 0` y no 0.15: el umbral es PROPORCIONAL al tamaño del
					// elemento, así que cualquier bloque más alto que ~6,5 pantallas (el
					// cuerpo entero de un artículo es un único .reveal) no llegaba nunca
					// al 15 % visible y se quedaba recortado. Con 0 basta con que asome
					// un píxel por encima del margen inferior.
					{ threshold: 0, rootMargin: '0px 0px -10% 0px' },
				);
			} catch {
				revealAll();
				return;
			}

			document.querySelectorAll('.reveal, .reveal-pop').forEach((el) => observer.observe(el));
			// Stagger: los hijos directos con .reveal se escalonan hasta 300 ms
			// para que las rejillas entrenan en cascada sin timers individuales.
			for (const group of document.querySelectorAll('[data-reveal-stagger]')) {
				[...group.children].forEach((child, i) => {
					if (!child.classList.contains('reveal') && !child.classList.contains('reveal-pop')) return;
					child.style.transitionDelay = `${Math.min(i * 60, 300)}ms`;
					child.addEventListener(
						'transitionend',
						() => {
							child.style.transitionDelay = '';
						},
						{ once: true },
					);
				});
			}
			};

			/* En carga inicial el documento sigue parseándose (readyState 'loading'):
			 * se difiere a DOMContentLoaded para que el footer ya exista. En navegaciones
			 * SPA el swap terminó antes de re-ejecutar el script, así que corre al acto.
			 * Observar tarde no pierde elementos: el IO siempre dispara un callback
			 * inicial con el estado actual, de modo que el footer ya en viewport al
			 * observar (recarga con scroll restaurado) también se revela. */
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', init, { once: true });
			} else {
				init();
			}
		})();
	</script>
</Layout>
