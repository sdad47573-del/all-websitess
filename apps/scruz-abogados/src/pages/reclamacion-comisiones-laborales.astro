---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho laboral', href: '/contratos-laborales' },
	{ label: 'Reclamación de comisiones', href: '/reclamacion-comisiones-laborales' },
];

const highlights = [
	'Revisión del contrato, el plan y los periodos de liquidación',
	'Cálculo de cantidades y comparación con los justificantes',
	'Estrategia de reclamación, negociación o defensa',
];

const sections = [
	{
		title: 'Reclamación de comisiones laborales',
		content: 'Las comisiones pueden formar parte de la retribución si así está pactado o acreditado. Una reclamación requiere revisar el contrato, los planes de ventas, las liquidaciones, los objetivos y las operaciones que la persona ha realizado.',
		points: [
			'Contrato, complementos y régimen de comisiones.',
			'Objetivos, liquidaciones, fechas y seguimiento.',
			'Facturas, pedidos, clientes y pruebas de venta.',
			'Pagos realizados, diferencias y reclamaciones anteriores.',
		],
	},
	{
		title: 'Cómo se calcula lo reclamado',
		content: 'La cantidad debe partir del régimen aplicable y de las operaciones realizadas. Las ventas no realizadas, las devoluciones, los descuentos o los cambios de clientes pueden afectar al cálculo. Por eso es importante reunir el contrato, los informes y los justificantes de cada periodo.',
	},
	{
		title: 'Reclamación y defensa',
		content: 'La estrategia puede comenzar con una reclamación escrita, seguida de negociación o un procedimiento laboral. Si la empresa rechaza la cantidad, debe solicitarse una explicación detallada sobre el motivo. El procedimiento y el plazo dependen de la situación laboral, el contrato y la normativa aplicable.',
	},
	{
		title: 'Cambios de condiciones',
		content: 'Una modificación de objetivos o del régimen de comisiones puede requerir revisión. También debe comprobarse si existe una notificación, un acuerdo posterior o una relación con una situación previa.',
	},
	{
		title: 'Cuándo se devengan las comisiones',
		content: 'El devengo depende de lo pactado: puede ligarse a la venta, al cobro del cliente, a la entrega del producto o al cierre del periodo de liquidación. Esa diferencia decide si la comisión ya es exigible aunque el cliente todavía no haya pagado. Por eso lo primero es localizar la cláusula o el plan que fija el criterio aplicable.',
		points: [
			'Cláusula del contrato o plan de ventas vigente.',
			'Momento pactado del devengo.',
			'Operaciones cerradas y pendientes de cobro.',
		],
	},
	{
		title: 'Cómo se prueban las ventas y los objetivos',
		content: 'La prueba habitual son los registros de la propia empresa, pero el trabajador puede reunir pedidos, albaranes, facturas, correos con clientes, accesos a programas de gestión y comunicaciones internas. Si la empresa no aporta la información, puede solicitarse formalmente la relación de operaciones del periodo reclamado.',
		points: [
			'Pedidos, albaranes y facturas emitidas.',
			'Correos, mensajes y accesos a programas internos.',
			'Solicitud escrita de la relación de operaciones.',
		],
	},
	{
		title: 'Reclamación de cantidad: pasos y cálculo',
		content: 'Se empieza por cuantificar el periodo y las operaciones, después se pide a la empresa la liquidación detallada y, si no se corrige, se plantea la reclamación formal. El cálculo debe separar comisiones devengadas de dietas, horas o complementos, porque mezclar conceptos debilita la petición y dificulta la negociación.',
		points: [
			'Periodos afectados y operaciones de cada uno.',
			'Importes ya cobrados y diferencias.',
			'Reclamación previa y respuesta de la empresa.',
		],
	},
];

const faqs = [
	{
		question: '¿Tengo derecho a comisiones?',
		answer: 'Depende de lo pactado y de las circunstancias. Deben revisarse el contrato, los complementos, los planes, las liquidaciones y la prueba de las operaciones realizadas.',
	},
	{
		question: '¿Qué documentos sirven para reclamarlas?',
		answer: 'Ayuda reunir contratos, liquidaciones, informes, facturas, correos y pruebas de ventas. También son útiles las comunicaciones con clientes o con la empresa.',
	},
	{
		question: '¿Se pueden reclamar comisiones no pagadas?',
		answer: 'Puede estudiarse la reclamación si existen operaciones realizadas y documentación que respalde la cantidad. La vía y el plazo deben analizarse según el caso.',
	},
	{
		question: '¿La reclamación puede causar un conflicto laboral?',
		answer: 'Depende de la situación y del contrato. Una reclamación formal puede generar una discusión, por lo que conviene valorar la estrategia y la documentación antes de actuar.',
	},
	{
		question: '¿Pueden quitarme las comisiones sin avisar?',
		answer: 'Un cambio del régimen de comisiones es una modificación de condiciones y debería comunicarse por escrito con antelación. Si se aplica sin acuerdo ni notificación, puede revisarse la legalidad de la medida y las diferencias que correspondan al periodo anterior.',
	},
];

const related = [
	{ label: 'Contratos laborales', href: '/contratos-laborales', description: 'Revisión del contrato y condiciones laborales.' },
	{ label: 'Cobro de deudas e impagos', href: '/cobro-deudas-impagos', description: 'Reclamación de cantidad y procedimiento monitorio.' },
	{ label: 'Despidos', href: '/despidos', description: 'Asesoría sobre despido y respuesta laboral.' },
];
---

<SeoLegalPage
	title="Abogado de Comisiones Laborales en Lucena | Reclamación"
	description="Reclamamos las comisiones laborales no pagadas en Lucena: revisión del contrato, los objetivos y las liquidaciones. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho laboral"
	headline="Reclamación de comisiones laborales"
	intro="Si trabajas con comisiones y no recibes el importe pactado, conviene revisar el contrato, las liquidaciones y las operaciones realizadas. Estudiamos la reclamación y su estrategia."
	highlights={highlights}
	serviceType="Asesoría para reclamación de comisiones laborales"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
/>
