---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Seguridad Social', href: '/recursos-administrativos' },
	{ label: 'Reclamación de pensiones', href: '/reclamacion-pensiones' },
];

const highlights = [
	'Revisión de la resolución y de los datos de cotización',
	'Análisis del motivo de denegación, suspensión o defecto',
	'Preparación de la reclamación y seguimiento administrativo',
];

const sections = [
	{
		title: '¿En qué casos se revisa una pensión?',
		content: 'Una reclamación puede ser necesaria cuando existe una denegación, un cálculo discutido, una suspensión, un reconocimiento incompleto o un defecto en la resolución. La respuesta depende de la situación de la persona, sus periodos de cotización, la pensión solicitada y la normativa aplicable.',
		points: [
			'Revisión de periodos de cotización y datos de afiliación.',
			'Pensión de jubilación, incapacidad, viudedad, orfandad o accidente.',
			'Reclamación de cantidades, base reguladora o complemento.',
			'Recurso administrativo y, cuando corresponda, revisión judicial.',
		],
	},
	{
		title: 'Cómo se prepara una reclamación',
		content: 'La reclamación debe identificar la resolución, explicar el desacuerdo y aportar la documentación que lo respalda. También es útil dejar constancia de las comunicaciones anteriores con el organismo y comprobar que la persona ha recibido toda la información necesaria para presentar el escrito en plazo.',
		points: [
			'Informe de vida laboral y movimientos relevantes.',
			'Resolución dictada y justificantes de notificación.',
			'Documentos médicos o funcionales cuando corresponda.',
			'Cálculos, certificados y justificantes de ingreso.',
		],
	},
	{
		title: 'Recurso administrativo frente a la Seguridad Social',
		content: 'El procedimiento aplicable debe estudiarse según el objeto de la reclamación y la situación del expediente. Es importante escoger correctamente la vía, cumplir los requisitos esenciales y presentar el escrito con claridad. Si la respuesta no es satisfactoria, puede valorarse la siguiente fase conforme a la normativa aplicable.',
	},
	{
		title: 'Documentación y seguimiento',
		content: 'La calidad de la reclamación depende de la documentación. Un profesional puede ordenar el expediente, detectar datos que no aparecen en la resolución y preparar una explicación jurídica comprensible. Durante el seguimiento deben controlarse las notificaciones, plazos y nuevas solicitudes de información.',
	},
	{
		title: 'Qué se puede reclamar: pensión, mínimos y atrasos',
		content: 'No toda discrepancia es una denegación. También puede reclamarse un cálculo que no coincide con la vida laboral, un complemento de mínimos mal aplicado o las cantidades dejadas de percibir desde la solicitud. Antes de reclamar conviene separar lo que es un error de lo que es una decisión de criterio, porque la vía y las posibilidades cambian.',
		points: [
			'Reconocimiento inicial de la pensión y de su cuantía.',
			'Complementos para alcanzar la pensión mínima cuando corresponde.',
			'Diferencias económicas ya devengadas y no abonadas.',
			'Revisión de oficio frente a reclamación del interesado.',
		],
	},
	{
		title: 'Errores de la vida laboral que reducen la pensión',
		content: 'Muchas reclamaciones nacen de un descuadre entre lo cotizado y lo reconocido. Periodos de trabajo de corta duración, empresas ya desaparecidas, contratos a tiempo parcial o etapas de cuidado familiar suelen quedar incompletos en el informe. Detectar esas lagunas a tiempo y poder acreditarlas es lo que suele marcar la diferencia en la cuantía final.',
		points: [
			'Altas y bajas que no aparecen o figuran con fechas erróneas.',
			'Periodos a tiempo parcial y su incidencia en la base.',
			'Etapas de cuidado de hijos o familiares que pueden computar.',
			'Empresas extinguidas que obligan a buscar la prueba por otra vía.',
		],
	},
	{
		title: 'Vía administrativa y vía judicial: qué cambia',
		content: 'La reclamación frente a la Seguridad Social se plantea primero ante el propio organismo, explicando el desacuerdo y aportando la prueba. Si la respuesta no llega o no es favorable, se abre la posibilidad de acudir a la vía judicial, donde ya decide un juez. La estrategia de la primera fase condiciona la segunda: un escrito bien armado deja el caso preparado.',
		points: [
			'Escrito dirigido al organismo que ha dictado la resolución.',
			'Prueba documental y, cuando procede, informe médico.',
			'Respuesta administrativa que agota o no la vía previa.',
			'Demanda ante el juzgado de lo social y su defensa.',
		],
	},
];

const faqs = [
	{
		question: '¿Se puede reclamar una pensión denegada?',
		answer: 'Sí, si existe un motivo de desacuerdo o un defecto de la resolución. Hay que revisar el motivo concreto, los periodos reconocidos, la normativa aplicable y el plazo correspondiente.',
	},
	{
		question: '¿Qué documento sirve para reclamar cotizaciones?',
		answer: 'El informe de vida laboral permite revisar los periodos registrados, pero puede ser necesario aportar contratos, nóminas o certificados de empresa para justificar periodos que no aparecen correctamente.',
	},
	{
		question: '¿Puedo reclamar una suspensión de pensión?',
		answer: 'La suspensión puede ser revisable según su causa y situación. Hay que estudiar la resolución, los hechos que la motivaron y si existe una obligación pendiente o un error en el procedimiento.',
	},
	{
		question: '¿Cuánto tarda la respuesta a la reclamación?',
		answer: 'El plazo depende del procedimiento, de la documentación y de la carga del organismo. El abogado puede ayudar a preparar el escrito y controlar las notificaciones, pero no conviene prometer una fecha sin conocer el caso.',
	},
	{
		question: '¿Qué documentación llevo a la primera consulta?',
		answer: 'Con la resolución que te hayan notificado, el justificante de la solicitud y el informe de vida laboral ya se puede hacer un primer análisis. Si además aportas contratos, nóminas, certificados de empresa o el expediente médico cuando lo haya, la valoración será mucho más concreta desde el principio.',
	},
];

const related = [
	{ label: 'Reclamación de pensión', href: '/blog/reclamacion-pension-seguridad-social', description: 'Guía informativa sobre el primer paso de una reclamación.' },
	{ label: 'Incapacidad permanente', href: '/incapacidad-permanente', description: 'Información sobre reconocimiento y revisión de la incapacidad.' },
	{ label: 'Recursos administrativos', href: '/recursos-administrativos', description: 'Orientación general sobre el procedimiento administrativo.' },
];
---

<SeoLegalPage
	title="Abogado de Reclamación de Pensiones en Lucena y Córdoba"
	description="Denegación o cuantía que no cuadra: reclamamos tu pensión a la Seguridad Social en Lucena y Córdoba. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Seguridad Social"
	headline="Reclamación de pensiones y Seguridad Social"
	intro="Una denegación, suspensión o cálculo incorrecto de una pensión puede requerir una reclamación administrativa. Revisamos el expediente y preparamos la vía adecuada para defender tus derechos."
	highlights={highlights}
	serviceType="Asesoría para reclamaciones de pensiones y Seguridad Social"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	showBlogGuides
/>
