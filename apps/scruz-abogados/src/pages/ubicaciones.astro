---
import a1 from '@assets/9.jpg';
import { getImage, Image } from '@astro-components';
import SecondaryHero from '../components/SecondaryHero.astro';
import UbicacionItem from '../components/UbicacionItem.astro';
import UbicacionItemReverse from '../components/UbicacionItemReverse.astro';
import { UBICACIONES } from '../data/data';
import CustomLayout from '../layouts/CustomLayout.astro';

const optimized = await getImage({ src: a1, width: 700, format: 'webp' });
---

<CustomLayout>
	<SecondaryHero
		title="Nuestras Ubicaciones"
		description="Estamos cerca de ti en Málaga, Lucena y Madrid, con despachos adicionales bajo demanda"
		background={optimized.src}
	/>
	<section class="py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">Nuestras Oficinas</h2><p
					class="text-xl text-gray-600"
				>
					Tres ubicaciones estratégicas para ofrecerte el mejor servicio
				</p>
			</div>
			<div class="space-y-16">
				{
					UBICACIONES.map((ubicacion, idx) =>
						idx % 2 === 0 ? (
							<UbicacionItem {...ubicacion} />
						) : (
							<UbicacionItemReverse {...ubicacion} />
						),
					)
				}
			</div>
		</div>
	</section>
	<section class="bg-gray-50 py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">Áreas de Cobertura</h2><p
					class="text-xl text-gray-600"
				>
					Atendemos clientes en múltiples ciudades y provincias
				</p>
			</div><div class="grid grid-cols-1 gap-8 md:grid-cols-3">
				<div class="rounded-xl bg-white p-8 shadow-lg">
					<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-100">
						<i class="ri-map-pin-line text-primary text-2xl"></i>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Málaga y Provincia</h3><div
						class="space-y-2"
					>
						<div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Málaga</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Marbella</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Fuengirola</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Torremolinos</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Benalmádena</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Estepona</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Antequera</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Ronda</span
							>
						</div>
					</div>
				</div><div class="rounded-xl bg-white p-8 shadow-lg">
					<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-100">
						<i class="ri-map-pin-line text-primary text-2xl"></i>
					</div>
					<h3 class="mb-4 text-xl font-bold text-gray-900">Córdoba y Provincia</h3><div
						class="space-y-2"
					>
						<div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Lucena</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Córdoba</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Puente Genil</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Montilla</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Priego de Córdoba</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Cabra</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Baena</span
							>
						</div>
					</div>
				</div><div class="rounded-xl bg-white p-8 shadow-lg">
					<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-100">
						<i class="ri-map-pin-line text-primary text-2xl"></i>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Madrid y Comunidad</h3><div
						class="space-y-2"
					>
						<div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Madrid</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Alcalá de Henares</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Getafe</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Leganés</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Fuenlabrada</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Móstoles</span
							>
						</div><div class="flex items-center space-x-2">
							<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
								>Alcorcón</span
							>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section><section class="bg-white py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="rounded-2xl bg-blue-50 p-8 md:p-12">
				<div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
					<div>
						<h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">
							Despachos Bajo Demanda
						</h2><p class="mb-6 text-lg text-gray-600">
							¿Necesitas nuestros servicios en otra ubicación? Disponemos de despachos profesionales
							bajo demanda para atender a nuestros clientes en cualquier punto de España.
						</p><div class="mb-6 space-y-4">
							<div class="flex items-center space-x-3">
								<div class="flex h-5 w-5 items-center justify-center">
									<i class="ri-check-line text-green-600"></i>
								</div><span class="text-gray-700">Despachos profesionales equipados</span>
							</div><div class="flex items-center space-x-3">
								<div class="flex h-5 w-5 items-center justify-center">
									<i class="ri-check-line text-green-600"></i>
								</div><span class="text-gray-700">Reuniones presenciales en tu ciudad</span>
							</div><div class="flex items-center space-x-3">
								<div class="flex h-5 w-5 items-center justify-center">
									<i class="ri-check-line text-green-600"></i>
								</div><span class="text-gray-700">Mismo nivel de servicio y profesionalidad</span>
							</div>
						</div>
						<a
							class="btn btn-primary btn-lg font-semibold transition-colors"
							href="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
							data-discover="true">Consultar Disponibilidad</a
						>
					</div><div>
						<Image
							alt="Despachos bajo demanda"
							class="h-64 w-full rounded-xl object-cover shadow-lg"
							src={a1}
						/>
					</div>
				</div>
			</div>
		</div>
	</section><section class="bg-primary py-20">
		<div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
			<h2 class="mb-6 text-3xl font-bold text-white md:text-4xl">
				¿Cuál es la Oficina Más Cercana?
			</h2><p class="mx-auto mb-8 max-w-3xl text-xl text-blue-100">
				Contacta con nosotros y te indicaremos la mejor opción para tu caso específico.
			</p><div class="flex flex-col justify-center gap-4 sm:flex-row">
				<a
					class="text-primary cursor-pointer rounded-lg bg-white px-8 py-4 text-lg font-semibold whitespace-nowrap transition-colors hover:bg-blue-50"
					href="mailto:info@scruzabogados.es?subject=Asunto%20del%20email&body=Texto%20del%20mensaje"
					data-discover="true">Contactar Ahora</a
				><a
					href="tel:+34 666 329 155"
					class="hover:text-primary cursor-pointer rounded-lg border-2 border-white px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-white"
					>Hablar por Teléfono</a
				>
			</div>
		</div>
	</section>
</CustomLayout>
