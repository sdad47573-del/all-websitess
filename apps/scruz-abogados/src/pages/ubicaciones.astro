							</div><div class="flex items-center space-x-2">
								<div class="h-2 w-2 rounded-full bg-blue-600"></div><span class="text-gray-700"
									>Ronda</span
								>
							</div>
						</div>
					</div><div class="rounded-xl bg-white p-8 shadow-lg">
						<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-100">
							<i class="ri-map-pin-line text-primary text-2xl"></i>
						</div>
						<h3 class="mb-4 text-xl font-bold text-gray-900">Córdoba y Provincia</h3><div
							class="space-y-2"
