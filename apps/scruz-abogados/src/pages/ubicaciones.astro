---
import Footer3 from "@components/Footer3.astro";
import Topbar1 from "@components/Topbar1.astro";
import Layout2 from "src/layouts/Layout2.astro";
---

<Layout2>
  <div class="min-h-screen bg-white">
    <Topbar1 />

    <section
      class="relative bg-cover bg-center bg-no-repeat py-24"
      style='background-image: linear-gradient(rgba(74, 109, 158, 0.8), rgba(74, 109, 158, 0.6)), url("/9.jpg");'
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center text-white">
          <h1 class="text-4xl md:text-5xl font-bold mb-6">
            Nuestras Ubicaciones
          </h1><p class="text-xl max-w-3xl mx-auto">
            Estamos cerca de ti en Málaga, Lucena y Madrid, con despachos
            adicionales bajo demanda
          </p>
        </div>
      </div>
    </section><section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Nuestras Oficinas
          </h2><p class="text-xl text-gray-600">
            Tres ubicaciones estratégicas para ofrecerte el mejor servicio
          </p>
        </div><div class="space-y-16">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
            <div class="">
              <div
                class="bg-white rounded-xl shadow-lg p-8 ring-2 ring-primary"
              >
                <h3 class="text-2xl font-bold text-gray-900 mb-2 flex gap-2">
                  Málaga
                  <div
                    class="bg-primary text-primary-content px-3 py-1 rounded-full text-sm font-semibold inline-block"
                  >
                    Oficina Principal
                  </div>
                </h3>
                <p class="text-gray-600 mb-6">Andalucía</p><p
                  class="text-gray-700 mb-6"
                >
                  Nuestra oficina principal, ubicada en el corazón de Málaga.
                  Aquí encontrarás nuestro equipo completo y todas las
                  especialidades.
                </p><div class="space-y-4 mb-6">
                  <div class="flex items-start space-x-3"></div>
                  <div class="flex items-start space-x-3">
                    <div
                      class="w-5 h-5 flex items-center justify-center mt-0.5"
                    >
                      <i class="ri-map-pin-line text-primary"></i>
                    </div><div>
                      <p class="text-gray-900 font-medium">
                        Calle Principal, 123
                      </p><p class="text-gray-600">29001 Málaga</p>
                    </div>
                  </div>
                </div>
              </div>
            </div><div class="">
              <div
                class="bg-gray-100 rounded-xl overflow-hidden shadow-lg h-80"
              >
                <iframe
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3198.5!2d-4.4214!3d36.7213!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzbCsDQzJzE2LjciTiA0wrAyNScxNy4wIlc!5e0!3m2!1ses!2ses!4v1234567890"
                  width="100%"
                  height="100%"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Mapa de Málaga"
                  style="border: 0px;"></iframe>
              </div>
            </div>
          </div><div
            class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start lg:grid-flow-col-dense"
          >
            <div class="lg:col-start-2">
              <div class="bg-white rounded-xl shadow-lg p-8">
                <h3 class="text-2xl font-bold text-gray-900 mb-2">Lucena</h3><p
                  class="text-gray-600 mb-6"
                >
                  Córdoba, Andalucía
                </p><p class="text-gray-700 mb-6">
                  Nuestra oficina en Lucena atiende toda la provincia de
                  Córdoba, ofreciendo servicios jurídicos de proximidad.
                </p><div class="space-y-4 mb-6">
                  <div class="flex items-start space-x-3">
                    <div
                      class="w-5 h-5 flex items-center justify-center mt-0.5"
                    >
                      <i class="ri-map-pin-line text-primary"></i>
                    </div>
                    <div>
                      <p class="text-gray-900 font-medium">C. el Agua, 19</p><p
                        class="text-gray-600"
                      >
                        14900 Lucena, Córdoba
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div><div class="lg:col-start-1 lg:row-start-1">
              <div
                class="bg-gray-100 rounded-xl overflow-hidden shadow-lg h-80"
              >
                <iframe
                  src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6338.5021012658535!2d-4.487424716949463!3d37.40754059899947!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd6d7100463548d7%3A0x8ddd019c9af14c71!2sAbogado%20Sergio%20Cruz%20Chac%C3%B3n!5e0!3m2!1ses!2sus!4v1761566280602!5m2!1ses!2sus"
                  width="100%"
                  height="100%"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Mapa de Lucena"
                  style="border: 0px;"></iframe>
              </div>
            </div>
          </div><div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
            <div class="">
              <div class="bg-white rounded-xl shadow-lg p-8">
                <h3 class="text-2xl font-bold text-gray-900 mb-2">Madrid</h3><p
                  class="text-gray-600 mb-6"
                >
                  Comunidad de Madrid
                </p><p class="text-gray-700 mb-6">
                  Nuestra oficina en la capital ofrece servicios especializados
                  para empresas y particulares en el centro de España.
                </p><div class="space-y-4 mb-6">
                  <div class="flex items-start space-x-3">
                    <div
                      class="w-5 h-5 flex items-center justify-center mt-0.5"
                    >
                      <i class="ri-map-pin-line text-primary"></i>
                    </div><div>
                      <p class="text-gray-900 font-medium">Gran Vía, 78</p><p
                        class="text-gray-600"
                      >
                        28013 Madrid
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div><div class="">
              <div
                class="bg-gray-100 rounded-xl overflow-hidden shadow-lg h-80"
              >
                <iframe
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3037.4!2d-3.7038!3d40.4168!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDDCsDI1JzAwLjAiTiAzwrA0MicxMy44Ilc!5e0!3m2!1ses!2ses!4v1234567892"
                  width="100%"
                  height="100%"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Mapa de Madrid"
                  style="border: 0px;"></iframe>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section><section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Áreas de Cobertura
          </h2><p class="text-xl text-gray-600">
            Atendemos clientes en múltiples ciudades y provincias
          </p>
        </div><div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white rounded-xl shadow-lg p-8">
            <div
              class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center mb-6"
            >
              <i class="ri-map-pin-line text-2xl text-primary"></i>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Málaga y Provincia
            </h3><div class="space-y-2">
              <div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Málaga</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Marbella</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Fuengirola</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Torremolinos</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Benalmádena</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Estepona</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Antequera</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Ronda</span
                >
              </div>
            </div>
          </div><div class="bg-white rounded-xl shadow-lg p-8">
            <div
              class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center mb-6"
            >
              <i class="ri-map-pin-line text-2xl text-primary"></i>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">
              Córdoba y Provincia
            </h3><div class="space-y-2">
              <div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Lucena</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Córdoba</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Puente Genil</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Montilla</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Priego de Córdoba</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Cabra</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Baena</span
                >
              </div>
            </div>
          </div><div class="bg-white rounded-xl shadow-lg p-8">
            <div
              class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center mb-6"
            >
              <i class="ri-map-pin-line text-2xl text-primary"></i>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Madrid y Comunidad
            </h3><div class="space-y-2">
              <div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Madrid</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Alcalá de Henares</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Getafe</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Leganés</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Fuenlabrada</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Móstoles</span
                >
              </div><div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-blue-600 rounded-full"></div><span
                  class="text-gray-700">Alcorcón</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section><section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-blue-50 rounded-2xl p-8 md:p-12">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <div>
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                Despachos Bajo Demanda
              </h2><p class="text-lg text-gray-600 mb-6">
                ¿Necesitas nuestros servicios en otra ubicación? Disponemos de
                despachos profesionales bajo demanda para atender a nuestros
                clientes en cualquier punto de España.
              </p><div class="space-y-4 mb-6">
                <div class="flex items-center space-x-3">
                  <div class="w-5 h-5 flex items-center justify-center">
                    <i class="ri-check-line text-green-600"></i>
                  </div><span class="text-gray-700"
                    >Despachos profesionales equipados</span
                  >
                </div><div class="flex items-center space-x-3">
                  <div class="w-5 h-5 flex items-center justify-center">
                    <i class="ri-check-line text-green-600"></i>
                  </div><span class="text-gray-700"
                    >Reuniones presenciales en tu ciudad</span
                  >
                </div><div class="flex items-center space-x-3">
                  <div class="w-5 h-5 flex items-center justify-center">
                    <i class="ri-check-line text-green-600"></i>
                  </div><span class="text-gray-700"
                    >Mismo nivel de servicio y profesionalidad</span
                  >
                </div>
              </div>
              <a
                class="btn btn-primary btn-lg font-semibold transition-colors"
                href="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
                data-discover="true">Consultar Disponibilidad</a
              >
            </div><div>
              <img
                alt="Despachos bajo demanda"
                class="rounded-xl shadow-lg object-cover w-full h-64"
                src="/9.jpg"
              />
            </div>
          </div>
        </div>
      </div>
    </section><section class="py-20 bg-primary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          ¿Cuál es la Oficina Más Cercana?
        </h2><p class="text-xl text-blue-100 mb-8 max-w-3xl mx-auto">
          Contacta con nosotros y te indicaremos la mejor opción para tu caso
          específico.
        </p><div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            class="bg-white text-primary px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-50 transition-colors cursor-pointer whitespace-nowrap"
            href="mailto:info@scruzabogados.es?subject=Asunto%20del%20email&body=Texto%20del%20mensaje"
            data-discover="true">Contactar Ahora</a
          ><a
            href="tel:+34 666 329 155"
            class="border-2 border-white text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white hover:text-primary transition-colors cursor-pointer whitespace-nowrap"
            >Hablar por Teléfono</a
          >
        </div>
      </div>
    </section>
  </div>
</Layout2>
