---
import a1 from '@assets/9.jpg';
import { getImage, Image } from '@astro-components';
import Footer3 from '../components/Footer3.astro';
import Topbar1 from '../components/Topbar1.astro';
import Layout2 from '../layouts/Layout2.astro';

const optimized = await getImage({ src: a1, width: 700, format: 'webp' });
---

<Layout2>
	<div class="min-h-screen bg-white">
		<Topbar1 />

		<section
			class="relative bg-cover bg-center bg-no-repeat py-24"
			style={`background-image: linear-gradient(rgba(74, 109, 158, 0.8),rgba(74, 109, 158, 0.6)), url(${optimized.src});`}
		>
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="text-center text-white">
					<h1 class="mb-6 text-4xl font-bold md:text-5xl">Nuestras Ubicaciones</h1><p
						class="mx-auto max-w-3xl text-xl"
					>
						Estamos cerca de ti en Málaga, Lucena y Madrid, con despachos adicionales bajo demanda
					</p>
				</div>
			</div>
		</section><section class="py-20">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="mb-16 text-center">
					<h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">Nuestras Oficinas</h2><p
						class="text-xl text-gray-600"
					>
						Tres ubicaciones estratégicas para ofrecerte el mejor servicio
					</p>
				</div><div class="space-y-16">
