---
import heroImg from '@assets/9.webp';
import { SITE_URL, SITE_NAME } from '../data/site';
import { NAP, OFFICES, OPENING_HOURS, ORG_ID } from '../data/seo';
import { Building2, Clock, Landmark, MapPin, Phone, Scale, Users, Video } from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import UbicacionItem from '../components/UbicacionItem.astro';
import UbicacionItemReverse from '../components/UbicacionItemReverse.astro';
import { UBICACIONES } from '../data/UBICACIONES';
import {
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialWhyUs,
} from '../components/editorial';

/**
 * Ancla estable por oficina (#lucena, #malaga). Sin acentos ni espacios para
 * que la URL no necesite escaparse, y ÚNICA fuente del `id` que renderizan las
 * fichas (`UbicacionItem`) y del `url` que declara el schema ItemList: si
 * divergieran, el schema apuntaría a un ancla inexistente.
 */
const anchorFor = (city: string) =>
	city
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.replace(/\s+/g, '-')
		.toLowerCase();

const heroStats = [
	{ Icon: Building2, label: 'Oficinas', value: 'Lucena · Málaga' },
	{ Icon: Clock, label: 'Horario', value: 'L–V 9:00–18:00' },
	{ Icon: Phone, label: 'Urgencias', value: '24 h' },
];

const oficina = [
	{
		Icon: MapPin,
		title: 'Lucena · C. El Agua, 19, 1º Izq.',
		description: '14900 Lucena (Córdoba). Oficina principal, en pleno centro.',
	},
	{
		Icon: Building2,
		title: 'Málaga · Av. de Gregorio Prieto, 27',
		description: '29190 Málaga, barrio de Teatinos-Universidad.',
	},
	{
		Icon: Landmark,
		title: 'Córdoba y otras sedes',
		description: 'Despachos bajo demanda con cita previa en cualquier punto de España.',
	},
	{
		Icon: Video,
		title: 'Videollamada',
		description: 'Consulta online con el mismo abogado, sin desplazarte.',
	},
];

/**
 * Cobertura por provincia. Solo se enlazan las ciudades con página propia: el hub
 * de ubicaciones reparte autoridad hacia ellas (/abogados-en-lucena/,
 * /abogados-en-malaga/, /abogados-en-rute/, …).
 *
 * Hasta sep 2026 esta lista enlazaba además 25 landings generadas por una única
 * plantilla en `LOCAL_LANDING_PAGES.ts`. Se retiraron: su texto era casi idéntico
 * entre sí (Jaccard 0,98-0,99, 0-6 palabras exclusivas por página), páginas
 * escaladas sin contenido propio. **Se han reescrito cinco** de la Costa del Sol
 * Occidental, ahora en `src/data/CITY_LANDINGS.ts`, cada una con su tribunal
 * verificado y su contenido propio; las otras veinte siguen redirigiendo a esta
 * página desde `vercel.json`. Las comarcas sin página propia se atienden desde
 * Lucena y Málaga, que es lo que dice el último bloque.
 */
// `href` es opcional: hay ciudades que se listan como zona de cobertura sin
// página propia. Sin el tipo explícito, TS no puede narrowear el union de los
// tres grupos y falla al desestructurar.
const cobertura: { title: string; cities: { name: string; href?: string }[] }[] = [
	{
		title: 'Herramientas',
		cities: [
			{
				name: '¿Qué juzgado me corresponde?',
				href: '/que-juzgado-me-corresponde/',
			},
			{
				name: 'Partidos judiciales',
				href: '/partidos-judiciales/',
			},
			{
				name: 'Calculadora de plazos',
				href: '/calculadora-plazos/',
			},
			{
				name: 'Dónde atendemos',
				href: '/donde-atendemos/',
			},
			{
				name: 'Calculadora de tasa judicial',
				href: '/calculadora-tasa-judicial/',
			},
		],
	},
	{
		title: 'Málaga y provincia',
		cities: [
			{ name: 'Málaga', href: '/abogados-en-malaga/' },
			{ name: 'Torremolinos', href: '/abogados-en-torremolinos/' },
			{ name: 'Benalmádena', href: '/abogados-en-benalmadena/' },
			{ name: 'Fuengirola', href: '/abogados-en-fuengirola/' },
			{ name: 'Marbella', href: '/abogados-en-marbella/' },
			{ name: 'Estepona', href: '/abogados-en-estepona/' },
			{ name: 'Antequera', href: '/abogados-en-antequera/' },
			{ name: 'Ronda', href: '/abogados-en-ronda/' },
			{ name: 'Alhaurín de la Torre', href: '/abogados-en-alhaurin-de-la-torre/' },
			{ name: 'Torrox', href: '/abogados-en-torrox/' },
			{ name: 'Nerja', href: '/abogados-en-nerja/' },
			{ name: 'Puente Genil', href: '/abogados-en-puente-genil/' },
		],
	},
	{
		title: 'Bahía y Sierra de Cádiz',
		cities: [
			{ name: 'Chiclana de la Frontera', href: '/abogados-en-chiclana-de-la-frontera/' },
			{ name: 'San Fernando', href: '/abogados-en-san-fernando/' },
			{ name: 'El Puerto de Santa María', href: '/abogados-en-el-puerto-de-santa-maria/' },
			{ name: 'Arcos de la Frontera', href: '/abogados-en-arcos-de-la-frontera/' },
		],
	},
	{
		title: 'Granada y Jaén',
		cities: [
			{ name: 'Santa Fe', href: '/abogados-en-santa-fe/' },
			{ name: 'Ogíjares', href: '/abogados-en-ogijares/' },
			{ name: 'Motril', href: '/abogados-en-motril/' },
			{ name: 'Almuñécar', href: '/abogados-en-almunecar/' },
			{ name: 'Guadix', href: '/abogados-en-guadix/' },
			{ name: 'Loja', href: '/abogados-en-loja/' },
			{ name: 'Baza', href: '/abogados-en-baza/' },
			{ name: 'Huéscar', href: '/abogados-en-huescar/' },
			{ name: 'Villacarrillo', href: '/abogados-en-villacarrillo/' },
		],
	},
	{
		title: 'Córdoba capital',
		cities: [{ name: 'Córdoba', href: '/abogados-en-cordoba/' }],
	},
	{
		title: 'Lucena y la Subbética',
		cities: [
			{ name: 'Lucena', href: '/abogados-en-lucena/' },
			{ name: 'Rute', href: '/abogados-en-rute/' },
			{ name: 'Montilla', href: '/abogados-en-montilla/' },
			{ name: 'Priego de Córdoba', href: '/abogados-en-priego-de-cordoba/' },
			{ name: 'Cabra', href: '/abogados-en-cabra/' },
			{ name: 'Baena', href: '/abogados-en-baena/' },
		],
	},
	{
		title: 'Sierra de Aracena (Huelva)',
		cities: [
			{ name: 'Aracena', href: '/abogados-en-aracena/' },
			{ name: 'Toda la comarca, 29 municipios' },
		],
	},
	{
		title: 'Comarcas que atendemos desde las dos oficinas',
		cities: [
			{ name: 'Costa del Sol Occidental (Marbella, Fuengirola, Estepona)' },
			{ name: 'Axarquía y Serranía malagueña (Nerja, Torrox, Ronda)' },
			{ name: 'Comarca de Antequera y Campiña de Málaga' },
			{ name: 'Córdoba capital y Valle del Guadalhorce' },
			{ name: 'Bahía y Sierra de Cádiz' },
			{ name: 'Valle de Lecrín y Vega de Granada' },
			{ name: 'Costa Tropical y Alpujarra granadina' },
			{ name: 'Sierra de Segura (Jaén)' },
		],
	},
];

const why = [
	{
		Icon: Users,
		title: 'El mismo equipo en cualquier sede',
		description:
			'Elijas la oficina que elijas, tu asunto lo lleva el mismo abogado desde el primer día: sin intermediarios ni traspasos entre departamentos.',
	},
	{
		Icon: Video,
		title: 'Presencial o por videollamada',
		description:
			'Si no puedes desplazarte, la consulta se celebra por videollamada con la misma atención, los mismos plazos y el mismo presupuesto cerrado.',
	},
	{
		Icon: Scale,
		title: 'Cobertura en toda España',
		description:
			'Además de Lucena y Málaga, contamos con despachos bajo demanda en Córdoba capital y en cualquier punto del país para las reuniones presenciales.',
	},
];

const faqEntries = [
	{
		question: '¿Cuántas oficinas tiene el despacho y dónde están?',
		answer:
			'Nuestra oficina principal está en Lucena (Calle El Agua, 19, 1º Izquierda) y tenemos una segunda sede en Málaga, en la Avenida de Gregorio Prieto, 27, en el barrio de Teatinos-Universidad. Para el resto del territorio trabajamos con despachos bajo demanda con cita previa, incluida Córdoba capital.',
	},
	{
		question: '¿En qué oficina me conviene pedir cita?',
		answer:
			'En la que te resulte más cómoda: el equipo, los criterios y el presupuesto son los mismos en las dos. Si tu asunto se va a tramitar ante los juzgados de una provincia concreta (Córdoba, Málaga u otra), te indicamos qué sede conviene según dónde se celebren las actuaciones.',
	},
	{
		question: '¿Puedo hacer la consulta por videollamada?',
		answer:
			'Sí. La videollamada es una vía habitual para clientes de otras provincias o para asuntos que no exigen presencialidad. Se cita con el mismo abogado que llevaría tu caso en la oficina y se entrega la misma documentación y presupuesto por escrito.',
	},
	{
		question: '¿Cuál es el horario de atención?',
		answer:
			'El horario de oficina es de lunes a viernes de 9:00 a 18:00 en todas las sedes. Las urgencias legales (detenciones, órdenes de protección, accidentes) se atienden fuera de ese horario por teléfono o WhatsApp en el 666 329 155.',
	},
	{
		question: '¿La primera consulta es gratuita?',
		answer:
			'Sí. La primera consulta es gratuita y confidencial, presencial en Lucena o Málaga y también por videollamada. Te explicamos las opciones reales, los plazos y un presupuesto cerrado antes de empezar: si decides no continuar, no pagas nada.',
	},
	{
		question: '¿Atendéis a clientes de fuera de Andalucía?',
		answer:
			'Sí. Gran parte de los asuntos se resuelven por videollamada y correo electrónico, y cuando hace falta una reunión presencial disponemos de despachos bajo demanda en otras ciudades de España. Los procedimientos judiciales fuera de Andalucía también se asumen, coordinando las actuaciones allí donde corresponda.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${SITE_URL}/ubicaciones/#faq`,
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

/**
 * ItemList con las sedes reales (src/data/seo.ts → OFFICES, que a su vez debe
 * coincidir con UBICACIONES). Declara cada oficina como LegalService con
 * dirección, geolocalización, teléfono y horario: es lo que ayuda a Google a
 * vincular el despacho con "abogado en Lucena" / "abogado en Málaga" y a
 * mostrar la sede correcta en el panel local. Sin @id propio para no competir
 * con la entidad Málaga del @graph base (buildBaseGraph → OFFICE_MALAGA_ID).
 */
const officesSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	'@id': `${SITE_URL}/ubicaciones/#oficinas`,
	name: `Oficinas de ${SITE_NAME}`,
	numberOfItems: OFFICES.length,
	itemListElement: OFFICES.map((office, idx) => ({
		'@type': 'ListItem',
		position: idx + 1,
		item: {
			'@type': 'LegalService',
			name: `${SITE_NAME} – ${office.city}${office.isMain ? ' (oficina principal)' : ''}`,
			url: `${SITE_URL}/ubicaciones/#${anchorFor(office.city)}`,
			telephone: NAP.phoneMobile,
			email: NAP.email,
			parentOrganization: { '@id': ORG_ID },
			address: {
				'@type': 'PostalAddress',
				streetAddress: office.streetAddress,
				addressLocality: office.city,
				addressRegion: office.region.split(',')[0],
				postalCode: office.postalCode,
				addressCountry: 'ES',
			},
			geo: {
				'@type': 'GeoCoordinates',
				latitude: office.geo.latitude,
				longitude: office.geo.longitude,
			},
			hasMap: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
				`${SITE_NAME} ${office.city}`,
			)}`,
			areaServed: [{ '@type': 'City', name: office.city }],
			openingHoursSpecification: OPENING_HOURS.map((hour) => ({
				'@type': 'OpeningHoursSpecification',
				dayOfWeek: hour.dayOfWeek,
				opens: hour.opens,
				closes: hour.closes,
			})),
		},
	})),
};
---

<CustomLayout
	title="Nuestras Oficinas en Lucena y Málaga | Scruz Abogados"
	description="Dos oficinas en Andalucía: Lucena (Córdoba) y Málaga. Atención presencial y online, con despachos bajo demanda en toda España. Consulta gratuita."
	keywords="oficinas abogados Málaga, despacho Lucena, abogados Córdoba, dirección Scruz Abogados, abogado Teatinos Málaga, abogado centro Lucena, despachos bajo demanda, consulta legal por videollamada, abogados Andalucía, teléfono abogado 666 329 155"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Ubicaciones', url: '/ubicaciones/' },
	]}
	additionalSchemas={[officesSchema, faqSchema]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Oficinas de Scruz Abogados en Lucena y Málaga"
		supertitle="Dónde estamos · Lucena y Málaga"
		description="Dos sedes estratégicas en Andalucía con atención presencial y despachos bajo demanda en toda España. El mismo abogado, estés donde estés."
		stats={heroStats}
	>
		<span slot="title">
			Nuestras oficinas: <span class="text-primary">cerca de ti, en toda Andalucía.</span>
		</span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Visítanos"
		title={'Tres puertas de entrada, <span class="text-primary">un mismo despacho.</span>'}
		factboxSupertitle="Dónde estamos"
		factboxTitle="Nuestras sedes"
		factboxItems={oficina}
	>
		<p class="mb-4">
			Nuestra <strong>oficina principal está en Lucena</strong> (Calle El Agua, 19, 1º Izquierda),
			en pleno centro, desde donde atendemos toda la provincia de Córdoba. La segunda sede está en
			<strong>Málaga</strong>, en la Avenida de Gregorio Prieto, 27 (Teatinos-Universidad), junto a
			la Universidad. Y para el resto del territorio trabajamos con despachos bajo demanda,
			incluida Córdoba capital. Puedes ver el detalle de cada una en{' '}
			<a href="/abogados-en-lucena/" data-discover="true">abogados en Lucena</a> y{' '}
			<a href="/abogados-en-malaga/" data-discover="true">abogados en Málaga</a>.
		</p>
		<p class="mb-4">
			Elegir oficina no cambia nada del servicio: el equipo es el mismo y el abogado que te atiende
			en la primera consulta es el que lleva tu asunto hasta el final. Desde Málaga atendemos la
			capital y la Costa del Sol (Marbella, Fuengirola, Torremolinos, Benalmádena, Estepona) y
			desde Lucena, la Subbética y el sur de Córdoba: Cabra, Montilla, Puente Genil, Priego de
			Córdoba, Baena, <a href="/abogados-en-rute/" data-discover="true">Rute</a> y municipios
			cercanos.
		</p>
		<p>
			Si vives lejos o no puedes desplazarte, la consulta se celebra por <strong>videollamada</strong>
			: misma información, mismos plazos y mismo presupuesto cerrado. Las urgencias legales
			(detenciones, órdenes de protección, accidentes) se atienden fuera del horario de oficina,
			porque un problema legal no espera a que abramos.
		</p>
	</EditorialIntro>

	<section class="bg-base-200 px-6 py-16 md:px-16 md:py-24">
		<div class="mx-auto max-w-6xl">
			<div class="reveal-pop mb-12 max-w-3xl">
				<p class="eyebrow">Dónde estamos</p>
				<h2 class="mb-4 font-title text-3xl leading-tight md:text-4xl lg:text-5xl">
					Nuestras oficinas de abogados en Lucena y Málaga
				</h2>
				<p class="text-base leading-relaxed text-base-content/70 md:text-lg">
					Dos sedes permanentes con atención presencial, cita previa y aparcamiento en el entorno.
					Si tu asunto se tramita en otra provincia, disponemos de despachos bajo demanda.
				</p>
			</div>
			<div class="space-y-16" data-reveal-stagger>
				{
					UBICACIONES.map((ubicacion, idx) =>
						idx % 2 === 0 ? (
							<UbicacionItem {...ubicacion} id={anchorFor(ubicacion.city)} />
						) : (
							<UbicacionItemReverse {...ubicacion} id={anchorFor(ubicacion.city)} />
						),
					)
				}
			</div>
		</div>
	</section>

	<section class="bg-base-100 px-6 py-16 md:px-16 md:py-24">
		<div class="mx-auto max-w-6xl">
			<div class="reveal-pop mb-12 max-w-3xl">
				<p class="eyebrow">Dónde atendemos</p>
				<h2 class="mb-4 font-title text-3xl leading-tight md:text-4xl lg:text-5xl">
					Áreas de cobertura: Málaga, Córdoba y toda Andalucía
				</h2>
				<p class="text-base leading-relaxed text-base-content/70 md:text-lg">
					Atendemos clientes de toda la provincia de Málaga y de Córdoba, tanto en nuestras
					sedes como desplazándonos con cita previa a la comarca.
				</p>
			</div>
			<div class="grid gap-8 md:grid-cols-2" data-reveal-stagger>
				{
					cobertura.map(({ title, cities }) => (
						<div class="card-surface reveal-pop rounded-2xl p-6 md:p-8">
							<div class="icon-chip mb-6 size-12 rounded-lg">
								<MapPin class="size-6" aria-hidden="true" />
							</div>
							<h3 class="mb-4 font-title text-xl font-bold">{title}</h3>
							<ul class="space-y-2">
								{cities.map(({ name, href }) => (
									<li class="flex items-center gap-3">
										<span class="bg-primary size-2 shrink-0 rounded-full" aria-hidden="true" />
										{href ? (
											<a
												href={href}
												class="text-primary font-medium hover:underline"
												data-discover="true"
											>
												{name}
											</a>
										) : (
											<span class="text-base-content/80">{name}</span>
										)}
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<EditorialWhyUs
		supertitle="Por qué elegir nuestro despacho"
		title="Un despacho con dos sedes y un solo interlocutor."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Información práctica sobre nuestras oficinas"
		description="Las dudas más habituales sobre las sedes, los horarios y la consulta previa."
		items={faqEntries}
	/>

	<ServiceBlogGuides
		supertitle="Blog jurídico"
		title="Guías legales de nuestras sedes"
	/>

	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'¿Cuál es la oficina <span class="text-primary">más cercana?</span>'}
		description="Dinos dónde estás y te indicamos la sede que mejor te encaja, con la primera consulta gratuita y confidencial en Lucena, Málaga o por videollamada."
		relatedLinks={[
			{ label: 'Abogados en Lucena', href: '/abogados-en-lucena/' },
			{ label: 'Abogados en Málaga', href: '/abogados-en-malaga/' },
			{ label: 'Abogados en Rute', href: '/abogados-en-rute/' },
			{ label: 'Guías del blog jurídico', href: '/blog/' },
		]}
	/>
	<section class="mx-auto max-w-5xl px-4 pb-16" aria-labelledby="atencion-montilla">
		<h2 id="atencion-montilla" class="text-2xl font-bold">Clientes de Montilla</h2>
		<p class="mt-2 text-slate-600">También atendemos consultas de clientes de Montilla desde la oficina de Lucena.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/abogados-en-montilla/">Ver información para Montilla</a>
	</section>
	<section class="mx-auto max-w-5xl px-4 pb-16" aria-labelledby="atencion-priego">
		<h2 id="atencion-priego" class="text-2xl font-bold">Clientes de Priego de Córdoba</h2>
		<p class="mt-2 text-slate-600">Atendemos también consultas de clientes de Priego de Córdoba desde la oficina de Lucena.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/abogados-en-priego-de-cordoba/">Ver información para Priego de Córdoba</a>
	</section>
	<section class="mx-auto max-w-5xl px-4 pb-16" aria-labelledby="atencion-cabra">
		<h2 id="atencion-cabra" class="text-2xl font-bold">Clientes de Cabra</h2>
		<p class="mt-2 text-slate-600">Atendemos también consultas de clientes de Cabra desde la oficina de Lucena.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/abogados-en-cabra/">Ver información para Cabra</a>
	</section>
	<section class="mx-auto max-w-5xl px-4 pb-16" aria-labelledby="atencion-baena">
		<h2 id="atencion-baena" class="text-2xl font-bold">Clientes de Baena</h2>
		<p class="mt-2 text-slate-600">Atendemos también consultas de clientes de Baena desde la oficina de Lucena.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/abogados-en-baena/">Ver información para Baena</a>
	</section>
</CustomLayout>
