---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Empresas', href: '/empresas' },
	{ label: 'Licencias de actividad', href: '/licencias-de-actividad' },
];

const highlights = [
	'Revisión de la actividad y de la documentación necesaria',
	'Preparación de la solicitud y seguimiento del expediente',
	'Recurso frente a denegaciones, subsanaciones o requerimientos',
];

const sections = [
	{
		title: 'Asesoría para licencias de actividad',
		content: 'La licencia de actividad permite desarrollar determinadas actividades económicas en un establecimiento. Los requisitos y el procedimiento dependen de la actividad, la ubicación, la normativa municipal y los requisitos ambientales o sanitarios aplicables.',
		points: [
			'Identificación de la actividad y su encaje normativo.',
			'Documentación del local, la actividad y la representación.',
			'Presentación, subsanación y seguimiento de la solicitud.',
			'Recursos ante denegaciones, condicionamientos o errores.',
		],
	},
	{
		title: 'Antes de presentar la solicitud',
		content: 'Conviene comprobar si la actividad está permitida en la zona, si necesita autorización adicional y qué documentación debe aportar la empresa. Una solicitud incompleta puede paralizar el expediente. También debe revisarse si existen actividades que no puedan compatibilizarse en la misma dirección o el mismo local.',
	},
	{
		title: 'Denegaciones y recursos',
		content: 'Si la solicitud se deniega o queda condicionada, debe revisarse el motivo exacto, la normativa y la documentación aportada. Según el caso, puede procederse a subsanar, presentar un recurso o estudiar una actuación administrativa posterior.',
	},
	{
		title: 'Alta de la actividad y cumplimiento',
		content: 'Obtener la licencia no elimina las obligaciones posteriores: puede seguir siendo necesario presentar declaraciones, mantener el local en condiciones y cumplir con las medidas de seguridad, accesibilidad, consumo o medio ambiente aplicables.',
	},
	{
		title: 'Licencia, declaración responsable y comunicación previa',
		content: 'No todas las actividades se autorizan igual. La licencia exige que el ayuntamiento compruebe el proyecto antes de abrir. La declaración responsable y la comunicación previa permiten iniciar la actividad presentando la documentación y asumiendo la empresa que cumple la normativa, sin perjuicio de la comprobación posterior. Cuál corresponde depende de la actividad, de su incidencia y de la ordenanza del municipio.',
		points: [
			'Licencia: control previo del proyecto.',
			'Declaración responsable: inicio bajo responsabilidad.',
			'Comunicación previa en actividades de menor incidencia.',
			'La ordenanza municipal concreta el régimen aplicable.',
		],
	},
	{
		title: 'El expediente paso a paso',
		content: 'El expediente se ordena alrededor de tres bloques: la actividad y su encaje urbanístico, el local con sus instalaciones, y la documentación técnica y de representación. Los defectos de forma son la causa más habitual de retraso, así que conviene preparar la relación completa de documentos y responder a la subsanación dentro del plazo concedido, sin dejar transcurrir el requerimiento.',
		points: [
			'Comprobar el local y el uso permitido en la zona.',
			'Reunir proyecto, seguros y documentación técnica.',
			'Presentar y hacer seguimiento del expediente.',
			'Subsanar sin dejar pasar el plazo concedido.',
		],
	},
	{
		title: 'Denegación, clausura y recursos',
		content: 'Si la resolución deniega o condiciona la actividad, lo primero es leer el motivo exacto: puede ser urbanístico, de accesibilidad, de ruido, de seguridad o de documentación. Según el defecto puede interesar corregirlo y volver a presentar, o recurrir la resolución por la vía que corresponda. Cuando el ayuntamiento ordena el cese, el margen de actuación es breve y conviene valorarlo de inmediato.',
		points: [
			'Identificar el defecto concreto de la denegación.',
			'Corregir y volver a presentar si es subsanable.',
			'Recurrir la resolución cuando el motivo no se comparte.',
			'Actuar con rapidez ante una orden de cese.',
		],
	},
];

const faqs = [
	{
		question: '¿Cuánto tarda una licencia de actividad?',
		answer: 'El plazo depende de la actividad, la documentación y del procedimiento aplicable. Puede haber un plazo inicial y una fase de subsanación o comprobación posterior.',
	},
	{
		question: '¿Se puede solicitar online?',
		answer: 'La forma de presentación depende del municipio y de la administración competente. Conviene verificar el procedimiento oficial antes de presentar documentos.',
	},
	{
		question: '¿Qué hago si me deniegan la licencia?',
		answer: 'Debe revisarse la resolución y el motivo de la denegación. Según el caso, puede ser posible subsanar o presentar el recurso administrativo correspondiente.',
	},
	{
		question: '¿La licencia cubre todas las actividades del local?',
		answer: 'No necesariamente. La autorización puede limitarse a una actividad concreta. Cualquier ampliación o cambio debe revisarse antes de realizarse.',
	},
	{
		question: '¿Qué diferencia hay entre licencia y declaración responsable?',
		answer: 'Con la licencia, el ayuntamiento controla el proyecto antes de que la actividad empiece. Con la declaración responsable o la comunicación previa, la empresa presenta la documentación, declara que cumple y puede abrir sin esa comprobación previa, aunque queda sujeta a la inspección posterior. Cuál de las dos se aplica depende de la actividad y de la ordenanza municipal.',
	},
];

const related = [
	{ label: 'Empresas', href: '/empresas', description: 'Servicios jurídicos para empresas y negocios.' },
	{ label: 'Contratos mercantiles', href: '/empresas/contratos-mercantiles', description: 'Contratos, obligaciones y relaciones comerciales.' },
	{ label: 'Urbanismo', href: '/urbanismo', description: 'Obras, licencias y uso del suelo.' },
];
---

<SeoLegalPage
	title="Abogado de Licencias de Actividad en Lucena | Scruz Abogados"
	description="Licencias de actividad de bares, comercios o naves: expediente, subsanaciones, denegaciones y recursos en Lucena y Córdoba. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho empresarial y administrativo"
	headline="Licencias de actividad para empresas"
	intro="La licencia de actividad es un paso esencial para muchas empresas. Revisamos la documentación, el procedimiento y las medidas necesarias para presentar la solicitud y responder a sus posibles obstáculos."
	highlights={highlights}
	serviceType="Asesoría para licencias de actividad empresarial"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
/>
