---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho civil', href: '/derecho-civil' },
	{ label: 'Nulidad de contrato', href: '/nulidad-contrato' },
];

const highlights = [
	'Revisión de la validez y de las condiciones del contrato',
	'Identificación de vicios y efectos jurídicos',
	'Estrategia de reclamación o defensa',
];

const sections = [
	{
		title: '¿Cuándo puede ser nulo un contrato?',
		content: 'Un contrato puede ser nulo cuando carece de consentimiento válido, versa sobre una materia no permitida, oculta una causa de nulidad o incumple un requisito esencial. La respuesta depende del tipo de contrato y de los hechos que lo sustentan.',
		points: [
			'Falta de consentimiento o vicios en su formación.',
			'Objeto o causa que no sean lícitos o determinados.',
			'Incumplimiento de requisitos legales esenciales.',
			'Cláusulas nulas y efectos sobre pagos o restitución.',
		],
	},
	{
		title: 'Prueba y revisión del contrato',
		content: 'La revisión debe comparar el documento con los hechos, las comunicaciones, los pagos y el contexto en que se firmó. Un contrato puede ser válido en lo general y contener una cláusula nula, por lo que conviene estudiar el problema con precisión.',
	},
	{
		title: 'Consecuencias y actuación',
		content: 'Las consecuencias dependen del vicio y de si el contrato se ha ejecutado. Puede ser necesario pedir la nulidad, la restitución o la declaración de una cláusula inválida. También puede existir una responsabilidad por daños cuando procede.',
	},
	{
		title: 'Negociación y procedimiento',
		content: 'Antes de demandar conviene conocer si la parte contraria reconoce el problema o si existe una solución contractual. Si no, debe estudiarse la vía judicial, la competencia, las pruebas y los plazos aplicables.',
	},
	{
		title: 'Nulidad y anulabilidad: la diferencia práctica',
		content: 'La nulidad absoluta supone que el contrato nunca produjo efectos válidos y puede apreciarse aunque nadie la invoque de forma expresa. La anulabilidad, en cambio, protege a una parte concreta y exige que esa parte la ejerza; si no lo hace, el contrato se mantiene como estaba. Distinguir una de otra decide quién puede reclamar, qué se puede pedir y qué ocurre con lo ya entregado.',
		points: [
			'Nulidad: vicio esencial y efectos desde el inicio.',
			'Anulabilidad: protección de una parte concreta.',
			'La anulación exige que la ejerza quien puede invocarla.',
			'Cambian la petición y el resultado con lo entregado.',
		],
	},
	{
		title: 'Vicios del consentimiento: error, dolo, violencia e intimidación',
		content: 'El consentimiento puede estar viciado cuando se firmó por un error esencial sobre el objeto o las condiciones, por un engaño determinante, por violencia o por intimidación. No basta con haberse arrepentido de lo firmado: hay que explicar qué se sabía, qué se ocultó y cómo eso llevó a aceptar un contenido que no se habría aceptado de otro modo.',
		points: [
			'Qué información se dio y cuál se omitió.',
			'Correos, mensajes y testigos de la negociación.',
			'Contexto de presión o de necesidad al firmar.',
			'Relación entre el vicio y el contenido aceptado.',
		],
	},
	{
		title: 'Efectos de declarar nulo un contrato',
		content: 'Declarada la nulidad, lo habitual es volver a la situación anterior: devolución de lo entregado, restitución de cantidades y compensación de frutos o gastos. Si el contrato ya se ejecutó en parte hay que valorar qué puede devolverse y qué se compensa en dinero. La nulidad de una sola cláusula puede dejar el resto del contrato en pie si el contrato sigue teniendo sentido sin ella.',
		points: [
			'Restitución de prestaciones y de cantidades.',
			'Compensación de frutos, gastos y mejoras.',
			'Cláusula nula con el contrato aún vigente.',
			'Daños adicionales cuando existan.',
		],
	},
];

const faqs = [
	{
		question: '¿Un contrato puede ser nulo por una cláusula?',
		answer: 'Sí, una cláusula concreta puede ser inválida aunque el contrato restante siga siendo válido. La consecuencia y la vía deben analizarse según el tipo de cláusula y el contrato.',
	},
	{
		question: '¿Qué diferencia hay entre nulidad y resolución?',
		answer: 'La nulidad puede estar relacionada con un vicio esencial del contrato o del consentimiento. La resolución puede surgir por el incumplimiento de una obligación válida. Son conceptos diferentes.',
	},
	{
		question: '¿Hay que reclamar antes de demandar?',
		answer: 'Depende del caso y de la vía aplicable. La reclamación escrita puede servir para identificar el problema, pero no sustituye necesariamente un requisito legal previo.',
	},
	{
		question: '¿Qué pasa si he pagado un contrato nulo?',
		answer: 'Puede estudiarse la restitución de cantidades y, en su caso, una reclamación de daños. La respuesta depende del vicio, de la ejecución y de la prueba.',
	},
	{
		question: '¿Puedo pedir la nulidad de una sola cláusula?',
		answer: 'Sí. Puede ocurrir que el problema se limite a una cláusula concreta y que el resto del contrato conserve sentido sin ella; entonces se pide la nulidad de esa cláusula y la devolución de lo cobrado por su aplicación. Si el contrato entero depende de esa cláusula, la petición cambia, por eso revisamos el documento antes de decidir la vía.',
	},
];

const related = [
	{ label: 'Derecho civil', href: '/derecho-civil', description: 'Información general sobre contratos y obligaciones.' },
	{ label: 'Contratos comerciales', href: '/contratos-comerciales', description: 'Asesoría para contratos de empresas.' },
	{ label: 'Incumplimiento de contrato', href: '/incumplimiento-contrato', description: 'Reclamación y defensa por incumplimiento.' },
];
---

<SeoLegalPage
	title="Abogado de Nulidad de Contratos en Lucena y Córdoba | Scruz"
	description="Nulidad de un contrato o de una cláusula por vicio del consentimiento: estudio, restitución y defensa en Lucena y Córdoba. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho civil"
	headline="Nulidad de contratos y cláusulas"
	intro="Un contrato o una cláusula puede ser inválido por un vicio de consentimiento, objeto, causa o forma. Revisamos el documento y los hechos antes de recomendar una actuación."
	highlights={highlights}
	serviceType="Asesoría sobre nulidad de contratos"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	guides={['contratos-lucena', 'alquiler-con-opcion-de-compra', 'monitorio-reclamacion-deudas']}
/>
