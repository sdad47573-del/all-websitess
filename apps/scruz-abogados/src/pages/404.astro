---
import { ArrowRight, Compass, FileText, MapPin, Phone, Scale, Search } from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';

/**
 * 404 propia. Vercel sirve este `dist/404.html` (con estado 404 real) para
 * cualquier URL que no exista, así que sustituye a su página genérica: en vez de
 * un callejón sin salida, el usuario (y el crawler que llega desde un enlace
 * viejo) encuentra las rutas principales del sitio a un clic.
 *
 * `noindex` explícito: una URL inventada no debe entrar en el índice ni heredar
 * el título del despacho. El canonical del layout apunta a /404/, que no existe,
 * y con noindex da igual.
 */
const atajos = [
	{
		Icon: Scale,
		title: 'Servicios jurídicos',
		description: 'Todas las áreas del Derecho: civil, familia, laboral, penal, mercantil y extranjería.',
		href: '/servicios/',
	},
	{
		Icon: MapPin,
		title: 'Nuestras oficinas',
		description: 'Direcciones, mapas y horarios de las sedes de Lucena y Málaga.',
		href: '/ubicaciones/',
	},
	{
		Icon: FileText,
		title: 'Blog jurídico',
		description: 'Guías prácticas con plazos, requisitos y jurisprudencia actualizada.',
		href: '/blog/',
	},
	{
		Icon: Compass,
		title: 'Quiénes somos',
		description: 'El despacho, su equipo y más de 20 años de experiencia en Andalucía.',
		href: '/quienes-somos/',
	},
];
---

<CustomLayout
	title="Página no encontrada (404) | Scruz Abogados"
	description="La página que buscas no existe o ha cambiado de dirección. Accede a los servicios jurídicos, las oficinas y el blog del despacho, o llámanos al 666 329 155."
	noindex
>
	<section class="bg-base-100 px-6 py-16 md:px-16 md:py-24">
		<div class="mx-auto max-w-4xl text-center">
			<p class="eyebrow eyebrow--center mb-3">Error 404</p>
			<h1 class="font-title mb-6 text-4xl font-bold leading-tight md:text-5xl lg:text-6xl">
				Esta página no existe
			</h1>
			<p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-base-content/70">
				Puede que el enlace esté mal escrito o que la hayamos movido de sitio. Desde aquí
				llegas a todo lo demás: si buscas asesoramiento legal, lo más rápido es llamarnos.
			</p>

			<div class="mb-12 flex flex-wrap justify-center gap-3">
				<a href="tel:+34666329155" class="btn btn-primary btn-lg">
					<Phone class="size-5" aria-hidden="true" /> Llamar al 666 329 155
				</a>
				<a href="/buscar/" class="btn btn-outline btn-neutral btn-lg" data-discover="true">
					<Search class="size-5" aria-hidden="true" /> Buscar en la web
				</a>
			</div>

			<div class="grid gap-px overflow-hidden rounded-2xl border border-base-300 bg-base-300 text-left sm:grid-cols-2" data-reveal-stagger>
				{
					atajos.map(({ Icon, title, description, href }) => (
						<a
							href={href}
							class="reveal-pop group hover-lift flex h-full flex-col bg-base-100 p-6 md:p-8"
							data-discover="true"
						>
							<div class="bg-primary/10 text-primary mb-4 flex size-11 items-center justify-center rounded-md transition-colors duration-300 group-hover:bg-primary group-hover:text-primary-content">
								<Icon class="size-5" stroke-width="1.6" aria-hidden="true" />
							</div>
							<h2 class="font-title group-hover:text-primary mb-2 text-lg font-bold transition-colors">
								{title}
							</h2>
							<p class="text-sm leading-relaxed text-base-content/70">{description}</p>
							<span class="text-primary mt-4 inline-flex items-center gap-2 text-sm font-semibold">
								Ver <ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" />
							</span>
						</a>
					))
				}
			</div>

			<p class="mt-10 text-sm text-base-content/60">
				¿Buscabas algo concreto? También puedes escribirnos a{' '}
				<a href="mailto:info@scruzabogados.es" class="text-primary font-medium">info@scruzabogados.es</a>
				.
			</p>
		</div>
	</section>
</CustomLayout>
