---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";

import heroImg from "../assets/BANNER-SERVICIOS.jpg";

import { Image } from "astro:assets";
import { DATA } from "src/data/data";
---

<Layout>
  <!-- subtitle="Aréas de Práctica" -->
  <Hero
    heroClasses="min-h-[40vh] md:min-h-[40vh]"
    heroImg={heroImg}
    title="Servicios"
  />
  <h2 class="p-6 md:p-16 text-3xl text-center sm:text-left">
    Podemos ayudarte con todas las áreas de <span class="font-bold">
      Práctica Jurídica
    </span>
  </h2>
  <div class="flex flex-wrap gap-16 justify-center !pt-0 p-6 md:p-16">
    {
      DATA.services.map(({ title, img, description, path }) => (
        <div class=" flex flex-col justify-between gap-4 items-center w-72">
          <div class=" flex flex-col items-center gap-4 ">
            <figure class=" size-11">
              <Image
                src={img}
                alt={`Representación de ${title.toLowerCase()}`}
                class="rounded-xl"
              />
            </figure>
            <h3 class="text-center card-title">{title}</h3>
            <p class="text-center">{description} </p>
          </div>
          <a href={path} class="btn btn-sm btn-wide btn-neutral">
            Más info
          </a>
        </div>
      ))
    }
  </div>
</Layout>
