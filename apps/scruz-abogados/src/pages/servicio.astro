---
import heroImg from '@assets/BANNER-SERVICIOS.jpg';
import { Image } from '@astro-components';
import Hero from '../components/Hero.astro';
import { DATA } from '../data/data';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<!-- subtitle="Aréas de Práctica" -->
	<Hero heroClasses="min-h-[40vh] md:min-h-[40vh]" heroImg={heroImg} title="Servicios" />
	<h2 class="p-6 text-center text-3xl sm:text-left md:p-16">
		Podemos ayudarte con todas las áreas de <span class="font-bold"> Práctica Jurídica </span>
	</h2>
	<div class="flex flex-wrap justify-center gap-16 p-6 !pt-0 md:p-16">
		{
			DATA.services.map(({ title, img, description, path }) => (
				<div class="flex w-72 flex-col items-center justify-between gap-4">
					<div class="flex flex-col items-center gap-4">
						<figure class="size-11">
							<Image
								src={img}
								alt={`Representación de ${title.toLowerCase()}`}
								class="rounded-xl"
							/>
						</figure>
						<h3 class="card-title text-center">{title}</h3>
						<p class="text-center">{description} </p>
					</div>
					<a href={path} class="btn btn-sm btn-wide btn-neutral">
						Más info
					</a>
				</div>
			))
		}
	</div>
</Layout>
