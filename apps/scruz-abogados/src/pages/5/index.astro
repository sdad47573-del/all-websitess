									placeholder="+34 600 000 000"
									type="tel"
									value=""
									name="telefono"
								/>
							</div>
						</div><div>
							<label for="asunto" class="mb-2 block text-sm font-semibold text-slate-900"
								>Área Legal *</label
							><select
								id="asunto"
								name="asunto"
								required=""
								class="w-full cursor-pointer rounded-lg border border-slate-300 px-4 py-3 pr-8 text-sm transition-all outline-none focus:border-amber-600 focus:ring-2 focus:ring-amber-600/20"
								><option value="">Selecciona un área</option><option value="civil"
									>Derecho Civil</option
								><option value="penal">Derecho Penal</option><option value="laboral"
									>Derecho Laboral</option
								><option value="mercantil">Derecho Mercantil</option><option value="inmobiliario"
									>Derecho Inmobiliario</option
								><option value="familia">Derecho de Familia</option><option value="otro"
									>Otro</option
								></select
							>
						</div><div>
							<label for="mensaje" class="mb-2 block text-sm font-semibold text-slate-900"
								>Mensaje *</label
							><textarea
								id="mensaje"
								name="mensaje"
								required=""
								maxlength="500"
								rows="5"
								class="w-full resize-none rounded-lg border border-slate-300 px-4 py-3 text-sm transition-all outline-none focus:border-amber-600 focus:ring-2 focus:ring-amber-600/20"
