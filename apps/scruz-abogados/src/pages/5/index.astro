								class="mt-1 text-xs text-slate-500"
							>
								Máximo 500 caracteres
							</p>
						</div><button
							type="submit"
							class="w-full cursor-pointer rounded-lg bg-amber-600 px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-all hover:bg-amber-700 disabled:cursor-not-allowed disabled:opacity-50"
							>Enviar Consulta</button
						>
					</form>
				</div><div class="space-y-8">
					<div class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
						<h4 class="mb-6 text-2xl font-bold text-slate-900">Información de Contacto</h4><div
							class="space-y-6"
						>
							<div class="flex items-start gap-4">
								<div
									class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-amber-100"
								>
									<i class="ri-map-pin-line text-2xl text-amber-600"></i>
								</div><div>
									<h5 class="mb-1 font-semibold text-slate-900">Dirección</h5><p
										class="text-slate-600"
									>
										Calle Gran Vía, 45, 3º B<br />28013 Madrid, España
