---
import Footer3 from '../components/Footer3.astro';
import Topbar1 from '../components/Topbar1.astro';
import Layout2 from '../layouts/Layout2.astro';
---

<Layout2>
	<div class="min-h-screen bg-white">
		<Topbar1 />
		<section
			class="relative bg-cover bg-center bg-no-repeat py-24"
			style='background-image: linear-gradient(rgba(74, 109, 158, 0.8),rgba(74, 109, 158, 0.6)), url("/1.jpg");'
		>
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="text-center text-white">
					<h1 class="mb-6 text-4xl font-bold md:text-5xl">Sobre Nosotros</h1><p
						class="mx-auto max-w-3xl text-xl"
					>
						Más de dos décadas ofreciendo servicios jurídicos de calidad con un enfoque humano y
						profesional
					</p>
				</div>
			</div>
		</section>

		<section id="experiencia" class="bg-white py-20">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="grid items-center gap-12 lg:grid-cols-2">
					<div>
						<h2 class="mb-6 text-4xl font-bold text-gray-900">+20 Años de Experiencia</h2><p
							class="mb-8 text-xl text-gray-600"
						>
							Nuestro compromiso con la excelencia jurídica y la satisfacción del cliente nos ha
							posicionado como uno de los bufetes más confiables de la región.
						</p><div class="mb-8 grid grid-cols-2 gap-8">
							<div class="text-center">
								<div class="text-primary mb-2 text-4xl font-bold">500+</div><div
									class="text-gray-600"
								>
									Casos Exitosos
								</div>
							</div><div class="text-center">
								<div class="text-primary mb-2 text-4xl font-bold">98%</div><div
									class="text-gray-600"
								>
									Satisfacción Cliente
								</div>
							</div><div class="text-center">
								<div class="text-primary mb-2 text-4xl font-bold">15</div><div
									class="text-gray-600"
								>
									Años Experiencia
								</div>
							</div><div class="text-center">
								<div class="text-primary mb-2 text-4xl font-bold">24/7</div><div
									class="text-gray-600"
								>
									Disponibilidad
								</div>
							</div>
						</div><div class="space-y-4">
							<div class="flex items-center">
								<i class="ri-check-line mr-3 text-xl text-green-600"></i><span class="text-gray-700"
									>Colegiado en el Ilustre Colegio de Abogados</span
								>
							</div><div class="flex items-center">
								<i class="ri-check-line mr-3 text-xl text-green-600"></i><span class="text-gray-700"
									>Especialización en múltiples áreas del derecho</span
								>
							</div><div class="flex items-center">
								<i class="ri-check-line mr-3 text-xl text-green-600"></i><span class="text-gray-700"
									>Formación continua y actualización jurídica</span
								>
							</div><div class="flex items-center">
								<i class="ri-check-line mr-3 text-xl text-green-600"></i><span class="text-gray-700"
									>Atención personalizada y cercana</span
								>
							</div>
						</div>
					</div><div class="relative">
						<img
							alt="Abogado profesional"
							class="h-96 w-full rounded-xl object-cover object-top shadow-2xl lg:h-full"
							src="https://readdy.ai/api/search-image?query=Professional%20lawyer%20in%20elegant%20office%20setting%2C%20confident%20pose%2C%20wearing%20formal%20business%20suit%2C%20law%20books%20and%20legal%20documents%20in%20background%2C%20warm%20professional%20lighting%2C%20trustworthy%20appearance%2C%20modern%20office%20environment%2C%20scales%20of%20justice%20visible%2C%20representing%20legal%20expertise%20and%20professionalism&width=600&height=800&seq=lawyer-portrait&orientation=portrait"
						/><div
							class="absolute inset-0 rounded-xl bg-gradient-to-t from-black/20 to-transparent"
						>
						</div>
					</div>
				</div>
			</div>
		</section>
		<section class="py-20">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="mb-20">
					<h2 class="mb-12 text-center text-3xl font-bold text-gray-900 md:text-4xl">
						Nuestros Valores
					</h2><div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
						<div class="text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
							>
								<i class="ri-shield-check-line text-primary text-2xl"></i>
							</div><h3 class="mb-3 text-xl font-bold text-gray-900">Integridad</h3><p
								class="text-gray-600"
							>
								Actuamos con transparencia y honestidad en cada caso, manteniendo siempre los más
								altos estándares éticos.
							</p>
						</div><div class="text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
							>
								<i class="ri-user-heart-line text-primary text-2xl"></i>
							</div><h3 class="mb-3 text-xl font-bold text-gray-900">Cercanía</h3><p
								class="text-gray-600"
							>
								Tratamos a cada cliente como único, ofreciendo un servicio personalizado y humano.
							</p>
						</div><div class="text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
							>
								<i class="ri-award-line text-primary text-2xl"></i>
							</div><h3 class="mb-3 text-xl font-bold text-gray-900">Excelencia</h3><p
								class="text-gray-600"
							>
								Buscamos constantemente la excelencia en nuestro trabajo, manteniéndonos
								actualizados en las últimas normativas.
							</p>
						</div><div class="text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
							>
								<i class="ri-time-line text-primary text-2xl"></i>
							</div><h3 class="mb-3 text-xl font-bold text-gray-900">Compromiso</h3><p
								class="text-gray-600"
							>
								Nos comprometemos con los plazos y resultados, trabajando incansablemente por
								nuestros clientes.
							</p>
						</div>
					</div>
				</div>

				<ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical mb-20">
					<!-- Paso 1 -->
					<li>
						<div class="timeline-middle text-2xl">
							<i class="ri-focus-fill text-primary"></i>
						</div>
						<div
							class="timeline-start mb-10 flex w-full flex-col items-center md:items-end md:text-end"
						>
							<div class="rounded-lg bg-white p-6 shadow-lg">
								<div class="text-primary mb-2 text-lg font-bold">2004</div><h3
									class="mb-2 text-xl font-bold text-gray-900"
								>
									Fundación del Despacho
								</h3><p class="text-gray-600">
									Inicio de actividad en Málaga, especializándose en Derecho Civil y de Familia.
								</p>
							</div>
						</div>
						<hr class="bg-blue-200" />
					</li>
					<!-- Paso 2 -->
					<li>
						<hr class="bg-blue-200" />
						<div class="timeline-middle text-2xl">
							<i class="ri-focus-fill text-primary"></i>
						</div>
						<div
							class="timeline-end mb-10 flex w-full flex-col items-center md:items-start md:text-start"
						>
							<div class="rounded-lg bg-white p-6 shadow-lg">
								<div class="text-primary mb-2 text-lg font-bold">2008</div><h3
									class="mb-2 text-xl font-bold text-gray-900"
								>
									Expansión a Córdoba
								</h3><p class="text-gray-600">
									Apertura de oficina en Lucena para atender toda la provincia de Córdoba.
								</p>
							</div>
						</div>
						<hr class="bg-blue-200" />
					</li>
					<!-- Paso 3 -->
					<li>
						<hr class="bg-blue-200" />
						<div class="timeline-middle text-2xl">
							<i class="ri-focus-fill text-primary"></i>
						</div>
						<div
							class="timeline-start mb-10 flex w-full flex-col items-center md:items-end md:text-end"
						>
							<div class="rounded-lg bg-white p-6 shadow-lg">
								<div class="text-primary mb-2 text-lg font-bold">2015</div><h3
									class="mb-2 text-xl font-bold text-gray-900"
								>
									Incorporación Derecho Mercantil
								</h3><p class="text-gray-600">
									Ampliación de servicios hacia empresas y derecho mercantil.
								</p>
							</div>
						</div>
						<hr class="bg-blue-200" />
					</li>
					<!-- Paso 4 -->
					<li>
						<hr class="bg-blue-200" />

						<div class="timeline-middle text-2xl">
							<i class="ri-focus-fill text-primary"></i>
						</div>
						<div
							class="timeline-end mb-10 flex w-full flex-col items-center md:items-start md:text-start"
						>
							<div class="rounded-lg bg-white p-6 shadow-lg">
								<div class="text-primary mb-2 text-lg font-bold">2020</div><h3
									class="mb-2 text-xl font-bold text-gray-900"
								>
									Oficina en Madrid
								</h3><p class="text-gray-600">Expansión nacional con nueva sede en la capital.</p>
							</div>
						</div>
						<hr class="bg-blue-200" />
					</li>
					<!--  -->
					<li>
						<hr class="bg-blue-200" />
						<div class="timeline-middle text-2xl">
							<i class="ri-focus-fill text-primary"></i>
						</div>
						<div
							class="timeline-start mb-10 flex w-full flex-col items-center md:items-end md:text-end"
						>
							<div class="rounded-lg bg-white p-6 shadow-lg">
								<div class="text-primary mb-2 text-lg font-bold">2024</div><h3
									class="mb-2 text-xl font-bold text-gray-900"
								>
									Más de 20 años
								</h3><p class="text-gray-600">
									Consolidación como referente en servicios jurídicos integrales.
								</p>
							</div>
						</div>
					</li>
				</ul>
				<div class="rounded-2xl bg-gray-50 p-8 md:p-12">
					<div class="text-center">
						<h2 class="mb-6 text-3xl font-bold text-gray-900 md:text-4xl">Nuestra Misión</h2><p
							class="mx-auto mb-8 max-w-4xl text-xl text-gray-600"
						>
							Proporcionar servicios jurídicos de la más alta calidad, combinando experiencia,
							profesionalidad y cercanía humana. Nuestro objetivo es ser el socio legal de confianza
							que acompañe a nuestros clientes en cada etapa de sus vidas profesionales y
							personales.
						</p><div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
							<div class="text-center">
								<div class="text-primary mb-2 text-4xl font-bold">20+</div><div
									class="text-gray-600"
								>
									Años de Experiencia
								</div>
							</div><div class="text-center">
								<div class="text-primary mb-2 text-4xl font-bold">3</div><div class="text-gray-600">
									Oficinas
								</div>
							</div><div class="text-center">
								<div class="text-primary mb-2 text-4xl font-bold">1000+</div><div
									class="text-gray-600"
								>
									Casos Resueltos
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		<section class="bg-primary py-20">
			<div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
				<h2 class="mb-6 text-3xl font-bold text-white md:text-4xl">¿Quieres Conocer Más?</h2><p
					class="mx-auto mb-8 max-w-3xl text-xl text-blue-100"
				>
					Agenda una consulta gratuita y descubre cómo nuestro equipo puede ayudarte con tus
					necesidades legales.
				</p><div class="flex flex-col justify-center gap-4 sm:flex-row">
					<a
						class="text-primary cursor-pointer rounded-lg bg-white px-8 py-4 text-lg font-semibold whitespace-nowrap transition-colors hover:bg-blue-50"
						href="tel:+34666329155"
						data-discover="true">Consulta Gratuita</a
					><a
						class="hover:text-primary cursor-pointer rounded-lg border-2 border-white px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-white"
						href="/servicios"
						data-discover="true">Ver Servicios</a
					>
				</div>
			</div>
		</section>
	</div>
</Layout2>
