---
import Footer3 from "@components/Footer3.astro";
import Topbar1 from "@components/Topbar1.astro";
import Layout2 from "src/layouts/Layout2.astro";
---

<Layout2>
  <div class="min-h-screen bg-white">
    <Topbar1 />
    <section
      class="relative bg-cover bg-center bg-no-repeat py-24"
      style='background-image: linear-gradient(rgba(74, 109, 158, 0.8),rgba(74, 109, 158, 0.6)), url("/1.jpg");'
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center text-white">
          <h1 class="text-4xl md:text-5xl font-bold mb-6">Sobre Nosotros</h1><p
            class="text-xl max-w-3xl mx-auto"
          >
            Más de dos décadas ofreciendo servicios jurídicos de calidad con un
            enfoque humano y profesional
          </p>
        </div>
      </div>
    </section>

    <section id="experiencia" class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-4xl font-bold text-gray-900 mb-6">
              +20 Años de Experiencia
            </h2><p class="text-xl text-gray-600 mb-8">
              Nuestro compromiso con la excelencia jurídica y la satisfacción
              del cliente nos ha posicionado como uno de los bufetes más
              confiables de la región.
            </p><div class="grid grid-cols-2 gap-8 mb-8">
              <div class="text-center">
                <div class="text-4xl font-bold text-primary mb-2">500+</div><div
                  class="text-gray-600"
                >
                  Casos Exitosos
                </div>
              </div><div class="text-center">
                <div class="text-4xl font-bold text-primary mb-2">98%</div><div
                  class="text-gray-600"
                >
                  Satisfacción Cliente
                </div>
              </div><div class="text-center">
                <div class="text-4xl font-bold text-primary mb-2">15</div><div
                  class="text-gray-600"
                >
                  Años Experiencia
                </div>
              </div><div class="text-center">
                <div class="text-4xl font-bold text-primary mb-2">24/7</div><div
                  class="text-gray-600"
                >
                  Disponibilidad
                </div>
              </div>
            </div><div class="space-y-4">
              <div class="flex items-center">
                <i class="ri-check-line text-green-600 text-xl mr-3"></i><span
                  class="text-gray-700"
                  >Colegiado en el Ilustre Colegio de Abogados</span
                >
              </div><div class="flex items-center">
                <i class="ri-check-line text-green-600 text-xl mr-3"></i><span
                  class="text-gray-700"
                  >Especialización en múltiples áreas del derecho</span
                >
              </div><div class="flex items-center">
                <i class="ri-check-line text-green-600 text-xl mr-3"></i><span
                  class="text-gray-700"
                  >Formación continua y actualización jurídica</span
                >
              </div><div class="flex items-center">
                <i class="ri-check-line text-green-600 text-xl mr-3"></i><span
                  class="text-gray-700">Atención personalizada y cercana</span
                >
              </div>
            </div>
          </div><div class="relative">
            <img
              alt="Abogado profesional"
              class="rounded-xl shadow-2xl object-cover w-full h-96 lg:h-full object-top"
              src="https://readdy.ai/api/search-image?query=Professional%20lawyer%20in%20elegant%20office%20setting%2C%20confident%20pose%2C%20wearing%20formal%20business%20suit%2C%20law%20books%20and%20legal%20documents%20in%20background%2C%20warm%20professional%20lighting%2C%20trustworthy%20appearance%2C%20modern%20office%20environment%2C%20scales%20of%20justice%20visible%2C%20representing%20legal%20expertise%20and%20professionalism&width=600&height=800&seq=lawyer-portrait&orientation=portrait"
            /><div
              class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent rounded-xl"
            >
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-20">
          <h2
            class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-12"
          >
            Nuestros Valores
          </h2><div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
          >
            <div class="text-center">
              <div
                class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <i class="ri-shield-check-line text-2xl text-primary"></i>
              </div><h3 class="text-xl font-bold text-gray-900 mb-3">
                Integridad
              </h3><p class="text-gray-600">
                Actuamos con transparencia y honestidad en cada caso,
                manteniendo siempre los más altos estándares éticos.
              </p>
            </div><div class="text-center">
              <div
                class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <i class="ri-user-heart-line text-2xl text-primary"></i>
              </div><h3 class="text-xl font-bold text-gray-900 mb-3">
                Cercanía
              </h3><p class="text-gray-600">
                Tratamos a cada cliente como único, ofreciendo un servicio
                personalizado y humano.
              </p>
            </div><div class="text-center">
              <div
                class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <i class="ri-award-line text-2xl text-primary"></i>
              </div><h3 class="text-xl font-bold text-gray-900 mb-3">
                Excelencia
              </h3><p class="text-gray-600">
                Buscamos constantemente la excelencia en nuestro trabajo,
                manteniéndonos actualizados en las últimas normativas.
              </p>
            </div><div class="text-center">
              <div
                class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <i class="ri-time-line text-2xl text-primary"></i>
              </div><h3 class="text-xl font-bold text-gray-900 mb-3">
                Compromiso
              </h3><p class="text-gray-600">
                Nos comprometemos con los plazos y resultados, trabajando
                incansablemente por nuestros clientes.
              </p>
            </div>
          </div>
        </div>

        <ul
          class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical mb-20"
        >
          <!-- Paso 1 -->
          <li>
            <div class="timeline-middle text-2xl">
              <i class="ri-focus-fill text-primary"></i>
            </div>
            <div
              class="timeline-start mb-10 md:text-end flex flex-col items-center md:items-end w-full"
            >
              <div class="bg-white rounded-lg shadow-lg p-6">
                <div class="text-primary font-bold text-lg mb-2">2004</div><h3
                  class="text-xl font-bold text-gray-900 mb-2"
                >
                  Fundación del Despacho
                </h3><p class="text-gray-600">
                  Inicio de actividad en Málaga, especializándose en Derecho
                  Civil y de Familia.
                </p>
              </div>
            </div>
            <hr class="bg-blue-200" />
          </li>
          <!-- Paso 2 -->
          <li>
            <hr class="bg-blue-200" />
            <div class="timeline-middle text-2xl">
              <i class="ri-focus-fill text-primary"></i>
            </div>
            <div
              class="timeline-end mb-10 md:text-start w-full md:items-start items-center flex flex-col"
            >
              <div class="bg-white rounded-lg shadow-lg p-6">
                <div class="text-primary font-bold text-lg mb-2">2008</div><h3
                  class="text-xl font-bold text-gray-900 mb-2"
                >
                  Expansión a Córdoba
                </h3><p class="text-gray-600">
                  Apertura de oficina en Lucena para atender toda la provincia
                  de Córdoba.
                </p>
              </div>
            </div>
            <hr class="bg-blue-200" />
          </li>
          <!-- Paso 3 -->
          <li>
            <hr class="bg-blue-200" />
            <div class="timeline-middle text-2xl">
              <i class="ri-focus-fill text-primary"></i>
            </div>
            <div
              class="timeline-start mb-10 md:text-end flex flex-col items-center md:items-end w-full"
            >
              <div class="bg-white rounded-lg shadow-lg p-6">
                <div class="text-primary font-bold text-lg mb-2">2015</div><h3
                  class="text-xl font-bold text-gray-900 mb-2"
                >
                  Incorporación Derecho Mercantil
                </h3><p class="text-gray-600">
                  Ampliación de servicios hacia empresas y derecho mercantil.
                </p>
              </div>
            </div>
            <hr class="bg-blue-200" />
          </li>
          <!-- Paso 4 -->
          <li>
            <hr class="bg-blue-200" />

            <div class="timeline-middle text-2xl">
              <i class="ri-focus-fill text-primary"></i>
            </div>
            <div
              class="timeline-end mb-10 md:text-start w-full md:items-start items-center flex flex-col"
            >
              <div class="bg-white rounded-lg shadow-lg p-6">
                <div class="text-primary font-bold text-lg mb-2">2020</div><h3
                  class="text-xl font-bold text-gray-900 mb-2"
                >
                  Oficina en Madrid
                </h3><p class="text-gray-600">
                  Expansión nacional con nueva sede en la capital.
                </p>
              </div>
            </div>
            <hr class="bg-blue-200" />
          </li>
          <!--  -->
          <li>
            <hr class="bg-blue-200" />
            <div class="timeline-middle text-2xl">
              <i class="ri-focus-fill text-primary"></i>
            </div>
            <div
              class="timeline-start mb-10 md:text-end flex flex-col items-center md:items-end w-full"
            >
              <div class="bg-white rounded-lg shadow-lg p-6">
                <div class="text-primary font-bold text-lg mb-2">2024</div><h3
                  class="text-xl font-bold text-gray-900 mb-2"
                >
                  Más de 20 años
                </h3><p class="text-gray-600">
                  Consolidación como referente en servicios jurídicos
                  integrales.
                </p>
              </div>
            </div>
          </li>
        </ul>
        <div class="bg-gray-50 rounded-2xl p-8 md:p-12">
          <div class="text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
              Nuestra Misión
            </h2><p class="text-xl text-gray-600 max-w-4xl mx-auto mb-8">
              Proporcionar servicios jurídicos de la más alta calidad,
              combinando experiencia, profesionalidad y cercanía humana. Nuestro
              objetivo es ser el socio legal de confianza que acompañe a
              nuestros clientes en cada etapa de sus vidas profesionales y
              personales.
            </p><div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
              <div class="text-center">
                <div class="text-4xl font-bold text-primary mb-2">20+</div><div
                  class="text-gray-600"
                >
                  Años de Experiencia
                </div>
              </div><div class="text-center">
                <div class="text-4xl font-bold text-primary mb-2">3</div><div
                  class="text-gray-600"
                >
                  Oficinas
                </div>
              </div><div class="text-center">
                <div class="text-4xl font-bold text-primary mb-2">
                  1000+
                </div><div class="text-gray-600">Casos Resueltos</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="py-20 bg-primary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          ¿Quieres Conocer Más?
        </h2><p class="text-xl text-blue-100 mb-8 max-w-3xl mx-auto">
          Agenda una consulta gratuita y descubre cómo nuestro equipo puede
          ayudarte con tus necesidades legales.
        </p><div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            class="bg-white text-primary px-8 py-4 rounded-lg text-lg font-semibold hover:bg-blue-50 transition-colors cursor-pointer whitespace-nowrap"
            href="tel:+34666329155"
            data-discover="true">Consulta Gratuita</a
          ><a
            class="border-2 border-white text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white hover:text-primary transition-colors cursor-pointer whitespace-nowrap"
            href="/servicios"
            data-discover="true">Ver Servicios</a
          >
        </div>
      </div>
    </section>
  </div>
</Layout2>
