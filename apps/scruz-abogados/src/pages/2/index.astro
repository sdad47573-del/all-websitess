			style='background-image: url("https://readdy.ai/api/search-image?query=Professional%20lawyer%20portrait%20background%20with%20law%20office%20interior%2C%20sophisticated%20atmosphere%2C%20legal%20books%2C%20modern%20office%20design%2C%20professional%20lighting%2C%20elegant%20environment&width=1920&height=1080&seq=lawyer-bg&orientation=landscape");'
