              class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
              src="https://www.vazquezabogados.es/wp-content/uploads/2024/07/PHILLIPS-RESPIRONIC-RESPIRADORES-RECLAMACION.webp"
            />
          </div><div class="p-6">
            <h3
              class="text-lg font-semibold text-gray-800 mb-3 line-clamp-2 group-hover:text-blue-900 transition-colors"
            >
              <a href="/blog/phillips-respironic-reclamacion"
                >PHILLIPS RESPIRONIC RESPIRADORES RECLAMACION INDEMNIZACION
                PERJUICIOS PACIENTES</a
              >
            </h3><p
