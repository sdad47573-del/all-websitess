---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho civil', href: '/derecho-civil' },
	{ label: 'Incumplimiento de contrato', href: '/incumplimiento-contrato' },
];

const highlights = [
	'Revisión de la obligación, el incumplimiento y la prueba',
	'Valoración de daños, intereses y pérdidas derivadas',
	'Estrategia de reclamación, negociación o demanda',
];

const sections = [
	{
		title: 'Reclamación por incumplimiento de contrato',
		content: 'Un incumplimiento puede consistir en no pagar, no entregar, no prestar un servicio, no respetar un plazo o cumplir una condición esencial. La reclamación debe identificar la obligación concreta, el incumplimiento y la solución que se solicita.',
		points: [
			'Contrato, anexos, pedidos y modificaciones.',
			'Facturas, pagos, entregas y comunicaciones.',
			'Intereses, penalizaciones y costes derivados.',
			'Daños y pérdida de oportunidades cuando sean probables.',
		],
	},
	{
		title: 'Cómo demostrar el incumplimiento',
		content: 'La prueba puede combinar documentos, mensajes, testigos, fotos, facturas y registros. Es importante demostrar que la obligación existía, que la parte debía cumplirla y que el incumplimiento produjo el daño que se reclama.',
	},
	{
		title: 'Reclamación previa y negociación',
		content: 'Una reclamación escrita puede permitir exigir el cumplimiento, negociar una solución o dejar constancia de la posición. Debe incluir los hechos, el contrato aplicable, la fecha y una petición concreta. Conserva el justificante de envío.',
	},
	{
		title: 'Demanda y cumplimiento',
		content: 'Si no existe acuerdo, puede estudiarse una demanda para exigir el cumplimiento, los daños o la resolución del contrato. La competencia, el plazo y la prueba deben analizarse antes de presentar la actuación.',
	},
	{
		title: 'Requerimiento previo y resolución del contrato',
		content: 'Antes de acudir a los tribunales conviene enviar un requerimiento fehaciente: deja constancia de la obligación incumplida, del plazo concedido para cumplir y de la intención de resolver el contrato si no se corrige. El orden importa, porque en los contratos con obligaciones recíprocas la parte que pretende resolver no debería estar incumpliendo a su vez, y la constancia del requerimiento suele marcar el punto de partida de todo lo que venga después.',
		points: [
			'Requerimiento por escrito, con fecha y acuse de recibo.',
			'Plazo razonable y concreto para cumplir.',
			'Aviso de resolución si no hay respuesta.',
			'Copia y justificante de envío guardados.',
		],
	},
	{
		title: 'Cómo se prueba el incumplimiento',
		content: 'Lo que se valora es si la obligación existía, si era exigible, si se incumplió y qué consecuencia tuvo. La prueba no es solo el contrato: cuentan las facturas y albaranes, los correos y mensajes, las fotografías del estado de lo entregado, los informes técnicos y el testimonio de quien estuvo en la operación. Cuanto antes se ordenen los documentos, más sólida queda la reclamación.',
		points: [
			'Contrato, anexos y condiciones particulares.',
			'Correos, mensajes y actas de reunión.',
			'Facturas, albaranes y justificantes de pago.',
			'Informes técnicos o periciales del daño.',
		],
	},
	{
		title: 'Daños y perjuicios: qué se puede pedir además',
		content: 'Pedir el cumplimiento o la resolución no agota lo que se puede reclamar. También pueden pedirse los daños y perjuicios causados, siempre que se prueben: el gasto asumido, el beneficio que se dejó de obtener, el coste de una solución alternativa o el interés por el retraso. La cuantificación debe ser razonable y documentada, porque una cifra sin respaldo debilita el resto del caso.',
		points: [
			'Gasto real y documentado.',
			'Lucro cesante cuando sea acreditable.',
			'Intereses y costes de financiación.',
			'Propuesta de cuantificación razonada.',
		],
	},
];

const faqs = [
	{
		question: '¿Puedo reclamar por un incumplimiento de contrato?',
		answer: 'Sí, si existe una obligación válida, se ha incumplido y se puede demostrar el hecho y el daño. La vía depende del contrato y de la situación concreta.',
	},
	{
		question: '¿Qué pruebas necesito?',
		answer: 'Ayuda reunir el contrato, anexos, facturas, correos, mensajes, fotos y cualquier documento que acredite la obligación, el incumplimiento y el daño.',
	},
	{
		question: '¿Puedo reclamar intereses?',
		answer: 'Puede estudiarse si el contrato, la ley o la conducción del caso lo permite. Deben revisarse el tipo de incumplimiento, las fechas y la documentación de las cantidades debidas.',
	},
	{
		question: '¿Es mejor reclamar o demandar directamente?',
		answer: 'La reclamación puede ser útil para negociar o dejar constancia, pero no siempre es un requisito. La estrategia depende de los riesgos, el plazo y la prueba disponible.',
	},
	{
		question: '¿Qué hago si la otra parte ignora mi reclamación?',
		answer: 'Conviene revisar si el requerimiento se envió con un medio que acredite la recepción: ese justificante demuestra que la otra parte conoció la reclamación. Una reclamación ignorada no cierra el caso, normalmente abre la vía judicial, y si el plazo está cerca de agotarse ese detalle cambia la estrategia.',
	},
];

const related = [
	{ label: 'Nulidad de contratos', href: '/nulidad-contrato', description: 'Revisión de vicios y cláusulas inválidas.' },
	{ label: 'Contratos comerciales', href: '/contratos-comerciales', description: 'Asesoría para empresas y operadores comerciales.' },
	{ label: 'Derecho civil', href: '/derecho-civil', description: 'Información general sobre obligaciones y contratos.' },
];
---

<SeoLegalPage
	title="Abogado por Incumplimiento de Contrato en Lucena | Scruz"
	description="¿No te pagan, no te entregan o no cumplen lo pactado? Reclamamos por incumplimiento de contrato en Lucena y Córdoba. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho civil"
	headline="Reclamación por incumplimiento de contrato"
	intro="Cuando una de las partes no cumple lo pactado, es importante identificar la obligación, demostrar el incumplimiento y valorar los daños antes de reclamar."
	highlights={highlights}
	serviceType="Asesoría para incumplimientos de contratos"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
/>
