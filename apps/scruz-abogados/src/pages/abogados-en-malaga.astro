---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Briefcase,
	Building2,
	Car,
	Clock,
	Heart,
	Landmark,
	MapPin,
	Phone,
	Scale,
	ShieldCheck,
	Users,
	Video,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Dónde está vuestra oficina en Málaga?',
		answer:
			'Estamos en el barrio de Teatinos-Universidad, en la Avenida de Gregorio Prieto, 27 (29190 Málaga), muy cerca de la Universidad de Málaga y bien comunicado con el centro y la costa. Atendemos con cita previa para que no esperes.',
	},
	{
		question: '¿Atendéis en toda Málaga y la Costa del Sol?',
		answer:
			'Sí. Desde nuestra oficina de Málaga atendemos a clientes de la capital y de la Costa del Sol —Marbella, Fuengirola, Torremolinos, Benalmádena, Estepona— y del interior de la provincia. Cuando el asunto no requiere presencialidad, también te atendemos por videollamada.',
	},
	{
		question: '¿Cuál es el horario de atención?',
		answer:
			'El horario de oficina es de lunes a viernes de 9:00 a 18:00. Las urgencias legales (detenciones, órdenes de protección, accidentes) se atienden fuera de ese horario por teléfono o WhatsApp en el 666 329 155.',
	},
	{
		question: '¿La primera consulta es gratuita?',
		answer:
			'Sí. La primera consulta es gratuita y confidencial, presencial en Málaga o por videollamada. Te explicamos las opciones reales, los plazos y un presupuesto cerrado antes de empezar.',
	},
	{
		question: '¿Qué asuntos lleváis desde Málaga?',
		answer:
			'Todas las áreas: divorcios y custodias, herencias, derecho laboral (despidos, accidentes de trabajo, incapacidades), accidentes de tráfico, derecho penal, reclamaciones bancarias, seguros, empresas y extranjería. Si tu asunto se tramita en los juzgados de Málaga, nos encargamos de todo el procedimiento.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: MapPin, label: 'Dirección', value: 'Av. Gregorio Prieto, 27' },
	{ Icon: Clock, label: 'Horario', value: 'L–V 9:00–18:00' },
	{ Icon: Phone, label: 'Urgencias', value: '24 h' },
];

const oficina = [
	{
		Icon: MapPin,
		title: 'Avenida de Gregorio Prieto, 27',
		description: 'Teatinos-Universidad · 29190 Málaga. Con cita previa.',
	},
	{
		Icon: Clock,
		title: 'Lunes a viernes, 9:00 – 18:00',
		description: 'Y urgencias fuera de horario por teléfono y WhatsApp.',
	},
	{
		Icon: Phone,
		title: '666 329 155 · 957 118 195',
		description: 'También en info@scruzabogados.es y por WhatsApp.',
	},
	{
		Icon: Video,
		title: 'Consultas online',
		description: 'Videollamada para Málaga, la Costa del Sol y toda España.',
	},
];

const areas = [
	{
		Icon: Heart,
		title: 'Familia: divorcios y custodia',
		description: 'Divorcios, custodias, pensiones de alimentos y medidas paterno-filiales.',
		href: '/divorcios-separaciones/',
	},
	{
		Icon: Car,
		title: 'Accidentes de tráfico',
		description: 'Reclamamos tu indemnización por accidente con el baremo vigente.',
		href: '/indemnizaciones-trafico/',
	},
	{
		Icon: Briefcase,
		title: 'Laboral: despidos e incapacidades',
		description: 'Despidos, accidentes de trabajo, incapacidad permanente y pensiones.',
		href: '/despidos/',
	},
	{
		Icon: Scale,
		title: 'Civil, bancario y seguros',
		description: 'Contratos, reclamaciones bancarias, seguros y reclamaciones de cantidad.',
		href: '/derecho-civil/',
	},
	{
		Icon: Landmark,
		title: 'Herencias y sucesiones',
		description: 'Herencia sin testamento, testamentos, particiones e impuesto de sucesiones.',
		href: '/herencias-testamentos/',
	},
	{
		Icon: ShieldCheck,
		title: 'Penal y otras áreas',
		description: 'Defensa penal, extranjería, empresas y recursos administrativos.',
		href: '/derecho-penal/',
	},
];

const why = [
	{
		Icon: Users,
		title: 'Oficina junto a la Universidad',
		description:
			'Nos encuentras en Teatinos-Universidad, a un paso del campus de la UMA y bien comunicado con toda Málaga y la Costa del Sol.',
	},
	{
		Icon: Building2,
		title: 'Un despacho, toda Andalucía',
		description:
			'Coordinamos tu asunto con nuestra oficina de Lucena (Córdoba) cuando intervienen juzgados de distintas provincias.',
	},
	{
		Icon: ShieldCheck,
		title: 'Primera consulta gratuita',
		description:
			'Te informamos de las opciones reales y del presupuesto cerrado antes de empezar. Transparencia desde el primer contacto.',
	},
];
---

<CustomLayout
	title="Abogados en Málaga (Teatinos) | Civil, familia y laboral"
	description="Abogados en Málaga, en Teatinos-Universidad: divorcios, accidentes, despidos, herencias, penal y empresas. Primera consulta gratuita."
	keywords="abogados en Málaga, abogado Teatinos, abogado cerca de la Universidad de Málaga, despacho abogados Málaga capital, abogado Costa del Sol, Scruz Abogados Málaga"
	ogImage={heroImg.src}
	alternates={[
		{ hreflang: 'es-ES', href: `${SITE_URL}/abogados-en-malaga/` },
		{ hreflang: 'en', href: `${SITE_URL}/en/lawyers-in-malaga/` },
		{ hreflang: 'x-default', href: `${SITE_URL}/abogados-en-malaga/` },
	]}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Abogados en Málaga', url: '/abogados-en-malaga/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/abogados-en-malaga/#service`,
			serviceType: 'Despacho de abogados',
			name: 'Abogados en Málaga (Teatinos)',
			description:
				'Despacho jurídico en Teatinos-Universidad (Málaga) con atención presencial y online para toda la provincia y la Costa del Sol.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Málaga', 'Andalucía'],
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Av. de Gregorio Prieto, 27, Teatinos-Universidad',
				addressLocality: 'Málaga',
				addressRegion: 'Málaga',
				postalCode: '29190',
				addressCountry: 'ES',
			},
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogados de Scruz Abogados en la oficina de Málaga, barrio de Teatinos-Universidad"
		supertitle="Oficina en Málaga · Teatinos-Universidad"
		description="Despacho de abogados en Málaga capital con atención presencial y online. Todas las áreas del Derecho para particulares y empresas."
		stats={heroStats}
	>
		<span slot="title">Tu despacho de abogados en Málaga, cerca de la Universidad.</span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Visítanos en Málaga"
		title={'Atención presencial en Teatinos <span class="text-primary">u online desde cualquier punto</span>.'}
		factboxSupertitle="Dónde estamos"
		factboxTitle="Oficina en Málaga"
		factboxItems={oficina}
	>
		<p class="mb-4">
			Nuestra oficina de Málaga está en la <strong>Avenida de Gregorio Prieto, 27</strong>, en el
			barrio de Teatinos-Universidad, junto a la Universidad de Málaga. Desde aquí atendemos a
			particulares, estudiantes, autónomos y empresas de Málaga capital, del campus universitario
			y de la Costa del Sol.
		</p>
		<p class="mb-4">
			Trabajamos con cita previa y también por videollamada, de modo que no necesitas desplazarte
			si vives en Marbella, Fuengirola, Torremolinos, Benalmádena, Estepona, Antequera o Ronda:
			con una conexión a internet puedes tener tu consulta con el mismo abogado que llevaría tu
			caso en persona.
		</p>
		<p>
			Si tu asunto se tramita ante los juzgados de Málaga (familia, laboral, penal, civil,
			mercantil, tráfico), gestionamos todo el procedimiento por ti. Pide cita: la primera
			consulta es gratuita y confidencial.
		</p>
		<p>
			<strong>Do you prefer English?</strong> Read our
			<a class="link link-primary" href="/en/lawyers-in-malaga/" hreflang="en" lang="en"
				>English page about the Málaga office</a
			>.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué hacemos en Málaga"
		title="Áreas de práctica en Málaga"
		description="Cubrimos las principales áreas del Derecho desde nuestra oficina de Teatinos-Universidad."
		items={areas}
		ctaLabel="Más información"
	/>

	<EditorialWhyUs
		supertitle="Por qué elegir nuestro despacho en Málaga"
		title="Cerca de la Universidad y de los juzgados de Málaga."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Información práctica sobre la oficina de Málaga"
		description="Las dudas más habituales de los clientes que nos contactan en Málaga."
		items={faqEntries}
	/>

	<ServiceBlogGuides />

	<EditorialCtaFinal
		supertitle="Estamos en Málaga"
		title={'Pide cita. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial en nuestra oficina de Teatinos o por videollamada. Te informamos de las opciones, los plazos y los costes antes de empezar."
		relatedLinks={[
			{ label: 'Abogados en Lucena', href: '/abogados-en-lucena/' },
			{ label: 'Abogados en Rute', href: '/abogados-en-rute/' },
			{ label: 'Todas las ubicaciones', href: '/ubicaciones/' },
			{ label: 'Servicios jurídicos', href: '/servicios/' },
		]}
	/>
</CustomLayout>
