---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Seguridad Social', href: '/recursos-administrativos' },
	{ label: 'Reclamación de jubilación', href: '/reclamacion-jubilacion' },
];

const highlights = [
	'Revisión del expediente y de los periodos cotizados',
	'Análisis del cálculo, la denegación o la suspensión',
	'Preparación de la reclamación y seguimiento administrativo',
];

const sections = [
	{
		title: 'Reclamación de una pensión de jubilación',
		content: 'Una reclamación puede ser necesaria cuando existe una denegación, un cálculo discutido, periodos no reconocidos o una suspensión. La estrategia depende de la resolución, de la normativa vigente y de los documentos que acreditan la situación.',
		points: [
			'Revisión de la edad, la historia laboral y los periodos cotizados.',
			'Cálculo de la prestación y base reguladora.',
			'Recursos administrativo o revisión de la respuesta.',
			'Reclamación de cotizaciones, cantidades o complementos.',
		],
	},
	{
		title: 'Documentación para la reclamación',
		content: 'El informe de vida laboral, los contratos, las nóminas y los certificados de empresa pueden ayudar a demostrar los periodos de cotización. También deben incluirse la resolución, los justificantes de notificación y las comunicaciones con la administración.',
	},
	{
		title: 'Recurso administrativo y seguimiento',
		content: 'La reclamación debe explicar el motivo del desacuerdo y solicitar una respuesta concreta. Conviene controlar las notificaciones, los plazos y cualquier solicitud de información. Si la respuesta no es satisfactoria, puede estudiarse la siguiente vía.',
	},
	{
		title: 'Jubilación ordinaria, anticipada o parcial',
		content: 'La modalidad depende de la situación y de los requisitos aplicables. Antes de reclamar conviene comprobar si el problema es la vía elegida, el cálculo, la cotización o una suspensión. Un análisis completo evita reclamar sobre un aspecto incorrecto.',
	},
	{
		title: 'Por qué deniegan la jubilación',
		content: 'Las denegaciones suelen repetir cuatro motivos: no alcanzar el periodo de cotización exigido, no acreditar la edad en la fecha del hecho causante, un error en el cálculo de la base reguladora o periodos de alta que no constan. El motivo que invoca la resolución orienta la estrategia, así que conviene leerlo junto al informe de vida laboral antes de decidir cómo reclamar.',
		points: [
			'Edad y cotización exigidas según la modalidad solicitada.',
			'Base reguladora y porcentaje aplicado a cada periodo.',
			'Periodos no reconocidos o computados a tiempo parcial.',
			'Situación de alta o asimilada en la fecha del hecho causante.',
		],
	},
	{
		title: 'Cómo se reclama: de la Administración al juzgado',
		content: 'El primer paso es un escrito de reclamación ante el organismo, explicando el desacuerdo, aportando la prueba y pidiendo una resolución concreta. Si no se estima, queda abierta la vía judicial ante los juzgados de lo social. Las dos fases se preparan a la vez: los hechos y los documentos que no se fijan en la primera son difíciles de incorporar después.',
		points: [
			'Escrito de reclamación con los hechos y la prueba documental.',
			'Certificado de empresa y justificantes de cotización.',
			'Control de la notificación y de los plazos de cada fase.',
			'Demanda ante el juzgado de lo social si no hay acuerdo.',
		],
	},
	{
		title: 'Atrasos: qué periodos se pueden recuperar',
		content: 'Cuando la reclamación prospera, además del reconocimiento de la pensión pueden reclamarse las cantidades correspondientes a los periodos no abonados o abonados de menos. El alcance depende de la fecha desde la que se solicita, de la respuesta administrativa y de lo que se haya pedido en cada escrito. Por eso conviene reclamar cuanto antes y dejar constancia de lo solicitado.',
		points: [
			'Diferencias desde la solicitud cuando el reconocimiento llega tarde.',
			'Complementos y porcentajes aplicados de forma incorrecta.',
			'Efectos del retraso en el pago de la prestación.',
			'Necesidad de concretar en el escrito qué cantidades se reclaman.',
		],
	},
];

const faqs = [
	{
		question: '¿Se puede reclamar una pensión de jubilación denegada?',
		answer: 'Sí, si existe un motivo de desacuerdo o un defecto en la resolución. Hay que revisar la normativa, los periodos cotizados, el motivo concreto y el plazo correspondiente.',
	},
	{
		question: '¿Qué pasa si faltan periodos de cotización?',
		answer: 'Debe revisarse el informe de vida laboral y reunir contratos, nóminas o certificados. Si los periodos no aparecen correctamente, puede solicitarse su corrección y reclamarse su reconocimiento.',
	},
	{
		question: '¿Se puede reclamar una suspensión?',
		answer: 'Puede estudiarse la suspensión y su causa mediante el procedimiento correspondiente. Hay que conocer la resolución, los hechos que la motivaron y la situación actual.',
	},
	{
		question: '¿Qué ocurre si la reclamación es denegada?',
		answer: 'Debe revisarse el motivo de la respuesta y la vía siguiente. Dependiendo del caso, puede existir un recurso adicional o una revisión judicial dentro de los plazos aplicables.',
	},
	{
		question: '¿Puedo reclamar si ya me han denegado la jubilación?',
		answer: 'Sí, mientras la resolución sea revisable y se respeten los plazos para impugnarla. Lo primero es identificar el motivo concreto de la denegación y comprobar la vida laboral y el cálculo de la base. Con esa base se decide el escrito de reclamación, la vía y la documentación que hay que reunir.',
	},
];

const related = [
	{ label: 'Reclamación de pensiones', href: '/reclamacion-pensiones', description: 'Revisión de resoluciones, cotizaciones y recursos.' },
	{ label: 'Jubilación parcial', href: '/jubilacion-parcial', description: 'Compatibilidad entre prestación y actividad laboral.' },
	{ label: 'Recursos administrativos', href: '/recursos-administrativos', description: 'Información sobre procedimientos y reclamaciones.' },
];
---

<SeoLegalPage
	title="Abogado de Jubilación en Lucena | Denegaciones y Cuantía"
	description="¿Te deniegan la jubilación o la cuantía no cuadra? Revisamos tu vida laboral y reclamamos en Lucena, Córdoba y Málaga. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Seguridad Social"
	headline="Reclamación de pensión de jubilación"
	intro="Una denegación, suspensión o cálculo incorrecto puede requerir una reclamación. Revisamos tu historia laboral, la resolución y la vía adecuada para defender tus derechos."
	highlights={highlights}
	serviceType="Asesoría para reclamación de pensión de jubilación"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
/>
