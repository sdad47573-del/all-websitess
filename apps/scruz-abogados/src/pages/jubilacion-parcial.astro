---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Seguridad Social', href: '/recursos-administrativos' },
	{ label: 'Jubilación parcial', href: '/jubilacion-parcial' },
];

const highlights = [
	'Revisión de la edad, cotización y situación laboral',
	'Análisis de la vía aplicable y de su efecto en otras prestaciones',
	'Preparación de la solicitud y seguimiento de la resolución',
];

const sections = [
	{
		title: '¿Qué es la jubilación parcial?',
		content: 'La jubilación parcial permite reducir la actividad laboral en determinados supuestos y obtener una prestación compatible con la actividad que se mantenga. Las condiciones pueden variar según la edad, la cotización, el tipo de empleo y la normativa vigente.',
		points: [
			'Reducción de la jornada o del trabajo durante un periodo.',
			'Compatibilidad entre la prestación y la actividad que permanezca.',
			'Necesidad de acreditar los requisitos y la forma de trabajo.',
			'Revisión de cotizaciones, compatibilidad y base de cálculo.',
		],
	},
	{
		title: 'Qué datos deben revisarse',
		content: 'La primera valoración debe partir de la historia laboral, la edad, los contratos, la actividad actual y las circunstancias personales. También conviene estudiar si existen periodos no reconocidos, si la actividad es compatible y qué efectos tendría la solicitud sobre otras prestaciones.',
		points: [
			'Informe de vida laboral y periodos cotizados.',
			'Contrato, jornada y actividad económica actual.',
			'Situación familiar y presupuesto compatibles con la solicitud.',
			'Posibles diferencias entre el acceso y la prestación posterior.',
		],
	},
	{
		title: 'Solicitud y seguimiento',
		content: 'La solicitud debe presentarse con la documentación adecuada y una solicitud clara. Si la resolución no coincide con lo solicitado o contiene errores, puede ser necesario estudiar un recurso. El seguimiento incluye la notificación, el control de plazos y la respuesta a los requisitos que solicite la administración.',
	},
	{
		title: 'Jubilación parcial y anticipada',
		content: 'No son la misma modalidad. La jubilación anticipada termina principalmente la actividad laboral, mientras que la parcial permite compatibilizar la prestación con una actividad reducida en los supuestos previstos. La elección debe hacerse comparando la situación real, no solo por la edad.',
	},
	{
		title: 'Requisitos del trabajador y de la empresa',
		content: 'La jubilación parcial no depende solo de la voluntad del trabajador: exige que la empresa acepte la reducción de jornada y que se cumplan las condiciones de edad, cotización y actividad que la normativa fija en cada momento. Por eso la primera revisión es conjunta: situación personal, contrato, jornada y disposición real de la empresa.',
		points: [
			'Edad y periodos cotizados exigidos en cada momento.',
			'Antigüedad y condiciones previstas para la reducción de jornada.',
			'Actividad y régimen en el que está encuadrado el trabajador.',
			'Conformidad de la empresa con la reducción y con el relevo.',
		],
	},
	{
		title: 'El contrato de relevo y su efecto en la pensión',
		content: 'La reducción de jornada suele ir acompañada de la incorporación de otra persona mediante contrato de relevo. Esa pieza no es un trámite: determina la cotización durante los años previos a la jubilación definitiva y, con ello, la base sobre la que después se calcula la pensión. Conviene revisar las condiciones del relevo antes de firmar.',
		points: [
			'Modalidad y duración del contrato de relevo.',
			'Jornada que conserva el trabajador y periodo previsto.',
			'Cotización durante la reducción y su impacto en la base.',
			'Coordinación entre empresa, trabajador y persona relevista.',
		],
	},
	{
		title: 'Si la empresa o la Seguridad Social deniegan',
		content: 'Una negativa de la empresa y una denegación de la Seguridad Social son problemas distintos. En el primer caso se valora si existe una vía de negociación o de defensa laboral; en el segundo hay que revisar la resolución, comprobar si el defecto estaba en la documentación o en los requisitos, y decidir si procede reclamar por la vía administrativa.',
		points: [
			'Revisión del motivo de la denegación y de la documentación presentada.',
			'Subsanación de defectos antes de plantear la reclamación.',
			'Negociación con la empresa sobre jornada y condiciones.',
			'Reclamación administrativa y, en su caso, revisión judicial.',
		],
	},
];

const faqs = [
	{
		question: '¿Se puede trabajar después de la jubilación parcial?',
		answer: 'La compatibilidad con la actividad depende de las condiciones de la modalidad y del tipo de trabajo. Debe revisarse el contrato, la jornada y la normativa aplicable antes de mantener o iniciar una actividad.',
	},
	{
		question: '¿Qué requisitos se deben cumplir?',
		answer: 'Los requisitos dependen de la normativa vigente y de las circunstancias de la persona. Conviene revisar la edad, los periodos cotizados, la actividad y la compatibilidad con otras prestaciones.',
	},
	{
		question: '¿Qué pasa si la Seguridad Social deniega la solicitud?',
		answer: 'La denegación debe revisarse para comprobar el motivo, la documentación y el procedimiento. Según el caso, puede estudiarse una reclamación administrativa o una revisión judicial.',
	},
	{
		question: '¿Se puede pedir un historial laboral actualizado?',
		answer: 'Sí, si se detectan periodos que no aparecen correctamente o se necesitan datos para estudiar la solicitud. Conviene reunir contratos, nóminas y certificados de empresa.',
	},
	{
		question: '¿Puedo cobrar la jubilación parcial y seguir trabajando?',
		answer: 'Esa es precisamente la finalidad de la modalidad: compatibilizar la prestación con una actividad reducida, siempre que se cumplan las condiciones de jornada y cotización. Mantener un trabajo distinto o ampliar la jornada sin ajustarse a la normativa puede afectar a la prestación, así que conviene revisarlo antes.',
	},
];

const related = [
	{ label: 'Reclamación de pensiones', href: '/reclamacion-pensiones', description: 'Revisión de resoluciones, cotizaciones y recursos.' },
	{ label: 'Recursos administrativos', href: '/recursos-administrativos', description: 'Orientación sobre procedimientos y reclamaciones.' },
	{ label: 'Jubilación anticipada 2026', href: '/blog/requisitos-jubilacion-anticipada-2026', description: 'Qué datos conviene revisar antes de solicitar una jubilación anticipada.' },
];
---

<SeoLegalPage
	title="Abogado de Jubilación Parcial en Córdoba y Lucena | Scruz"
	description="Jubilación parcial: revisamos edad, cotización y contrato de relevo, y cómo reclamarla si te la deniegan. Lucena y Córdoba. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Seguridad Social"
	headline="Jubilación parcial y compatibilidad laboral"
	intro="La jubilación parcial puede permitir compatibilizar una prestación con una actividad laboral reducida. Analizamos tu situación, tus cotizaciones y la normativa aplicable antes de preparar la solicitud."
	highlights={highlights}
	serviceType="Asesoría para jubilación parcial"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
/>
