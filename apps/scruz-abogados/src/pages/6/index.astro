									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</section><section class="relative px-6 py-24" style="background-color: rgb(30, 58, 95);">
				<div class="absolute inset-0 opacity-5">
					<div
						class="h-full w-full"
						style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M30 30l15-15v30H15z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;); background-size: 60px 60px;"
					>
					</div>
				</div><div class="relative mx-auto max-w-4xl text-center">
					<div
						class="mx-auto mb-8 flex h-20 w-20 items-center justify-center rounded-full"
