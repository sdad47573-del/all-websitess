										class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
										src="https://readdy.ai/api/search-image?query=modern%20corporate%20office%20with%20business%20professionals%20reviewing%20contracts%20and%20documents%2C%20sleek%20contemporary%20interior%2C%20clean%20simple%20background%20emphasizing%20commercial%20law%20and%20business%20excellence&width=400&height=500&seq=commercial-law-area&orientation=portrait"
									/>
								</div><div
									class="absolute -bottom-4 left-1/2 -translate-x-1/2 transform rounded-full px-5 py-2 text-sm font-semibold whitespace-nowrap text-white"
