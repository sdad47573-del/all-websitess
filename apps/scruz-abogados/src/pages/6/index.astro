										<i
											class="ri-check-line mr-2 flex-shrink-0 text-lg"
											style="color: rgb(212, 175, 55);"></i><span>Despidos improcedentes</span>
									</li><li class="flex items-start text-sm text-gray-600">
										<i
											class="ri-check-line mr-2 flex-shrink-0 text-lg"
											style="color: rgb(212, 175, 55);"></i><span>Reclamaciones salariales</span>
