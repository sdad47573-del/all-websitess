---
import CustomLayout from '../../layouts/CustomLayout.astro';
---

<CustomLayout>
	<div id="root">
		<div class="min-h-screen bg-white">
			<nav class="fixed top-0 right-0 left-0 z-50 bg-transparent transition-all duration-300">
				<div class="mx-auto max-w-7xl px-6 py-4">
					<div class="flex items-center justify-between">
						<div class="flex items-center space-x-3">
							<div class="flex h-12 w-12 items-center justify-center">
								<i class="ri-scales-3-line text-3xl" style="color: rgb(212, 175, 55);"></i>
							</div><span
								class="text-2xl font-bold text-white transition-colors"
								style='font-family: "Playfair Display", serif;'>Lex Advocatus</span>
						</div><div class="hidden items-center space-x-8 md:flex">
							<a
								href="#inicio"
								class="text-sm font-medium text-white transition-colors hover:opacity-80">Inicio</a
							><a
								href="#areas"
								class="text-sm font-medium text-white transition-colors hover:opacity-80"
								>Áreas de Práctica</a
							><a
								href="#servicios"
								class="text-sm font-medium text-white transition-colors hover:opacity-80"
								>Servicios</a
							><a
								href="#testimonios"
								class="text-sm font-medium text-white transition-colors hover:opacity-80"
								>Testimonios</a
							><a
								href="#contacto"
								class="text-sm font-medium text-white transition-colors hover:opacity-80"
								>Contacto</a
							><a
								href="#contacto"
								class="cursor-pointer rounded-full px-6 py-2 text-sm font-semibold whitespace-nowrap text-white transition-all hover:scale-105"
								style="background-color: rgb(212, 175, 55);">Consulta Gratuita</a>
						</div><button class="flex h-8 w-8 items-center justify-center text-white md:hidden"
							><i class="ri-menu-line text-2xl"></i></button>
					</div>
				</div>
			</nav><section
				id="inicio"
				class="relative flex h-[85vh] items-center justify-center overflow-hidden"
			>
				<div class="absolute inset-0">
					<img
						alt="Edificio corporativo"
						class="h-full w-full object-cover object-top"
						src="https://readdy.ai/api/search-image?query=modern%20corporate%20law%20office%20building%20with%20glass%20facade%20and%20professional%20architecture%2C%20dramatic%20lighting%2C%20high%20quality%20professional%20photography%20with%20clean%20simple%20background%20emphasizing%20legal%20authority%20and%20trust&width=1920&height=1080&seq=hero-law-firm&orientation=landscape"
					/><div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/40 to-black/50">
					</div>
				</div><div class="relative z-10 mx-auto max-w-5xl px-6 text-center">
					<div
						class="mb-6 inline-flex items-center space-x-2 rounded-full bg-white/10 px-4 py-2 backdrop-blur-sm"
					>
						<i class="ri-shield-check-line text-lg" style="color: rgb(212, 175, 55);"></i><span
							class="text-sm text-white/90">Más de 20 años de experiencia</span>
					</div><h1
						class="mb-6 text-6xl font-bold text-white md:text-7xl lg:text-8xl"
						style='font-family: "Playfair Display", serif;'
					>
						EXCELENCIA JURÍDICA<br />A SU SERVICIO
					</h1><p class="mx-auto mb-10 max-w-3xl text-lg text-white/85 md:text-xl">
						Defendemos sus derechos con profesionalidad, ética y resultados comprobados
					</p><div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
						<a
							href="#contacto"
							class="cursor-pointer rounded-full px-8 py-4 text-base font-semibold whitespace-nowrap text-gray-900 shadow-lg transition-all hover:scale-105"
							style="background-color: rgb(212, 175, 55);">CONSULTA GRATUITA</a
						><a
							href="#areas"
							class="cursor-pointer rounded-full border-2 border-white px-8 py-4 text-base font-semibold whitespace-nowrap text-white transition-all hover:bg-white/10"
							>NUESTROS SERVICIOS</a>
					</div>
				</div>
			</section><section id="areas" class="px-6 py-24">
