---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import Hero from '../components/Hero.astro';
import CustomLayout from '../layouts/CustomLayout.astro';
---

<CustomLayout>
	<Hero
		heroClasses="min-h-[40vh] md:min-h-[40vh]"
		heroImg={heroImg}
		contentClasses="max-w-[unset]"
		title="Despidos"
	/>
	<div class="flex flex-col gap-3.5 p-6 text-sm text-[#666666] max-[430px]:break-words md:p-16">
		<h2 class="font-bold">Impugnamos despidos y reclamamos tu indemnización.</h2>
		<p>
			¿Tu despido es nulo, improcedente o discriminatorio? No aceptes una salida injusta. Analizamos
			tu caso para impugnar el despido y reclamar la indemnización que te corresponde por ley,
			además de salarios pendientes y cualquier otro derecho vulnerado. Luchamos para que una
			decisión empresarial injusta no perjudique tu trayectoria profesional ni tu economía.
		</p>
	</div>
</CustomLayout>
