---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho administrativo', href: '/recursos-administrativos' },
	{ label: 'Reclamación de multas de tráfico', href: '/reclamacion-multas-trafico' },
];

const highlights = [
	'Revisión de la notificación, el tránsito y la prueba disponible',
	'Análisis del motivo de la sanción y del procedimiento seguido',
	'Preparación de alegaciones y seguimiento del recurso',
];

const sections = [
	{
		title: '¿Se pueden reclamar multas de tráfico?',
		content: 'Una multa de tráfico puede ser recurrida cuando existen errores en los hechos, en la identificación del conductor, en la notificación, en la prueba o en el procedimiento. La respuesta depende de la vía utilizada, del tipo de sanción y de las circunstancias concretas.',
		points: [
			'Identificación del conductor y de la fecha del hecho.',
			'Revisión de la notificación y del procedimiento.',
			'Pruebas sobre el lugar, el vehículo o la matrícula.',
			'Importes, puntos, tasa y reducción legal aplicable, si existe.',
		],
	},
	{
		title: 'Qué revisar antes de presentar el recurso',
		content: 'La defensa debe centrarse en hechos concretos y pruebas verificables. No es suficiente utilizar argumentos generales: es más útil explicar qué ocurrió, qué documento lo demuestra y qué corrección o respuesta se solicita.',
		points: [
			'Denuncia, boletín, carta o resolución recibida.',
			'Fotos, vídeos, testigos o ubicación del vehículo.',
			'Documentación del conductor autorizado y del vehículo.',
			'Indicación clara de la alegación y de lo solicitado.',
		],
	},
	{
		title: 'Recurso y respuesta administrativa',
		content: 'La forma de impugnación depende de la sanción y del momento del procedimiento. Puede existir un recurso previo, una alegación o una vía posterior ante la jurisdicción contencioso-administrativa. El abogado debe comprobar la fecha de notificación y preparar el escrito correspondiente.',
	},
	{
		title: 'Importes y responsabilidad del conductor',
		content: 'La sanción puede tener un importe y efectos sobre el permiso de conducir. La responsabilidad no siempre corresponde a la persona que figura como conductor o propietario. También debe revisarse si existe un error, una bonificación aplicable o una autorización defectuosa.',
	},
];

const faqs = [
	{
		question: '¿Cuánto tiempo tengo para recurrir una multa de tráfico?',
		answer: 'El plazo depende del tipo de sanción y de la vía de recurso. Es importante revisar la fecha de notificación y el contenido de la resolución antes de presentar la alegación.',
	},
	{
		question: '¿Se puede impugnar una multa por un error de identificación?',
		answer: 'Puede estudiarse la impugnación si existe un error o una prueba que contradiga la sanción. Un desacuerdo con el importe no siempre basta por sí solo.',
	},
	{
		question: '¿Puede recurrirse la notificación?',
		answer: 'Sí, si la notificación es defectuosa o no permite conocer adecuadamente el acto o el plazo. El defecto puede afectar al procedimiento y debe estudiarse antes de presentar el recurso.',
	},
	{
		question: '¿Se devuelve el importe si se presenta un recurso?',
		answer: 'La presentación de un recurso no significa que el importe se devuelva automáticamente. Deben estudiarse la normativa aplicable, el momento del pago y la forma de solicitar la devolución.',
	},
];

const related = [
	{ label: 'Recursos administrativos', href: '/recursos-administrativos', description: 'Información general sobre recursos y reclamaciones.' },
	{ label: 'Impugnación de sanciones', href: '/impugnacion-sanciones-administrativas', description: 'Defensa de sanciones administrativas de distintos tipos.' },
	{ label: 'Indemnizaciones de tráfico', href: '/indemnizaciones-trafico', description: 'Reclamación de daños y lesiones en accidentes.' },
];
---

<SeoLegalPage
	title="Abogados para reclamar multas de tráfico"
	description="Abogados para recurrir multas de tráfico en Córdoba. Revisión de la notificación, alegaciones, prueba y seguimiento del recurso administrativo."
	breadcrumb={breadcrumb}
	eyebrow="Derecho de tráfico"
	headline="Reclamación y recurso de multas de tráfico"
	intro="Una multa puede ser recurrida si concurren errores en la identificación, los hechos, la notificación o el procedimiento. Revisamos la resolución y preparamos una defensa basada en tus pruebas."
	highlights={highlights}
	serviceType="Asesoría para reclamar multas de tráfico"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
/>
