	<section class="bg-white py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
				<div>
					<h2 class="mb-6 text-3xl font-bold text-gray-900 md:text-4xl">¿Por Qué Elegirnos?</h2><div
						class="space-y-6"
					>
						<div class="flex items-start space-x-4">
							<div
								class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-blue-100"
							>
								<i class="ri-time-line text-primary text-xl"></i>
							</div><div>
								<h3 class="mb-2 text-xl font-semibold text-gray-900">+20 Años de Experiencia</h3><p
									class="text-gray-600"
								>
									Décadas de experiencia respaldando a nuestros clientes en sus necesidades legales
									más importantes.
								</p>
							</div>
						</div><div class="flex items-start space-x-4">
							<div
								class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-blue-100"
							>
								<i class="ri-map-pin-line text-primary text-xl"></i>
							</div><div>
								<h3 class="mb-2 text-xl font-semibold text-gray-900">Múltiples Ubicaciones</h3><p
									class="text-gray-600"
								>
									Oficinas en Málaga, Lucena y Madrid, con despachos adicionales bajo demanda.
								</p>
							</div>
						</div><div class="flex items-start space-x-4">
							<div
								class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-blue-100"
							>
								<i class="ri-user-heart-line text-primary text-xl"></i>
							</div><div>
								<h3 class="mb-2 text-xl font-semibold text-gray-900">Atención Personalizada</h3><p
									class="text-gray-600"
								>
									Cada caso es único. Ofrecemos un servicio cercano y adaptado a tus necesidades
									específicas.
								</p>
							</div>
						</div><div class="flex items-start space-x-4">
							<div
								class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg bg-blue-100"
							>
								<i class="ri-shield-check-line text-primary text-xl"></i>
							</div><div>
								<h3 class="mb-2 text-xl font-semibold text-gray-900">Resultados Garantizados</h3><p
									class="text-gray-600"
								>
									Nuestro compromiso es obtener los mejores resultados para nuestros clientes.
								</p>
							</div>
						</div>
					</div>
				</div><div class="relative">
					<Image
						alt="Consulta legal profesional"
						class="h-96 w-full rounded-xl object-cover object-top shadow-2xl lg:h-full"
						src={img}
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-gray-50 py-20">
