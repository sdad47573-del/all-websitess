	<section class="bg-gray-50 py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">Nuestras Oficinas</h2>
				<p class="text-xl text-gray-600">
					Estamos cerca de ti en las principales ciudades de Andalucía y Madrid
				</p>
			</div>
			<div class="grid grid-cols-1 gap-8 md:grid-cols-3">
				{UBICACIONES.map((ubi) => <UbicacionMiniItem {...ubi} />)}
			</div>
			<div class="mt-12 text-center">
				<a class="btn btn-primary btn-lg btn-wide" href="/ubicaciones" data-discover="true"
					>Ver Todas las Ubicaciones</a
				>
			</div>
		</div>
	</section>
	<section class="py-20">
		<!-- class="mx-auto grid grid-cols-2 px-4 sm:px-6 lg:px-8 gap-y-12 gap-x-4" -->
		<!-- class="mx-auto flex flex-wrap px-4 sm:px-6 lg:px-8 gap-y-12 gap-x-4 justify-center" -->
		<h2 class="mb-4 text-center text-3xl font-bold text-gray-900 md:text-4xl">
			Preguntas frecuentes
		</h2><p class="mx-auto max-w-4xl pb-16 text-center text-xl text-gray-600">
			Resolvemos las dudas más comunes sobre nuestros servicios jurídicos y procedimientos legales
		</p>

		<div class="mx-auto flex max-w-4xl flex-col gap-4 px-4 sm:px-6 lg:px-8">
			{[FAQ[1], FAQ[2]].map((faq) => <FAQItem {...faq} />)}
			<div class="mt-12 text-center">
				<a class="btn btn-primary btn-lg btn-wide" href="/FAQ" data-discover="true"
					>Ver más preguntas</a
				>
			</div>
		</div>
		<section class="bg-gray-50 py-20">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="mb-16 text-center">
					<h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">
						Servicios Especializados
