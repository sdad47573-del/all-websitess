---
import CustomLayout from '../../layouts/CustomLayout.astro';
---

<CustomLayout>
	<nav class="sticky top-0 z-50 border-b border-gray-100 bg-white shadow-sm">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="flex h-16 items-center justify-between">
				<div class="flex items-center">
					<h1 class="text-2xl font-bold text-gray-900" style="font-family: Pacifico, serif;">
						Bufete Jurídico Málaga
					</h1>
				</div><div class="hidden md:block">
					<div class="ml-10 flex items-baseline space-x-8">
						<a
							href="#inicio"
							class="cursor-pointer px-3 py-2 text-sm font-medium whitespace-nowrap text-gray-900 hover:text-blue-600"
							>Inicio</a
						><a
							href="#quienes-somos"
							class="cursor-pointer px-3 py-2 text-sm font-medium whitespace-nowrap text-gray-700 hover:text-blue-600"
							>Quiénes Somos</a
						><a
							href="#servicios"
							class="cursor-pointer px-3 py-2 text-sm font-medium whitespace-nowrap text-gray-700 hover:text-blue-600"
							>Servicios</a
						><a
							href="#equipo"
							class="cursor-pointer px-3 py-2 text-sm font-medium whitespace-nowrap text-gray-700 hover:text-blue-600"
							>Equipo</a
						><a
							href="#blog"
							class="cursor-pointer px-3 py-2 text-sm font-medium whitespace-nowrap text-gray-700 hover:text-blue-600"
							>Blog</a
						><a
							href="#contacto"
							class="hover:bg-primary cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-sm font-medium whitespace-nowrap text-white"
							>Contacto</a
						>
					</div>
				</div><div class="md:hidden">
					<button class="cursor-pointer text-gray-700 hover:text-gray-900"
						><i class="ri-menu-line text-xl"></i></button
					>
				</div>
			</div>
		</div>
	</nav><section
		id="inicio"
		class="to-primary relative flex min-h-screen items-center bg-gradient-to-r from-blue-900 text-white"
		style='background-image: linear-gradient(rgba(30, 58, 138, 0.8), rgba(29, 78, 216, 0.8)), url("https://readdy.ai/api/search-image?query=Professional%20modern%20law%20office%20interior%20in%20M%C3%A1laga%20Spain%20with%20elegant%20furniture%2C%20legal%20books%2C%20scales%20of%20justice%2C%20warm%20lighting%2C%20sophisticated%20atmosphere%2C%20marble%20surfaces%2C%20wooden%20details%2C%20contemporary%20design%2C%20trustworthy%20environment&width=1920&height=1080&seq=hero-law-office&orientation=landscape"); background-size: cover; background-position: center center;'
	>
		<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
				<div class="space-y-8">
					<div class="space-y-4">
						<h1 class="text-5xl leading-tight font-bold lg:text-6xl">
							Su Despacho de Abogados en <span class="text-yellow-400">Málaga</span>
						</h1><p class="text-xl text-blue-100 lg:text-2xl">
							Más de 20 años de experiencia defendiendo sus derechos con profesionalidad y trato
							cercano
						</p>
					</div><div class="space-y-4">
						<div class="flex items-center space-x-3">
							<i class="ri-check-line text-xl text-yellow-400"></i><span class="text-lg"
								>Especialistas en Derecho de Familia, Herencias y Accidentes</span
							>
						</div><div class="flex items-center space-x-3">
							<i class="ri-check-line text-xl text-yellow-400"></i><span class="text-lg"
								>Primera consulta gratuita</span
							>
						</div><div class="flex items-center space-x-3">
							<i class="ri-check-line text-xl text-yellow-400"></i><span class="text-lg"
								>Atención en español, inglés, francés y árabe</span
							>
						</div><div class="flex items-center space-x-3">
							<i class="ri-check-line text-xl text-yellow-400"></i><span class="text-lg"
								>Colegiados en el Ilustre Colegio de la Abogacía de Málaga</span
							>
						</div>
					</div><div class="flex flex-col space-y-4 sm:flex-row sm:space-y-0 sm:space-x-4">
						<a
							href="#contacto"
							class="cursor-pointer rounded-lg bg-yellow-500 px-8 py-4 text-center text-lg font-semibold whitespace-nowrap text-blue-900 transition-colors hover:bg-yellow-400"
							>Primera Consulta Gratuita</a
						><a
							href="tel:952123456"
							class="cursor-pointer rounded-lg border-2 border-white px-8 py-4 text-center text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-white hover:text-blue-900"
							><i class="ri-phone-line mr-2"></i>952 123 456</a
						>
					</div>
				</div><div class="hidden lg:block">
					<img
						alt="Equipo de abogados profesionales"
						class="h-96 w-full rounded-lg object-cover shadow-2xl"
						src="https://readdy.ai/api/search-image?query=Professional%20Spanish%20lawyers%20team%20in%20elegant%20law%20office%2C%20confident%20legal%20professionals%20in%20business%20attire%2C%20modern%20office%20setting%20in%20M%C3%A1laga%2C%20trustworthy%20atmosphere%2C%20scales%20of%20justice%2C%20legal%20books%20background%2C%20sophisticated%20lighting&width=600&height=800&seq=lawyers-team&orientation=portrait"
					/>
				</div>
			</div>
		</div>
	</section><section id="quienes-somos" class="bg-gray-50 py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<h2 class="mb-4 text-4xl font-bold text-gray-900">Quiénes Somos</h2><p
					class="mx-auto max-w-3xl text-xl text-gray-600"
				>
					Fundado en 2003, nuestro despacho se ha consolidado como referente en servicios jurídicos
					en Málaga, ofreciendo un trato personalizado y soluciones eficaces a particulares y
					empresas.
				</p>
			</div><div class="mb-16 grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
				<div>
					<img
						alt="Oficinas del despacho en Málaga"
						class="h-80 w-full rounded-lg object-cover shadow-lg"
						src="https://readdy.ai/api/search-image?query=Modern%20law%20office%20building%20exterior%20in%20M%C3%A1laga%20Spain%2C%20professional%20architecture%2C%20glass%20facade%2C%20contemporary%20design%2C%20urban%20setting%2C%20Mediterranean%20style%2C%20prestigious%20location%2C%20clear%20blue%20sky&width=600&height=400&seq=office-building&orientation=landscape"
					/>
				</div><div class="space-y-6">
					<h3 class="text-3xl font-bold text-gray-900">Nuestra Misión</h3><p
						class="text-lg text-gray-700"
					>
						Ofrecer un servicio jurídico de excelencia, con transparencia y compromiso. Nuestro
						equipo está compuesto por abogados titulados, colegiados en el Ilustre Colegio de la
						Abogacía de Málaga, con formación especializada.
					</p><div class="grid grid-cols-2 gap-6">
						<div class="text-center">
							<div class="text-3xl font-bold text-blue-600">20+</div><div class="text-gray-600">
								Años de experiencia
							</div>
						</div><div class="text-center">
							<div class="text-3xl font-bold text-blue-600">1000+</div><div class="text-gray-600">
								Casos resueltos
							</div>
						</div><div class="text-center">
							<div class="text-3xl font-bold text-blue-600">95%</div><div class="text-gray-600">
								Casos ganados
							</div>
						</div><div class="text-center">
							<div class="text-3xl font-bold text-blue-600">4</div><div class="text-gray-600">
								Idiomas
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="bg-blue-600 py-20 text-white">
		<div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
			<h2 class="mb-6 text-4xl font-bold">Primera Consulta Gratuita</h2><p
				class="mx-auto mb-8 max-w-3xl text-xl"
			>
				Analizamos su caso sin compromiso. Si decidimos avanzar, le presentaremos una propuesta
				clara con costes estimados y plazos. Transparencia, trato cercano y resultados.
			</p><div class="mb-12 grid grid-cols-1 gap-8 md:grid-cols-3">
				<div class="text-center">
					<div
						class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-yellow-500"
					>
						<i class="ri-phone-line text-2xl text-blue-900"></i>
					</div><h3 class="mb-2 text-xl font-bold">1. Contacte</h3><p>
						Llámenos o envíe un mensaje para concertar su cita
					</p>
				</div><div class="text-center">
					<div
						class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-yellow-500"
					>
						<i class="ri-search-line text-2xl text-blue-900"></i>
					</div><h3 class="mb-2 text-xl font-bold">2. Análisis</h3><p>
						Estudiamos su caso y evaluamos las posibilidades
					</p>
				</div><div class="text-center">
					<div
						class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-yellow-500"
					>
						<i class="ri-file-text-line text-2xl text-blue-900"></i>
					</div><h3 class="mb-2 text-xl font-bold">3. Propuesta</h3><p>
						Le presentamos una estrategia clara y transparente
					</p>
				</div>
			</div><a
				href="#contacto"
				class="cursor-pointer rounded-lg bg-yellow-500 px-8 py-4 text-lg font-semibold whitespace-nowrap text-blue-900 transition-colors hover:bg-yellow-400"
				>Solicitar Consulta Gratuita</a
			>
		</div>
	</section>
	<footer class="bg-gray-900 py-12 text-white">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 gap-8 md:grid-cols-4">
				<div>
					<h3 class="mb-4 text-xl font-bold" style="font-family: Pacifico, serif;">
						Bufete Jurídico Málaga
					</h3><p class="mb-4 text-gray-400">
						Su despacho de confianza en Málaga con más de 20 años de experiencia.
					</p><div class="flex space-x-4">
						<i class="ri-facebook-fill cursor-pointer text-xl hover:text-blue-400"></i><i
							class="ri-twitter-fill cursor-pointer text-xl hover:text-blue-400"></i><i
							class="ri-linkedin-fill cursor-pointer text-xl hover:text-blue-400"></i>
					</div>
				</div><div>
					<h4 class="mb-4 text-lg font-semibold">Servicios</h4><ul class="space-y-2 text-gray-400">
						<li>
							<a href="#servicios" class="cursor-pointer hover:text-white"
								>Herencias y Testamentos</a
							>
						</li><li>
							<a href="#servicios" class="cursor-pointer hover:text-white">Accidentes de Tráfico</a>
						</li><li>
							<a href="#servicios" class="cursor-pointer hover:text-white">Derecho de Familia</a>
						</li><li>
							<a href="#servicios" class="cursor-pointer hover:text-white">Derecho Penal</a>
						</li>
					</ul>
				</div><div>
					<h4 class="mb-4 text-lg font-semibold">Contacto</h4><ul class="space-y-2 text-gray-400">
						<li>Calle Larios 15, Málaga</li><li>952 123 456</li><li>
							info@bufetejuridicomalaga.es
						</li><li>Lun-Vie: 9:00-19:00</li>
					</ul>
				</div><div>
					<h4 class="mb-4 text-lg font-semibold">Enlaces</h4><ul class="space-y-2 text-gray-400">
						<li>
							<a href="#quienes-somos" class="cursor-pointer hover:text-white">Quiénes Somos</a>
						</li><li>
							<a href="#blog" class="cursor-pointer hover:text-white">Blog Jurídico</a>
						</li><li>
							<a href="#contacto" class="cursor-pointer hover:text-white">Primera Consulta</a>
						</li><li>
							<a href="https://readdy.ai/?origin=logo" class="cursor-pointer hover:text-white"
								>Website Builder</a
							>
						</li>
					</ul>
				</div>
			</div><div class="mt-8 border-t border-gray-800 pt-8 text-center text-gray-400">
				<p>© 2024 Bufete Jurídico Málaga. Todos los derechos reservados.</p>
			</div>
		</div>
	</footer>
</CustomLayout>
