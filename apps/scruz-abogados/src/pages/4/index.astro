---
import Layout2 from "../../layouts/Layout2.astro";
---

<Layout2>
  <div id="root">
    <div class="min-h-screen bg-white">
      <nav
        class="bg-white shadow-sm border-b border-gray-100 sticky top-0 z-50"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-center h-16">
            <div class="flex items-center">
              <h1
                class="text-2xl font-bold text-gray-900"
                style="font-family: Pacifico, serif;"
              >
                Bufete Jurídico Málaga
              </h1>
            </div><div class="hidden md:block">
              <div class="ml-10 flex items-baseline space-x-8">
                <a
                  href="#inicio"
                  class="text-gray-900 hover:text-blue-600 px-3 py-2 text-sm font-medium cursor-pointer whitespace-nowrap"
                  >Inicio</a
                ><a
                  href="#quienes-somos"
                  class="text-gray-700 hover:text-blue-600 px-3 py-2 text-sm font-medium cursor-pointer whitespace-nowrap"
                  >Quiénes Somos</a
                ><a
                  href="#servicios"
                  class="text-gray-700 hover:text-blue-600 px-3 py-2 text-sm font-medium cursor-pointer whitespace-nowrap"
                  >Servicios</a
                ><a
                  href="#equipo"
                  class="text-gray-700 hover:text-blue-600 px-3 py-2 text-sm font-medium cursor-pointer whitespace-nowrap"
                  >Equipo</a
                ><a
                  href="#blog"
                  class="text-gray-700 hover:text-blue-600 px-3 py-2 text-sm font-medium cursor-pointer whitespace-nowrap"
                  >Blog</a
                ><a
                  href="#contacto"
                  class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-primary cursor-pointer whitespace-nowrap"
                  >Contacto</a
                >
              </div>
            </div><div class="md:hidden">
              <button class="text-gray-700 hover:text-gray-900 cursor-pointer"
                ><i class="ri-menu-line text-xl"></i></button
              >
            </div>
          </div>
        </div>
      </nav><section
        id="inicio"
        class="relative bg-gradient-to-r from-blue-900 to-primary text-white min-h-screen flex items-center"
        style='background-image: linear-gradient(rgba(30, 58, 138, 0.8), rgba(29, 78, 216, 0.8)), url("https://readdy.ai/api/search-image?query=Professional%20modern%20law%20office%20interior%20in%20M%C3%A1laga%20Spain%20with%20elegant%20furniture%2C%20legal%20books%2C%20scales%20of%20justice%2C%20warm%20lighting%2C%20sophisticated%20atmosphere%2C%20marble%20surfaces%2C%20wooden%20details%2C%20contemporary%20design%2C%20trustworthy%20environment&width=1920&height=1080&seq=hero-law-office&orientation=landscape"); background-size: cover; background-position: center center;'
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="space-y-8">
              <div class="space-y-4">
                <h1 class="text-5xl lg:text-6xl font-bold leading-tight">
                  Su Despacho de Abogados en <span class="text-yellow-400"
                    >Málaga</span
                  >
                </h1><p class="text-xl lg:text-2xl text-blue-100">
                  Más de 20 años de experiencia defendiendo sus derechos con
                  profesionalidad y trato cercano
                </p>
              </div><div class="space-y-4">
                <div class="flex items-center space-x-3">
                  <i class="ri-check-line text-yellow-400 text-xl"></i><span
                    class="text-lg"
                    >Especialistas en Derecho de Familia, Herencias y Accidentes</span
                  >
                </div><div class="flex items-center space-x-3">
                  <i class="ri-check-line text-yellow-400 text-xl"></i><span
                    class="text-lg">Primera consulta gratuita</span
                  >
                </div><div class="flex items-center space-x-3">
                  <i class="ri-check-line text-yellow-400 text-xl"></i><span
                    class="text-lg"
                    >Atención en español, inglés, francés y árabe</span
                  >
                </div><div class="flex items-center space-x-3">
                  <i class="ri-check-line text-yellow-400 text-xl"></i><span
                    class="text-lg"
                    >Colegiados en el Ilustre Colegio de la Abogacía de Málaga</span
                  >
                </div>
              </div><div
                class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4"
              >
                <a
                  href="#contacto"
                  class="bg-yellow-500 text-blue-900 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-yellow-400 transition-colors cursor-pointer whitespace-nowrap text-center"
                  >Primera Consulta Gratuita</a
                ><a
                  href="tel:952123456"
                  class="border-2 border-white text-white px-8 py-4 rounded-lg text-lg font-semibold hover:bg-white hover:text-blue-900 transition-colors cursor-pointer whitespace-nowrap text-center"
                  ><i class="ri-phone-line mr-2"></i>952 123 456</a
                >
              </div>
            </div><div class="hidden lg:block">
              <img
                alt="Equipo de abogados profesionales"
                class="rounded-lg shadow-2xl object-cover w-full h-96"
                src="https://readdy.ai/api/search-image?query=Professional%20Spanish%20lawyers%20team%20in%20elegant%20law%20office%2C%20confident%20legal%20professionals%20in%20business%20attire%2C%20modern%20office%20setting%20in%20M%C3%A1laga%2C%20trustworthy%20atmosphere%2C%20scales%20of%20justice%2C%20legal%20books%20background%2C%20sophisticated%20lighting&width=600&height=800&seq=lawyers-team&orientation=portrait"
              />
            </div>
          </div>
        </div>
      </section><section id="quienes-somos" class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-900 mb-4">
              Quiénes Somos
            </h2><p class="text-xl text-gray-600 max-w-3xl mx-auto">
              Fundado en 2003, nuestro despacho se ha consolidado como referente
              en servicios jurídicos en Málaga, ofreciendo un trato
              personalizado y soluciones eficaces a particulares y empresas.
            </p>
          </div><div
            class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16"
          >
            <div>
              <img
                alt="Oficinas del despacho en Málaga"
                class="rounded-lg shadow-lg object-cover w-full h-80"
                src="https://readdy.ai/api/search-image?query=Modern%20law%20office%20building%20exterior%20in%20M%C3%A1laga%20Spain%2C%20professional%20architecture%2C%20glass%20facade%2C%20contemporary%20design%2C%20urban%20setting%2C%20Mediterranean%20style%2C%20prestigious%20location%2C%20clear%20blue%20sky&width=600&height=400&seq=office-building&orientation=landscape"
              />
            </div><div class="space-y-6">
              <h3 class="text-3xl font-bold text-gray-900">Nuestra Misión</h3><p
                class="text-lg text-gray-700"
              >
                Ofrecer un servicio jurídico de excelencia, con transparencia y
                compromiso. Nuestro equipo está compuesto por abogados
                titulados, colegiados en el Ilustre Colegio de la Abogacía de
                Málaga, con formación especializada.
              </p><div class="grid grid-cols-2 gap-6">
                <div class="text-center">
                  <div class="text-3xl font-bold text-blue-600">20+</div><div
                    class="text-gray-600"
                  >
                    Años de experiencia
                  </div>
                </div><div class="text-center">
                  <div class="text-3xl font-bold text-blue-600">1000+</div><div
                    class="text-gray-600"
                  >
                    Casos resueltos
                  </div>
                </div><div class="text-center">
                  <div class="text-3xl font-bold text-blue-600">95%</div><div
                    class="text-gray-600"
                  >
                    Casos ganados
                  </div>
                </div><div class="text-center">
                  <div class="text-3xl font-bold text-blue-600">4</div><div
                    class="text-gray-600"
                  >
                    Idiomas
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="py-20 bg-blue-600 text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h2 class="text-4xl font-bold mb-6">Primera Consulta Gratuita</h2><p
            class="text-xl mb-8 max-w-3xl mx-auto"
          >
            Analizamos su caso sin compromiso. Si decidimos avanzar, le
            presentaremos una propuesta clara con costes estimados y plazos.
            Transparencia, trato cercano y resultados.
          </p><div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
            <div class="text-center">
              <div
                class="w-16 h-16 bg-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <i class="ri-phone-line text-2xl text-blue-900"></i>
              </div><h3 class="text-xl font-bold mb-2">1. Contacte</h3><p>
                Llámenos o envíe un mensaje para concertar su cita
              </p>
            </div><div class="text-center">
              <div
                class="w-16 h-16 bg-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <i class="ri-search-line text-2xl text-blue-900"></i>
              </div><h3 class="text-xl font-bold mb-2">2. Análisis</h3><p>
                Estudiamos su caso y evaluamos las posibilidades
              </p>
            </div><div class="text-center">
              <div
                class="w-16 h-16 bg-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <i class="ri-file-text-line text-2xl text-blue-900"></i>
              </div><h3 class="text-xl font-bold mb-2">3. Propuesta</h3><p>
                Le presentamos una estrategia clara y transparente
              </p>
            </div>
          </div><a
            href="#contacto"
            class="bg-yellow-500 text-blue-900 px-8 py-4 rounded-lg text-lg font-semibold hover:bg-yellow-400 transition-colors cursor-pointer whitespace-nowrap"
            >Solicitar Consulta Gratuita</a
          >
        </div>
      </section>
      <footer class="bg-gray-900 text-white py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <div>
              <h3
                class="text-xl font-bold mb-4"
                style="font-family: Pacifico, serif;"
              >
                Bufete Jurídico Málaga
              </h3><p class="text-gray-400 mb-4">
                Su despacho de confianza en Málaga con más de 20 años de
                experiencia.
              </p><div class="flex space-x-4">
                <i
                  class="ri-facebook-fill text-xl hover:text-blue-400 cursor-pointer"
                ></i><i
                  class="ri-twitter-fill text-xl hover:text-blue-400 cursor-pointer"
                ></i><i
                  class="ri-linkedin-fill text-xl hover:text-blue-400 cursor-pointer"
                ></i>
              </div>
            </div><div>
              <h4 class="text-lg font-semibold mb-4">Servicios</h4><ul
                class="space-y-2 text-gray-400"
              >
                <li>
                  <a href="#servicios" class="hover:text-white cursor-pointer"
                    >Herencias y Testamentos</a
                  >
                </li><li>
                  <a href="#servicios" class="hover:text-white cursor-pointer"
                    >Accidentes de Tráfico</a
                  >
                </li><li>
                  <a href="#servicios" class="hover:text-white cursor-pointer"
                    >Derecho de Familia</a
                  >
                </li><li>
                  <a href="#servicios" class="hover:text-white cursor-pointer"
                    >Derecho Penal</a
                  >
                </li>
              </ul>
            </div><div>
              <h4 class="text-lg font-semibold mb-4">Contacto</h4><ul
                class="space-y-2 text-gray-400"
              >
                <li>Calle Larios 15, Málaga</li><li>952 123 456</li><li>
                  info@bufetejuridicomalaga.es
                </li><li>Lun-Vie: 9:00-19:00</li>
              </ul>
            </div><div>
              <h4 class="text-lg font-semibold mb-4">Enlaces</h4><ul
                class="space-y-2 text-gray-400"
              >
                <li>
                  <a
                    href="#quienes-somos"
                    class="hover:text-white cursor-pointer">Quiénes Somos</a
                  >
                </li><li>
                  <a href="#blog" class="hover:text-white cursor-pointer"
                    >Blog Jurídico</a
                  >
                </li><li>
                  <a href="#contacto" class="hover:text-white cursor-pointer"
                    >Primera Consulta</a
                  >
                </li><li>
                  <a
                    href="https://readdy.ai/?origin=logo"
                    class="hover:text-white cursor-pointer">Website Builder</a
                  >
                </li>
              </ul>
            </div>
          </div><div
            class="border-t border-gray-800 mt-8 pt-8 text-center text-gray-400"
          >
            <p>
              © 2024 Bufete Jurídico Málaga. Todos los derechos reservados.
            </p>
          </div>
        </div>
      </footer>
    </div>
  </div>
</Layout2>
