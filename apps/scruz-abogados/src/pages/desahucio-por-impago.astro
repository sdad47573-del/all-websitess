---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho civil', href: '/derecho-civil' },
	{ label: 'Desahucio por impago', href: '/desahucio-por-impago' },
];

const highlights = [
	'Análisis del contrato, la deuda y los intentos de cobro',
	'Estrategia para negociar, reclamar o defender el alquiler',
	'Valoración de costas, plazos y alternativas antes de actuar',
];

const sections = [
	{
		title: '¿Cuándo procede un desahucio por impago?',
		content: 'El desahucio por impago tiene por finalidad recuperar la vivienda cuando la parte arrendataria no cumple la obligación de pagar la renta o cantidades exigibles. Para valorar la vía adecuada hay que revisar el contrato, los avisos previos, la cantidad impagada y la situación de la vivienda.',
		points: [
			'Rentas impagadas y sus fechas de vencimiento.',
			'Notificaciones o requerimientos enviados a la parte arrendataria.',
			'Cláusulas contractuales sobre resolución y penalizaciones.',
			'Posibilidad de recuperar cantidades cuando el contrato ha finalizado.',
		],
	},
	{
		title: 'Cómo se desarrolla el procedimiento',
		content: 'La vía y los pasos dependen del tipo de arrendamiento, de si la vivienda está ocupada y de la antigüedad de la deuda. Antes de presentar una demanda conviene comprobar la competencia del órgano, la documentación y las consecuencias de la notificación.',
		points: [
			'Revisión del contrato, recibos, avisos y pruebas de impago.',
			'Intento de acuerdo o requerimiento cuando resulte conveniente.',
			'Preparación de la demanda y cálculo de lo que se reclama.',
			'Seguimiento de las citaciones, la contestación y las posibles medidas cautelares.',
		],
	},
	{
		title: 'Opciones antes de acudir a los tribunales',
		content: 'La negociación puede permitir recuperar la vivienda mediante un acuerdo, un pago calendarizado o un protocolo de salida ordenado. También puede estudiarse la aplicación de un instrumento de pago o la recuperación de cantidades. Cualquier acuerdo debe documentar importes, plazos, entrega de llaves, estado de la vivienda y consecuencias del incumplimiento.',
	},
	{
		title: 'Defensa del arrendatario y del propietario',
		content: 'La respuesta depende de los hechos y no todas las defensas son válidas. En el lado arrendatario se analizan, entre otros extremos, la deuda, las mejoras, las comunicaciones y las deducciones. En el lado propietario se revisan la legalidad del procedimiento, la prueba de la deuda y la posibilidad de reclamar cantidades. La estrategia debe definirse con el expediente completo.',
	},
	{
		title: 'El requerimiento antes de demandar',
		content: 'Un requerimiento escrito y fechado deja constancia de que se comunicó el impago y se exigió el pago antes de acudir al juzgado. No sustituye a la demanda, pero ordena los hechos y evita discusiones sobre qué se reclamó y cuándo. Conviene detallar la cantidad, el periodo al que corresponde y la forma de pago admitida.',
		points: [
			'Cantidad, rentas y periodos vencidos.',
			'Medio de envío y prueba de la recepción.',
			'Plazo concedido y consecuencia del silencio.',
		],
	},
	{
		title: 'Monitorio de rentas y desahucio',
		content: 'El procedimiento monitorio sirve para reclamar cantidades líquidas y documentadas, mientras que el desahucio persigue recuperar la posesión de la vivienda. Cuando existe impago, ambas pretensiones pueden plantearse de forma coordinada para no abrir dos procesos separados ni perder ninguna cantidad por el camino.',
		points: [
			'Cuantía, documentos y reconocimiento de la deuda.',
			'Posesión de la vivienda y ocupación real.',
			'Coordinación de las dos pretensiones.',
		],
	},
	{
		title: 'Pagar, oponerse o negociar: la defensa del inquilino',
		content: 'El arrendatario puede pagar y enervar la acción cuando la ley lo permite, oponerse si existen defectos en la reclamación o negociar una salida ordenada con entrega de llaves y calendario de pago. Cada opción tiene consecuencias distintas sobre el coste y el procedimiento, y la decisión debe tomarse con los documentos delante.',
		points: [
			'Revisión de la deuda y de los pagos realizados.',
			'Defectos formales de la comunicación o de la demanda.',
			'Acuerdo de salida, entrega de llaves y cantidades.',
		],
	},
];

const faqs = [
	{
		question: '¿Se puede recuperar una vivienda alquilada con impago?',
		answer: 'Sí, cuando existe impago y se cumplen los requisitos legales y contractuales. La forma y el procedimiento dependen del tipo de arrendamiento, de si la vivienda está ocupada y de la deuda existente.',
	},
	{
		question: '¿Hay que enviar un burofax antes de demandar?',
		answer: 'No siempre es un requisito universal, pero un requerimiento puede acreditar que se ha comunicado el incumplimiento y se ha intentado exigir el pago. Su oportunidad debe analizarse según el contrato y la situación.',
	},
	{
		question: '¿Puedo reclamar también las rentas impagadas?',
		answer: 'Puede estudiarse una acción para reclamarlas cuando el contrato ha terminado o en determinados procedimientos. Debe comprobarse el título, la deuda, los intereses y la vigencia de la reclamación.',
	},
	{
		question: '¿Qué ocurre si la vivienda está abandonada?',
		answer: 'La recuperación de una vivienda desocupada requiere un procedimiento diferente y no basta con cambiar la cerradura. Un profesional puede estudiar las vías legales y las medidas de seguridad adecuadas.',
	},
	{
		question: '¿Es lo mismo reclamar la deuda que desahuciar?',
		answer: 'No. Recuperar la vivienda y cobrar las rentas son pretensiones distintas, aunque puedan plantearse de forma coordinada. Conviene analizar ambas para no perder la posibilidad de cobrar lo pendiente ni la de recuperar la posesión.',
	},
];

const related = [
	{ label: 'Reclamaciones de deudas', href: '/cobro-deudas-impagos', description: 'Opciones para reclamar cantidades pendientes.' },
	{ label: 'Derecho civil', href: '/derecho-civil', description: 'Información general sobre obligaciones y controversias civiles.' },
	{ label: 'Desahucio en Lucena', href: '/blog/desahucio-por-impago-lucena', description: 'Guía práctica sobre el procedimiento y sus principales efectos.' },
];
---

<SeoLegalPage
	title="Abogado de Desahucio por Impago en Lucena | Alquiler"
	description="Desahucio por impago en Lucena y Córdoba: requerimiento, monitorio de rentas y defensa del propietario o del inquilino. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho civil y vivienda"
	headline="Desahucio por impago de alquiler"
	intro="El impago de la renta puede obligar a actuar, pero cada caso requiere una revisión cuidadosa del contrato y del procedimiento aplicable. Te ayudamos a valorar la deuda, las alternativas de acuerdo y la estrategia para recuperar la vivienda o defender tu posición."
	highlights={highlights}
	serviceType="Asesoría en desahucios por impago de alquiler"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
/>
