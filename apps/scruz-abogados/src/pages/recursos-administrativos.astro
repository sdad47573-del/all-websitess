---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	BookOpen,
	Building2,
	Clock,
	FileCheck,
	FilePenLine,
	Gavel,
	Handshake,
	Landmark,
	Scale,
	ScrollText,
	ShieldCheck,
	UserCheck,
	Users,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Qué recursos puedo presentar contra una resolución administrativa?',
		answer:
			'Depende de si el acto agota o no la vía administrativa. Si no la agota, procede el recurso de alzada; si la agota, cabe el recurso potestativo de reposición y, agotada la vía administrativa, el recurso contencioso-administrativo ante los tribunales. También existe el recurso extraordinario de revisión para supuestos tasados (errores de hecho, documentos nuevos, prevaricación). Estudiamos cada resolución y te indicamos el recurso correcto para no perder plazos.',
	},
	{
		question: '¿Cuánto tiempo tengo para recurrir una sanción o una resolución?',
		answer:
			'Con carácter general, el plazo para interponer el recurso de alzada o el de reposición es de un mes desde la notificación. El recurso extraordinario de revisión tiene un plazo de tres meses. Transcurridos los plazos sin recurrir, la resolución adquiere firmeza, por lo que es fundamental actuar con rapidez en cuanto recibes la notificación.',
	},
	{
		question: '¿Qué ocurre si la Administración no contesta a mi recurso?',
		answer:
			'Se produce el silencio administrativo. En los recursos de alzada y reposición, si transcurren tres meses sin resolución expresa, el recurso se entiende desestimado (silencio negativo), lo que permite acudir a la vía contencioso-administrativa. Hay supuestos en los que la ley atribuye silencio positivo, es decir, que la solicitud se entiende estimada.',
	},
	{
		question: '¿Me pueden sancionar sin darme la oportunidad de defenderme?',
		answer:
			'No. Todo procedimiento sancionador debe respetar el derecho de defensa: se te debe notificar el acuerdo de incoación, concederte trámite de alegaciones y audiencia antes de la resolución y permitirte proponer pruebas. Cuando estos trámites se omiten, la sanción puede anularse por indefensión. También cabe alegar la caducidad del procedimiento si la Administración supera el plazo máximo sin resolver.',
	},
	{
		question: '¿Es obligatorio agotar la vía administrativa antes de ir a los juzgados?',
		answer:
			'En la mayoría de los casos sí: contra los actos de las administraciones públicas hay que interponer primero los recursos administrativos procedentes y solo después, en el plazo de dos meses desde la notificación o desde el silencio, acudir a la jurisdicción contencioso-administrativa. Existen excepciones (por ejemplo, la vía penal o ciertas materias con regulación especial), que analizamos caso por caso.',
	},
	{
		question: '¿Puedo reclamar una indemnización a la Administración por los daños que me cause?',
		answer:
			'Sí. Cuando el funcionamiento de un servicio público causa un daño efectivo, evaluable económicamente e individualizado (una actuación incorrecta de un organismo, un retraso, un accidente por deficiencias de mantenimiento...), cabe reclamar la responsabilidad patrimonial de la Administración. El plazo general es de un año desde que se produjo el hecho o se manifestó su alcance.',
	},
	{
		question: 'Me han denegado una licencia o han abierto un expediente de urbanismo: ¿qué puedo hacer?',
		answer:
			'Los actos de urbanismo —denegación de licencias de obra o de primera ocupación, expedientes de disciplina e infracciones urbanísticas, órdenes de suspensión o retirada de obras— son actos administrativos recurribles, pero con plazos muy breves y con un expediente técnico que hay que leer antes de decidir la estrategia. Revisamos la notificación, el informe municipal y los plazos para presentar el recurso o las alegaciones procedentes ante el Ayuntamiento de Lucena o la Junta de Andalucía, y valoramos también la vía contencioso-administrativa si la respuesta no llega o no es favorable.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: Landmark, label: 'Ámbito', value: 'Toda la Administración' },
	{ Icon: Scale, label: 'Sedes', value: 'Lucena · Córdoba · Málaga' },
	{ Icon: UserCheck, label: 'Primera cita', value: 'Gratuita' },
];

const plazos = [
	{
		Icon: Clock,
		title: '1 mes',
		description: 'Plazo general para alzada o reposición desde la notificación.',
	},
	{
		Icon: FileCheck,
		title: '3 meses',
		description: 'Silencio desestimatorio si la Administración no resuelve tu recurso.',
	},
	{
		Icon: Gavel,
		title: '2 meses',
		description: 'Plazo para interponer el recurso contencioso-administrativo.',
	},
];

const conceptos = [
	{
		Icon: Building2,
		title: 'Urbanismo: licencias y disciplina urbanística',
		description:
			'Recurrimos denegaciones de licencias de obra y de primera ocupación, expedientes de disciplina e infracciones urbanísticas, y órdenes de suspensión o retirada de obras, ante el Ayuntamiento de Lucena y la Junta de Andalucía.',
		href: '/urbanismo/',
	},
	{
		Icon: FilePenLine,
		title: 'Recursos de alzada y reposición',
		description:
			'Interponemos los recursos administrativos procedentes contra resoluciones de cualquier administración: Ayuntamiento de Lucena, Junta de Andalucía, Estado u organismos públicos.',
	},
	{
		Icon: Gavel,
		title: 'Defensa en procedimientos sancionadores',
		description:
			'Te defendemos frente a sanciones de tráfico, urbanismo, consumo, laborales, medioambientales o de cualquier otra materia: alegaciones, pruebas, proporcionalidad, caducidad y prescripción.',
	},
	{
		Icon: Landmark,
		title: 'Responsabilidad patrimonial de la Administración',
		description:
			'Reclamamos la indemnización que te corresponde por los daños causados por el funcionamiento de los servicios públicos, con el plazo de un año que establece la ley.',
	},
	{
		Icon: ScrollText,
		title: 'Silencio administrativo y contencioso',
		description:
			'Gestionamos las consecuencias del silencio administrativo y, cuando procede, preparamos el recurso contencioso-administrativo ante los tribunales.',
	},
	{
		Icon: FileCheck,
		title: 'Reclamaciones económico-administrativas',
		description:
			'Impugnamos liquidaciones y actos tributarios locales o autonómicos (IBI, IAE, tasas, sanciones tributarias) por las vías de reclamación específicas.',
	},
	{
		Icon: BookOpen,
		title: 'Orientación preventiva y plazos',
		description:
			'Revisamos cada notificación que recibas para identificar el recurso procedente y su plazo: actuar tarde puede hacer firme una resolución desfavorable.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Análisis de la resolución',
		description:
			'Estudiamos la notificación, el procedimiento seguido y los plazos aplicables para determinar el recurso correcto y las posibilidades reales de éxito.',
	},
	{
		number: '02',
		title: 'Interposición del recurso',
		description:
			'Redactamos e interponemos el recurso administrativo en plazo, con los motivos de fondo y de forma, y solicitamos la suspensión de la ejecución cuando procede.',
	},
	{
		number: '03',
		title: 'Alegaciones y pruebas',
		description:
			'Presentamos alegaciones y proponemos las pruebas necesarias en el trámite de audiencia, tanto en recursos como en procedimientos sancionadores.',
	},
	{
		number: '04',
		title: 'Vía judicial si es necesario',
		description:
			'Si la Administración desestima o guarda silencio, preparamos la demanda contencioso-administrativa en el plazo de dos meses y te acompañamos hasta la sentencia.',
	},
];

const why = [
	{
		Icon: Users,
		title: 'Especialistas frente a la Administración',
		description:
			'Conocemos los procedimientos y plazos de las administraciones locales, autonómicas y estatales: un error formal puede costarte el recurso.',
	},
	{
		Icon: ShieldCheck,
		title: 'Defensa firme de tus derechos',
		description:
			'Las administraciones disponen de grandes recursos técnicos y jurídicos. Te aportamos la misma solidez profesional para que tu recurso esté en igualdad de condiciones.',
	},
	{
		Icon: Handshake,
		title: 'Transparencia en cada paso',
		description:
			'Te explicamos con claridad las posibilidades reales de cada recurso, los plazos y los costes antes de actuar. Sin falsas expectativas ni sorpresas.',
	},
];

const rangos = [
	{
		title: 'Alzada o reposición',
		value: '1 mes',
		note: 'Desde la notificación de la resolución',
	},
	{
		title: 'Silencio administrativo',
		value: '3 meses',
		note: 'Sin resolución expresa, el recurso se entiende desestimado',
	},
	{
		title: 'Contencioso-administrativo',
		value: '2 meses',
		note: 'Desde la notificación o el silencio administrativo',
	},
	{
		title: 'Responsabilidad patrimonial',
		value: '1 año',
		note: 'Desde el daño o el conocimiento de su alcance',
	},
];
---

<CustomLayout
	title="Abogado de Recursos Administrativos en Lucena | Scruz Abogados"
	description="Abogado de recursos administrativos, procedimientos sancionadores y responsabilidad patrimonial en Lucena y Córdoba. Consulta gratuita: 666 329 155."
	keywords="abogado recursos administrativos Lucena, abogado procedimiento sancionador Lucena, recurso alzada Córdoba, recurso reposición Málaga, defensa sanciones Lucena, responsabilidad patrimonial administración, abogado contencioso administrativo Andalucía"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Recursos Administrativos', url: '/recursos-administrativos/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/recursos-administrativos/#service`,
			serviceType: 'Derecho Administrativo',
			name: 'Recursos administrativos y procedimiento sancionador',
			description:
				'Recursos de alzada y reposición, defensa en procedimientos sancionadores y reclamaciones por responsabilidad patrimonial de la Administración en Lucena, Córdoba y Málaga.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogados especialistas en recursos administrativos y procedimientos sancionadores en Lucena, Córdoba y Málaga"
		supertitle="Derecho Administrativo · Recursos y sanciones"
		description="Defendemos tus derechos frente a cualquier administración: recursos, sanciones, silencios y responsabilidad patrimonial."
		stats={heroStats}
	>
		<span slot="title">Abogado de recursos y sanciones en Lucena.</span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Cada notificación tiene un plazo. <span class="text-primary">No lo dejes pasar.</span>'}
		factboxSupertitle="Plazos clave"
		factboxTitle="No dejes pasar los plazos"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Recibir una notificación de la Administración no significa asumirla: una sanción de
			tráfico o urbanismo, una liquidación tributaria, la denegación de una licencia o de una
			ayuda, un expediente sancionador laboral o medioambiental... casi todas las resoluciones
			administrativas pueden recurrirse, pero siempre dentro de unos plazos muy breves. Dejarlos
			pasar convierte la resolución en firme.
		</p>
		<p class="mb-4">
			En Scruz Abogados defendemos a particulares y empresas frente a todas las
			administraciones: el Ayuntamiento de Lucena y los de la comarca, la Junta de Andalucía,
			los organismos estatales y las entidades públicas. Interponemos los recursos de alzada y
			reposición que correspondan, te defendemos en los procedimientos sancionadores con
			alegaciones y pruebas, reclamamos la responsabilidad patrimonial de la Administración por
			los daños que te cause y, cuando es necesario, acudimos a la jurisdicción
			contencioso-administrativa.
		</p>
		<p>
			La clave está en actuar con rapidez y con la estrategia adecuada desde el primer día.
			Revisamos tu notificación, valoramos el recurso procedente y sus posibilidades reales de
			éxito, y te informamos del coste antes de dar ningún paso.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué tramitamos"
		title="Recursos y defensa administrativa"
		description="Toda la defensa frente a la Administración: recursos, sanciones, reclamaciones patrimoniales y vía contencioso-administrativa."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Tiempos y plazos"
		title="Plazos que debes conocer"
		description="Los plazos generales que maneja la normativa administrativa. Cada caso concreto puede tener regulación especial, que verificamos antes de actuar."
		valueFormat="single-currency"
		noteLabel="Plazo general orientativo."
		disclaimer="Plazos legales generales de la Ley 39/2015 y la LJCA. Existen plazos especiales según la materia; los confirmamos en la consulta inicial."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Cómo defendemos tu caso"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Tu recurso, en manos de quien conoce las reglas del juego."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre recursos administrativos, sanciones y reclamaciones frente a la Administración."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Revísanos tu notificación y te decimos el plazo y el recurso que procede. Si decides no continuar, no pagas nada."
		relatedLinks={[
			{ label: 'Nacionalidad y extranjería', href: '/nacionalidad-extranjeria/' },
			{ label: 'Derecho civil', href: '/derecho-civil/' },
			{ label: 'Empresas', href: '/empresas/' },
		]}
	/>
</CustomLayout>
