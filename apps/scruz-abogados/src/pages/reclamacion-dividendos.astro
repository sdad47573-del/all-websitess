---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Empresas', href: '/empresas' },
	{ label: 'Reclamación de dividendos', href: '/reclamacion-dividendos' },
];

const highlights = [
	'Revisión de derechos, aprobación y pago de dividendos',
	'Análisis de estatutos, acuerdos y documentación societaria',
	'Estrategia de reclamación o actuación societaria',
];

const sections = [
	{
		title: 'Reclamación de dividendos',
		content: 'La reclamación de dividendos depende de la condición de socio, del derecho reconocido, de la aprobación de la junta y del pago correspondiente. También deben revisarse los estatutos, los acuerdos y las comunicaciones de la empresa.',
		points: [
			'Identificación de la condición de socio y fecha de adquisición.',
			'Aprobación de resultados y acuerdo de reparto.',
			'Cantidad, fecha y medio de pago.',
			'Retenciones, fiscalidad y comunicación a la empresa.',
		],
	},
	{
		title: 'Documentación societaria',
		content: 'La información puede estar en los estatutos, el contrato de sociedad, las actas de la junta general, las cuentas aprobadas y las comunicaciones de la administración. La revisión debe confirmar que el derecho existía y que no se ha pagado.',
	},
	{
		title: 'Reclamación a la empresa',
		content: 'La reclamación debe explicar la condición de socio, el acuerdo de reparto, la cantidad pendiente y la vía de cobro. Según el caso, puede ser necesario solicitar información, presentar una reclamación formal o estudiar una actuación judicial.',
	},
	{
		title: 'Derechos y límites de la reclamación',
		content: 'La respuesta depende de las normas de la empresa y de la normativa aplicable. Los estatutos pueden establecer condiciones, plazos o requisitos que deben revisarse antes de reclamar.',
	},
	{
		title: 'Cuándo nace el derecho al dividendo',
		content: 'El derecho al dividendo surge con el acuerdo de reparto que adopta la junta general sobre los resultados del ejercicio. Desde ese momento el socio puede exigir su parte en la forma y el plazo acordados. Antes del acuerdo existe una expectativa, no un derecho de cobro, y por eso la fecha del acta resulta decisiva.',
		points: [
			'Cuentas aprobadas y acuerdo de aplicación del resultado.',
			'Fecha, importe y forma de pago acordados.',
			'Socio legitimado en la fecha del acuerdo.',
		],
	},
	{
		title: 'Acuerdos de la junta y abuso de la mayoría',
		content: 'La junta puede acordar no repartir beneficios y destinarlos a reservas, lo que en principio es una decisión de gestión. La revisión se centra en si el acuerdo persigue dejar al socio sin su derecho económico o si se aparta de los estatutos y de los pactos de socios. Documentar la convocatoria, las mayorías y el acta es imprescindible.',
		points: [
			'Actas, convocatoria y mayorías exigidas.',
			'Destino acordado de los resultados.',
			'Pactos de socios y derecho de separación cuando proceda.',
		],
	},
	{
		title: 'Reclamación frente a la sociedad y frente a los administradores',
		content: 'Lo habitual es reclamar primero a la sociedad el dividendo acordado y no recibido. Si el impago responde a una gestión que ha causado un daño al socio, puede estudiarse además la responsabilidad de los administradores por no haber cumplido sus obligaciones. La vía depende de la documentación disponible.',
		points: [
			'Requerimiento a la sociedad y respuesta obtenida.',
			'Información contable y societaria disponible.',
			'Responsabilidad de los administradores cuando proceda.',
		],
	},
];

const faqs = [
	{
		question: '¿Cómo sé si tengo derecho a dividendos?',
		answer: 'Debe revisarse la condición de socio, los estatutos, el acuerdo de reparto y la fecha en que se adquirieron los derechos. La respuesta depende de la sociedad y del acuerdo aplicable.',
	},
	{
		question: '¿Tengo que reclamar a la empresa?',
		answer: 'La vía puede incluir una reclamación escrita, una petición de información o una actuación judicial. El procedimiento y la urgencia deben analizarse según los documentos.',
	},
	{
		question: '¿Qué pasa si no me pagan un dividendo aprobado?',
		answer: 'Puede estudiarse la reclamación de la cantidad y de los intereses que correspondan. Hay que revisar el acuerdo, la comunicación, la fecha de pago y la situación actual de la sociedad.',
	},
	{
		question: '¿Qué ocurre con los dividendos aprobados y no cobrados?',
		answer: 'El socio mantiene su derecho a cobrarlos, así que se revisa el acuerdo de la junta, la fecha de pago, las comunicaciones con la sociedad y el importe pendiente. Si la sociedad alega que intentó pagar y no pudo localizar al socio, conviene documentar la reclamación y la cuenta de destino antes de dar el paso siguiente.',
	},
	{
		question: '¿Puede la junta decidir no repartir beneficios?',
		answer: 'En principio sí, porque el reparto es una decisión de la junta sobre los resultados del ejercicio. Lo que puede discutirse es un acuerdo que en la práctica prive al socio de su derecho económico o que se aparte de lo previsto en los estatutos o en los pactos de socios.',
	},
];

const related = [
	{ label: 'Empresas', href: '/empresas', description: 'Servicios jurídicos para empresas y negocios.' },
	{ label: 'Pactos de socios', href: '/blog/pactos-de-socios-sl', description: 'Acuerdos entre socios y gobierno de la sociedad.' },
	{ label: 'Responsabilidad de administradores', href: '/blog/responsabilidad-administradores-sl', description: 'Obligaciones y responsabilidad en la gestión.' },
];
---

<SeoLegalPage
	title="Abogado para Reclamar Dividendos en Lucena | Scruz Abogados"
	description="Dividendos aprobados y sin pagar o derechos económicos de socio: revisamos acuerdos, estatutos y pagos en Lucena y Córdoba. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho mercantil"
	headline="Reclamación de dividendos y derechos de socios"
	intro="Si consideras que tienes derecho a dividendos o no has recibido el importe correspondiente, conviene revisar la situación societaria y la documentación de la empresa."
	highlights={highlights}
	serviceType="Asesoría para reclamación de dividendos"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	guides={['pactos-de-socios-sl', 'responsabilidad-administradores-sl', 'monitorio-reclamacion-deudas']}
/>
