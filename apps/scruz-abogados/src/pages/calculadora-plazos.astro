---
import SeoLegalPage from '../components/SeoLegalPage.astro';
import { MATERIAS, PLAZOS } from '../data/PLAZOS';

/**
 * Calculadora de plazos por materia.
 *
 * La idea es resolver la duda real, que no es «¿cuánto dura el plazo?» sino
 * «¿hasta qué día tengo?». Por eso el orden de la página es el de una persona
 * con prisa: primero el cálculo, y debajo el catálogo completo con el artículo
 * de cada plazo al lado.
 *
 * Los datos vienen de `src/data/PLAZOS.ts`, con el artículo de origen
 * verificado en el texto consolidado del BOE. El cálculo se hace en el cliente
 * con la misma aritmética que se explica en la última sección: los plazos en
 * meses van de fecha a fecha y los expresados en días cuentan el día
 * siguiente al del hecho. No se corrigen festivos ni días inhábiles porque no
 * se puede saber en qué provincia se tramita el asunto desde un formulario: se
 * avisa de ello y se manda a la consulta, que es donde se comprueba.
 *
 * Es una herramienta de orientación, no un sustituto de mirar el expediente. Lo
 * dice en la propia página, no en letra pequeña.
 */

const totalPlazos = PLAZOS.length;
const porMateria = MATERIAS.map((materia) => ({
	...materia,
	plazos: PLAZOS.filter((p) => p.materia === materia.id),
}));

const sections = [
	{
		title: 'Un plazo sin fecha de inicio no sirve de nada',
		content:
			'Cuando alguien pregunta cuánto tiene de plazo, casi siempre falta lo importante: desde cuándo corre. En vía administrativa corre desde la notificación, y la notificación empieza a correr el día siguiente al de la fecha en que se recibe. En lo social, desde que el derecho se hizo exigible. En una herencia, desde el fallecimiento o desde que se tuvo conocimiento de él. Cambia la fecha de inicio y cambia el vencimiento, y ese error es el que hace que un plazo se pierda por un día.',
		points: [
			'El día del hecho no se cuenta: se cuenta desde el siguiente.',
			'Los plazos en meses van de fecha a fecha, no día a día.',
			'Los plazos en días son días hábiles en vía administrativa.',
			'Si el último día es festivo o sábado, se prorroga al primer día hábil siguiente.',
		],
	},
	{
		title: 'Qué plazos están aquí y cuáles no',
		content: `Se han metido ${totalPlazos} plazos de cuatro materias: recursos administrativos, herencias, laboral y prescripción. Cada uno lleva su artículo, para que se pueda comprobar. Quedan fuera los que dependen de una norma sectorial que no se ha verificado, como las notificaciones de la Seguridad Social o de la Agencia Tributaria, que tienen plazos propios. Es preferible un catálogo corto y comprobable que uno largo y dudoso.`,
		points: [
			'Recursos: reposición, alzada, extraordinario de revisión, contencioso y vía de hecho.',
			'Herencias: aceptar o rechazar, prerrogativa de un mes, recisión y legítima.',
			'Laboral: acta de despido y prescripción de derechos.',
			'Prescripción: infracciones administrativas y acciones personales.',
		],
	},
	{
		title: 'Lo que la calculadora no puede saber',
		content:
			'No sabe en qué provincia se tramita el asunto, y por eso no aplica el calendario de festivos de cada provincia. Tampoco sabe si el acto que se recurrió es de mero trámite o no, ni si la notificación estaba completa. Esos tres datos cambian el resultado. Por eso la fecha que sale es una estimación con la base a la vista, y la comprobación se hace en la consulta, que es gratuita.',
		points: [
			'Si el plazo vence en sábado, domingo o festivo, se prorroga al primer día hábil.',
			'En vía administrativa los plazos en días son días hábiles.',
			'Una notificación defectuosa puede hacer que el plazo no haya empezado a correr.',
			'Cuando el plazo va en meses y el día no existe en el mes de vencimiento, vence el último día de ese mes.',
		],
	},
];

const faqs = [
	{
		question: '¿La fecha que sale es exacta?',
		answer:
			'No del todo. La fecha base y el plazo salen de datos verificados, pero la calculadora no aplica los festivos de la provincia donde se tramite ni comprueba si la notificación fue válida. Es una estimación con la base a la vista, pensada para que sepas si el caso corre prisa.',
	},
	{
		question: '¿Los plazos se cuentan en días hábiles o naturales?',
		answer:
			'En vía administrativa, los plazos expresados en días son días hábiles: no se cuentan sábados, domingos ni festivos. En la mayoría de los procedimientos judiciales el cómputo es de días naturales, aunque el último día inhábil se prorroga. La propia ficha de cada plazo indica cómo se cuenta.',
	},
	{
		question: '¿Me han dicho que el plazo se ha interrumpido, es verdad?',
		answer:
			'No siempre. La prescripción se interrumpe si se reclama ante la administración o el órgano que corresponda, pero la caducidad no se interrumpe: el recurso contencioso es un plazo de caducidad y en ese caso hay que estar encima. La diferencia es la clave, y la primera consulta empieza por saber cuál de las dos cosas corre en tu caso.',
	},
	{
		question: '¿Y si mi plazo no está en la lista?',
		answer:
			'Escríbenos con la materia y la fecha. Si es un plazo general que hemos dejado fuera por no estar verificado, lo comprobamos y lo añadimos con su artículo. Preferimos que falte un plazo en la lista a que haya uno puesto a ojo.',
	},
	{
		question: '¿La primera consulta sigue siendo gratuita?',
		answer:
			'Sí. Se revisan los documentos, se identifica la materia, el órgano competente y el plazo que corre, y se dan las opciones con su coste. La calculadora no sustituye a esa revisión, la prepara.',
	},
];

const related = [
	{
		label: 'Recursos administrativos',
		href: '/recursos-administrativos/',
		description: 'Recursos contra multas, sanciones y actos de la Administración.',
	},
	{
		label: 'Herencias y testamentos',
		href: '/herencias-testamentos/',
		description: 'Aceptación, renuncia, legítima y partición.',
	},
	{
		label: 'Despidos',
		href: '/despidos/',
		description: 'Despido disciplinario, objetivo e improcedente, y carta de despido.',
	},
	{
		label: 'Qué juzgado me corresponde',
		href: '/que-juzgado-me-corresponde/',
		description: 'Antes de fechar un plazo, saber ante qué órgano.',
	},
	{
		label: 'Partidos judiciales',
		href: '/partidos-judiciales/',
		description: 'Qué se tramita en cada partido y dónde va lo social.',
	},
	{
		label: 'Calculadora de tasa judicial',
		href: '/calculadora-tasa-judicial/',
		description: 'Si vas como particular, no pagas: la cuota variable también se anuló.',
	},
	{
		label: 'Reparto de herencia y legítima',
		href: '/reparto-herencia/',
		description: 'Cuánto es la legítima y cómo se reparte entre cónyuge e hijos.',
	},
	{
		label: 'Oficinas y ubicaciones',
		href: '/ubicaciones/',
		description: 'Consulta gratuita en Lucena o Málaga.',
	},
];
---

<SeoLegalPage
	title="Calculadora de plazos legales | Scruz"
	description="Calcula la fecha de vencimiento de los plazos más habituales: recursos administrativos, herencias, laboral y prescripción. Cada plazo, con su artículo."
	breadcrumb={[
		{ label: 'Inicio', href: '/' },
		{ label: 'Recursos administrativos', href: '/recursos-administrativos/' },
		{ label: 'Calculadora de plazos', href: '/calculadora-plazos/' },
	]}
	eyebrow="Herramientas"
	headline="Calculadora de plazos"
	intro="Elige la materia, el plazo y la fecha desde la que corre, y mira hasta qué día tienes. Cada plazo lleva el artículo del que sale, porque un plazo sin base de cómputo no sirve de nada."
	highlights={[
		`${totalPlazos} plazos en cuatro materias`,
		'Cada uno con su artículo y su fecha de inicio',
		'Cómputo de meses de fecha a fecha, como manda la ley',
		'Primera consulta gratuita en Lucena o Málaga',
	]}
	serviceType="Cálculo y revisión de plazos legales"
	areaServed="Málaga, Córdoba, Cádiz, Granada, Huelva y toda España"
	sections={sections}
	faqs={faqs}
	related={related}
/>

<section class="bg-base-200 px-6 py-14 md:px-16">
	<div class="mx-auto max-w-3xl">
		<h2 class="mb-2 font-title text-2xl md:text-3xl">Calcula tu vencimiento</h2>
		<p class="mb-6 text-base-content/70">
			Pon la fecha desde la que corre el plazo, no la fecha en que te han
			enterado.
		</p>

		<label class="mb-2 block font-semibold" for="materia">Materia</label>
		<select id="materia" class="select select-bordered mb-4 w-full">
			{porMateria.map((m) => <option value={m.id}>{m.nombre}</option>)}
		</select>

		<label class="mb-2 block font-semibold" for="plazo">Plazo</label>
		<select id="plazo" class="select select-bordered mb-4 w-full"></select>

		<label class="mb-2 block font-semibold" for="fecha">Fecha desde la que corre</label>
		<input id="fecha" type="date" class="input input-bordered mb-6 w-full" />

		<div id="resultado" class="hidden" aria-live="polite"></div>

		<p class="mt-6 text-sm text-base-content/60">
			No se aplican festivos: la fecha depende de la provincia donde se
			tramite. La comprobación va con la consulta.
		</p>
	</div>
</section>

<section class="bg-base-100 px-6 py-14 md:px-16">
	<div class="mx-auto max-w-5xl">
		<h2 class="mb-2 font-title text-2xl md:text-3xl">Todos los plazos, con su artículo</h2>
		<p class="mb-8 max-w-3xl text-base-content/70">
			Esta tabla es la calculadora en papel. Es también lo que hay que mirar
			cuando el plazo no está en la calculadora.
		</p>

		{
			porMateria.map((m) => (
				<div class="mb-10">
					<h3 class="mb-1 font-title text-xl">{m.nombre}</h3>
					<p class="mb-4 max-w-3xl text-base-content/70">{m.resumen}</p>
					<div class="overflow-x-auto">
						<table class="table-zebra table table-sm">
							<thead>
								<tr>
									<th>Plazo</th>
									<th>Tiempo</th>
									<th>Desde cuándo corre</th>
									<th>Artículo</th>
								</tr>
							</thead>
							<tbody>
								{m.plazos.map((p) => (
									<tr>
										<td class="font-semibold">{p.nombre}</td>
										<td>{p.texto}</td>
										<td>{p.base}</td>
										<td class="text-sm">{p.fuente}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
					<p class="mt-3">
						<a class="link link-primary" href={m.href}>
							Ver {m.nombre.toLowerCase()}
						</a>
					</p>
				</div>
			))
		}
	</div>
</section>

<script is:inline
	type="application/json"
	id="datos-plazos"
	set:html={JSON.stringify({ materias: MATERIAS, plazos: PLAZOS }).replace(/</g, '\\u003c')}
/>

<script>
	/**
	 * El cálculo va en el cliente porque el visitante va a cambiar de fecha
	 * varias veces y no tiene sentido volver a pedir la página. La aritmética es
	 * la que se explica en la página: en meses, de fecha a fecha; en días
	 * hábiles, saltando sábados y domingos y sin contar el día de la base.
	 */
	interface Plazo {
		id: string;
		materia: string;
		nombre: string;
		texto: string;
		meses?: number;
		dias?: number;
		computo: 'naturales' | 'habiles' | 'fecha-a-fecha';
		base: string;
		fuente: string;
		aviso?: string;
	}
	interface Materia {
		id: string;
		nombre: string;
		resumen: string;
	}

	const datos = JSON.parse(
		document.getElementById('datos-plazos')?.textContent ?? '{"plazos":[]}',
	) as { materias: Materia[]; plazos: Plazo[] };

	const selectMateria = document.getElementById('materia') as HTMLSelectElement | null;
	const selectPlazo = document.getElementById('plazo') as HTMLSelectElement | null;
	const inputFecha = document.getElementById('fecha') as HTMLInputElement | null;
	const resultado = document.getElementById('resultado');

	const sumarMeses = (fecha: Date, meses: number): Date => {
		const d = new Date(fecha);
		const diaOriginal = d.getDate();
		d.setDate(1);
		d.setMonth(d.getMonth() + meses);
		const ultimo = new Date(d.getFullYear(), d.getMonth() + 1, 0).getDate();
		// Si el mes de vencimiento no tiene el día original, vence el último.
		d.setDate(Math.min(diaOriginal, ultimo));
		return d;
	};

	const sumarDias = (fecha: Date, dias: number, habiles: boolean): Date => {
		const d = new Date(fecha);
		let restantes = dias;
		while (restantes > 0) {
			d.setDate(d.getDate() + 1);
			const dia = d.getDay();
			if (!habiles || (dia !== 0 && dia !== 6)) restantes--;
		}
		return d;
	};

	const vence = (plazo: Plazo, base: Date): Date => {
		if (plazo.computo === 'fecha-a-fecha' && plazo.meses) return sumarMeses(base, plazo.meses);
		if (plazo.dias) return sumarDias(base, plazo.dias, plazo.computo === 'habiles');
		return base;
	};

	const largo = (d: Date) =>
		d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

	const pintarPlazos = () => {
		if (!selectPlazo || !selectMateria) return;
		const lista = datos.plazos.filter((p) => p.materia === selectMateria.value);
		selectPlazo.innerHTML = lista
			.map((p) => `<option value="${p.id}">${p.nombre} — ${p.texto}</option>`)
			.join('');
		calcular();
	};

	const calcular = () => {
		if (!resultado || !inputFecha || !selectPlazo) return;
		if (!inputFecha.value) {
			resultado.classList.add('hidden');
			return;
		}
		const plazo = datos.plazos.find((p) => p.id === selectPlazo.value);
		if (!plazo) return;

		const base = new Date(`${inputFecha.value}T12:00:00`);
		const fin = vence(plazo, base);
		const hoy = new Date();
		const dias = Math.round((fin.getTime() - hoy.getTime()) / 86_400_000);
		const finde = fin.getDay() === 0 || fin.getDay() === 6;
		const venceYa = dias < 0;

		let estado: string;
		if (venceYa) {
			estado =
				'<p class="mt-2"><strong class="text-error">Ese plazo ya ha vencido.</strong> ' +
				'Dicho esto, algunos plazos se interrumpen o se prorrogan, y eso solo se puede ' +
				'comprobar mirando el caso.</p>';
		} else if (dias === 0) {
			estado = '<p class="mt-2"><strong>Vence hoy.</strong></p>';
		} else {
			estado = `<p class="mt-2"><strong>${dias} días</strong> desde hoy.</p>`;
		}

		resultado.innerHTML =
			'<div class="rounded-box border border-primary/30 bg-primary/5 p-5">' +
			`<p class="text-sm opacity-70">${plazo.nombre} — ${plazo.texto}</p>` +
			`<h3 class="mt-1 font-title text-xl">Vence el ${largo(fin)}</h3>` +
			estado +
			`<dl class="mt-4 space-y-2 text-sm">` +
			`<div><dt class="font-semibold">Cuentas desde</dt><dd>${plazo.base} (${largo(base)}).</dd></div>` +
			`<div><dt class="font-semibold">Cómo se cuenta</dt><dd>${
				plazo.computo === 'fecha-a-fecha'
					? 'de fecha a fecha'
					: plazo.computo === 'habiles'
						? 'en días hábiles, sin contar el día de la base'
						: 'en días naturales'
			}.</dd></div>` +
			`<div><dt class="font-semibold">Artículo</dt><dd>${plazo.fuente}</dd></div>` +
			`</dl>` +
			(finde
				? '<p class="mt-3 text-sm"><strong>Esa fecha cae en fin de semana.</strong> El último día inhábil se prorroga al primer día hábil siguiente, así que margen de un día o dos.</p>'
				: '') +
			(plazo.aviso ? `<p class="mt-3 text-sm">${plazo.aviso}</p>` : '') +
			'<p class="mt-4"><a class="link link-primary" href="/ubicaciones/">Comprobar mi caso, gratis</a></p>' +
			'</div>';
		resultado.classList.remove('hidden');
	};

	selectMateria?.addEventListener('change', pintarPlazos);
	selectPlazo?.addEventListener('change', calcular);
	inputFecha?.addEventListener('change', calcular);
	inputFecha?.addEventListener('input', calcular);
	if (selectMateria) pintarPlazos();
</script>
