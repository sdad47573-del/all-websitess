---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Empresas', href: '/empresas' },
	{ label: 'Contratos comerciales', href: '/contratos-comerciales' },
];

const highlights = [
	'Revisión de condiciones económicas, riesgos y obligaciones',
	'Negociación y redacción de cláusulas para empresas',
	'Reclamación y defensa por incumplimiento contractual',
];

const sections = [
	{
		title: 'Asesoría sobre contratos comerciales',
		content: 'Un contrato comercial debe definir con claridad qué se contrata, los precios, los plazos, la forma de entrega, las responsabilidades y cómo se resuelve el incumplimiento. Una revisión antes de firmar puede reducir disputas posteriores.',
		points: [
			'Alcance del servicio, producto o suministro.',
			'Precios, IVA, gastos, revisiones y condiciones de pago.',
			'Plazos, garantías, confidencialidad y protección de datos.',
			'Incumplimiento, penalizaciones, resolución y jurisdicción.',
		],
	},
	{
		title: 'Negociación y redacción',
		content: 'La negociación debe recuperar los riesgos reales del negocio. No basta con cambiar el nombre de una cláusula: hay que comprobar que el equilibrio entre riesgos, plazos y responsabilidades sea coherente con la operación. La versión final debe almacenarse y firmarse correctamente.',
	},
	{
		title: 'Incumplimiento y reclamación',
		content: 'Si una de las partes no cumple, conviene revisar el contrato, las facturas, los pedidos, las entregas y las comunicaciones. Según el caso, puede procederse a una reclamación, negociación o demanda. También debe estudiarse si existe una cláusula de resolución o un mecanismo de mediación.',
	},
	{
		title: 'Contratos con clientes, proveedores y socios',
		content: 'Cada relación comercial tiene riesgos diferentes. Un contrato de servicios no es igual que uno de distribución, suministro o licencia. La revisión debe adaptarse a la operación real y a la capacidad de las partes.',
	},
	{
		title: 'Distribución, agencia y suministro: qué se negocia en cada tipo',
		content: 'No es lo mismo vender a través de un distribuidor que delegar la promoción en un agente o comprometer entregas periódicas en un suministro. Cambian la exclusividad, la comisión o el margen, quién asume el stock, quién paga la logística y cómo se termina la relación. Confundir los modelos es una de las causas más frecuentes de conflicto entre empresas.',
		points: [
			'Distribución: compra y reventa, territorio y exclusividad.',
			'Agencia: promoción por cuenta ajena, comisión y clientela.',
			'Suministro: precios, volumen, plazos y penalizaciones.',
			'Duración, preaviso y qué ocurre al terminar el contrato.',
		],
	},
	{
		title: 'Facturas impagadas, reclamación y cláusulas de penalización',
		content: 'Cuando el cliente deja de pagar, el expediente decide: contrato, pedidos, albaranes de entrega, facturas y comunicaciones. A partir de ahí se puede exigir el principal, los intereses pactados y, si el contrato lo prevé, una penalización o una indemnización. Si se acepta un pago parcial o un calendario largo, conviene dejarlo por escrito.',
		points: [
			'Documentar la entrega, no solo la factura emitida.',
			'Intereses de demora y cláusula penal si están pactados.',
			'Requerimiento formal y constancia actualizada de la deuda.',
			'Los acuerdos de pago, siempre por escrito.',
		],
	},
	{
		title: 'Confidencialidad, no competencia y protección de datos',
		content: 'En las relaciones entre empresas se cruza información sensible: precios, clientes, procesos y datos personales. Los acuerdos de confidencialidad, las cláusulas de no competencia y el tratamiento de datos deben estar bien delimitados, porque su infracción no solo genera responsabilidad contractual: también puede interesar a la normativa de protección de datos.',
		points: [
			'Delimitar qué información es confidencial y durante cuánto tiempo.',
			'No competencia: ámbito, actividad y proporción.',
			'Datos personales: base jurídica y encargados del tratamiento.',
			'Consecuencias del incumplimiento y prueba del daño.',
		],
	},
];

const faqs = [
	{
		question: '¿Cuándo conviene revisar un contrato comercial?',
		answer: 'Conviene revisarlo antes de firmarlo, antes de aceptar un pedido importante y cuando cambien el precio, la entrega o las condiciones del servicio. También es útil ante un incumplimiento.',
	},
	{
		question: '¿Un contrato por WhatsApp es válido?',
		answer: 'Un mensaje puede tener efectos según el caso, la normativa aplicable y el contenido. Es importante conservar las comunicaciones y valorar si la forma utilizada es adecuada.',
	},
	{
		question: '¿Puede modificarse un contrato comercial?',
		answer: 'Una modificación debe analizarse según el contrato y la normativa aplicable. Debe documentarse por escrito y aceptarse por las partes para evitar disputas.',
	},
	{
		question: '¿Qué ocurre si el cliente no paga?',
		answer: 'Debe revisarse el contrato, las facturas, las entregas y las comunicaciones. La reclamación y la vía judicial dependen del importe, la prueba y las condiciones pactadas.',
	},
	{
		question: '¿Hace falta un contrato con cada proveedor habitual?',
		answer: 'No siempre es obligatorio, pero sí recomendable. Un contrato marco con condiciones de pago, entregas, responsabilidad y resolución evita discutir cada pedido y sirve de prueba cuando surge el conflicto. Si ya se trabaja por correo, se puede ordenar por escrito lo que se venía aplicando.',
	},
];

const related = [
	{ label: 'Contratos mercantiles', href: '/empresas/contratos-mercantiles', description: 'Asesoría sobre relaciones mercantiles y obligaciones.' },
	{ label: 'Empresas', href: '/empresas', description: 'Servicios jurídicos para empresas y negocios.' },
	{ label: 'Compraventas de empresas', href: '/compraventas-empresas', description: 'Operaciones de compraventa y due diligence.' },
];
---

<SeoLegalPage
	title="Abogado de Contratos en Lucena | Redacción y Revisión"
	description="Redacción, revisión y negociación de contratos comerciales en Lucena y Córdoba: cláusulas, incumplimiento, pagos y resolución. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho mercantil"
	headline="Contratos comerciales para empresas"
	intro="Los contratos comerciales regulan relaciones con clientes, proveedores y socios. Te ayudamos a reducir riesgos, negociar condiciones y actuar si una de las partes incumple."
	highlights={highlights}
	serviceType="Asesoría en contratos comerciales"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	guides={['monitorio-reclamacion-deudas', 'tarifa-plana-abogados', 'resenas-google-derecho-al-honor']}
/>
