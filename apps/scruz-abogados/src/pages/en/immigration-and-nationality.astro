---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import CustomLayout from '../../layouts/CustomLayout.astro';
import { SITE_URL } from '../../data/site';

// Versión inglesa de /nacionalidad-extranjeria/. Enfocada a quien ya vive en
// España (o quiere hacerlo) y necesita entender el expediente: qué se pide, en
// qué plazo y qué pasa si deniegan. Los tiempos son orientativos y se confirman
// tras revisar el caso, igual que en la página española.
const alternates = [
	{ hreflang: 'es-ES', href: `${SITE_URL}/nacionalidad-extranjeria/` },
	{ hreflang: 'en', href: `${SITE_URL}/en/immigration-and-nationality/` },
	{ hreflang: 'x-default', href: `${SITE_URL}/nacionalidad-extranjeria/` },
];

const faqEntries = [
	{
		question: 'How long does Spanish nationality by residence take?',
		answer:
			'The legal waiting period is 10 years of continuous legal residence in general, 2 years for nationals of Ibero-American countries, Andorra, the Philippines, Equatorial Guinea and Portugal, and 1 year for people born in Spain or married to a Spaniard (after a year of marriage, not separated). Once filed, the file usually takes between 1 and 3 years to be decided, depending on the office handling it.',
	},
	{
		question: 'Do I need to pass an exam for nationality?',
		answer:
			'Yes, in most cases: the CCSE test on Spanish constitutional and cultural knowledge, and a DELE A2 Spanish certificate unless you are exempt. Exemptions depend on your nationality, your schooling in Spanish and other circumstances, so we check your situation before booking the tests.',
	},
	{
		question: 'What is the difference between residency and nationality?',
		answer:
			'Residency authorises you to live and usually work in Spain for a limited period and must be renewed. Nationality makes you a Spanish citizen, with a Spanish passport, the right to vote and no renewal, and it is not lost by living abroad. Residency years count towards nationality, so renewals must never be allowed to lapse.',
	},
	{
		question: 'What happens if my application is refused?',
		answer:
			'Every refusal can be appealed. Depending on the procedure you have one month for an administrative appeal (reposición) and two months to go to the contentious-administrative court. Missing those deadlines is the most common reason for losing a case that could have been won, so we study the resolution as soon as it arrives.',
	},
	{
		question: 'Can you handle the file if I am not in Spain?',
		answer:
			'Yes. Most of the work is documentary and can be prepared remotely, and we attend the appointments and interviews that require your presence. Powers of attorney can be signed at a Spanish consulate or before a notary in your country.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	'@id': `${SITE_URL}/en/immigration-and-nationality/#service`,
	serviceType: 'Immigration law',
	name: 'Immigration and nationality advice in English',
	description:
		'Spanish residency, family reunification, EU registration, asylum appeals and nationality files prepared and defended in English.',
	provider: { '@id': `${SITE_URL}/#organization` },
	areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
};

const services = [
	{
		title: 'Residency and work permits',
		description:
			'Initial authorisation for employed or self-employed work, renewals within the 60-day window and long-term residence.',
	},
	{
		title: 'Exceptional circumstances (arraigo)',
		description:
			'Social, labour and family roots: proving time in Spain, means of support and integration, and avoiding formal defects that lead to refusal.',
	},
	{
		title: 'Family reunification',
		description:
			'Spouse or registered partner, children and dependent parents, with the housing report and financial means the office requires.',
	},
	{
		title: 'EU citizens and their families',
		description:
			'Registration certificates for EU nationals and residence cards for non-EU family members, including retained rights after divorce.',
	},
	{
		title: 'Nationality and passports',
		description:
			'Nationality by residence, option or carta de naturaleza, CCSE and DELE preparation, and the appointment for the oath and registration.',
	},
	{
		title: 'Refusals, appeals and asylum',
		description:
			'Administrative appeals and court proceedings against refusals, sanctions and expulsion orders; asylum and international protection files.',
	},
];

const timelines = [
	{ label: 'Initial residency file', value: '3–6 months', note: 'Decided by the provincial immigration office' },
	{ label: 'Renewal of the TIE card', value: '1–3 months', note: 'Filed within 60 days before expiry' },
	{ label: 'Appeal against a refusal', value: '1–3 months', note: 'One month to file the administrative appeal' },
	{ label: 'Nationality by residence', value: '1–3 years', note: 'From filing until the oath at the Civil Registry' },
];

const steps = [
	{
		title: '1. Review of your situation',
		description:
			'We check your immigration history, your family ties, your income and the documents you already have, and choose the route with the best chance of success.',
	},
	{
		title: '2. File preparation',
		description:
			'Sworn translations, apostilles, official forms and evidence of means. The aim is to answer the requirements before the office asks them.',
	},
	{
		title: '3. Filing and follow-up',
		description:
			'We file online or in person, track the file, respond to requirements and attend the interviews with you when your presence is needed.',
	},
	{
		title: '4. Appeals if necessary',
		description:
			'If the file is refused or left without a decision, we prepare the administrative appeal or the court claim within the deadline.',
	},
];
---

<CustomLayout
	title="Immigration & Nationality Lawyers in Spain | Scruz"
	description="English-speaking immigration lawyers: residency, family reunification, EU registration, asylum appeals and Spanish nationality. Offices in Lucena and Málaga."
	keywords="immigration lawyer Spain English, Spanish residency lawyer, nationality Spain lawyer, arraigo lawyer, family reunification Spain, TIE renewal, abogado extranjería inglés"
	ogImage={heroImg.src}
	lang="en"
	alternates={alternates}
	breadcrumb={[
		{ name: 'Home', url: '/' },
		{ name: 'Immigration and nationality (English)', url: '/en/immigration-and-nationality/' },
	]}
	additionalSchemas={[serviceSchema, faqSchema]}
>
	<section class="bg-primary text-primary-content">
		<div class="mx-auto max-w-6xl px-6 py-16 md:px-16 md:py-24">
			<p class="text-warning mb-3 text-sm font-semibold uppercase tracking-wide">
				Immigration · Nationality · Appeals
			</p>
			<h1 class="font-title mb-5 max-w-3xl text-3xl font-bold leading-tight md:text-5xl">
				Immigration and nationality, explained in English.
			</h1>
			<p class="mb-8 max-w-2xl text-lg text-white/90">
				Residency, family reunification, EU registration and Spanish nationality. We prepare the
				file, file it and defend it if it is refused — and we tell you in English what each
				document is for.
			</p>
			<div class="flex flex-col gap-3 sm:flex-row">
				<a class="btn btn-warning btn-lg" href="tel:+34666329155">Call 666 329 155</a>
				<a
					class="btn btn-outline btn-lg !border-white !text-white hover:!bg-white hover:!text-primary"
					href="https://wa.me/34666329155?text=Hello%2C%20I%20need%20advice%20on%20my%20Spanish%20residency%20or%20nationality%20file."
					target="_blank"
					rel="noopener noreferrer">Message on WhatsApp</a
				>
			</div>
		</div>
	</section>

	<section class="bg-white py-12 md:py-20">
		<div class="mx-auto max-w-4xl space-y-5 px-6 text-lg leading-relaxed text-gray-700 md:px-16">
			<p class="eyebrow">How the file works</p>
			<h2 class="font-title text-2xl font-bold text-gray-900 md:text-3xl">
				Spanish immigration law, without the guesswork
			</h2>
			<p>
				Immigration files are decided on documents, not on arguments. A missing apostille, a
				certificate issued too long ago or an income figure below the threshold can sink an
				application that was otherwise solid, and the refusal arrives months later, when the
				residency card is about to expire.
			</p>
			<p>
				We work the file backwards: first we identify the route that fits your situation, then we
				list exactly which documents it needs and in what form, and only then do we file. If a
				requirement arrives, we answer it within the deadline. If the resolution is a refusal, we
				check the appeal deadline the same day it is notified.
			</p>
			<p>
				All filings are made in Spanish, as the administration requires. We keep the explanation
				and the working language in English, and we tell you what you are signing before you sign
				it.
			</p>
			<p>
				Read the
				<a
					class="link link-primary"
					href="/nacionalidad-extranjeria/"
					hreflang="es-ES"
					lang="es">Spanish version of this page</a
				>
				if you prefer to work in Spanish with the office.
			</p>
		</div>
	</section>

	<section class="bg-gray-50 py-12 md:py-20">
		<div class="mx-auto max-w-6xl px-6 md:px-16">
			<p class="eyebrow eyebrow--center mb-3">What we handle</p>
			<h2 class="font-title mb-10 text-center text-2xl font-bold md:text-4xl">
				Immigration services
			</h2>
			<div class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					services.map(({ title, description }) => (
						<div class="card-surface rounded-xl p-6">
							<h3 class="mb-2 text-lg font-bold text-gray-900">{title}</h3>
							<p class="text-gray-600">{description}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-white py-12 md:py-20">
		<div class="mx-auto max-w-6xl px-6 md:px-16">
			<p class="eyebrow eyebrow--center mb-3">What to expect</p>
			<h2 class="font-title mb-4 text-center text-2xl font-bold md:text-4xl">
				Typical processing times
			</h2>
			<p class="mx-auto mb-10 max-w-3xl text-center text-gray-600">
				Indicative ranges. Real times depend on the provincial office, the volume of files it is
				handling and the complexity of your case; we confirm the estimate after reviewing your
				documents.
			</p>
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					timelines.map(({ label, value, note }) => (
						<div class="rounded-xl border border-base-300 p-5 text-center">
							<p class="text-primary font-title text-2xl font-bold">{value}</p>
							<p class="mt-1 font-semibold text-gray-900">{label}</p>
							<p class="mt-2 text-sm text-gray-600">{note}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-gray-50 py-12 md:py-20">
		<div class="mx-auto max-w-4xl px-6 md:px-16">
			<p class="eyebrow eyebrow--center mb-3">Method</p>
			<h2 class="font-title mb-8 text-center text-2xl font-bold md:text-4xl">
				Your file, step by step
			</h2>
			<ol class="space-y-6">
				{
					steps.map(({ title, description }) => (
						<li class="card-surface rounded-xl p-6">
							<h3 class="mb-2 text-lg font-bold text-gray-900">{title}</h3>
							<p class="text-gray-600">{description}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="bg-white py-12 md:py-20">
		<div class="mx-auto max-w-4xl px-6 md:px-16">
			<p class="eyebrow eyebrow--center mb-3">Before you call</p>
			<h2 class="font-title mb-8 text-center text-2xl font-bold md:text-4xl">
				Frequently asked questions
			</h2>
			<div class="space-y-4">
				{
					faqEntries.map((item) => (
						<details class="rounded-xl border border-gray-200 p-5">
							<summary class="cursor-pointer font-bold text-gray-900">{item.question}</summary>
							<p class="mt-3 leading-relaxed text-gray-700">{item.answer}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-primary text-primary-content py-14 md:py-20">
		<div class="mx-auto max-w-4xl px-6 text-center md:px-16">
			<h2 class="font-title mb-4 text-2xl font-bold md:text-4xl">Start with a free consultation</h2>
			<p class="mx-auto mb-8 max-w-2xl text-white/90">
				Bring whatever documents you have, even if the file is incomplete. We will tell you which
				route applies, how long it should take and what it would cost, before you pay anything.
			</p>
			<div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a class="btn btn-warning btn-lg" href="tel:+34666329155">Call 666 329 155</a>
				<a
					class="btn btn-outline btn-lg !border-white !text-white hover:!bg-white hover:!text-primary"
					href="mailto:info@scruzabogados.es?subject=Immigration%20consultation%20(English)"
					>Email us</a
				>
			</div>
			<p class="mt-8 text-sm text-white/70">
				General information, not legal advice. Deadlines depend on the notification date of each
				resolution.
			</p>
		</div>
	</section>
</CustomLayout>
