---
import a1 from '@assets/15.jpg';
import { getImage } from '@astro-components';
import SecondaryHero from '../components/SecondaryHero.astro';
import CustomLayout from '../layouts/CustomLayout.astro';

const optimized = await getImage({ src: a1, width: 700, format: 'webp' });

const DATA = [
	{
		title: 'Honorarios y Costes',
		questions: [
			{
				title: '¿Cuánto cuestan sus servicios?',
				answer:
					'Nuestros honorarios se adaptan a la complejidad del caso y al tipo de procedimiento. Tras una primera valoración, le ofreceremos un presupuesto claro y por escrito, sin compromiso.',
			},
			{
				title: '¿Ofrecen consultas gratuitas?',
				answer:
					'Sí, contamos con una primera consulta orientativa gratuita en la que podrá exponer su situación y recibir una valoración inicial.',
			},
			{
				title: '¿Aceptan pagos fraccionados?',
				answer:
					'Sí. Para facilitar el acceso a la justicia, ofrecemos planes de pago fraccionado y adaptado a las necesidades del cliente.',
			},
			{
				title: '¿Hay costes adicionales además de los honorarios?',
				answer:
					'En algunos casos pueden existir gastos adicionales como tasas judiciales, peritajes o notificaciones. Siempre se informará previamente de cualquier coste extra.',
			},
		],
	},
	{
		title: 'Plazos y Procedimientos',
		questions: [
			{
				title: '¿Cuánto tiempo tarda en resolverse un caso?',
				answer:
					'Depende del tipo de procedimiento y del juzgado correspondiente. Le informaremos de los plazos aproximados desde el inicio y actualizaremos cualquier cambio relevante.',
			},
			{
				title: '¿Con qué frecuencia me informarán del progreso?',
				answer:
					'Mantenemos una comunicación constante. Le informaremos cada vez que haya novedades importantes y podrá contactar con nosotros cuando lo necesite.',
			},
			{
				title: '¿Qué documentación necesito aportar?',
				answer:
					'La documentación varía según el caso (contratos, sentencias, DNI, certificados, etc.). Le indicaremos detalladamente qué documentos necesitamos.',
			},
			{
				title: '¿Puedo cambiar de abogado durante el proceso?',
				answer:
					'Sí. Tiene derecho a cambiar de abogado en cualquier momento. Nosotros le ayudaremos con el trámite si así lo desea.',
			},
		],
	},
	{
		title: 'Servicios Específicos',
		questions: [
			{
				title: '¿Atienden casos de urgencia?',
				answer:
					'Sí. Disponemos de un servicio de atención urgente para situaciones que requieren actuación inmediata.',
			},
			{
				title: '¿Realizan consultas online?',
				answer:
					'Sí, ofrecemos consultas por videollamada, teléfono o correo electrónico para su comodidad.',
			},
			{
				title: '¿Atienden casos fuera de sus oficinas?',
				answer:
					'Nos desplazamos si el caso lo requiere o si el cliente no puede acudir presencialmente. También actuamos en procedimientos de otras provincias.',
			},
			{
				title: '¿Qué idiomas hablan?',
				answer: 'Atendemos en español, inglés y otros idiomas bajo solicitud.',
			},
		],
	},
	{
		title: 'Derecho de Familia',
		questions: [
			{
				title: '¿Cuánto cuesta un divorcio?',
				answer:
					'El precio depende de si es de mutuo acuerdo o contencioso. Ofrecemos presupuestos cerrados y facilidades de pago.',
			},
			{
				title: '¿Cuánto tiempo tarda un divorcio?',
				answer:
					'Un divorcio de mutuo acuerdo puede resolverse en 1 a 3 meses. Si es contencioso, el proceso puede extenderse varios meses o más.',
			},
			{
				title: '¿Cómo se determina la custodia de los hijos?',
				answer:
					'Se valora el interés superior del menor, la situación de cada progenitor, su disponibilidad, entorno familiar y vínculos afectivos.',
			},
			{
				title: '¿Puedo modificar una sentencia de divorcio?',
				answer:
					'Sí. Si han cambiado las circunstancias desde la sentencia, se puede solicitar una modificación de medidas.',
			},
		],
	},
	{
		title: 'Derecho Laboral',
		questions: [
			{
				title: '¿Qué hacer si me despiden injustamente?',
				answer:
					'Debe actuar rápidamente: tiene un plazo de 20 días hábiles para reclamar. Le ayudamos a presentar la papeleta de conciliación y, si es necesario, la demanda judicial.',
			},
			{
				title: '¿Cuánto puedo recibir por despido improcedente?',
				answer:
					'Depende del salario y la antigüedad en la empresa. Calcularemos la indemnización que le corresponde conforme a la ley.',
			},
			{
				title: '¿Puedo reclamar salarios impagados?',
				answer:
					'Sí. Puede reclamar los salarios pendientes hasta un año atrás e incluso solicitar intereses de demora.',
			},
			{
				title: '¿Qué es el mobbing laboral?',
				answer:
					'Es el acoso psicológico en el trabajo mediante conductas reiteradas que afectan a la dignidad o salud del trabajador. Le asesoramos para denunciarlo y proteger sus derechos.',
			},
		],
	},
	{
		title: 'Derecho Civil',
		questions: [
			{
				title: '¿Cómo puedo desahuciar a un inquilino?',
				answer:
					'Se debe presentar una demanda de desahucio por impago o finalización del contrato. Nos encargamos del procedimiento completo, desde el requerimiento al inquilino hasta el juicio.',
			},
			{
				title: '¿Qué hacer en caso de accidente de tráfico?',
				answer:
					'Debe recopilar pruebas, parte amistoso o atestado, informes médicos y contactar con un abogado. Le ayudamos a reclamar indemnizaciones por daños materiales y personales.',
			},
			{
				title: '¿Cómo reclamar una deuda?',
				answer:
					'Podemos enviar un requerimiento previo y, si no se paga, iniciar un procedimiento monitorio o judicial para recuperar su dinero.',
			},
			{
				title: '¿Qué es una herencia a beneficio de inventario?',
				answer:
					'Es una forma de aceptar la herencia en la que el heredero responde de las deudas solo con los bienes heredados, sin comprometer su patrimonio personal.',
			},
		],
	},
];
---

<CustomLayout>
	<div class="min-h-screen bg-white">
		<SecondaryHero
			title="Preguntas Frecuentes"
			description="Resolvemos las dudas más comunes sobre nuestros servicios jurídicos y procedimientos legales"
			background={optimized.src}
		/>
		<section class="py-20">
			<!-- class="mx-auto grid grid-cols-2 px-4 sm:px-6 lg:px-8 gap-y-12 gap-x-4" -->
			<!-- class="mx-auto flex flex-wrap px-4 sm:px-6 lg:px-8 gap-y-12 gap-x-4 justify-center" -->
			<div class="mx-auto flex max-w-4xl flex-col gap-4 px-4 sm:px-6 lg:px-8">
				{
					DATA.map(({ title, questions }) => (
						<div class="overflow-hidden rounded-xl bg-white shadow-lg">
							{/* <div class="bg-white rounded-xl shadow-lg overflow-hidden max-w-xl w-full h-fit"> */}
							<div class="border-b border-blue-100 bg-blue-50 px-6 py-4">
								<div class="flex items-center space-x-3">
									<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-100">
										<i class="ri-money-euro-circle-line text-primary" />
									</div>
									<h2 class="text-xl font-bold text-gray-900">{title}</h2>
								</div>
							</div>
							<div class="divide-y divide-gray-200">
								{questions.map(({ title, answer }) => (
									<details name={title} class="w-full">
										<summary class="accordion-header flex w-full cursor-pointer items-center justify-between p-6 text-left">
											<h3 class="pr-4 text-lg font-semibold text-gray-900">{title}</h3>
											{/* <div class="w-6 h-6 flex items-center justify-center flex-shrink-0">
                        {/* <i class="ri-add-line text-primary text-xl" /> 
                        <i class="ri-subtract-line text-primary text-xl" />
                      </div> */}
										</summary>
										<div class="accordion-content p-6">
											<p class="pr-4 text-gray-700">{answer}</p>
										</div>
									</details>
								))}
							</div>
						</div>
					))
				}
			</div>
		</section>
		<section class="bg-gray-50 py-20">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="rounded-2xl bg-white p-8 shadow-lg md:p-12">
					<div class="mb-8 text-center">
						<h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">
							¿No Encuentras tu Respuesta?
						</h2><p class="text-xl text-gray-600">
							Nuestro equipo está aquí para resolver todas tus dudas legales
						</p>
					</div><div class="grid grid-cols-1 gap-8 md:grid-cols-3">
						<div class="text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
							>
								<i class="ri-phone-line text-primary text-2xl"></i>
							</div><h3 class="mb-2 text-lg font-semibold text-gray-900">Llámanos</h3><p
								class="mb-4 text-gray-600"
							>
								Habla directamente con un abogado
							</p><a
								target="_blank"
								rel="noopener noreferrer"
								href="tel:+34 666 329 155"
								class="text-primary font-semibold">+34 666 329 155</a
							>
						</div><div class="text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
							>
								<i class="ri-whatsapp-line text-primary text-2xl"></i>
							</div><h3 class="mb-2 text-lg font-semibold text-gray-900">Whatsapp</h3><p
								class="mb-4 text-gray-600"
							>
								Consulta inmediata por voz
							</p><a
								target="_blank"
								rel="noopener noreferrer"
								href="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
								class="text-primary cursor-pointer font-semibold hover:text-blue-800"
								>Hablar Ahora</a
							>
						</div><div class="text-center">
							<div
								class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
							>
								<i class="ri-calendar-line text-primary text-2xl"></i>
							</div><h3 class="mb-2 text-lg font-semibold text-gray-900">Consulta Presencial</h3><p
								class="mb-4 text-gray-600"
							>
								Primera consulta gratuita
							</p><a
								class="text-primary cursor-pointer font-semibold hover:text-blue-800"
								href="mailto:info@scruzabogados.es?subject=Asunto%20del%20email&body=Texto%20del%20mensaje"
								data-discover="true">Agendar Cita</a
							>
						</div>
					</div>
				</div>
			</div>
		</section><section class="bg-white py-20">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="mb-16 text-center">
					<h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">
						Consejos Legales Rápidos
					</h2><p class="text-xl text-gray-600">
						Información útil para situaciones legales comunes
					</p>
				</div><div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
					<div class="rounded-xl bg-blue-50 p-6">
						<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100">
							<i class="ri-alarm-warning-line text-primary text-xl"></i>
						</div><h3 class="mb-3 text-lg font-bold text-gray-900">En Caso de Accidente</h3><ul
							class="space-y-1 text-sm text-gray-700"
						>
							<li>• Busca atención médica inmediata</li><li>• Denuncia el hecho a la policía</li><li
							>
								• Toma fotos y recopila pruebas
							</li><li>• No firmes documentos sin asesoramiento</li>
						</ul>
					</div><div class="rounded-xl bg-green-50 p-6">
						<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-green-100">
							<i class="ri-file-text-line text-xl text-green-700"></i>
						</div><h3 class="mb-3 text-lg font-bold text-gray-900">Antes de Firmar Contratos</h3><ul
							class="space-y-1 text-sm text-gray-700"
						>
							<li>• Lee todo el documento completo</li><li>• Entiende todas las cláusulas</li><li>
								• Consulta con un abogado si hay dudas
							</li><li>• Guarda una copia firmada</li>
						</ul>
					</div><div class="rounded-xl bg-yellow-50 p-6">
						<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-yellow-100">
							<i class="ri-time-line text-xl text-yellow-700"></i>
						</div><h3 class="mb-3 text-lg font-bold text-gray-900">Plazos Importantes</h3><ul
							class="space-y-1 text-sm text-gray-700"
						>
							<li>• Despido: 20 días hábiles para demandar</li><li>
								• Accidentes: 1 año para reclamar
							</li><li>• Herencias: 6 meses para aceptar/renunciar</li><li>
								• Deudas: 5 años de prescripción general
							</li>
						</ul>
					</div>
				</div>
			</div>
		</section>
	</div>
</CustomLayout>
