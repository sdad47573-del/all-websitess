---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	ArrowLeftRight,
	Banknote,
	Building2,
	Clock,
	FileCheck,
	FilePenLine,
	Handshake,
	Landmark,
	Scale,
	ShieldCheck,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Qué es una due diligence y por qué es vital?',
		answer:
			'La due diligence legal es la auditoría jurídica que se realiza sobre la empresa objetivo antes de materializar la compra. Incluye revisión de contratos, litigios, deudas, situación fiscal, laboral y mercantil. Es vital porque detecta pasivos ocultos, contingencias y riesgos que pueden retrasar la operación o provocar una rebaja importante del precio.',
	},
	{
		question: '¿Cómo se combinan due diligence legal y fiscal?',
		answer:
			'La due diligence legal revisa contratos, licencias, litigios y situación mercantil; la fiscal examina la tributación de los últimos cuatro ejercicios, IVA, Impuesto de Sociedades y contingencias con Hacienda. En Scruz Abogados trabajamos con un equipo multidisciplinar para que ambas auditorías se complementen y entregues al comprador una visión completa.',
	},
	{
		question: '¿Qué garantías se negocian en un SPA?',
		answer:
			'El Contrato de Compraventa de Acciones (SPA) incluye las manifestaciones y garantías del vendedor (representations & warranties), los ajustes de precio, las cláusulas de indemnidad por incumplimiento, las retenciones en escrow, las cláusulas de no competencia y los pactos de confidencialidad.',
	},
	{
		question: '¿Cuánto dura una operación de M&A?',
		answer:
			'Entre 3 y 6 meses en una operación de tamaño medio: 1 mes para la fase previa y firma del LOI, 1-3 meses para la due diligence completa, 1-2 meses para la negociación del SPA y firma en notario. Las operaciones grandes pueden alargarse hasta un año si hay financiación bancaria o regulación sectorial.',
	},
	{
		question: '¿Cómo se valora una empresa?',
		answer:
			'Existen varios métodos de valoración: múltiplos de mercado (ventas o EBITDA), descuento de flujos de caja futuros, valor patrimonial neto y método de los múltiplos de transacciones comparables. En Scruz Abogados combinamos varios métodos para ofrecer al cliente un rango razonable y defenderlo en la negociación.',
	},
	{
		question: '¿Qué pasa con los empleados al vender la empresa?',
		answer:
			'La legislación española protege a los trabajadores: el comprador se subroga en todos los derechos y obligaciones del vendedor. Es importante revisar las condiciones laborales, convenios aplicables y cualquier compromiso futuro (planes de pensiones, premios de antigüedad) para evitar sorpresas tras el cierre.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: Building2, label: 'Operación', value: 'Due diligence completa' },
	{ Icon: Scale, label: 'Asesoramiento', value: 'Mercantil + fiscal' },
	{ Icon: ShieldCheck, label: 'Confidencialidad', value: 'NDA obligatorio' },
];

const plazos = [
	{
		Icon: Clock,
		title: '3 — 6 meses',
		description: 'Operación de tamaño medio en sus distintas fases (LOI, due diligence, SPA, firma).',
	},
	{
		Icon: FileCheck,
		title: 'NDA + LOI',
		description: 'Acuerdos de confidencialidad y oferta no vinculante: primer hito formal.',
	},
	{
		Icon: Landmark,
		title: 'Cierre notarial',
		description: 'Firma del SPA, pagos y escrituración ante notario e inscripción mercantil.',
	},
];

const conceptos = [
	{
		Icon: FileCheck,
		title: 'Due diligence legal',
		description:
			'Auditoría jurídica completa: contratos, licencias, litigios, deudas, situación mercantil y cualquier contingencia que pueda afectar al precio.',
	},
	{
		Icon: FileCheck,
		title: 'Due diligence fiscal',
		description:
			'Auditoría de la tributación de los últimos cuatro ejercicios en IVA, IS y tributos autonómicos. Detección de pasivos y contingencias con Hacienda.',
	},
	{
		Icon: FilePenLine,
		title: 'Contrato de compraventa (SPA)',
		description:
			'Redacción del Share Purchase Agreement con precio, garantías, ajustes, cláusulas de indemnidad, retenciones en escrow y no competencia.',
	},
	{
		Icon: Banknote,
		title: 'Estructuración fiscal',
		description:
			'Optimización de la operación: tipo de transmisión (acciones vs ramas de actividad), implicaciones en IVA, IS e IRPF para vendedores individuales.',
	},
	{
		Icon: ShieldCheck,
		title: 'Pasivos ocultos',
		description:
			'Investigación profunda de litigios, deudas con bancos, Hacienda, Seguridad Social y proveedores que podrían emerger tras la firma.',
	},
	{
		Icon: ArrowLeftRight,
		title: 'Reestructuración societaria',
		description:
			'Cuando conviene, planteamos fusiones, escisiones o aportaciones de rama de actividad para conseguir una estructura óptima antes de la venta.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Acuerdos previos (NDA y LOI)',
		description:
			'Firmamos el NDA de confidencialidad y, una vez analizada la oportunidad, redactamos la oferta no vinculante (LOI o term sheet) con el rango de precio y las condiciones básicas.',
	},
	{
		number: '02',
		title: 'Due diligence',
		description:
			'Realizamos las auditorías jurídica, fiscal, laboral y financiera. Identificamos contingencias, propuestas de mitigación y bases para la negociación del precio.',
	},
	{
		number: '03',
		title: 'Negociación del SPA',
		description:
			'Redactamos y negociamos el Contrato de Compraventa (SPA): representaciones, warranties, ajustes de precio, cláusulas de indemnidad, retentions y covenants.',
	},
	{
		number: '04',
		title: 'Firma y cierre',
		description:
			'Acompañamos al cliente el día del cierre: firma del SPA y demás documentos en notaría, pagos, depósitos en escrow y trámites registrales (Registro Mercantil y Propiedad).',
	},
];

const why = [
	{
		Icon: Scale,
		title: 'Visión mercantil y fiscal',
		description:
			'Combinamos abogados mercantiles y fiscales para diseñar la operación global, no solo el contrato. La fiscalidad puede suponer un 10-25% de ahorro si se estructura bien.',
	},
	{
		Icon: ShieldCheck,
		title: 'Asesoramiento preventivo',
		description:
			'Antes de presentar la operación, anticipamos problemas: conflictos entre socios, deudas ocultas, pactos de exclusividad. Eso permite negociar con margen y sin sorpresas en el cierre.',
	},
	{
		Icon: Handshake,
		title: 'Negociación estratégica',
		description:
			'Representamos tus intereses en la mesa con un enfoque pragmático: conseguimos el mejor precio y las mejores garantías, sin poner en riesgo la operación.',
	},
];

const rangos = [
	{ title: 'Operación pequeña', value: '1 — 3 meses', note: 'PYME, sin financiación compleja' },
	{ title: 'Operación mediana', value: '3 — 6 meses', note: 'Due diligence estándar' },
	{ title: 'Operación grande', value: '6 — 12 meses', note: 'Financiación bancaria o regulación' },
	{ title: 'Operación internacional', value: '12+ meses', note: 'Multi-jurisdicción' },
];
---

<CustomLayout
	title="Abogado de Compraventa de Empresas en Lucena | Scruz Abogados"
	description="Abogado de compraventa de empresas en Lucena, Córdoba y Málaga: due diligence, negociación y cierre de operaciones. Consulta gratuita: 666 329 155."
	keywords="abogado M&A Lucena, compraventa empresas Córdoba, due diligence Málaga, fusión empresas Andalucía, transmisión acciones, abogado mercantil"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Compraventas de Empresas', url: '/compraventas-empresas/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/compraventas-empresas/#service`,
			serviceType: 'Derecho Mercantil - M&A',
			name: 'Asesoramiento en compra y venta de empresas (M&A)',
			description:
				'Due diligence, negociación, estructuración fiscal y cierre de operaciones mercantiles.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: [
				{ '@type': 'City', name: 'Lucena' },
				{ '@type': 'City', name: 'Córdoba' },
				{ '@type': 'City', name: 'Málaga' },
			],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogado para compraventa de empresas y operaciones M&A en Lucena, Córdoba y Málaga"
		supertitle="Derecho Mercantil · M&A y operaciones societarias"
		description="Asesoramiento integral en compra y venta de empresas: due diligence legal y fiscal, negociación del SPA, estructuración fiscal y cierre notarial seguro."
		stats={heroStats}
	>
		<span slot="title">Abogado de compraventa de empresas en Lucena.</span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Una operación de M&A bien asesorada <span class="text-primary">marca la diferencia</span>.'}
		factboxSupertitle="Plazos clave"
		factboxTitle="Cronología de una operación"
		factboxItems={plazos}
	>
		<p class="mb-4">
			La compra o venta de una empresa es una de las operaciones más críticas para un
			negocio. Un buen asesoramiento, desde la due diligence hasta la firma del
			contrato, marca la diferencia entre una operación rentable y un problema
			gestionado con estrecheces durante años. Ofrecemos un servicio integral que cubre
			todas las fases.
		</p>
		<p class="mb-4">
			Combinamos abogados mercantiles y fiscales para diseñar la estructura óptima de
			la operación: elección entre compra de acciones o de rama de actividad, valoración
			del negocio, redacción y negociación del SPA, gestión de los fondos en escrow y
			tramitación completa del cierre (notaría, Registro Mercantil, Registro de la
			Propiedad y autorización sectorial cuando proceda).
		</p>
		<p>
			Trabajamos con presupuesto cerrado y, sobre todo, con la máxima confidencialidad.
			Firmamos un NDA en la primera reunión y mantenemos el secreto profesional sobre
			todas las operaciones en curso. Garantizamos la seguridad jurídica, la
			transparencia en cada paso y la protección de tu inversión a lo largo de todo el
			proceso.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué cubrimos"
		title="Servicios de M&A"
		description="Acompañamos a compradores y vendedores en todas las fases de la operación: due diligence, redacción del SPA, estructuración fiscal y cierre notarial."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Tiempos habituales"
		title="Plazos de una operación"
		description="Visión rápida del tiempo que toma una operación de M&A en sus distintas fases, según tamaño y complejidad."
		valueFormat="single-currency"
		noteLabel="Plazo indicativo."
		disclaimer="Tiempos aproximados. La duración real depende del tamaño de la operación, la complejidad sectorial, la financiación bancaria y los plazos regulatorios."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="El proceso de M&A, paso a paso"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Visión integral y negociación estratégica."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre compraventa de empresas, due diligence, contratos y plazos."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="¿Tienes una operación a la vista?"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Analizamos tu operación, te informamos del proceso, los plazos y los costes esperables."
		relatedLinks={[
			{ label: 'Empresas', href: '/empresas/' },
			{ label: 'Cobro de deudas', href: '/cobro-deudas-impagos/' },
			{ label: 'Sobre nosotros', href: '/quienes-somos/' },
		]}
	/>
</CustomLayout>
