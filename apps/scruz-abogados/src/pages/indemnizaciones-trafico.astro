---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Award,
	Calculator,
	Clock,
	FileText,
	Gavel,
	Heart,
	Scale,
	ShieldAlert,
	Sparkles,
	Stethoscope,
	Users,
	Wallet,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Cuándo puedo reclamar tras un accidente de tráfico?',
		answer:
			'El plazo general para reclamar la indemnización es de 1 año desde la fecha de estabilización de las lesiones (curación o consolidación de secuelas). Si solo se reclaman daños materiales en el vehículo y otros bienes, el plazo es de 2 años. Es importante iniciar cuanto antes la reclamación para preservar pruebas y evitar que el seguro alegue prescripción.',
	},
	{
		question: '¿Cuánto puedo recibir por mi accidente?',
		answer:
			'La cuantía depende del baremo vigente, del tipo de lesiones, de las secuelas resultantes, de los días de baja y de los daños materiales. Para que te hagas una idea, las indemnizaciones por lesiones temporales oscilan entre 800 € y los 100.000 € en casos graves; las secuelas pueden sumar cantidades similares o superiores, dependiendo del grado. Te hacemos un cálculo personalizado tras revisar tu informe médico.',
	},
	{
		question: '¿Qué hacer justo después del accidente?',
		answer:
			'1) Solicita asistencia sanitaria y guarda todos los informes. 2) Llama a la policía o la Guardia Civil para levantar atestado. 3) Rellena el parte amistoso o, si no es posible, deja constancia de los hechos. 4) Toma fotografías de los daños y de la zona. 5) No firmes acuerdos con la aseguradora sin asesoramiento. 6) Contacta con un abogado especialista en los días siguientes.',
	},
	{
		question: '¿Puedo reclamar al seguro aunque haya sido el culpable?',
		answer:
			'Sí, en muchas situaciones. Aunque seas el conductor responsable, la aseguradora del vehículo contrario o la propia póliza de seguros (cobertura de defensa jurídica, seguro del conductor, etc.) puede cubrir una parte. Además, las pólizas de accidentes incluyen coberturas específicas para lesiones del conductor. Te indicamos qué opciones tienes en tu caso.',
	},
	{
		question: '¿Qué pasa si el conductor contrario no tenía seguro?',
		answer:
			'En España existe el Consorcio de Compensación de Seguros, que abona las indemnizaciones en casos como accidentes causados por vehículos sin seguro, desconocidos, robados o en el extranjero. Te guiamos en la reclamación ante el Consorcio para que no quedes desprotegido.',
	},
	{
		question: '¿Cuánto cuesta reclamar una indemnización de tráfico?',
		answer:
			'Trabajamos con honorarios condicionados a resultado: si no obtenemos indemnización, no pagas. Si ganamos, nuestros honorarios son un porcentaje acordado por escrito sobre la cantidad obtenida. Si tienes seguro de defensa jurídica, asumimos los costes cubiertos por la póliza. Siempre te informamos de las opciones antes de empezar.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};
---

<CustomLayout
	title="Abogado de Accidentes de Tráfico en Lucena | Scruz Abogados"
	description="Abogado de accidentes de tráfico en Lucena, Córdoba y Málaga. Reclamamos tu indemnización por lesiones, secuelas y daños. Consulta gratuita: 666 329 155."
	keywords="indemnización accidente tráfico, abogado Lucena accidentes, reclamación atestado, lesiones tráfico, secuelas baremo, daños materiales vehículo"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Indemnizaciones de Tráfico', url: '/indemnizaciones-trafico/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/indemnizaciones-trafico/#service`,
			serviceType: 'Derecho Civil - Accidentes de tráfico',
			name: 'Reclamación de indemnizaciones por accidentes de tráfico',
			description:
				'Reclamamos la máxima indemnización aplicando el baremo vigente: lesiones temporales, permanentes, secuelas y daños materiales.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqSchema },
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Despacho Scruz Abogados especializado en indemnizaciones por accidentes de tráfico"
		supertitle="Derecho de daños · Indemnización de tráfico"
		description="Aplicamos el baremo de tráfico vigente para que recibas la máxima compensación por lesiones, secuelas y daños materiales. Honorarios solo si ganamos."
		stats={[
			{ Icon: Scale, label: 'Honorarios', value: 'Solo si ganamos' },
			{ Icon: Award, label: 'Experiencia', value: '+20 años' },
			{ Icon: Calculator, label: 'Baremo', value: 'Actualizado 2024' },
		]}
	>
		<span slot="title">Abogado de accidentes de tráfico en Lucena: <span class="text-primary">la indemnización que la ley te debe.</span></span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Reclama la <span class="text-primary">máxima compensación</span> por tu accidente.'}
		factboxSupertitle="Datos clave"
		factboxTitle="¿Por qué actuar ya?"
		factboxItems={[
			{
				Icon: Clock,
				title: '1 año',
				description: 'Plazo general desde la estabilización de las lesiones.',
			},
			{
				Icon: Clock,
				title: '2 años',
				description: 'Para reclamar solo daños materiales del vehículo.',
			},
			{
				Icon: Award,
				title: 'Prueba documental',
				description: 'Informe médico, atestado, fotos y partes son la base del caso.',
			},
		]}
	>
		<p class="mb-4">
			Un accidente de tráfico puede cambiar tu vida en un instante, provocando lesiones,
			secuelas y gastos inesperados que muchas aseguradoras intentan minimizar. No te conformes
			con menos de lo que mereces. Nuestro equipo especializado evalúa todas las consecuencias
			de tu accidente —físicas, emocionales y económicas— para reclamar y negociar la
			indemnización máxima que la ley te otorga.
		</p>
		<p class="mb-4">
			Conocemos al detalle el Baremo de Tráfico (Ley 35/2015 y sus actualizaciones), las tablas
			de valoración y la jurisprudencia aplicable. Eso nos permite defender tu caso frente a
			las aseguradoras con argumentos sólidos, pericias médicas propias y un cálculo
			pormenorizado de cada concepto indemnizable.
		</p>
		<p>
			Y lo más importante: trabajamos con honorarios condicionados al resultado. Si no
			obtenemos indemnización, no pagas. Así, reclamar es siempre una opción, nunca un riesgo.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué reclamamos"
		title="Conceptos indemnizables"
		description="Aplicamos el baremo de tráfico (Ley 35/2015) para reclamar cada concepto que la ley reconoce: días de baja, secuelas, daño moral y gastos materiales."
		items={[
			{
				Icon: Stethoscope,
				title: 'Lesiones temporales',
				description:
					'Días de hospitalización, días impeditivos (con baja o asistencia médica) y días no impeditivos. Aplicamos las tablas actualizadas del baremo.',
			},
			{
				Icon: ShieldAlert,
				title: 'Lesiones permanentes',
				description:
					'Secuelas funcionales y estéticas tras la estabilización clínica. Cada secuela se valora según gravedad, con indemnización independiente.',
			},
			{
				Icon: Heart,
				title: 'Daño moral y patrimonial',
				description:
					'Reclamamos daño moral, lucro cesante (ingresos dejados de percibir), pérdida de oportunidades y gastos de asistencia futura.',
			},
			{
				Icon: Wallet,
				title: 'Daños materiales',
				description:
					'Reparación o valor venal del vehículo, gastos de grúa, alquiler de coche, bienes dañados y cualquier coste económico acreditado.',
			},
			{
				Icon: Users,
				title: 'Accidentes con lesionados',
				description:
					'Cobertura de la póliza del conductor, indemnizaciones del responsable y reclamaciones al Consorcio para vehículos no asegurados.',
			},
			{
				Icon: FileText,
				title: 'Negociación con la aseguradora',
				description:
					'Negociamos directamente con las compañías para cerrar acuerdos ventajosos o, en su defecto, llevamos el caso a juicio.',
			},
		]}
	/>

	<EditorialMeasures
		supertitle="Estimación orientativa"
		title="¿Cuánto podrías recibir?"
		description="Las indemnizaciones varían según la gravedad, los días de baja y las secuelas. Estos rangos ilustrativos proceden de casos reales tramitados por nuestro bufete en Andalucía."
		valueFormat="currency"
		noteLabel="Cifras indicativas según baremo."
		disclaimer="Cifras orientativas. El cálculo exacto requiere revisar tu informe médico, la duración de la baja y los factores de corrección aplicables a tu caso."
		items={[
			{
				title: 'Latigazo cervical y lesiones leves',
				from: 1000,
				to: 6000,
				note: 'Sin secuelas · alta precoz',
			},
			{
				title: 'Fracturas y lesiones moderadas',
				from: 6000,
				to: 25000,
				note: 'Días impeditivos + asistencia',
			},
			{
				title: 'Secuelas graves o lesiones permanentes',
				from: 25000,
				to: 100000,
				note: 'Según baremo + factores de corrección',
			},
		]}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="De la primera asistencia al cobro"
		items={[
			{
				number: '01',
				title: 'Valoración médica y pericial',
				description:
					'Recopilamos todos los informes, analizamos tu evolución clínica y solicitamos una pericia médica independiente para fijar secuelas y estabilización.',
			},
			{
				number: '02',
				title: 'Cálculo de la indemnización',
				description:
					'Aplicamos el baremo vigente y elaboramos un cálculo transparente y detallado de cada partida: días, secuelas, daño moral y gastos.',
			},
			{
				number: '03',
				title: 'Reclamación amistosa',
				description:
					'Presentamos la reclamación formal a la aseguradora con toda la prueba documental y pericial. Negociamos durante el plazo legal.',
			},
			{
				number: '04',
				title: 'Procedimiento judicial',
				description:
					'Si la oferta no es justa, iniciamos la vía judicial para conseguir la indemnización completa, con intereses y costas.',
			},
		]}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Tu mejor defensa frente a la aseguradora."
		items={[
			{
				Icon: Gavel,
				title: 'Baremo actualizado',
				description:
					'Aplicamos las tablas y reformas legales vigentes, incluyendo los incrementos por lesiones graves y los factores de corrección.',
			},
			{
				Icon: Wallet,
				title: 'Honorarios condicionados',
				description:
					'Solo cobramos si ganamos. Si no conseguimos indemnización, no pagas nada. Acordamos el porcentaje por escrito, sin sorpresas.',
			},
			{
				Icon: Sparkles,
				title: 'Asesoramiento integral',
				description:
					'Trabajamos con peritos médicos y colaboradores de confianza para que tu caso esté bien fundamentado desde el principio.',
			},
		]}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre accidentes de tráfico, plazos, baremo y honorarios."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Te informamos de las opciones, los plazos y los honorarios. Si decides no reclamar, no pagas nada."
		relatedLinks={[
			{ label: 'Baremo 2026: guía completa', href: '/blog/baremo-lesiones-2026/' },
			{ label: 'Reclamaciones bancarias', href: '/reclamaciones-bancarias/' },
			{ label: 'Derecho penal', href: '/derecho-penal/' },
		]}
	/>
</CustomLayout>
