---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import Hero from '../components/Hero.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Hero
		heroClasses="min-h-[40vh] md:min-h-[40vh]"
		heroImg={heroImg}
		contentClasses="max-w-[unset]"
		title="Indemnizaciones de Tráfico"
	/>
	<div class="flex flex-col gap-3.5 p-6 text-sm text-[#666666] max-[430px]:break-words md:p-16">
		<h2 class="font-bold">Reclama la máxima compensación por tu accidente.</h2>
		<p>
			Un accidente de tráfico puede cambiar tu vida en un instante, provocando lesiones, secuelas y
			gastos inesperados. No te conformes con menos de lo que mereces. Nuestro equipo especializado
			se encarga de evaluar todas las consecuencias de tu accidente –físicas, emocionales y
			económicas– para reclamar y negociar la indemnización máxima que la ley te otorga. No pagues
			por un error que no cometiste.
		</p>
	</div>
</Layout>
