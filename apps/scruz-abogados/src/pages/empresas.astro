---
import a1 from '@assets/8.jpg';
import { getImage } from '@astro-components';
import SecondaryHero from '../components/SecondaryHero.astro';
import CustomLayout from '../layouts/CustomLayout.astro';

const optimized = await getImage({ src: a1, width: 700, format: 'webp' });
---

<CustomLayout
	title="Servicios Jurídicos para Empresas | Abogados Mercantiles en Lucena y Córdoba"
	description="Asesoramiento jurídico integral para empresas y autónomos en Lucena, Córdoba y Málaga. Derecho mercantil, laboral, compliance y fusiones. Consulta gratuita."
>
	<SecondaryHero
		title="Servicios para Empresas"
		description="Asesoramiento jurídico integral para empresas y autónomos. Tu socio legal de confianza para hacer crecer tu negocio."
		background={optimized.src}
	/>
	<section class="py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">
					Servicios Especializados
				</h2><p class="text-xl text-gray-600">
					Soluciones jurídicas adaptadas a las necesidades de tu empresa
				</p>
			</div><div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
				<div class="rounded-xl bg-white p-8 shadow-lg transition-shadow hover:shadow-xl">
					<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-100">
						<i class="ri-building-line text-primary text-2xl"></i>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Constitución de Sociedades</h3><p
						class="mb-6 text-gray-600"
					>
						Te ayudamos a crear tu empresa con la forma jurídica más adecuada
					</p><ul class="space-y-2">
						<li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>SL y SA
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Sociedades Civiles
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Cooperativas
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Fundaciones
						</li>
					</ul>
				</div><div class="rounded-xl bg-white p-8 shadow-lg transition-shadow hover:shadow-xl">
					<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-100">
						<i class="ri-file-text-line text-primary text-2xl"></i>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Contratos Mercantiles</h3><p
						class="mb-6 text-gray-600"
					>
						Redacción y revisión de todo tipo de contratos comerciales
					</p><ul class="space-y-2">
						<li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Contratos de distribución
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Acuerdos comerciales
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Franquicias
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Joint ventures
						</li>
					</ul>
				</div><div class="rounded-xl bg-white p-8 shadow-lg transition-shadow hover:shadow-xl">
					<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-100">
						<i class="ri-team-line text-primary text-2xl"></i>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Derecho Laboral Empresarial</h3><p
						class="mb-6 text-gray-600"
					>
						Gestión integral de las relaciones laborales en tu empresa
					</p><ul class="space-y-2">
						<li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Despidos
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Convenios colectivos
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Inspecciones
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Prevención de riesgos
						</li>
					</ul>
				</div><div class="rounded-xl bg-white p-8 shadow-lg transition-shadow hover:shadow-xl">
					<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-100">
						<i class="ri-scales-line text-primary text-2xl"></i>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Compliance y Cumplimiento</h3><p
						class="mb-6 text-gray-600"
					>
						Aseguramos que tu empresa cumpla con toda la normativa vigente
					</p><ul class="space-y-2">
						<li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>RGPD
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Blanqueo de capitales
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Compliance penal
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Auditorías legales
						</li>
					</ul>
				</div><div class="rounded-xl bg-white p-8 shadow-lg transition-shadow hover:shadow-xl">
					<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-100">
						<i class="ri-exchange-line text-primary text-2xl"></i>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Fusiones y Adquisiciones</h3><p
						class="mb-6 text-gray-600"
					>
						Asesoramiento en operaciones de M&amp;A y reestructuraciones
					</p><ul class="space-y-2">
						<li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Due diligence
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Valoraciones
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Negociación
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Cierre de operaciones
						</li>
					</ul>
				</div><div class="rounded-xl bg-white p-8 shadow-lg transition-shadow hover:shadow-xl">
					<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-lg bg-blue-100">
						<i class="ri-shield-check-line text-primary text-2xl"></i>
					</div><h3 class="mb-4 text-xl font-bold text-gray-900">Resolución de Conflictos</h3><p
						class="mb-6 text-gray-600"
					>
						Mediación y litigio en disputas comerciales
					</p><ul class="space-y-2">
						<li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Arbitraje
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Mediación
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Litigio mercantil
						</li><li class="flex items-center text-sm text-gray-700">
							<div class="mr-2 flex h-4 w-4 items-center justify-center">
								<i class="ri-check-line text-green-600"></i>
							</div>Reclamaciones
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
	<section class="bg-gray-50 py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">Sectores que Atendemos</h2><p
					class="text-xl text-gray-600"
				>
					Experiencia en múltiples industrias y sectores empresariales
				</p>
			</div><div class="grid grid-cols-2 gap-6 md:grid-cols-4">
				<div
					class="rounded-xl bg-white p-6 text-center shadow-lg transition-shadow hover:shadow-xl"
				>
					<div
						class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100"
					>
						<i class="ri-computer-line text-primary text-xl"></i>
					</div><h3 class="font-semibold text-gray-900">Tecnología</h3>
				</div><div
					class="rounded-xl bg-white p-6 text-center shadow-lg transition-shadow hover:shadow-xl"
				>
					<div
						class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100"
					>
						<i class="ri-store-line text-primary text-xl"></i>
					</div><h3 class="font-semibold text-gray-900">Retail</h3>
				</div><div
					class="rounded-xl bg-white p-6 text-center shadow-lg transition-shadow hover:shadow-xl"
				>
					<div
						class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100"
					>
						<i class="ri-hammer-line text-primary text-xl"></i>
					</div><h3 class="font-semibold text-gray-900">Construcción</h3>
				</div><div
					class="rounded-xl bg-white p-6 text-center shadow-lg transition-shadow hover:shadow-xl"
				>
					<div
						class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100"
					>
						<i class="ri-restaurant-line text-primary text-xl"></i>
					</div><h3 class="font-semibold text-gray-900">Hostelería</h3>
				</div><div
					class="rounded-xl bg-white p-6 text-center shadow-lg transition-shadow hover:shadow-xl"
				>
					<div
						class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100"
					>
						<i class="ri-heart-pulse-line text-primary text-xl"></i>
					</div><h3 class="font-semibold text-gray-900">Salud</h3>
				</div><div
					class="rounded-xl bg-white p-6 text-center shadow-lg transition-shadow hover:shadow-xl"
				>
					<div
						class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100"
					>
						<i class="ri-graduation-cap-line text-primary text-xl"></i>
					</div><h3 class="font-semibold text-gray-900">Educación</h3>
				</div><div
					class="rounded-xl bg-white p-6 text-center shadow-lg transition-shadow hover:shadow-xl"
				>
					<div
						class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100"
					>
						<i class="ri-bank-line text-primary text-xl"></i>
					</div><h3 class="font-semibold text-gray-900">Finanzas</h3>
				</div><div
					class="rounded-xl bg-white p-6 text-center shadow-lg transition-shadow hover:shadow-xl"
				>
					<div
						class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100"
					>
						<i class="ri-truck-line text-primary text-xl"></i>
					</div><h3 class="font-semibold text-gray-900">Logística</h3>
				</div>
			</div>
		</div>
	</section><section class="bg-white py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">
					¿Por Qué Elegirnos para tu Empresa?
				</h2><p class="text-xl text-gray-600">
					Ventajas exclusivas para nuestros clientes empresariales
				</p>
			</div><div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
				<div class="text-center">
					<div
						class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
					>
						<i class="ri-time-line text-primary text-2xl"></i>
					</div><h3 class="mb-3 text-xl font-bold text-gray-900">Respuesta Rápida</h3><p
						class="text-gray-600"
					>
						Entendemos que el tiempo es dinero. Respuesta en menos de 24 horas.
					</p>
				</div><div class="text-center">
					<div
						class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
					>
						<i class="ri-user-settings-line text-primary text-2xl"></i>
					</div><h3 class="mb-3 text-xl font-bold text-gray-900">Asesor Dedicado</h3><p
						class="text-gray-600"
					>
						Un abogado especializado asignado específicamente a tu empresa.
					</p>
				</div><div class="text-center">
					<div
						class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
					>
						<i class="ri-phone-line text-primary text-2xl"></i>
					</div><h3 class="mb-3 text-xl font-bold text-gray-900">Disponibilidad 24/7</h3><p
						class="text-gray-600"
					>
						Línea directa para urgencias y consultas fuera del horario habitual.
					</p>
				</div><div class="text-center">
					<div
						class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100"
					>
						<i class="ri-price-tag-line text-primary text-2xl"></i>
					</div><h3 class="mb-3 text-xl font-bold text-gray-900">Tarifas Transparentes</h3><p
						class="text-gray-600"
					>
						Presupuestos claros sin sorpresas. Tarifas especiales para empresas.
					</p>
				</div>
			</div>
		</div>
	</section>
	<section class="bg-gray-50 py-20">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="">
				<!-- <div class="grid grid-cols-1 gap-12 lg:grid-cols-2"> -->
				<div class="hidden">
					<h2 class="mb-6 text-3xl font-bold text-gray-900">Solicita una Consulta Empresarial</h2><p
						class="mb-8 text-gray-600"
					>
						Cuéntanos sobre tu empresa y te proporcionaremos una propuesta personalizada de
						servicios jurídicos.
					</p><form class="space-y-6" id="consulta">
						<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
							<div>
								<label for="empresa" class="mb-2 block text-sm font-medium text-gray-700"
									>Nombre de la empresa *</label
								><input
									id="empresa"
									required=""
									class="w-full rounded-lg border border-gray-300 px-4 py-3 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
									placeholder="Tu empresa S.L."
									type="text"
									value=""
									name="empresa"
								/>
							</div><div>
								<label for="contacto" class="mb-2 block text-sm font-medium text-gray-700"
									>Persona de contacto *</label
								><input
									id="contacto"
									required=""
									class="w-full rounded-lg border border-gray-300 px-4 py-3 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
									placeholder="Nombre y apellidos"
									type="text"
									value=""
									name="contacto"
								/>
							</div>
						</div><div class="grid grid-cols-1 gap-6 md:grid-cols-2">
							<div>
								<label for="email" class="mb-2 block text-sm font-medium text-gray-700"
									>Email corporativo *</label
								><input
									id="email"
									required=""
									class="w-full rounded-lg border border-gray-300 px-4 py-3 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
									placeholder="contacto@tuempresa.com"
									type="email"
									value=""
									name="email"
								/>
							</div><div>
								<label for="telefono" class="mb-2 block text-sm font-medium text-gray-700"
									>Teléfono *</label
								><input
									id="telefono"
									required=""
									class="w-full rounded-lg border border-gray-300 px-4 py-3 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
									placeholder="+34 900 000 000"
									type="tel"
									value=""
									name="telefono"
								/>
							</div>
						</div><div class="grid grid-cols-1 gap-6 md:grid-cols-2">
							<div>
								<label for="sector" class="mb-2 block text-sm font-medium text-gray-700"
									>Sector de actividad</label
								><div class="relative">
									<select
										id="sector"
										name="sector"
										class="w-full appearance-none rounded-lg border border-gray-300 px-4 py-3 pr-8 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
										><option value="">Seleccionar sector</option><option value="tecnologia"
											>Tecnología</option
										><option value="retail">Retail</option><option value="construccion"
											>Construcción</option
										><option value="hosteleria">Hostelería</option><option value="salud"
											>Salud</option
										><option value="educacion">Educación</option><option value="finanzas"
											>Finanzas</option
										><option value="logistica">Logística</option><option value="otro">Otro</option
										></select
									><div
										class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3"
									>
										<i class="ri-arrow-down-s-line text-gray-400"></i>
									</div>
								</div>
							</div><div>
								<label for="empleados" class="mb-2 block text-sm font-medium text-gray-700"
									>Número de empleados</label
								><div class="relative">
									<select
										id="empleados"
										name="empleados"
										class="w-full appearance-none rounded-lg border border-gray-300 px-4 py-3 pr-8 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
										><option value="">Seleccionar rango</option><option value="1"
											>Solo yo (autónomo)</option
										><option value="2-10">2-10 empleados</option><option value="11-50"
											>11-50 empleados</option
										><option value="51-200">51-200 empleados</option><option value="200+"
											>Más de 200 empleados</option
										></select
									><div
										class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3"
									>
										<i class="ri-arrow-down-s-line text-gray-400"></i>
									</div>
								</div>
							</div>
						</div><div>
							<label for="servicio" class="mb-2 block text-sm font-medium text-gray-700"
								>Servicio de interés</label
							><div class="relative">
								<select
									id="servicio"
									name="servicio"
									class="w-full appearance-none rounded-lg border border-gray-300 px-4 py-3 pr-8 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
									><option value="">Seleccionar servicio</option><option value="constitucion"
										>Constitución de sociedades</option
									><option value="contratos">Contratos mercantiles</option><option value="laboral"
										>Derecho laboral empresarial</option
									><option value="compliance">Compliance y cumplimiento</option><option
										value="fusiones">Fusiones y adquisiciones</option
									><option value="conflictos">Resolución de conflictos</option><option
										value="integral">Asesoramiento integral</option
									></select
								><div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
									<i class="ri-arrow-down-s-line text-gray-400"></i>
								</div>
							</div>
						</div><div>
							<label for="descripcion" class="mb-2 block text-sm font-medium text-gray-700"
								>Descripción de la necesidad *</label
							><textarea
								id="descripcion"
								name="descripcion"
								required=""
								rows="4"
								maxlength="500"
								class="w-full resize-none rounded-lg border border-gray-300 px-4 py-3 text-sm focus:border-transparent focus:ring-2 focus:ring-blue-500"
								placeholder="Describe tu situación empresarial y qué tipo de asesoramiento necesitas..."
							></textarea><p class="mt-1 text-xs text-gray-500">Máximo 500 caracteres (0/500)</p>
