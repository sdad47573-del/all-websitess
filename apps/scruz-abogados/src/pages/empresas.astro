---
import Footer3 from "@components/Footer3.astro";
import Topbar1 from "@components/Topbar1.astro";
import Layout2 from "src/layouts/Layout2.astro";
---

<Layout2>
  <div class="min-h-screen bg-white">
    <Topbar1 />

    <section
      class="relative bg-cover bg-center bg-no-repeat py-24"
      style='background-image: linear-gradient(rgba(74, 109, 158, 0.8), rgba(74, 109, 158, 0.6)), url("/8.jpg");'
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center text-white">
          <h1 class="text-4xl md:text-5xl font-bold mb-6">
            Servicios para Empresas
          </h1><p class="text-xl max-w-3xl mx-auto">
            Asesoramiento jurídico integral para empresas y autónomos. Tu socio
            legal de confianza para hacer crecer tu negocio.
          </p>
        </div>
      </div>
    </section>
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Servicios Especializados
          </h2><p class="text-xl text-gray-600">
            Soluciones jurídicas adaptadas a las necesidades de tu empresa
          </p>
        </div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div
            class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow"
          >
            <div
              class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center mb-6"
            >
              <i class="ri-building-line text-2xl text-primary"></i>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Constitución de Sociedades
            </h3><p class="text-gray-600 mb-6">
              Te ayudamos a crear tu empresa con la forma jurídica más adecuada
            </p><ul class="space-y-2">
              <li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>SL y SA
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Sociedades Civiles
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Cooperativas
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Fundaciones
              </li>
            </ul>
          </div><div
            class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow"
          >
            <div
              class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center mb-6"
            >
              <i class="ri-file-text-line text-2xl text-primary"></i>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Contratos Mercantiles
            </h3><p class="text-gray-600 mb-6">
              Redacción y revisión de todo tipo de contratos comerciales
            </p><ul class="space-y-2">
              <li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Contratos de distribución
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Acuerdos comerciales
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Franquicias
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Joint ventures
              </li>
            </ul>
          </div><div
            class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow"
          >
            <div
              class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center mb-6"
            >
              <i class="ri-team-line text-2xl text-primary"></i>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Derecho Laboral Empresarial
            </h3><p class="text-gray-600 mb-6">
              Gestión integral de las relaciones laborales en tu empresa
            </p><ul class="space-y-2">
              <li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Despidos
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Convenios colectivos
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Inspecciones
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Prevención de riesgos
              </li>
            </ul>
          </div><div
            class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow"
          >
            <div
              class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center mb-6"
            >
              <i class="ri-scales-line text-2xl text-primary"></i>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Compliance y Cumplimiento
            </h3><p class="text-gray-600 mb-6">
              Aseguramos que tu empresa cumpla con toda la normativa vigente
            </p><ul class="space-y-2">
              <li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>RGPD
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Blanqueo de capitales
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Compliance penal
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Auditorías legales
              </li>
            </ul>
          </div><div
            class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow"
          >
            <div
              class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center mb-6"
            >
              <i class="ri-exchange-line text-2xl text-primary"></i>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Fusiones y Adquisiciones
            </h3><p class="text-gray-600 mb-6">
              Asesoramiento en operaciones de M&amp;A y reestructuraciones
            </p><ul class="space-y-2">
              <li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Due diligence
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Valoraciones
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Negociación
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Cierre de operaciones
              </li>
            </ul>
          </div><div
            class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl transition-shadow"
          >
            <div
              class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center mb-6"
            >
              <i class="ri-shield-check-line text-2xl text-primary"></i>
            </div><h3 class="text-xl font-bold text-gray-900 mb-4">
              Resolución de Conflictos
            </h3><p class="text-gray-600 mb-6">
              Mediación y litigio en disputas comerciales
            </p><ul class="space-y-2">
              <li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Arbitraje
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Mediación
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Litigio mercantil
              </li><li class="flex items-center text-sm text-gray-700">
                <div class="w-4 h-4 flex items-center justify-center mr-2">
                  <i class="ri-check-line text-green-600"></i>
                </div>Reclamaciones
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Sectores que Atendemos
          </h2><p class="text-xl text-gray-600">
            Experiencia en múltiples industrias y sectores empresariales
          </p>
        </div><div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <div
            class="bg-white rounded-xl shadow-lg p-6 text-center hover:shadow-xl transition-shadow"
          >
            <div
              class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4"
            >
              <i class="ri-computer-line text-xl text-primary"></i>
            </div><h3 class="font-semibold text-gray-900">Tecnología</h3>
          </div><div
            class="bg-white rounded-xl shadow-lg p-6 text-center hover:shadow-xl transition-shadow"
          >
            <div
              class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4"
            >
              <i class="ri-store-line text-xl text-primary"></i>
            </div><h3 class="font-semibold text-gray-900">Retail</h3>
          </div><div
            class="bg-white rounded-xl shadow-lg p-6 text-center hover:shadow-xl transition-shadow"
          >
            <div
              class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4"
            >
              <i class="ri-hammer-line text-xl text-primary"></i>
            </div><h3 class="font-semibold text-gray-900">Construcción</h3>
          </div><div
            class="bg-white rounded-xl shadow-lg p-6 text-center hover:shadow-xl transition-shadow"
          >
            <div
              class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4"
            >
              <i class="ri-restaurant-line text-xl text-primary"></i>
            </div><h3 class="font-semibold text-gray-900">Hostelería</h3>
          </div><div
            class="bg-white rounded-xl shadow-lg p-6 text-center hover:shadow-xl transition-shadow"
          >
            <div
              class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4"
            >
              <i class="ri-heart-pulse-line text-xl text-primary"></i>
            </div><h3 class="font-semibold text-gray-900">Salud</h3>
          </div><div
            class="bg-white rounded-xl shadow-lg p-6 text-center hover:shadow-xl transition-shadow"
          >
            <div
              class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4"
            >
              <i class="ri-graduation-cap-line text-xl text-primary"></i>
            </div><h3 class="font-semibold text-gray-900">Educación</h3>
          </div><div
            class="bg-white rounded-xl shadow-lg p-6 text-center hover:shadow-xl transition-shadow"
          >
            <div
              class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4"
            >
              <i class="ri-bank-line text-xl text-primary"></i>
            </div><h3 class="font-semibold text-gray-900">Finanzas</h3>
          </div><div
            class="bg-white rounded-xl shadow-lg p-6 text-center hover:shadow-xl transition-shadow"
          >
            <div
              class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4"
            >
              <i class="ri-truck-line text-xl text-primary"></i>
            </div><h3 class="font-semibold text-gray-900">Logística</h3>
          </div>
        </div>
      </div>
    </section><section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            ¿Por Qué Elegirnos para tu Empresa?
          </h2><p class="text-xl text-gray-600">
            Ventajas exclusivas para nuestros clientes empresariales
          </p>
        </div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="text-center">
            <div
              class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <i class="ri-time-line text-2xl text-primary"></i>
            </div><h3 class="text-xl font-bold text-gray-900 mb-3">
              Respuesta Rápida
            </h3><p class="text-gray-600">
              Entendemos que el tiempo es dinero. Respuesta en menos de 24
              horas.
            </p>
          </div><div class="text-center">
            <div
              class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <i class="ri-user-settings-line text-2xl text-primary"></i>
            </div><h3 class="text-xl font-bold text-gray-900 mb-3">
              Asesor Dedicado
            </h3><p class="text-gray-600">
              Un abogado especializado asignado específicamente a tu empresa.
            </p>
          </div><div class="text-center">
            <div
              class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <i class="ri-phone-line text-2xl text-primary"></i>
            </div><h3 class="text-xl font-bold text-gray-900 mb-3">
              Disponibilidad 24/7
            </h3><p class="text-gray-600">
              Línea directa para urgencias y consultas fuera del horario
              habitual.
            </p>
          </div><div class="text-center">
            <div
              class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <i class="ri-price-tag-line text-2xl text-primary"></i>
            </div><h3 class="text-xl font-bold text-gray-900 mb-3">
              Tarifas Transparentes
            </h3><p class="text-gray-600">
              Presupuestos claros sin sorpresas. Tarifas especiales para
              empresas.
            </p>
          </div>
        </div>
      </div>
    </section><section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <div>
            <h2 class="text-3xl font-bold text-gray-900 mb-6">
              Solicita una Consulta Empresarial
            </h2><p class="text-gray-600 mb-8">
              Cuéntanos sobre tu empresa y te proporcionaremos una propuesta
              personalizada de servicios jurídicos.
            </p><form class="space-y-6" id="consulta">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label
                    for="empresa"
                    class="block text-sm font-medium text-gray-700 mb-2"
                    >Nombre de la empresa *</label
                  ><input
                    id="empresa"
                    required=""
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
                    placeholder="Tu empresa S.L."
                    type="text"
                    value=""
                    name="empresa"
                  />
                </div><div>
                  <label
                    for="contacto"
                    class="block text-sm font-medium text-gray-700 mb-2"
                    >Persona de contacto *</label
                  ><input
                    id="contacto"
                    required=""
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
                    placeholder="Nombre y apellidos"
                    type="text"
                    value=""
                    name="contacto"
                  />
                </div>
              </div><div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label
                    for="email"
                    class="block text-sm font-medium text-gray-700 mb-2"
                    >Email corporativo *</label
                  ><input
                    id="email"
                    required=""
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
                    placeholder="contacto@tuempresa.com"
                    type="email"
                    value=""
                    name="email"
                  />
                </div><div>
                  <label
                    for="telefono"
                    class="block text-sm font-medium text-gray-700 mb-2"
                    >Teléfono *</label
                  ><input
                    id="telefono"
                    required=""
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
                    placeholder="+34 900 000 000"
                    type="tel"
                    value=""
                    name="telefono"
                  />
                </div>
              </div><div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label
                    for="sector"
                    class="block text-sm font-medium text-gray-700 mb-2"
                    >Sector de actividad</label
                  ><div class="relative">
                    <select
                      id="sector"
                      name="sector"
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm pr-8 appearance-none"
                      ><option value="">Seleccionar sector</option><option
                        value="tecnologia">Tecnología</option
                      ><option value="retail">Retail</option><option
                        value="construccion">Construcción</option
                      ><option value="hosteleria">Hostelería</option><option
                        value="salud">Salud</option
                      ><option value="educacion">Educación</option><option
                        value="finanzas">Finanzas</option
                      ><option value="logistica">Logística</option><option
                        value="otro">Otro</option
                      ></select
                    ><div
                      class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none"
                    >
                      <i class="ri-arrow-down-s-line text-gray-400"></i>
                    </div>
                  </div>
                </div><div>
                  <label
                    for="empleados"
                    class="block text-sm font-medium text-gray-700 mb-2"
                    >Número de empleados</label
                  ><div class="relative">
                    <select
                      id="empleados"
                      name="empleados"
                      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm pr-8 appearance-none"
                      ><option value="">Seleccionar rango</option><option
                        value="1">Solo yo (autónomo)</option
                      ><option value="2-10">2-10 empleados</option><option
                        value="11-50">11-50 empleados</option
                      ><option value="51-200">51-200 empleados</option><option
                        value="200+">Más de 200 empleados</option
                      ></select
                    ><div
                      class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none"
                    >
                      <i class="ri-arrow-down-s-line text-gray-400"></i>
                    </div>
                  </div>
                </div>
              </div><div>
                <label
                  for="servicio"
                  class="block text-sm font-medium text-gray-700 mb-2"
                  >Servicio de interés</label
                ><div class="relative">
                  <select
                    id="servicio"
                    name="servicio"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm pr-8 appearance-none"
                    ><option value="">Seleccionar servicio</option><option
                      value="constitucion">Constitución de sociedades</option
                    ><option value="contratos">Contratos mercantiles</option
                    ><option value="laboral">Derecho laboral empresarial</option
                    ><option value="compliance"
                      >Compliance y cumplimiento</option
                    ><option value="fusiones">Fusiones y adquisiciones</option
                    ><option value="conflictos">Resolución de conflictos</option
                    ><option value="integral">Asesoramiento integral</option
                    ></select
                  ><div
                    class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none"
                  >
                    <i class="ri-arrow-down-s-line text-gray-400"></i>
                  </div>
                </div>
              </div><div>
                <label
                  for="descripcion"
                  class="block text-sm font-medium text-gray-700 mb-2"
                  >Descripción de la necesidad *</label
                ><textarea
                  id="descripcion"
                  name="descripcion"
                  required=""
                  rows="4"
                  maxlength="500"
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm resize-none"
                  placeholder="Describe tu situación empresarial y qué tipo de asesoramiento necesitas..."
                ></textarea><p class="text-xs text-gray-500 mt-1">
                  Máximo 500 caracteres (0/500)
                </p>
              </div><button
                type="submit"
                class="w-full bg-primary text-white py-4 px-6 rounded-lg font-semibold hover:bg-blue-800 transition-colors disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap"
                >Solicitar Consulta Empresarial</button
              >
            </form>
          </div><div>
            <div class="bg-white rounded-xl shadow-lg p-8">
              <h3 class="text-2xl font-bold text-gray-900 mb-6">
                ¿Por Qué Necesitas un Abogado para tu Empresa?
              </h3><div class="space-y-6">
                <div class="flex items-start space-x-4">
                  <div
                    class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-1"
                  >
                    <i class="ri-shield-check-line text-primary"></i>
                  </div><div>
                    <h4 class="font-semibold text-gray-900 mb-2">
                      Prevención de Problemas
                    </h4><p class="text-gray-600">
                      Evita costosos litigios y sanciones con asesoramiento
