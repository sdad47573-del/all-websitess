---
import CustomLayout from '../../layouts/CustomLayout.astro';
import { ArrowRight, Clock, FileText, MapPin } from '@lucide/astro';
import { SITE_URL } from '../../data/site';
import { BLOG_POSTS } from '../../data/BLOG_POSTS';
import { BLOG_CATEGORY_HUBS } from '../../data/BLOG_CATEGORIES';

const posts = BLOG_POSTS;

// Schema Blog + blogPost (ItemList) — estructura el índice del blog para que
// Google entienda que estas 38 URLs son artículos del mismo blog.
const blogSchema = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	'@id': `${SITE_URL}/blog/#blog`,
	name: 'Blog jurídico de Scruz Abogados',
	description:
		'Guías y artículos jurídicos redactados por el despacho Scruz Abogados para Lucena, Córdoba, Málaga y toda Andalucía.',
	url: `${SITE_URL}/blog/`,
	publisher: { '@id': `${SITE_URL}#organization` },
	blogPost: posts.map((post) => ({
		'@type': 'BlogPosting',
		'@id': `${SITE_URL}${post.href}#article`,
		headline: post.title,
		description: post.description,
		url: `${SITE_URL}${post.href}`,
		datePublished: post.date,
		inLanguage: 'es-ES',
		isPartOf: { '@id': `${SITE_URL}/blog/#blog` },
	})),
};

// FAQPage — respuestas a dudas generales que también aparecen como texto
// visible en la página. Google puede mostrarlas como resultados enriquecidos.
const BLOG_FAQ = [
	{
		question: '¿Qué guías legales encuentro en este blog?',
		answer:
			'Guías prácticas sobre divorcio y familia, herencias, accidentes de tráfico, laboral, extranjería, consumo y reclamaciones bancarias, explicadas para vecinos de Lucena, Córdoba y Málaga.',
	},
	{
		question: '¿El contenido del blog sustituye a la consulta con un abogado?',
		answer:
			'No. Los artículos son orientativos y explican el procedimiento general. Cada caso tiene matices que solo la revisión personalizada de un abogado puede valorar; la primera consulta del despacho es gratuita.',
	},
	{
		question: '¿Con qué frecuencia se publican artículos nuevos?',
		answer:
			'El blog se actualiza con cambios normativos relevantes (laborales, de Seguridad Social, de consumo) y con guías nuevas sobre los trámites jurídicos más demandados en el despacho.',
	},
	{
		question: '¿Puedo sugerir un tema para una nueva guía?',
		answer:
			'Sí. Puedes proponer temas llamando al despacho o escribiéndonos: priorizamos las dudas que más se repiten en las consultas de Lucena, Córdoba y Málaga.',
	},
	{
		question: '¿Las guías están actualizadas a la normativa vigente?',
		answer:
			'Cada guía indica su fecha de publicación y revisamos las más consultadas cuando cambia la normativa que afecta a su contenido, incluyendo reformas con entrada en vigor futura.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${SITE_URL}/blog/#faq`,
	url: `${SITE_URL}/blog/`,
	name: 'Preguntas frecuentes sobre el blog jurídico',
	mainEntity: BLOG_FAQ.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

<CustomLayout
	title="Blog Jurídico | Guías legales en Lucena, Córdoba y Málaga"
	description="Guías y artículos jurídicos del despacho Scruz Abogados: divorcios, herencias, accidentes y más, para Lucena, Córdoba y Málaga."
	keywords="blog abogados Lucena, guías legales Córdoba, divorcio mutuo acuerdo, herencia sin testamento, indemnización accidente tráfico, Scruz Abogados"
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Blog', url: '/blog/' },
	]}
	additionalSchemas={[blogSchema, faqSchema]}
>
	<section class="bg-gray-50 py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-6 md:px-16">
			<div class="reveal-pop mb-12 max-w-3xl">
				<p class="eyebrow">Blog jurídico</p>
				<h1 class="mb-4 text-4xl font-bold text-gray-900 md:text-5xl">
					Guías legales escritas para que entiendas tu caso
				</h1>
				<p class="text-xl text-gray-600">
					Explicamos con claridad los procedimientos legales más habituales en Lucena, Córdoba
					y Málaga: qué dice la ley, qué necesitas y cuánto puede tardar. Contenido orientativo:
					cada caso concreto requiere asesoramiento personalizado.
				</p>
			</div>

			<!--
				Acceso por área antes del listado completo: cada chip es un hub
				(/blog/categoria/<slug>/) que agrupa sus guías y reparte autoridad dentro
				del blog. Las categorías con 1-2 artículos no tienen hub, así que no
				aparecen aquí (seguirían siendo páginas de contenido pobre).
			-->
			<div class="reveal-pop mb-12">
				<h2 class="mb-4 text-xl font-bold text-gray-900">Explora las guías por área</h2>
				<div class="flex flex-wrap gap-3">
					{
						BLOG_CATEGORY_HUBS.map((hub) => (
							<a
								href={hub.href}
								class="text-primary inline-flex items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold transition-colors hover:bg-blue-100"
								data-discover="true"
							>
								<FileText class="size-4" /> {hub.name}
								<span class="text-gray-500">{hub.posts.length}</span>
							</a>
						))
					}
				</div>
			</div>

			<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
				{
					posts.map((post) => (
						<a
							href={post.href}
							class="card-surface reveal-pop hover:-translate-y-1 flex flex-col rounded-xl p-8"
							data-discover="true"
						>
							<div class="mb-6 flex items-center justify-between">
								<span class="text-primary inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1 text-sm font-semibold">
									<FileText class="size-4" /> {post.category}
								</span>
							</div>
							<h2 class="mb-3 flex-1 text-xl font-bold text-gray-900">{post.title}</h2>
							<p class="mb-6 text-gray-600">{post.description}</p>
							<div class="mt-auto flex items-center justify-between border-t border-gray-100 pt-4 text-sm text-gray-500">
								<span class="inline-flex items-center gap-1"><Clock class="size-4" /> {post.readTime} lectura</span>
								<span class="inline-flex items-center gap-1">
									Leer guía <ArrowRight class="size-4" />
								</span>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-white py-16 md:py-20">
		<div class="mx-auto max-w-3xl px-6">
			<h2 class="font-title mb-8 text-center text-3xl font-bold md:text-4xl">Preguntas frecuentes sobre el blog</h2>
			<div class="space-y-5" data-reveal-stagger>					{BLOG_FAQ.map((item) => (
						<div class="reveal-pop">
							<h3 class="mb-1 font-bold text-gray-900">{item.question}</h3>
						<p class="text-gray-600">{item.answer}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="bg-gray-50 py-16 md:py-20">			<div class="reveal mx-auto max-w-7xl px-6 text-center md:px-16">
			<p class="eyebrow eyebrow--center mb-3">Estamos a tu lado</p>
			<h2 class="mb-4 font-title text-3xl font-bold md:text-4xl lg:text-5xl">¿Prefieres hablar directamente con un abogado?</h2>
			<p class="mx-auto mb-8 max-w-3xl text-xl text-gray-600">
				Resolvemos tu caso concreto en una primera consulta gratuita y confidencial, en Lucena,
				Málaga u online.
			</p>
			<div class="flex flex-col justify-center gap-4 sm:flex-row">
				<a
					class="btn btn-primary btn-lg"
					href="/servicios/"
					data-discover="true">Ver nuestros servicios</a
				>
				<a
					class="btn btn-outline btn-lg"
					href="tel:+34666329155"
					data-discover="true">Llamar: +34 666 329 155</a
				>
			</div>
			<p class="mt-8 inline-flex items-center gap-2 text-sm text-gray-500">
				<MapPin class="size-4" /> Despachos en Lucena (Córdoba) y Málaga (Teatinos)
			</p>
		</div>
	</section>
	<aside class="mx-auto mb-12 max-w-5xl border-l-4 border-amber-500 bg-slate-50 p-6">
		<h2 class="text-xl font-bold">¿Cuánto cuesta contratar un abogado?</h2>
		<p class="mt-2 text-slate-600">Guía práctica sobre honorarios, presupuestos y qué preguntar antes de contratar.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/blog/cuanto-cuesta-contratar-abogado-cordoba/">Leer la guía</a>
	</aside>
	<aside class="mx-auto mb-12 max-w-5xl border-l-4 border-amber-500 bg-slate-50 p-6">
		<h2 class="text-xl font-bold">Requisitos de la jubilación anticipada en 2026</h2>
		<p class="mt-2 text-slate-600">Qué debes revisar antes de solicitar una jubilación anticipada.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/blog/requisitos-jubilacion-anticipada-2026/">Leer la guía</a>
	</aside>
	<aside class="mx-auto mb-12 max-w-5xl border-l-4 border-amber-500 bg-slate-50 p-6">
		<h2 class="text-xl font-bold">Jubilación anticipada o parcial: principales diferencias</h2>
		<p class="mt-2 text-slate-600">Qué cambia en cada modalidad y qué datos debes revisar.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/blog/jubilacion-anticipada-o-parcial-diferencias/">Leer la guía</a>
	</aside>
	<aside class="mx-auto mb-12 max-w-5xl border-l-4 border-amber-500 bg-slate-50 p-6">
		<h2 class="text-xl font-bold">Buro de Créditos y EBR: qué es y cómo comprobar tus datos</h2>
		<p class="mt-2 text-slate-600">Qué revisar si detectas una deuda, un importe o una anotación incorrecta.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/blog/buro-de-creditos-ebr-que-es/">Leer la guía</a>
	</aside>
	<aside class="mx-auto mb-12 max-w-5xl border-l-4 border-amber-500 bg-slate-50 p-6">
		<h2 class="text-xl font-bold">Licencias de actividad para empresas</h2>
		<p class="mt-2 text-slate-600">Qué debes revisar antes de presentar la solicitud.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/blog/licencias-actividad-empresas/">Leer la guía</a>
	</aside>
	<aside class="mx-auto mb-12 max-w-5xl border-l-4 border-amber-500 bg-slate-50 p-6">
		<h2 class="text-xl font-bold">Cómo reclamar comisiones laborales</h2>
		<p class="mt-2 text-slate-600">Documentos y pasos para revisar una reclamación.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/blog/como-reclamar-comisiones-laborales/">Leer la guía</a>
	</aside>
	<aside class="mx-auto mb-12 max-w-5xl border-l-4 border-amber-500 bg-slate-50 p-6">
		<h2 class="text-xl font-bold">Reconocimiento de paternidad: cómo se hace</h2>
		<p class="mt-2 text-slate-600">Qué revisar antes de elegir la vía voluntaria o judicial.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/blog/reconocimiento-paternidad-proceso/">Leer la guía</a>
	</aside>
	<aside class="mx-auto mb-12 max-w-5xl border-l-4 border-amber-500 bg-slate-50 p-6">
		<h2 class="text-xl font-bold">Cómo reclamar una pensión de jubilación</h2>
		<p class="mt-2 text-slate-600">Documentación y pasos para organizar una reclamación.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/blog/reclamar-pension-jubilacion/">Leer la guía</a>
	</aside>
	<aside class="mx-auto mb-12 max-w-5xl border-l-4 border-amber-500 bg-slate-50 p-6">
		<h2 class="text-xl font-bold">Cómo reclamar el incumplimiento de un contrato</h2>
		<p class="mt-2 text-slate-600">Pasos y pruebas para preparar una reclamación.</p>
		<a class="mt-3 inline-block font-semibold text-blue-800 underline" href="/blog/como-reclamar-incumplimiento-contrato/">Leer la guía</a>
	</aside>
</CustomLayout>
