---
import type { GetStaticPaths } from 'astro';
import CustomLayout from '../../layouts/CustomLayout.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import ArticleCtaBand from '../../components/ArticleCtaBand.astro';
import { SEO_ARTICLES, type SeoArticle } from '../../data/SEO_ARTICLES';
import { SITE_URL } from '../../data/site';
import defaultImage from '../../@assets/OG-DEFAULT-1200x630.webp';

export const getStaticPaths = (() =>
	SEO_ARTICLES.map((article) => ({
		params: { slug: article.slug },
		props: { article },
	}))) satisfies GetStaticPaths;

interface Props {
	article: SeoArticle;
}

const { article } = Astro.props;
const published = article.date;
const canonical = `${SITE_URL}/blog/${article.slug}/`;
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	'@id': `${canonical}#article`,
	headline: article.title,
	description: article.description,
	datePublished: published,
	dateModified: published,
	inLanguage: 'es-ES',
	author: { '@id': `${SITE_URL}/#sergio-cruz-chacon` },
	// El contenido jurídico lo revisa el letrado titular: `reviewedBy` refuerza
	// la señal de experiencia (E-E-A-T) además del autor visible del artículo.
	reviewedBy: { '@id': `${SITE_URL}/#sergio-cruz-chacon` },
	publisher: { '@id': `${SITE_URL}/#organization` },
	mainEntityOfPage: canonical,
	image: defaultImage.src,
};
---

<CustomLayout
	title={article.title}
	description={article.description}
	keywords={`${article.title}, abogado ${article.category}, Scruz Abogados`}
	image={defaultImage.src}
	ogType="article"
	articlePublishedTime={published}
	articleModifiedTime={published}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Blog', url: '/blog/' },
		{ name: article.title, url: `/blog/${article.slug}/` },
	]}
	additionalSchemas={[articleSchema]}
>
	<article class="bg-white py-16 md:py-24">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<header class="mx-auto mb-12 max-w-4xl text-center">
				<p class="text-primary mb-3 text-sm font-semibold uppercase tracking-wide">
					{article.category} · Guía práctica
				</p>
				<h1 class="mb-5 text-3xl font-bold text-gray-900 md:text-5xl">{article.title}</h1>
				<p class="mx-auto max-w-3xl text-xl leading-relaxed text-gray-600">{article.intro}</p>
				<p class="mt-5 text-sm text-gray-500">
					Publicado el {new Date(`${article.date}T00:00:00Z`).toLocaleDateString('es-ES', {
						day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
					})} · Lectura: {article.readTime}
				</p>
			</header>

			<ArticleCtaBand />

			<div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem]">
				<div class="reveal article-content min-w-0 space-y-6 text-lg leading-relaxed text-gray-700">
					{
						article.sections.map((section, index) => (
							<section id={`seccion-${index + 1}`}>
								<h2 class="pt-4 text-2xl font-bold text-gray-900">
									{index + 1}. {section.heading}
								</h2>
								{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
							</section>
						))
					}

					<div class="reveal-pop my-10 rounded-2xl bg-gray-50 p-6 md:p-8">
						<h2 class="mb-4 text-2xl font-bold text-gray-900">Checklist antes de actuar</h2>
						<ul class="list-disc space-y-2 pl-6">
							{article.checklist.map((item) => <li>{item}</li>)}
						</ul>
					</div>

					<section id="preguntas-frecuentes">
						<h2 class="pt-4 text-2xl font-bold text-gray-900">Preguntas frecuentes</h2>
						<div class="mt-4 space-y-4">
							{
								article.faq.map((item) => (
									<details class="rounded-xl border border-gray-200 p-5">
										<summary class="cursor-pointer font-bold text-gray-900">{item.question}</summary>
										<p class="mt-3 leading-relaxed">{item.answer}</p>
									</details>
								))
							}
						</div>
					</section>

					<RelatedServices />

					<div class="reveal-pop rounded-2xl bg-primary p-8 text-primary-content">
						<h2 class="mb-2 text-2xl font-bold">¿Tienes una duda sobre tu caso?</h2>
						<p class="mb-6">
							Esta guía es orientativa. Revisa tu documentación con un abogado antes de presentar una reclamación o tomar una decisión con plazos en marcha. Primera consulta gratuita.
						</p>
						<a class="btn btn-secondary" href="/#contacto" data-discover="true">Solicitar una consulta</a>
					</div>
				</div>

				<aside class="hidden lg:block">
					<div class="sticky top-8 rounded-2xl border border-base-300 bg-base-200 p-6">
						<h2 class="font-title mb-4 text-lg font-bold">En esta guía</h2>
						<nav aria-label="Índice de la guía">
							<ol class="space-y-2 text-sm text-gray-600">
								{article.sections.map((section, index) => (
									<li><a class="hover:text-primary" href={`#seccion-${index + 1}`}>{index + 1}. {section.heading}</a></li>
								))}
								<li><a class="hover:text-primary" href="#preguntas-frecuentes">Preguntas frecuentes</a></li>
							</ol>
						</nav>
					</div>
				</aside>
			</div>
		</div>
	</article>
</CustomLayout>

<style is:global>
	.article-content h2 { color: var(--color-base-content); }
	.article-content summary { list-style: revert; }
	.article-content summary::marker { color: var(--scruz-primary-ink); }
	.article-content a { color: var(--scruz-primary-ink); text-decoration: underline; text-underline-offset: 3px; }
	.article-content .btn { text-decoration: none; }
</style>
