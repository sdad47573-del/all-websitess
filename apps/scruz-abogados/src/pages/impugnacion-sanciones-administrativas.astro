---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Recursos administrativos', href: '/recursos-administrativos' },
	{ label: 'Impugnación de sanciones administrativas', href: '/impugnacion-sanciones-administrativas' },
];

const highlights = [
	'Revisión de la resolución y del procedimiento sancionador',
	'Análisis de la prueba, notificación y defensa jurídica',
	'Estrategia para recurrir y solicitar medidas provisionales cuando procedan',
];

const sections = [
	{
		title: 'Recursos contra sanciones administrativas',
		content: 'Una sanción administrativa puede impugnarse si existe un error en los hechos, en la prueba, en el procedimiento, en la competencia o en la cuantificación. No todas las sanciones siguen el mismo régimen. La primera valoración debe identificar la administración, el órgano y la resolución concreta.',
		points: [
			'Sanciones en materias de actividad, urbanismo, medio ambiente o seguridad.',
			'Multas, expedientes de contratación o responsabilidad profesional.',
			'Errores de notificación, prescripción o caducidad.',
			'Recursos de reposición, reconsideración o vía contencioso-administrativa.',
		],
	},
	{
		title: 'Qué debe incluir la defensa',
		content: 'Una defensa eficaz expone los hechos de forma ordenada, discute las pruebas que no acreditan la infracción, señala defectos formales y solicita una conclusión concreta. También conviene distinguir los hechos aceptados de los que se discuten para que la argumentación sea clara y verificable.',
		points: [
			'Copia de la resolución y justificantes de notificación.',
			'Pruebas y documentos anteriores a la incoación.',
			'Cronología de actuaciones administrativas y comunicaciones.',
			'Objeto exacto de la impugnación y solicitud formulada.',
		],
	},
	{
		title: 'Suspensión y otras medidas provisionales',
		content: 'La suspensión de la sanción o la adopción de medidas provisionales depende de la normativa aplicable y de la existencia de motivos relevantes. No es automático solicitar la suspensión en todos los casos. El abogado puede valorar si procede pedirla y cómo proteger la situación mientras se resuelve el recurso.',
	},
	{
		title: 'Después de la resolución administrativa',
		content: 'La respuesta a un recurso puede admitir o rechazar las alegaciones. Si no se obtiene la revisión solicitada, conviene estudiar la siguiente vía y comprobar los plazos aplicables. La notificación debe revisarse porque puede iniciar el cómputo de un nuevo plazo.',
	},
	{
		title: 'Recurso de reposición o recurso de alzada',
		content: 'El recurso de reposición se dirige al mismo órgano que dictó la resolución, mientras que el de alzada se presenta ante el superior jerárquico. Saber cuál corresponde evita perder la impugnación por dirigirla a quien no es competente. La propia resolución sancionadora suele indicar los recursos procedentes y ante quién deben presentarse.',
		points: [
			'Órgano que dictó la resolución y su superior.',
			'Recursos que indica la notificación.',
			'Consecuencias de elegir la vía equivocada.',
		],
	},
	{
		title: 'Alegaciones y prueba: qué se presenta',
		content: 'Las alegaciones deben discutir hechos concretos y proponer prueba útil: informes, fotografías, facturas, testigos, registros o documentos anteriores al expediente. También importa señalar los defectos de tramitación, como la falta de audiencia o una notificación defectuosa. La defensa gana claridad cuando distingue lo que se niega de lo que se matiza.',
		points: [
			'Prueba documental y de testigos.',
			'Defectos de tramitación y de notificación.',
			'Propuesta de prueba en el momento adecuado.',
		],
	},
	{
		title: 'La vía contencioso-administrativa',
		content: 'Cuando la vía administrativa no da resultado, el asunto se plantea ante la jurisdicción contencioso-administrativa. Allí se revisan de nuevo los hechos, la prueba y el procedimiento seguido por la administración, y puede solicitarse la suspensión del acto impugnado. Los plazos son breves, así que la decisión de recurrir debe tomarse con la notificación delante.',
		points: [
			'Comprobación de la vía administrativa agotada.',
			'Prueba y defectos que se alegan en la demanda.',
			'Costas y consecuencias de la sentencia.',
		],
	},
];

const faqs = [
	{
		question: '¿Puedo recurrir una multa administrativa?',
		answer: 'Sí, en principio una sanción puede ser recurrida si se ha recibido la resolución y procede según la materia y la normativa aplicable. El tipo de sanción y la administración competente determinan la vía.',
	},
	{
		question: '¿Qué pasa si no me han notificado correctamente?',
		answer: 'La notificación es importante porque puede afectar a la fecha de inicio del plazo. Es necesario revisar cómo se ha realizado, si el expediente permite conocer la resolución y qué consecuencias tiene la notificación defectuosa.',
	},
	{
		question: '¿Se puede pedir la suspensión de una sanción?',
		answer: 'Puede estudiarse en determinados casos, pero no se concede automáticamente. Deben valorarse la normativa sectorial, el riesgo de daño y la solicitud presentada.',
	},
	{
		question: '¿Recurso o demanda contencioso-administrativa?',
		answer: 'La vía depende de la resolución, la materia y el momento del procedimiento. Primero debe identificarse si la Administración admite un recurso o si la cuestión debe revisarse ante la jurisdicción contencioso-administrativa.',
	},
	{
		question: '¿Puedo alegar hechos nuevos al recurrir una sanción?',
		answer: 'Puede valorarse cuando los hechos constan en el expediente o cuando se conocieron después de la resolución. Lo habitual es apoyarse en la prueba documental existente y ordenarla para desvirtuar la imputación, sin olvidar que el plazo del recurso es breve.',
	},
];

const related = [
	{ label: 'Recursos administrativos', href: '/recursos-administrativos', description: 'Guía general para presentar y revisar recursos.' },
	{ label: 'Procedimiento sancionador', href: '/blog/procedimiento-sancionador', description: 'Aspectos principales de la investigación y sanción.' },
	{ label: 'Silencio administrativo', href: '/blog/silencio-administrativo-positivo-negativo', description: 'Qué implica el silencio positivo o negativo.' },
];
---

<SeoLegalPage
	title="Abogado de Sanciones Administrativas en Lucena | Scruz"
	description="Recurre una sanción administrativa en Lucena o Córdoba: revisamos la resolución, los plazos y la prueba antes de alegar. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho administrativo"
	headline="Impugnación de sanciones administrativas"
	intro="Una sanción administrativa puede ser discutida por errores en los hechos, la prueba, el procedimiento o la cuantificación. Analizamos la resolución y preparamos la defensa adecuada para tu caso."
	highlights={highlights}
	serviceType="Asesoría para impugnar sanciones administrativas"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	guides={['recurso-administrativo-guia', 'silencio-administrativo-positivo-negativo', 'multas-penales-suspension-condenas']}
/>
