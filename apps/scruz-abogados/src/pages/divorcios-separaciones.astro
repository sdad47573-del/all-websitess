---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import Hero from '../components/Hero.astro';
import CustomLayout from '../layouts/CustomLayout.astro';
---

<CustomLayout
	title="Abogados de Divorcios y Separaciones en Lucena y Córdoba | Scruz Abogados"
	description="Expertos en divorcios y separaciones en Lucena, Córdoba y Málaga. Asesoramiento en custodia, pensión alimenticia y liquidación de bienes. Consulta gratuita."
>
	<Hero
		heroClasses="min-h-[40vh] md:min-h-[40vh]"
		heroImg={heroImg}
		contentClasses="max-w-[unset]"
		title="Divorcios y Separaciones"
	/>
	<div class="flex flex-col gap-3.5 p-6 text-sm text-[#666666] max-[430px]:break-words md:p-16">
		<h2 class="font-bold">Soluciones rápidas y justas en rupturas familiares.</h2>
		<p>
			Una separación es un momento difícil que no tiene que convertirse en una batalla legal
			interminable. Buscamos la solución más rápida y justa para todos, especialmente si hay hijos
			de por medio. Te asesoramos en todos los aspectos: custodia, pensión alimenticia, liquidación
			del régimen económico… Nuestro objetivo es proteger tus intereses y ofrecerte un camino claro
			para empezar de nuevo.
		</p>
	</div>
</CustomLayout>
