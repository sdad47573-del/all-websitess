---
import heroImg from '@assets/ABOGADOS-EN-LUCENA-3-980x654.webp';
import { SITE_URL } from '../data/site';
import {
	Banknote,
	Calendar,
	Clock,
	Euro,
	FilePenLine,
	Handshake,
	Heart,
	House,
	Landmark,
	Scale,
	ShieldCheck,
	Users,
} from '@lucide/astro';
import CustomLayout from '../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialMeasures,
	EditorialProcess,
	EditorialWhyUs,
} from '../components/editorial';

const faqEntries = [
	{
		question: '¿Es obligatorio ir a juicio para divorciarse?',
		answer:
			'No. En los divorcios de mutuo acuerdo basta con un convenio regulador firmado por ambos cónyuges y ratificado judicialmente. Solo se celebra vista cuando hay hijos menores o patrimonios que proteger y las partes no se han puesto de acuerdo. En los divorcios contenciosos sí hay juicio, pero trabajamos para evitarlo siempre que sea posible.',
	},
	{
		question: '¿Cuánto tarda un divorcio de mutuo acuerdo en Lucena o Córdoba?',
		answer:
			'Entre 1 y 3 meses si el convenio está bien redactado y la documentación completa. Te preparamos todo el expediente, concertamos la cita con el procurador y nos encargamos de la ratificación judicial para que solo tengas que acudir a una vista.',
	},
	{
		question: '¿Quién se queda con la vivienda familiar?',
		answer:
			'Depende de si hay hijos, del título de propiedad y de la posibilidad de ambos cónyuges de hacer frente a la hipoteca. La custodia, los ingresos y la capacidad económica son los criterios principales. Te ayudamos a negociar o, en su defecto, a solicitar la atribución que mejor proteja tus intereses y los de tus hijos.',
	},
	{
		question: '¿Cómo se calcula la pensión de alimentos?',
		answer:
			'Los tribunales fijan la pensión de alimentos combinando dos criterios: las necesidades del menor (comida, ropa, educación, sanidad, ocio) y la capacidad económica del obligado a pagarla. Se aplica un porcentaje orientativo del 25-35% de los ingresos del progenitor para un hijo, con ajustes según el número de hijos y otras cargas familiares.',
	},
	{
		question: '¿Puedo pedir la custodia compartida?',
		answer:
			'Sí. La custodia compartida es actualmente la opción preferente por los tribunales salvo que exista causa justificada para no concederla. La solicitamos cuando es lo más conveniente para el interés del menor: estabilidad de horarios, proximidad de los domicilios y buena comunicación entre los padres.',
	},
	{
		question: '¿Qué ocurre con los bienes gananciales?',
		answer:
			'La liquidación del régimen económico matrimonial forma parte del proceso de separación o divorcio. Inventariamos los bienes y las deudas, los valoramos y proponemos una adjudicación equitativa. Si hay desacuerdo, defendemos tu postura en el juicio.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: Heart, label: 'Modalidad', value: 'Acuerdo o contencioso' },
	{ Icon: Users, label: 'Atención', value: 'Con cita previa' },
	{ Icon: Scale, label: 'Confidencialidad', value: 'Total' },
];

const plazos = [
	{
		Icon: Clock,
		title: '1 — 3 meses',
		description: 'Divorcio de mutuo acuerdo bien preparado.',
	},
	{
		Icon: Calendar,
		title: '6 — 12 meses',
		description: 'Promedio en divorcios contenciosos sin medidas cautelares.',
	},
	{
		Icon: ShieldCheck,
		title: 'Interés del menor',
		description: 'Criterio rector en cualquier decisión sobre custodia o alimentos.',
	},
];

const conceptos = [
	{
		Icon: Users,
		title: 'Custodia y régimen de visitas',
		description:
			'Negociamos o reclamamos la custodia monoparental o compartida, las visitas, la pensión de alimentos y los gastos extraordinarios de los hijos.',
	},
	{
		Icon: Euro,
		title: 'Pensión compensatoria',
		description:
			'Reclamamos o negociamos la pensión compensatoria para quien, tras el divorcio, queda en situación de desequilibrio económico respecto al otro cónyuge.',
	},
	{
		Icon: House,
		title: 'Uso de la vivienda familiar',
		description:
			'Solicitamos la atribución del uso de la vivienda familiar en favor de los hijos o, en su caso, del cónyuge con derecho a la compensatoria.',
	},
	{
		Icon: Landmark,
		title: 'Liquidación de gananciales',
		description:
			'Inventariamos los bienes y deudas del matrimonio, los valoramos y acordamos (o reclamamos judicialmente) una partición equitativa.',
	},
	{
		Icon: Banknote,
		title: 'Pensiones alimenticias',
		description:
			'Cálculo y reclamación de pensiones de alimentos para hijos menores y mayores de edad que sigan estudiando, incluyendo cláusulas de actualización.',
	},
	{
		Icon: FilePenLine,
		title: 'Convenio regulador',
		description:
			'Redacción de un convenio regulador completo, claro y justo que recoja todas las medidas: custodia, pensiones, vivienda, gananciales y pactos de futuro.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Entrevista y diagnóstico',
		description:
			'Te escuchamos, identificamos tus prioridades y te explicamos las opciones reales: acuerdo, mediación o procedimiento contencioso, con sus plazos y costes.',
	},
	{
		number: '02',
		title: 'Negociación y acuerdo',
		description:
			'Si hay voluntad de acuerdo, mediamos con la otra parte para redactar un convenio regulador que contemple todas las medidas y os represente con el procurador.',
	},
	{
		number: '03',
		title: 'Demanda y ratificación',
		description:
			'Si no hay acuerdo, presentamos la demanda con todas las medidas cautelares necesarias y te acompañamos a la vista de ratificación o juicio.',
	},
	{
		number: '04',
		title: 'Ejecución y modificaciones',
		description:
			'Cumplida la sentencia, intervenimos en cualquier incumplimiento o modificación de medidas: nueva custodia, pensión revisada o cambio de domicilio.',
	},
];

const why = [
	{
		Icon: Heart,
		title: 'Trato humano y discreto',
		description:
			'Las separaciones afectan a toda la familia. Mantenemos una conversación cercana, sin tecnicismos innecesarios, y cuidamos la discreción de cada visita.',
	},
	{
		Icon: ShieldCheck,
		title: 'Prioridad a los hijos',
		description:
			'Diseñamos la estrategia pensando siempre en el bienestar de los menores. Custodia compartida cuando es posible y pensiones ajustadas a la realidad.',
	},
	{
		Icon: Handshake,
		title: 'Búsqueda de acuerdo',
		description:
			'Antes de litigar, intentamos la mediación. Un acuerdo bien construido ahorra tiempo, dinero y desgaste emocional a toda la familia.',
	},
];

const rangos = [
	{
		title: 'Divorcio de mutuo acuerdo',
		value: '1 — 3 meses',
		note: 'Con convenio bien preparado',
	},
	{
		title: 'Divorcio contencioso',
		value: '6 — 12 meses',
		note: 'Promedio en Audiencias Provinciales',
	},
	{
		title: 'Modificación de medidas',
		value: '3 — 6 meses',
		note: 'Para revisar custodias o pensiones',
	},
	{
		title: 'Ejecución de sentencia',
		value: '3 — 9 meses',
		note: 'Incumplimientos y reclamaciones',
	},
];
---

<CustomLayout
	title="Abogado de Divorcios en Lucena | Consulta Gratuita Hoy"
	description="Divorcio de mutuo acuerdo o contencioso, custodia y pensiones, con presupuesto cerrado desde la primera llamada. Abogado de familia en Lucena: 666 329 155."
	keywords="abogado divorcio Lucena, separación Córdoba, custodia compartida, pensión alimentos Málaga, liquidación gananciales, abogado familia Andalucía"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Servicios', url: '/servicios/' },
		{ name: 'Divorcios y Separaciones', url: '/divorcios-separaciones/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/divorcios-separaciones/#service`,
			serviceType: 'Derecho de Familia',
			name: 'Divorcios y separaciones',
			description:
				'Tramitación de divorcios y separaciones de mutuo acuerdo y contenciosos, custodia, pensión alimenticia y liquidación de gananciales.',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogados especialistas en divorcios y separaciones en Lucena, Córdoba y Málaga"
		supertitle="Derecho de Familia · Divorcios y separaciones"
		description="Asesoramiento cercano, confidencial y eficaz para divorcios y separaciones en Andalucía. Custodia, pensiones y liquidación de bienes."
		stats={heroStats}
	>
		<span slot="title">Abogado de familia en Lucena: <span class="text-primary">un nuevo comienzo, con tu abogado.</span></span>
	</EditorialHero>

	<EditorialIntro
		supertitle="Bufete Scruz Abogados"
		title={'Acompañamos a tu familia en la separación con <span class="text-primary">sensibilidad y rigor jurídico</span>.'}
		factboxSupertitle="Plazos y criterios"
		factboxTitle="Lo que debes saber"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Una separación es uno de los momentos más difíciles para cualquier familia. No tiene
			por qué convertirse en una batalla legal interminable. En Scruz Abogados buscamos
			siempre la solución más rápida, justa y respetuosa para todos, especialmente cuando
			hay hijos menores de por medio.
		</p>
		<p class="mb-4">
			Te asesoramos en todos los aspectos: tipo de divorcio (mutuo acuerdo o contencioso),
			custodia de los hijos, régimen de visitas, pensión de alimentos, pensión
			compensatoria, uso de la vivienda familiar y liquidación del régimen económico
			matrimonial. Cuando hay voluntad de acuerdo, mediamos con la otra parte para evitar
			el desgaste de un juicio; cuando no la hay, te defendemos en vía contenciosa con
			total firmeza.
		</p>
		<p class="mb-4">
			Para preparar la conversación, el blog recoge cada pieza del proceso: la
			<a href="/blog/custodia-compartida-cordoba/">custodia compartida</a>, el
			<a href="/blog/regimen-de-visitas/">régimen de visitas</a>, la
			<a href="/blog/pension-de-alimentos/">pensión de alimentos</a> y — cuando toca
			repartir lo construido en común — la
			<a href="/blog/liquidacion-gananciales-paso-a-paso/">liquidación de gananciales paso a paso</a>,
			también cuando el vínculo terminó por fallecimiento y la sociedad se liquida dentro
			del <a href="/herencias-testamentos/">reparto de la herencia</a>.
		</p>
		<p>
			Nuestro objetivo es doble: proteger tus intereses legales y minimizar el coste
			emocional para ti y para tus hijos. Mantenemos una comunicación cercana y
			transparente en cada paso, sin sorpresas, con un presupuesto cerrado desde el
			principio.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué tramitamos"
		title="Servicios de familia"
		description="Cubrimos todas las medidas que pueden derivarse de una separación o divorcio, desde el convenio regulador hasta la ejecución de la sentencia."
		items={conceptos}
	/>

	<EditorialMeasures
		supertitle="Tiempos orientativos"
		title="Plazos habituales"
		description="Una estimación realista de los plazos que manejan los juzgados de familia en Andalucía. Cada caso se confirma tras la consulta inicial."
		valueFormat="single-currency"
		noteLabel="Plazo orientativo."
		disclaimer="Tiempos aproximados. La duración real depende de la carga del juzgado, la complejidad del caso y la voluntad de acuerdo entre las partes."
		items={rangos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="De la primera consulta a la sentencia"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Acompañamos a tu familia, sin perder de vista tus intereses."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Resolvemos tus dudas"
		description="Las preguntas más habituales sobre divorcios, custodias, pensiones y bienes gananciales."
		items={faqEntries}
	/>

	<ServiceBlogGuides />
	<EditorialCtaFinal
		supertitle="Estamos a tu lado"
		title={'Hablemos. <span class="text-primary">Sin compromiso.</span>'}
		description="Primera consulta gratuita y confidencial. Te informamos de las opciones, los plazos y los costes. Si decides no continuar, no pagas nada."
		relatedLinks={[
			{ label: 'Coste del divorcio: guía', href: '/blog/cuanto-cuesta-un-divorcio/' },
			{ label: 'Liquidación de gananciales', href: '/liquidacion-gananciales/' },
			{ label: 'Guarda y custodia', href: '/guarda-custodia/' },
			{ label: 'Herencias y testamentos', href: '/herencias-testamentos/' },
		]}
	/>
</CustomLayout>
