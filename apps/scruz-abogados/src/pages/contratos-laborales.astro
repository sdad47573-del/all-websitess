---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho laboral', href: '/contratos-laborales' },
	{ label: 'Contratos laborales', href: '/contratos-laborales' },
];

const highlights = [
	'Revisión del contrato, la jornada y las condiciones económicas',
	'Análisis de modificaciones, incumplimientos y extinciones',
	'Opciones de negociación, reclamación o defensa laboral',
];

const sections = [
	{
		title: 'Asesoría sobre contratos laborales',
		content: 'El contrato laboral recoge las condiciones básicas de la relación de trabajo. Su revisión es importante antes de firmar, cambiar funciones, modificar el salario o solicitar una medida laboral. También puede ser necesario comprobar si una cláusula o una decisión de la empresa es conforme a la normativa.',
		points: [
			'Tipo de contrato, duración, jornada y periodo de prueba.',
			'Salario, complementos, horas y condiciones de trabajo.',
			'Funciones, movilidad, confidencialidad y propiedad intelectual.',
			'Extinción, preaviso y consentimiento del trabajador.',
		],
	},
	{
		title: 'Revisión antes de firmar o modificar un contrato',
		content: 'Antes de aceptar una propuesta conviene comparar el documento con la oferta real. Las modificaciones relevantes suelen ser el salario, la jornada, el lugar, las funciones o la duración. Una modificación no debe quedar únicamente en una conversación: debe constar por escrito y revisarse para evitar disputas.',
	},
	{
		title: 'Incumplimientos y reclamaciones laborales',
		content: 'La falta de pago, la ausencia de justificantes, el incumplimiento del horario o un cambio unilateral pueden requerir una reclamación. La respuesta depende de los hechos, la prueba y el procedimiento aplicable. Conviene actuar pronto si existe riesgo de prescripción o de pérdida de documentación.',
		points: [
			'Nóminas, contratos, cuadrantes y justificantes de trabajo.',
			'Correos, mensajes y comunicaciones con la empresa.',
			'Liquidaciones, recibos de salario y justificantes de pago.',
			'Testigos o pruebas de las tareas realizadas.',
		],
	},
	{
		title: 'Negociación y reclamación',
		content: 'En algunos casos es posible negociar una solución antes de acudir a los tribunales. Si la empresa no responde o existe un incumplimiento claro, puede estudiarse una reclamación laboral con la documentación necesaria. La estrategia debe tener en cuenta la relación laboral actual y la forma de extinguirla.',
	},
	{
		title: 'Cláusulas que suelen generar problemas después',
		content: 'Más allá del salario y la jornada, hay cláusulas que pasan desapercibidas al firmar y luego condicionan toda la relación: objetivos y retribución variable, disponibilidad, no competencia, permanencia mínima o cesión de derechos. Leerlas con calma antes de firmar evita tener que discutirlas cuando ya existe un conflicto y la posición es más débil.',
		points: [
			'Retribución variable, objetivos y su forma de cálculo.',
			'Jornada real, disponibilidad, guardias y registro horario.',
			'No competencia, permanencia y confidencialidad.',
			'Funciones pactadas y su relación con la categoría profesional.',
		],
	},
	{
		title: 'Modificación de condiciones y movilidad',
		content: 'Cambios de funciones, de centro de trabajo, de horario o de sistema de remuneración pueden ser legítimos, pero deben respetar el procedimiento previsto y estar justificados. Si el cambio es sustancial y se impone sin seguir la vía adecuada, cabe oponerse o impugnarlo. La clave es documentar cómo y cuándo se comunicó la decisión.',
		points: [
			'Movilidad funcional y ajuste a la categoría y a la titulación.',
			'Traslado o desplazamiento: causa, preaviso y compensación.',
			'Modificación sustancial de jornada, horario o salario.',
			'Dónde y cómo reclamar si no se acepta el cambio.',
		],
	},
	{
		title: 'Formativo, fijo discontinuo y contrato de relevo',
		content: 'La modalidad contractual influye en la duración, en la cotización y en los derechos que se generan. Un contrato formativo no es equiparable a uno por circunstancias de la producción, y un fijo discontinuo tiene un régimen propio de llamamiento que conviene conocer. Elegir mal la modalidad afecta a la relación actual y a las prestaciones futuras.',
		points: [
			'Formación en alternancia y práctica profesional adaptada al puesto.',
			'Fijo discontinuo: llamamiento, orden y cómputo de antigüedad.',
			'Relevo y sustitución: coordinación entre dos contratos.',
			'Sucesión de contratos temporales y su efecto en la antigüedad.',
		],
	},
];

const faqs = [
	{
		question: '¿Debe revisarse un contrato antes de firmarlo?',
		answer: 'Es recomendable revisar el contrato, especialmente si contiene cláusulas no comprendidas o condiciones que no coinciden con la oferta. Las dudas deben aclararse antes de firmar.',
	},
	{
		question: '¿Puede cambiarse el salario o la jornada?',
		answer: 'Un cambio relevante debe analizarse según su naturaleza, la causa y la forma en que se comunica. No siempre es suficiente una modificación oral y puede ser necesario impugnar la decisión.',
	},
	{
		question: '¿Qué hago si no me pagan el salario?',
		answer: 'Deben conservarse las nóminas, los justificantes y las comunicaciones, y estudiarse la reclamación adecuada. La vía y el plazo dependen de las circunstancias y de la situación laboral actual.',
	},
	{
		question: '¿Se puede reclamar por no recibir las horas extra?',
		answer: 'La reclamación depende de la existencia de trabajo no registrado, su duración y la prueba disponible. Cuadrantes, mensajes, informes y testigos pueden ayudar a reconstruir las jornadas.',
	},
	{
		question: '¿Qué hago si la empresa cambia mi horario sin avisar?',
		answer: 'Conviene pedir por escrito el motivo y la fecha del cambio, y conservar los cuadrantes, los fichajes y los mensajes anteriores y posteriores. Si la modificación es sustancial y no se sigue el procedimiento correcto, existen cauces de reclamación, así que merece la pena revisarlo antes de aceptarla.',
	},
];

const related = [
	{ label: 'Laboral para empresas', href: '/empresas/derecho-laboral', description: 'Contratos, despidos y reclamaciones desde la empresa.' },
	{ label: 'Despidos', href: '/despidos', description: 'Asesoría sobre despido y respuesta laboral.' },
	{ label: 'Jubilación parcial', href: '/jubilacion-parcial', description: 'Compatibilidad entre prestación y actividad laboral.' },
];
---

<SeoLegalPage
	title="Abogado de Contratos Laborales en Lucena | Revisión"
	description="Revisión de contratos laborales, cambios de salario o jornada e impagos: abogado laboralista en Lucena y Córdoba. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho laboral"
	headline="Contratos laborales y reclamaciones"
	intro="El contrato laboral y sus modificaciones pueden generar dudas sobre salario, jornada, funciones o extinción de la relación. Revisamos el documento y los hechos para valorar la vía adecuada."
	highlights={highlights}
	serviceType="Asesoría en contratos laborales"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
	showBlogGuides
/>
