---
import SeoLegalPage from '../components/SeoLegalPage.astro';

const breadcrumb = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Derecho civil', href: '/derecho-civil' },
	{ label: 'Disputas de herencias', href: '/disputas-herencias' },
];

const highlights = [
	'Estudio de documentos, sucesión y condiciones de los herederos',
	'Identificación de plazos y acciones jurídicas aplicables',
	'Opciones de negociación, mediación o procedimiento judicial',
];

const sections = [
	{
		title: '¿Qué es una disputa de herencia?',
		content: 'Surge cuando existe desacuerdo sobre la sucesión, la validez de un testamento, la pertenencia de un bien, la partición, el reconocimiento de herederos o la administración de la herencia. También puede ser necesario regularizar la testamentaría o defender la posición de un heredero frente a una reclamación.',
		points: [
			'Impugnación de un testamento o de una cláusula concreta.',
			'Reclamación de legítima o de derechos sucesorios.',
			'Problemas en la aceptación, renuncia o exclusión de herederos.',
			'Disputas sobre la valoración o división de bienes.',
		],
	},
	{
		title: 'Cómo se analiza una herencia',
		content: 'La actuación depende del tipo de bien, de la existencia de testamento, de la fecha de fallecimiento, de los herederos y de si existe una donación entre vivos. Antes de recomendar una acción, conviene ordenar el expediente: certificados, testamentos, inventario, liquidaciones, declaraciones y comunicaciones familiares.',
	},
	{
		title: 'Negociación, mediación y vía judicial',
		content: 'Cuando la relación familiar lo permite, negociar o acudir a mediación puede evitar un litigio costoso y preservar las relaciones. Si no existe acuerdo o la discusión impide avanzar, puede ser necesaria una demanda. La estrategia debe valorar la prueba disponible, el interés de cada parte, los costes y la urgencia.',
		points: [
			'Preparar una propuesta clara de reparto o inventario.',
			'Separar los conflictos jurídicos de los emocionales.',
			'Documentar acuerdos y evitar compromisos informales sin respaldo.',
			'Adoptar medidas procesales solo cuando sean necesarias y proporcionadas.',
		],
	},
	{
		title: 'Partición y administración de la herencia',
		content: 'La partición puede ser judicial o notarial, según proceda. Una vez aceptada la herencia, quien la administre puede necesitar inventoriar los bienes, hacer frente a deudas y rendir cuentas. Cualquier reparto debe hacerse con información suficiente sobre el patrimonio, las cargas y los derechos de todos los afectados.',
	},
	{
		title: 'Impugnar un testamento: motivos, pruebas y plazos',
		content: 'La impugnación se apoya en defectos de forma, en falta de capacidad del testador o en vicios del consentimiento, y cada motivo exige una prueba distinta. Los plazos para actuar son limitados y empiezan a correr en momentos diferentes según el caso, por lo que conviene revisar el testamento y la fecha del fallecimiento antes de decidir.',
		points: [
			'Defectos de forma o de otorgamiento del propio testamento.',
			'Falta de capacidad o vicios del consentimiento del testador.',
			'Pruebas médicas, declaraciones y documentos de la época.',
			'Revisar los plazos aplicables antes de plantear la demanda.',
		],
	},
	{
		title: 'Legítima y herederos forzosos: qué parte no se puede repartir libremente',
		content: 'Con hijos y descendientes, la mayor parte del patrimonio queda reservada a los herederos forzosos y el testador solo dispone libremente de una parte. El cálculo se hace sobre el patrimonio hereditario real y cambia según el número de hijos y la existencia de cónyuge viudo, así que conviene valorar los bienes antes de discutir cantidades.',
		points: [
			'La legítima corresponde a los herederos forzosos y no es disponible.',
			'Una parte puede destinarse a mejorar a un descendiente concreto.',
			'El cónyuge viudo tiene derechos propios que hay que respetar.',
			'El cálculo se hace sobre el patrimonio real, no sobre estimaciones.',
		],
	},
	{
		title: 'Proteger la herencia mientras se discute',
		content: 'Cuando los bienes corren riesgo de perderse, deteriorarse o ser dispuestos por otro, pueden solicitarse medidas para asegurar el caudal antes de que termine el procedimiento. Documentar el inventario y el estado de los bienes desde el principio facilita tanto el acuerdo como la defensa de cada parte.',
		points: [
			'Inventario de bienes, deudas y documentos desde el fallecimiento.',
			'Administración de los bienes mientras no haya reparto.',
			'Solicitud de medidas cautelares si existe riesgo real de pérdida.',
			'Evitar disposiciones sin acuerdo mientras dure la discusión.',
		],
	},
];

const faqs = [
	{
		question: '¿Cuándo se puede impugnar un testamento?',
		answer: 'La impugnación puede basarse en motivos como la incapacidad del testador, la coacción, la falta de lucidez o determinados defectos formales. La viabilidad depende de la fecha del testamento, de las pruebas y del tipo de defecto.',
	},
	{
		question: '¿Se puede reclamar la legítima de un heredero?',
		answer: 'Puede estudiarse una reclamación de legítima cuando el testamento disponga de bienes que necesariamente deberían haber recibido los herederos forzosos en la parte que corresponde. El cálculo requiere conocer el testamento y los bienes de la herencia.',
	},
	{
		question: '¿Hay que esperar a terminar la testamentaría para pedir la partición?',
		answer: 'No necesariamente, pero la partición debe realizarse con la información y las autorizaciones necesarias. Si hay deudas o disputas relevantes, puede ser conveniente resolver primero esas cuestiones.',
	},
	{
		question: '¿Se puede negociar sin ir a juicio?',
		answer: 'Sí, siempre que sea posible y seguro. Una negociación o mediación bien documentada puede establecer un reparto, resolver asuntos pendientes y evitar gastos innecesarios.',
	},
	{
		question: '¿Qué ocurre si uno de los herederos no firma la partición?',
		answer: 'La partición puede cerrarse sin la firma de todos si sigue la vía judicial, aunque el acuerdo entre los herederos siempre es más rápido y más barato. Si alguien no colabora, hay que acreditar su postura, valorar el contador partidor o la partición judicial y dejar documentado el inventario.',
	},
];

const related = [
	{ label: 'Herencias y testamentos', href: '/herencias-testamentos', description: 'Guía general sobre aceptación, testamento y reparto de una herencia.' },
	{ label: 'Herencia sin testamento', href: '/blog/herencia-sin-testamento', description: 'Qué cambia cuando existe una sucesión intestada.' },
	{ label: 'Impuesto de sucesiones', href: '/blog/impuesto-sucesiones-andalucia', description: 'Información general sobre el proceso tributario en Andalucía.' },
];
---

<SeoLegalPage
	title="Abogado de Disputas de Herencias en Lucena y Córdoba | Scruz"
	description="Partición, legítima o testamento impugnado: ordenamos el expediente y negociamos o litigamos tu herencia en Lucena y Córdoba. Consulta gratuita: 666 329 155."
	breadcrumb={breadcrumb}
	eyebrow="Derecho sucesorio"
	headline="Disputas de herencias y partición de bienes"
	intro="Una herencia puede generar conflictos por el testamento, los herederos, la legítima o la división de los bienes. Analizamos el expediente con claridad y valoramos la vía adecuada para proteger tus derechos sin perder de vista la relación familiar ni sus consecuencias."
	highlights={highlights}
	serviceType="Asesoría en disputas de herencias y partición"
	areaServed="Córdoba, Lucena y provincia"
	sections={sections}
	faqs={faqs}
	related={related}
/>
