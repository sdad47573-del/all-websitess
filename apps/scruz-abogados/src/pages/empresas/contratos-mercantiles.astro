---
import heroImg from '@assets/7.webp';
import { SITE_URL } from '../../data/site';
import {
	BadgeCheck,
	Briefcase,
	Building2,
	CalendarClock,
	Euro,
	FileCheck,
	Gavel,
	Handshake,
	PenLine,
	Receipt,
	Scale,
	ScrollText,
	ShieldCheck,
	TriangleAlert,
	Users,
} from '@lucide/astro';
import CustomLayout from '../../layouts/CustomLayout.astro';
import ServiceBlogGuides from '../../components/ServiceBlogGuides.astro';
import {
	EditorialConcepts,
	EditorialCtaFinal,
	EditorialFAQ,
	EditorialHero,
	EditorialIntro,
	EditorialProcess,
	EditorialWhyUs,
} from '../../components/editorial';

const faqEntries = [
	{
		question: '¿Cuánto tiempo tengo para reclamar si una empresa no me paga?',
		answer:
			'La acción personal para exigir el cumplimiento de un contrato prescribe a los cinco años desde que la deuda es exigible, plazo que se interrumpe con un requerimiento fehaciente —burofax o comunicación que acredite la recepción—, con una reclamación extrajudicial o con la presentación de la demanda. Recomendamos burofax con acuse: corta la prescripción, deja prueba del importe reclamado y muchas veces evita el procedimiento judicial.',
	},
	{
		question: '¿Sirve de algo intentar un acuerdo antes de demandar?',
		answer:
			'No solo sirve: para la mayoría de reclamaciones civiles y mercantiles es obligatorio desde la reforma procesal de 2025. La negociación previa (MASC) es un requisito de procedibilidad, así que hay que intentarla y documentarla: si no se acredita, el juzgado puede no admitir la demanda. Además, un acuerdo firmado en mediación o en conciliación es título ejecutivo y cobra mucho más rápido que una sentencia.',
	},
	{
		question: '¿Qué cláusulas son imprescindibles en un contrato entre empresas?',
		answer:
			'Objeto y alcance del servicio, precio y forma de pago con intereses de demora, plazo y condiciones de prórroga, responsabilidad con sus límites, indemnizaciones, protección de datos cuando hay datos personales de por medio, confidencialidad, causas de resolución y foro competente. En contratos con consumidores se añaden las condiciones generales y el control de transparencia. Un buen contrato no es el más largo, sino el que deja claro qué pasa si algo falla.',
	},
	{
		question: '¿Puedo reclamar los daños y perjuicios además del importe impagado?',
		answer:
			'Sí, siempre que se pruebe el daño y su relación con el incumplimiento. Se pueden reclamar los daños efectivos (el perjuicio causado) y el lucro cesante (lo que se dejó de ganar), además de los intereses. Si el contrato incluye cláusula penal, hay que elegir: reclamar la pena pactada o exigir el daño probado más los intereses, salvo que la propia cláusula prevea otra cosa. Es una decisión con impacto económico y conviene calcularla antes de presentar la demanda.',
	},
	{
		question: '¿Qué hago si un proveedor entrega mercancía defectuosa?',
		answer:
			'Comunicarlo por escrito lo antes posible y, en compraventas mercantiles, dentro del plazo pactado o, en su defecto, en los treinta días siguientes a la entrega: si se deja pasar, se presume que la mercancía fue aceptada y la reclamación se debilita mucho. Conviene dejar constancia del estado del género, no manipularlo y, si el defecto es relevante, pedir peritaje. A partir de ahí, la vía es exigir la reparación, la sustitución o la resolución con devolución del precio.',
	},
	{
		question: '¿Es válido un contrato firmado por email o sin firmar?',
		answer:
			'Sí. Entre empresas el contrato existe desde que hay consentimiento sobre el objeto y la causa, y un intercambio de correos, un presupuesto aceptado o unos pedidos confirmados pueden probarlo. El problema no es la validez, sino la prueba: sin firma ni documento único, lo que se discute en juicio es qué se pactó exactamente. Cuando el importe o el riesgo lo justifica, redactamos un contrato único con las condiciones completas y, si conviene, con firma electrónica cualificada.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqEntries.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

const heroStats = [
	{ Icon: PenLine, label: 'Antes de firmar', value: 'Revisión de cláusulas' },
	{ Icon: Handshake, label: 'Negociación', value: 'Acuerdo sin pleito' },
	{ Icon: Gavel, label: 'Si incumple', value: 'Reclamación judicial' },
];

const plazos = [
	{
		Icon: CalendarClock,
		title: '5 años',
		description:
			'Prescripción de la acción personal para reclamar el cumplimiento de un contrato (art. 1964 CC).',
	},
	{
		Icon: Receipt,
		title: '30 días',
		description:
			'Plazo habitual para comunicar por escrito defectos en una entrega mercantil antes de que se presuma la aceptación.',
	},
	{
		Icon: Scale,
		title: '1 mes',
		description:
			'Negociación previa (MASC) que hay que intentar y acreditar antes de demandar en la mayoría de reclamaciones mercantiles.',
	},
	{
		Icon: Euro,
		title: '4 años',
		description:
			'Plazo para exigir responsabilidad al administrador por las deudas sociales, contado desde su cese.',
	},
];

const conceptos = [
	{
		Icon: ScrollText,
		title: 'Redacción a medida',
		description:
			'Contratos redactados para tu operación concreta: objeto, precio, plazos, responsabilidad, penalizaciones, resolución y foro, sin plantillas genéricas que no cubren lo que tú necesitas.',
	},
	{
		Icon: FileCheck,
		title: 'Revisión antes de firmar',
		description:
			'Analizamos el borrador del cliente o del proveedor y señalamos por escrito dónde estás asumiendo un riesgo desproporcionado, con propuesta de redacción alternativa para cada cláusula.',
	},
	{
		Icon: Building2,
		title: 'Compraventa y suministro',
		description:
			'Contratos de compraventa mercantil, suministro y aprovisionamiento: entregas, calidad, precios revisables, reserva de dominio y garantías por defectos.',
	},
	{
		Icon: Handshake,
		title: 'Distribución, agencia y franquicia',
		description:
			'Contratos de distribución exclusiva o selectiva, agencia comercial y franquicia, con su indemnización por clientela, no competencia y extinción bien delimitadas.',
	},
	{
		Icon: Users,
		title: 'Prestación de servicios y obra',
		description:
			'Contratos de servicios profesionales, obra y mantenimiento: alcance, hitos, niveles de servicio (SLA), confidencialidad y propiedad de los resultados.',
	},
	{
		Icon: TriangleAlert,
		title: 'Incumplimiento y reclamación',
		description:
			'Requerimiento fehaciente, resolución del contrato, reclamación de cantidad, cláusula penal, daños y perjuicios y negociación previa obligatoria antes de la demanda.',
	},
];

const pasos = [
	{
		number: '01',
		title: 'Entender la operación',
		description:
			'Antes de escribir una sola cláusula: qué se vende, a quién, con qué márgenes, qué pasa si falla y qué es innegociable para cada parte. Un contrato sin eso copia el riesgo en vez de repartirlo.',
	},
	{
		number: '02',
		title: 'Redacción y cuadro de riesgos',
		description:
			'Redactamos el contrato o marcamos el borrador de la contraparte con las cláusulas críticas señaladas y su consecuencia práctica, para que puedas negociar con argumentos y no solo con intuición.',
	},
	{
		number: '03',
		title: 'Negociación y firma',
		description:
			'Cubrimos la negociación de las cláusulas abiertas, preparamos el documento definitivo y, si el volumen o la confidencialidad lo piden, la firma electrónica cualificada.',
	},
	{
		number: '04',
		title: 'Vigilancia y reclamación',
		description:
			'Revisamos prórrogas y preavisos para no dejar caducar plazos, y cuando aparece el incumplimiento activamos la vía más rápida: cobro, resolución o demanda, según lo que más te convenga.',
	},
];

const why = [
	{
		Icon: Briefcase,
		title: 'Contratos escritos para tu negocio',
		description:
			'Trabajamos a diario con pymes de la Subbética y del área de Málaga: sabemos qué se discute de verdad en un contrato de distribución, de suministro o de servicios.',
	},
	{
		Icon: ShieldCheck,
		title: 'Prevenir cuesta menos que litigar',
		description:
			'Una cláusula mal redactada se paga en el juzgado. Revisamos el contrato antes de la firma y, cuando el incumplimiento ya existe, buscamos cobrar sin pleito si es viable.',
	},
	{
		Icon: BadgeCheck,
		title: 'Interlocutor único y presupuesto cerrado',
		description:
			'Llevas el contrato y su reclamación con el mismo abogado, con presupuesto por escrito antes de empezar y sin costes que aparezcan a mitad del asunto.',
	},
];

const relatedGuides = [
	{ label: 'Qué revisar en un contrato', href: '/blog/contratos-lucena/' },
	{ label: 'El MASC: negociación previa obligatoria', href: '/blog/masc-negociacion-obligatoria/' },
	{ label: 'Reclamación de deudas y monitorio', href: '/blog/reclamacion-deudas-monitorio/' },
];
---

<CustomLayout
	title="Contratos Mercantiles para Empresas en Lucena | Scruz Abogados"
	description="Redacción y revisión de contratos mercantiles en Lucena: compraventa, distribución, servicios y cláusula penal. Consulta gratuita: 666 329 155."
	keywords="contratos mercantiles Lucena, redacción de contratos Córdoba, incumplimiento de contrato empresa, cláusula penal, contrato de distribución, condiciones generales, contratos entre empresas"
	ogImage={heroImg.src}
	breadcrumb={[
		{ name: 'Inicio', url: '/' },
		{ name: 'Empresas', url: '/empresas/' },
		{ name: 'Contratos Mercantiles', url: '/empresas/contratos-mercantiles/' },
	]}
	additionalSchemas={[
		{
			'@context': 'https://schema.org',
			'@type': 'Service',
			'@id': `${SITE_URL}/empresas/contratos-mercantiles/#service`,
			url: `${SITE_URL}/empresas/contratos-mercantiles/`,
			name: 'Contratos mercantiles para empresas',
			description:
				'Redacción y revisión de contratos mercantiles, y reclamación del incumplimiento: cantidad, resolución, daños y perjuicios.',
			serviceType: 'Derecho mercantil y contractual',
			provider: { '@id': `${SITE_URL}/#organization` },
			areaServed: ['Lucena', 'Córdoba', 'Málaga', 'Andalucía'],
			isPartOf: { '@id': `${SITE_URL}/empresas/#service` },
		},
		faqSchema,
	]}
>
	<EditorialHero
		image={heroImg}
		imageAlt="Abogado mercantil revisando un contrato de empresa en Lucena"
		supertitle="Empresas · Contratos mercantiles"
		description="Redactamos y revisamos los contratos que sostienen tu actividad, y reclamamos lo que no se cumple: sin firmar a ciegas y sin dejar prescribir la deuda."
		stats={heroStats}
	>
		<span slot="title"
			>Contratos mercantiles: <span class="text-primary"
				>lo que no se pacta, se discute en juicio.</span
			></span
		>
	</EditorialHero>

	<EditorialIntro
		supertitle="Contratación entre empresas"
		title={'El contrato es la primera <span class="text-primary">decisión de negocio</span>.'}
		factboxSupertitle="Lo que debes saber"
		factboxTitle="Plazos que no se pueden perder"
		factboxItems={plazos}
	>
		<p class="mb-4">
			Casi todos los conflictos mercantiles que llegan a un despacho se decidieron meses antes,
			en la mesa donde se firmó el contrato: un precio sin fecha de pago, una entrega sin
			consecuencias, un preaviso que nadie definió o una cláusula de resolución imposible de
			activar. Revisar ese documento cuesta una fracción de lo que cuesta un procedimiento.
		</p>
		<p class="mb-4">
			Asesoramos a empresas y autónomos de Lucena, Córdoba y Málaga en las dos caras de la
			contratación: la preventiva —redacción y revisión de contratos de compraventa, suministro,
			distribución, agencia, servicios y obra— y la de reclamación, cuando el contrato ya se ha
			incumplido y hay que cobrar, resolver o exigir daños y perjuicios.
		</p>
		<p>
			Todo encargo va con presupuesto cerrado y con el mismo abogado de principio a fin. Si
			además necesitas cubrir la parte laboral o de cumplimiento normativo,
			<a href="/empresas/">te lo cubrimos dentro del área de empresas</a>.
		</p>
	</EditorialIntro>

	<EditorialConcepts
		supertitle="Qué hacemos por tu empresa"
		title="Servicios contractuales"
		description="Desde el borrador del cliente hasta la demanda por incumplimiento, con una sola línea de trabajo."
		items={conceptos}
	/>

	<EditorialProcess
		supertitle="Metodología"
		title="Cómo trabajamos un contrato"
		items={pasos}
	/>

	<EditorialWhyUs
		supertitle="Por qué elegirnos"
		title="Contratos que aguantan una negociación y un juicio."
		items={why}
	/>

	<EditorialFAQ
		supertitle="Preguntas frecuentes"
		title="Dudas de empresa sobre contratos"
		description="Las preguntas que más nos llegan de pymes y autónomos antes de firmar un contrato o después de sufrir un incumplimiento."
		items={faqEntries}
	/>

	<ServiceBlogGuides supertitle="Guías para empresas" />

	<EditorialCtaFinal
		supertitle="Revisamos tu contrato"
		title={'Antes de firmar, <span class="text-primary">danos el borrador.</span>'}
		description="Primera consulta gratuita y confidencial. Revisamos el contrato o el impago que tienes sobre la mesa y te decimos qué riesgo asumes y cómo reclamarlo."
		relatedLinks={[
			...relatedGuides,
			{ label: 'Empresas y mercantil', href: '/empresas/' },
			{ label: 'Constitución de sociedades', href: '/empresas/constitucion-sociedades/' },
			{ label: 'Derecho laboral para empresas', href: '/empresas/derecho-laboral/' },
			{ label: 'Protección de datos y RGPD', href: '/empresas/proteccion-de-datos/' },
			{ label: 'Cobro de deudas e impagos', href: '/cobro-deudas-impagos/' },
		]}
	/>
</CustomLayout>
