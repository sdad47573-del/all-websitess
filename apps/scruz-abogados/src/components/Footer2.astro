---
import { FacebookIcon, InstagramIcon, LinkedinIcon, MapIcon, PhoneIcon } from '@astro-icons';
import Subfooter from '../components/Subfooter.astro';
---

<footer class="bg-primary text-primary-content pt-11" transition:name="footer">
	<div class="container mx-auto flex flex-col">
		<div class="flex flex-col gap-4 p-4 pb-16 md:flex-row md:px-16">
			<a href="/" class="cursor-pointer">
				<span class="font-title text-3xl"> SCRUZ </span>
				<span class="text-neutral font-title text-lg"> ABOGADOS </span>
			</a>
			<div class="flex flex-col">
				<p class="flex items-center pb-2 text-xl font-bold">Nuestro despacho</p>
				<a
					target="_blank"
					rel="noopener noreferrer"
					href="https://maps.app.goo.gl/LbozAFjGe4kxjRuZA"
					class="flex gap-2 pb-2"
				>
					<!-- <div class="flex gap-2 items-center"> -->
					<div>
						<p class="flex items-baseline gap-1 font-bold">
							<MapIcon class="size-5" />
							Lucena, Córdoba (España)
						</p>
						<p>Calle El Agua, 19, 1º Izq., 14900 Lucena.</p>
					</div>
				</a>
				<a
					target="_blank"
					rel="noopener noreferrer"
					href="tel:+34 666 329 155"
					class="link flex items-center gap-2"
				>
					<p class="flex items-center gap-1">
						<PhoneIcon class="size-5" />
						957 117 185 / 666 329 155
					</p>
				</a>
				<!-- <div class="flex flex-col">
          {
            DATA.footer.menu.map(({ label, href }) => (
              <a href={href}>{label}</a>
            ))
          }
        </div> -->
			</div>

			<div class="flex flex-col">
				{
					[
						'Abogado divorcios en Málaga',
						'Abogados de familia y herencias',
						'Abogados para guarda y custodia',
						'Asuntos penales',
						'Abogados bancarios',
						'Abogados para compraventa',
						'Arrendamientos',
						'Accidentes de tráfico',
						'Tarjetas revolving',
					].map((link) => <a class="btn btn-ghost btn-accent w-fit">{link}</a>)
				}
				<div class="flex gap-2 pt-5">
					<a href="" class="bg-base-100 block w-fit rounded p-1.5">
						<LinkedinIcon class="size-5" />
					</a>
					<a href="" class="block w-fit rounded bg-[#0866ff] p-1.5">
						<FacebookIcon class="size-5" />
					</a>
					<a href="" class="block w-fit rounded bg-[#eb3b6d] p-1.5">
						<InstagramIcon class="size-5" />
					</a>
				</div>
			</div>
		</div>
	</div>
	<Subfooter />
</footer>
