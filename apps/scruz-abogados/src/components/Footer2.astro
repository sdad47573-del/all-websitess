---
import { DATA } from "src/data/data";
import FacebookIcon from "src/icons/FacebookIcon.astro";
import InstagramIcon from "src/icons/InstagramIcon.astro";
import LinkedinIcon from "src/icons/LinkedinIcon.astro";
import MailIcon from "src/icons/MailIcon.astro";
import MapIcon from "src/icons/MapIcon.astro";
import PhoneIcon from "src/icons/PhoneIcon.astro";
import Subfooter from "src/components/Subfooter.astro";
---

<footer class="pt-11 bg-primary text-primary-content" transition:name="footer">
  <div class="mx-auto container flex flex-col">
    <div class="flex flex-col md:flex-row gap-4 p-4 md:px-16 pb-16">
      <a href="/" class="cursor-pointer">
        <span class="text-3xl font-title"> SCRUZ </span>
        <span class="text-lg text-neutral font-title"> ABOGADOS </span>
      </a>
      <div class="flex flex-col">
        <p class="text-xl font-bold flex items-center pb-2">Nuestro despacho</p>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://maps.app.goo.gl/LbozAFjGe4kxjRuZA"
          class="flex gap-2 pb-2"
        >
          <!-- <div class="flex gap-2 items-center"> -->
          <div>
            <p class="font-bold flex items-baseline gap-1">
              <MapIcon class="size-5" />
              Lucena, Córdoba (España)
            </p>
            <p>Calle El Agua, 19, 1º Izq., 14900 Lucena.</p>
          </div>
        </a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="tel:+34 666 329 155"
          class="flex gap-2 items-center link"
        >
          <p class="flex items-center gap-1">
            <PhoneIcon class="size-5" />
            957 117 185 / 666 329 155
          </p>
        </a>
        <!-- <div class="flex flex-col">
          {
            DATA.footer.menu.map(({ label, href }) => (
              <a href={href}>{label}</a>
            ))
          }
        </div> -->
      </div>

      <div class="flex flex-col">
        {
          [
            "Abogado divorcios en Málaga",
            "Abogados de familia y herencias",
            "Abogados para guarda y custodia",
            "Asuntos penales",
            "Abogados bancarios",
            "Abogados para compraventa",
            "Arrendamientos",
            "Accidentes de tráfico",
            "Tarjetas revolving",
          ].map((link) => <a class="btn btn-ghost w-fit btn-accent">{link}</a>)
        }
        <div class="flex gap-2 pt-5">
          <a href="" class="p-1.5 bg-base-100 block w-fit rounded">
            <LinkedinIcon class="size-5" />
          </a>
          <a href="" class="p-1.5 bg-[#0866ff] block w-fit rounded">
            <FacebookIcon class="size-5" />
          </a>
          <a href="" class="p-1.5 bg-[#eb3b6d] block w-fit rounded">
            <InstagramIcon class="size-5" />
          </a>
        </div>
      </div>
    </div>
  </div>
  <Subfooter />
</footer>
