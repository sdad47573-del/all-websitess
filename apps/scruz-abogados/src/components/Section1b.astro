---
import { Image } from "astro:assets";

// TODO: esto deberia de venir por props loading="eager" decoding="async"
const { rellenoImg, title, list } = Astro.props;
---

<div
  class="card lg:card-side bg-base-100 shadow-sm rounded-none p-6 md:p-16 gap-6 md:gap-16"
>
  <div class="card-body px-0 pt-0">
    <h2 class="card-title text-3xl pb-7">
      {title}
    </h2>
    <div class="flex flex-col gap-2">
      {list.map((text) => <p class="pb-4">{text}</p>)}
    </div>
  </div>
  <figure class="w-full md:w-[110%]">
    <Image
      loading="eager"
      decoding="async"
      class="!object-contain"
      src={rellenoImg}
      alt="Logotipo de Scruz Abogados"
    />
  </figure>
</div>
