---
/**
 * Lista editorial de medidas/estimaciones con hairline dividers.
 * Variantes:
 *   - valueFormat: "currency" (from–to €, default) | "single" ([scope], violencia-genero)
 *                  | "single-currency" (nacionalidad, "3 — 6 meses")
 *   - valueColor:  "primary" | "success"
 *   - Trailing note (derecha) configurable por item ("rowNote") o global ("noteLabel").
 */
interface Props {
	supertitle: string;
	title: string;
	description?: string;
	valueFormat?: 'currency' | 'single' | 'single-currency';
	valueColor?: 'primary' | 'success';
	noteLabel?: string;
	disclaimer: string;
	items: Array<{
		title: string;
		note?: string;
		from?: number;
		to?: number;
		value?: string;
		rowNote?: string;
	}>;
}

const {
	supertitle,
	title,
	description,
	valueFormat = 'currency',
	valueColor = 'primary',
	noteLabel = 'Cifras indicativas según baremo.',
	disclaimer,
	items,
} = Astro.props;
---

<section class="bg-base-100 px-6 py-16 md:px-16 md:py-24">
	<div class="reveal mx-auto max-w-5xl">
		<p class="eyebrow">{supertitle}</p>
		<h2 class="mb-4 font-title text-3xl leading-tight md:text-4xl lg:text-5xl">
			{title}
		</h2>
		{description && (
			<p class="mb-12 max-w-2xl text-base leading-relaxed text-base-content/70 md:text-lg">
				{description}
			</p>
		)}

		<div class="border-t border-base-300">
			{
				items.map(({ title: rowTitle, note, from, to, value, rowNote }) => (
					<div class="grid grid-cols-1 items-baseline gap-4 border-b border-base-300 py-7 md:grid-cols-[1.4fr_auto_auto] md:gap-10 md:py-9">
						<div>
							<p class="font-title text-lg font-bold md:text-2xl">{rowTitle}</p>
							{note && (
								<p class="mt-1 text-xs uppercase tracking-widest text-base-content/70">
									{note}
								</p>
							)}
						</div>
						<div class="flex items-baseline gap-3 md:justify-end">
							{valueFormat === 'currency' && (
								<>
									<span
										class:list={[
											'font-title text-2xl font-bold md:text-4xl',
											valueColor === 'success' ? 'text-success' : 'text-primary',
										]}
									>
										{from?.toLocaleString('es-ES')}€
									</span>
									<span class="text-base-content/70">–</span>
									<span
										class:list={[
											'font-title text-2xl font-bold md:text-4xl',
											valueColor === 'success' ? 'text-success' : 'text-primary',
										]}
									>
										{to?.toLocaleString('es-ES')}€
									</span>
								</>
							)}
							{valueFormat === 'single' && (
								<span
									class:list={[
										'font-title text-base font-bold md:text-2xl',
										valueColor === 'success' ? 'text-success' : 'text-primary',
									]}
								>
									{value}
								</span>
							)}
							{valueFormat === 'single-currency' && (
								<span class="font-title text-2xl font-bold text-primary md:text-4xl">
									{value}
								</span>
							)}
						</div>
						<p class="hidden text-xs text-base-content/70 md:block md:max-w-[12rem] md:text-right">
							{rowNote ?? noteLabel}
						</p>
					</div>
				))
			}
		</div>

		<p class="mt-6 text-sm italic leading-relaxed text-base-content/70">
			{disclaimer}
		</p>
	</div>
</section>
