---
/**
 * FAQ editorial con accordion (details/summary) y plus icon que rota 45° al abrirse.
 * Cada pregunta se separa con hairline border-b; bg cambia a base-200/60 cuando está abierto.
 */
interface Props {
	supertitle: string;
	title: string;
	description?: string;
	items: Array<{ question: string; answer: string }>;
}

const { supertitle, title, description, items } = Astro.props;
---

<section class="bg-base-100 px-6 py-16 md:px-16 md:py-24">
	<div class="reveal mx-auto max-w-4xl">
		<p class="eyebrow">{supertitle}</p>
		<h2 class="mb-4 font-title text-3xl leading-tight md:text-4xl">
			{title}
		</h2>
		{description && <p class="mb-10 text-base-content/70">{description}</p>}

		<div class="border-t border-base-300">
			{
				items.map(({ question, answer }) => (
					<details class="group border-b border-base-300 transition-colors duration-300 open:bg-base-200/60">
						<summary class="flex cursor-pointer list-none items-start justify-between gap-6 px-1 py-6 transition-colors duration-200 hover:text-primary [&::-webkit-details-marker]:hidden">
							<h3 class="font-title flex-1 pr-2 text-lg font-bold leading-snug md:text-xl">
								{question}
							</h3>
							<span class="mt-1 flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-primary font-bold text-primary transition-transform duration-300 group-open:rotate-45">
								<svg
									aria-hidden="true"
									class="size-4"
									stroke="currentColor"
									stroke-width="2.5"
									fill="none"
									viewBox="0 0 24 24"
								>
									<path d="M12 5v14M5 12h14" />
								</svg>
							</span>
						</summary>
						<div class="max-w-3xl px-1 pb-6 text-base leading-relaxed text-base-content/80">
							<p>{answer}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
</section>
