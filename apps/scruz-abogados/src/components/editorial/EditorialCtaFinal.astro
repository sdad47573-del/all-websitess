---
/**
 * CTA final dual layout (texto + tarjeta de contacto).
 * - appearance: "dark" (bg-primary / icons warning, default) | "light" (bg-base-100 + ring, servicio.astro)
 * - title acepta HTML para poder resaltar una parte en color primario.
 * - relatedLinks (chips ghost al final del texto)
 * - El título llega en HTML para permitir un span con .text-primary inline.
 */
interface ContactCardProps {
	appearance?: 'dark' | 'light';
	supertitle: string;
	title: string;
	description: string;
	relatedLinks: Array<{ label: string; href: string }>;
	warningPreText?: string;
}

const {
	appearance = 'dark',
	supertitle,
	title,
	description,
	relatedLinks,
	warningPreText = 'También podemos ayudarte con',
} = Astro.props as ContactCardProps;

const cardCls =
	appearance === 'light'
		? 'reveal-pop rounded-2xl bg-base-100 p-8 shadow-strong ring-1 ring-base-300 md:p-10'
		: 'reveal-pop rounded-2xl bg-primary p-8 text-primary-content shadow-strong md:p-10';

const cardEyebrowCls =
	appearance === 'light'
		? 'text-[0.7rem] font-bold uppercase tracking-widest text-primary'
		: 'text-[0.7rem] font-bold uppercase tracking-widest text-warning';

const cardHeadingCls = 'font-title text-2xl font-bold leading-tight md:text-3xl';

const rowCls =
	appearance === 'light'
		? 'group flex items-center gap-4 rounded-lg bg-base-200 p-4 transition-colors duration-200 hover:bg-base-300'
		: 'group flex items-center gap-4 rounded-lg bg-white/10 p-4 transition-colors duration-200 hover:bg-white/20';

const rowIconCls =
	appearance === 'light'
		? 'flex size-11 shrink-0 items-center justify-center rounded-full bg-primary text-primary-content transition-transform duration-300 group-hover:scale-110'
		: 'flex size-11 shrink-0 items-center justify-center rounded-full bg-warning text-primary transition-transform duration-300 group-hover:scale-110';

const rowLabelCls =
	appearance === 'light'
		? 'text-[0.65rem] font-bold uppercase tracking-widest text-base-content/70'
		: 'text-[0.65rem] font-bold uppercase tracking-widest opacity-70';

const rowTitleCls = 'font-title text-base font-bold leading-snug md:text-lg';
---

<section class="bg-base-200 px-6 py-16 md:px-16 md:py-24">
	<div
		class="reveal mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-16"
	>
		<div>
			<p class="eyebrow">{supertitle}</p>
			<h2
				class="mb-6 font-title text-3xl leading-tight md:text-4xl lg:text-5xl"
				set:html={title}
			/>
			<p
				class="mb-8 text-base leading-relaxed text-base-content/80 md:text-lg"
			>
				{description}
			</p>

			<p class="eyebrow !mb-3">{warningPreText}</p>
			<div class="flex flex-wrap gap-2">
				{
					relatedLinks.map(({ label, href }) => (
						<a href={href} class="btn btn-ghost btn-sm border border-base-300">
							{label}
						</a>
					))
				}
			</div>
		</div>

		<div class={cardCls}>
			<p class={cardEyebrowCls}>Contacto directo</p>
			<h3 class:list={[cardHeadingCls, 'mt-3 mb-8']}>Elige cómo quieres que te atendamos</h3>
			<div class="space-y-3">
				<a
					href="tel:+34666329155"
					class={rowCls}
				>
					<div class={rowIconCls}>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="size-5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.25"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path
								d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
							></path>
						</svg>
					</div>
					<div>
						<p class={rowLabelCls}>Teléfono</p>
						<p class="font-title text-lg font-bold">+34 666 329 155</p>
					</div>
				</a>

				<a
					href="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
					class={rowCls}
				>
					<div class={rowIconCls}>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="size-5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.25"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
						</svg>
					</div>
					<div>
						<p class={rowLabelCls}>WhatsApp</p>
						<p class="font-title text-lg font-bold">Respuesta inmediata</p>
					</div>
				</a>

				<a
					href="/ubicaciones/"
					class={rowCls}
				>
					<div class={rowIconCls}>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="size-5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.25"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
							<circle cx="12" cy="10" r="3"></circle>
						</svg>
					</div>
					<div>
						<p class={rowLabelCls}>Presencial</p>
						<p class={rowTitleCls}>C/ El Agua, 19 · Lucena</p>
					</div>
				</a>
			</div>
		</div>
	</div>
</section>
