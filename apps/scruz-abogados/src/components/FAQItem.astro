---
interface Props {
	title: string;
	questions: { title: string; answer: string }[];
}

const { title, questions } = Astro.props;
---

<div class="reveal-pop overflow-hidden rounded-2xl border border-base-300 bg-base-100">
	<div class="border-b border-base-300 bg-base-200 px-4 py-4 md:px-6 md:py-5">
		<div class="flex items-center space-x-3">
			<h2 class="font-title text-xl font-bold">{title}</h2>
		</div>
	</div>
	<div class="divide-y divide-base-300">
		{
			questions.map(({ title, answer }) => (
				<details name={title} class="w-full">
				<summary class="accordion-header flex w-full cursor-pointer items-center justify-between px-4 py-4 text-left md:p-6">
					<h3 class="font-title pr-4 text-base font-semibold md:text-lg">{title}</h3>
					</summary>
				<div class="accordion-content px-4 pb-4 md:p-6">
					<p class="pr-0 text-base-content/80 md:pr-4">{answer}</p>
					</div>
				</details>
			))
		}
	</div>
</div>
