---
const { title, questions } = Astro.props;
---

<div class="overflow-hidden rounded-xl bg-white shadow-lg">
	{/* <div class="bg-white rounded-xl shadow-lg overflow-hidden max-w-xl w-full h-fit"> */}
	<div class="border-b border-blue-100 bg-blue-50 px-6 py-4">
		<div class="flex items-center space-x-3">
			<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-100">
				<i class="ri-money-euro-circle-line text-primary"></i>
			</div>
			<h2 class="text-xl font-bold text-gray-900">{title}</h2>
		</div>
	</div>
	<div class="divide-y divide-gray-200">
		{
			questions.map(({ title, answer }) => (
				<details name={title} class="w-full">
					<summary class="accordion-header flex w-full cursor-pointer items-center justify-between p-6 text-left">
						<h3 class="pr-4 text-lg font-semibold text-gray-900">{title}</h3>
						{/* <div class="w-6 h-6 flex items-center justify-center flex-shrink-0">
                        {/* <i class="ri-add-line text-primary text-xl" /> 
                        <i class="ri-subtract-line text-primary text-xl" />
                      </div> */}
					</summary>
					<div class="accordion-content p-6">
						<p class="pr-4 text-gray-700">{answer}</p>
					</div>
				</details>
			))
		}
	</div>
</div>
