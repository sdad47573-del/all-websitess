---
import { Image } from "astro:assets";

const { balImg, certImg, peopImg, hammImg } = Astro.props;
---

<div class="bg-primary text-primary-content px-6 md:px-24 pt-16 pb-32">
  <h2 class="text-5xl text-center font-bold pb-20 max-[380px]:break-words">
    ¿Necesitas asesoramiento legal?
  </h2>
  <div class="flex flex-col md:flex-row md:justify-between gap-7">
    <div class="flex flex-col items-center gap-4">
      <Image
        src={balImg}
        alt="Balanza de justicia simbolizando más de 20 años de experiencia legal"
        class="size-20 object-contain"
      />
      <p class="text-xl text-center">Más de 20 años de experiencia</p>
    </div>

    <div class="flex flex-col items-center gap-4">
      <Image
        src={certImg}
        alt="Certificado representando un equipo multidisciplinario de abogados"
        class="size-20 object-contain"
      />

      <p class="text-xl text-center">Equipo multidisciplinar</p>
    </div>

    <div class="flex flex-col items-center gap-4">
      <Image
        src={peopImg}
        alt="Icono de persona indicando atención personalizada para clientes"
        class="size-20 object-contain"
      />
      <p class="text-xl text-center">Atención personalizada</p>
    </div>

    <div class="flex flex-col items-center gap-4">
      <Image
        src={hammImg}
        alt="Martillo de juez simbolizando resultados garantizados en casos legales"
        class="size-20 object-contain"
      />
      <p class="text-xl text-center">Resultados garantizados</p>
    </div>
  </div>
</div>
