---
import { getImage } from '@astro-components';
import { twMerge } from 'tailwind-merge';

const { heroClasses, contentClasses, heroImg, title, subtitle, action1, action2 } = Astro.props;

const optimized = await getImage({ src: heroImg, width: 700, format: 'webp' });
---

<!--
	Mismo lenguaje que EditorialHero: imagen a sangre, overlay azul tinta→negro,
	contenido alineado a la izquierda sobre max-w-6xl y botones del sistema
	(btn-warning + outline blanco) para que las páginas legales y "Sobre
	nosotros" abran con el mismo patrón que las fichas de servicio.
-->
<section
	transition:name="hero"
	class={twMerge(
		'relative flex min-h-[60vh] items-center overflow-hidden bg-cover bg-center bg-no-repeat md:min-h-[82vh]',
		heroClasses,
	)}
	style={`background-image: url(${optimized.src});`}
>
	<div
		class="absolute inset-0 bg-gradient-to-br from-primary/85 via-primary/55 to-black/70 dark:from-neutral/95 dark:via-neutral/85 dark:to-black/90"
		aria-hidden="true"
	>
	</div>
	<div class="relative z-10 mx-auto w-full max-w-6xl px-6 py-20 text-white md:px-16">
		<div class={twMerge('max-w-2xl', contentClasses)}>
			<h1 class="animate-fade-in-up mb-5 font-title text-4xl font-bold leading-[1.05] sm:text-5xl md:text-6xl">
				{title}
			</h1>
			{
				subtitle && (
					<p class="animate-fade-in-up mb-6 text-base leading-relaxed text-white/90 sm:text-lg" style="animation-delay: 0.1s">{subtitle}</p>
				)
			}
			{
				action1 && (
					<a
						href="/servicios/"
						class="btn btn-warning btn-md animate-fade-in-up mr-2 duration-700 md:btn-lg"
					>
						{action1}
					</a>
				)
			}
			{
				action2 && (
					<a
						href="tel:+34666329155"
						class="btn btn-outline btn-md animate-fade-in-up duration-700 md:btn-lg !border-white !bg-white/10 !text-white hover:!bg-white hover:!text-primary"
					>
						{action2}
					</a>
				)
			}
		</div>
	</div>
</section>
