---
import { twMerge } from "tailwind-merge";
import { getImage } from "astro:assets";

const {
  heroClasses,
  contentClasses,
  heroImg,
  title,
  subtitle,
  action1,
  action2,
} = Astro.props;

const optimized = await getImage({ src: heroImg, width: 700, format: "webp" });
---

<div
  transition:name="hero"
  class={twMerge(
    "hero min-h-[60vh] md:min-h-[82vh] object-fill overflow-hidden",
    heroClasses
  )}
  style={`background-image: url(${optimized.src});`}
>
  <div class="hero-overlay"></div>
  <div class="hero-content text-neutral-content text-center">
    <div class={twMerge("max-w-md", contentClasses)}>
      <h1
        class="mb-5 text-5xl font-bold animate__animated"
        data-animate="animate__backInDown"
      >
        {title}
      </h1>
      {
        subtitle && (
          <p
            class="mb-5 animate__animated animate__delay-1s"
            data-animate="animate__backInUp"
          >
            {subtitle}
          </p>
        )
      }
      {
        action1 && (
          <a
            href="/servicios"
            class="btn btn-outline animate__animated duration-700 animate__delay-2s mb-2"
            data-animate="animate__fadeIn"
          >
            {action1}
          </a>
        )
      }
      {
        action2 && (
          <a
            target="_blank"
            rel="noopener noreferrer"
            href="tel:+34 666 329 155"
            class="btn btn-neutral animate__animated duration-700 animate__delay-3s mb-2"
            data-animate="animate__bounceIn"
          >
            {action2}
          </a>
        )
      }
    </div>
  </div>
</div>
