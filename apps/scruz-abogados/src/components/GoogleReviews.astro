---
import GoogleImg from '@assets/google.webp';
import UnnamedImg from '@assets/unnamed (2).png';
import VerifiedImg from '@assets/verified.png';
import { Image } from '@astro-components';
import { GoogleIcon } from '@astro-icons';

const a = {
	profile_photo: UnnamedImg,
	author_name: 'elizabeth blu',
	rating: 5,

	text: 'Un profesional excelente. Tuvimos un problema y no sólo nos ayudó con todo, también nos tranquilizó durante todo el proceso y ayudó a mi familiar a salir de una situación injusta. Súper agradecidos y lo recomendamos al 100%',
};

const reviews = [a];
// const reviews = [a, a];
const review_url =
	'https://www.google.com/maps/place/Abogado+Sergio+Cruz+Chac%C3%B3n/@37.4271167,-4.4847368,14.33z/data=!4m8!3m7!1s0xd6d7100463548d7:0x8ddd019c9af14c71!8m2!3d37.4078135!4d-4.4876165!9m1!1b1!16s%2Fg%2F11y0b9bxt7?entry=ttu&g_ep=EgoyMDI1MTAwOC4wIKXMDSoASAFQAw%3D%3D';
---

<div class="container mx-auto flex flex-col gap-4 px-4 py-20">
	<div class="pb-8 text-center">
		<p class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">Opiniones de clientes</p>
		<p class="text-xl">Reseñas reales de Google</p>
	</div>
	<div class="flex flex-col-reverse items-center justify-center gap-20 md:flex-row">
		<div class="flex flex-col items-center">
			<p class="text-2xl font-bold">EXCELENTE</p>
			<div class="text-3xl">{'⭐'.repeat(5)}</div>
			<p class="pt-4 pb-2">
				A base de <span class="font-bold">1 reseñas</span>
			</p>
			<Image src={GoogleImg} alt="" class="mb-4 h-9 w-auto object-contain" />
			<a class="btn btn-accent btn-lg btn-wide" href={review_url}>Ver mas reseñas</a>
		</div>
		<div class="relative flex flex-col gap-4 md:flex-row">
			<a
				class="btn btn-accent btn-circle absolute top-24 -right-7 hidden md:flex"
				href={review_url}
			>
				<i class="ri-arrow-right-s-line"></i>
			</a>
			<a class="btn btn-accent btn-circle absolute top-24 -left-7 hidden md:flex" href={review_url}>
				<i class="ri-arrow-left-s-line"></i>
			</a>
			{
				reviews.slice(0, 2).map((r) => (
					<div class="ring-primary w-full max-w-96 rounded-xl bg-white p-4 shadow-lg transition-all hover:ring-2">
						<div class="flex justify-between">
							<div class="flex">
								<Image src={r.profile_photo} alt={r.author_name} class="mr-3.5 size-10" />
								<p class="font-bold">{r.author_name}</p>
							</div>
							<GoogleIcon class="size-5" />
						</div>
						<div class="flex items-center gap-2 py-2.5">
							{'⭐'.repeat(r.rating)}

							<Image src={VerifiedImg} alt="" class="size-4" />
						</div>

						<p class="text">{r.text}</p>
					</div>
				))
			}
		</div>
	</div>
</div>
