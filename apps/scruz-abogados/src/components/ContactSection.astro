---
import { Image } from 'astro:assets';
import { MailIcon, MapIcon, PhoneIcon } from '@astro-icons';

const { gmapsImg } = Astro.props;
---

<div class="flex flex-col gap-6 p-6 md:flex-row md:justify-center md:gap-16 md:p-16">
	<!-- <div class="container mx-auto py-12 px-4 flex flex-col gap-4"> -->

	<!-- <div class="container mx-auto py-12 px-4 flex flex-col gap-4"> -->
	<div class="flex flex-col">
		<div class="flex flex-col gap-4 pb-10">
			<p class="text-3xl font-bold">Cuéntanos tu caso en confianza</p>
			<p>
				Más de 20 años nos avalan. Contacta con nosotros através del formulario o con nuestros datos
				de contacto.
			</p>
		</div>
		<div class="flex flex-col gap-7">
			<a
				target="_blank"
				rel="noopener noreferrer"
				href="tel:+34 666 329 155"
				class="link flex items-center gap-2"
			>
				<PhoneIcon />

				<span class="text-xl font-bold">957 117 185 / 666 329 155</span>
			</a>
			<a
				target="_blank"
				rel="noopener noreferrer"
				href="https://maps.app.goo.gl/LbozAFjGe4kxjRuZA"
				class="flex gap-2"
			>
				<!-- <div class="flex gap-2 items-center"> -->
				<MapIcon />
				<div>
					<p class="text-xl font-bold">Lucena, Córdoba (España)</p>
					<p>Calle El Agua, 19, 1º Izq., 14900 Lucena.</p>
				</div>
			</a>
			<a
				target="_blank"
				rel="noopener noreferrer"
				href="mailto:info@scruzabogados.es?subject=Asunto%20del%20email&body=Texto%20del%20mensaje"
				class="link flex items-center gap-2 text-xl font-bold"
			>
				<MailIcon />
				info@scruzabogados.es
			</a>
			<a
				target="_blank"
				rel="noopener noreferrer"
				href="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
				class="btn btn-neutral animate__animated !w-full"
				data-animate="animate__bounceIn">Contactar por Whatsapp</a
			>
		</div>
	</div>
	<a
		target="_blank"
		rel="noopener noreferrer"
		href="https://maps.app.goo.gl/LbozAFjGe4kxjRuZA"
		class="md:indicator group"
	>
		<span
			class="indicator-item indicator-top indicator-start badge badge-neutral hidden font-bold group-hover:animate-bounce md:block"
			>Haz click</span
		>

		<Image
			src={gmapsImg}
			alt="Mapa con la ubicación del despacho de abogados Sergio Cruz Chacon"
			class="w-[698px] md:grid md:place-items-center"
		/>
	</a>
</div>
