---
import { Image } from "astro:assets";
import MailIcon from "src/icons/MailIcon.astro";
import MapIcon from "src/icons/MapIcon.astro";
import PhoneIcon from "src/icons/PhoneIcon.astro";

const { gmapsImg } = Astro.props;
---

<div
  class="p-6 md:p-16 flex flex-col md:flex-row gap-6 md:gap-16 md:justify-center"
>
  <!-- <div class="container mx-auto py-12 px-4 flex flex-col gap-4"> -->

  <!-- <div class="container mx-auto py-12 px-4 flex flex-col gap-4"> -->
  <div class="flex flex-col">
    <div class="flex flex-col gap-4 pb-10">
      <p class="font-bold text-3xl">Cuéntanos tu caso en confianza</p>
      <p>
        Más de 20 años nos avalan. Contacta con nosotros através del formulario
        o con nuestros datos de contacto.
      </p>
    </div>
    <div class="flex flex-col gap-7">
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="tel:+34 666 329 155"
        class="flex gap-2 items-center link"
      >
        <PhoneIcon />

        <span class="text-xl font-bold">957 117 185 / 666 329 155</span>
      </a>
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://maps.app.goo.gl/LbozAFjGe4kxjRuZA"
        class="flex gap-2"
      >
        <!-- <div class="flex gap-2 items-center"> -->
        <MapIcon />
        <div>
          <p class="text-xl font-bold">Lucena, Córdoba (España)</p>
          <p>Calle El Agua, 19, 1º Izq., 14900 Lucena.</p>
        </div>
      </a>
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="mailto:info@scruzabogados.es?subject=Asunto%20del%20email&body=Texto%20del%20mensaje"
        class="flex gap-2 items-center text-xl font-bold link"
      >
        <MailIcon />
        info@scruzabogados.es
      </a>
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
        class="btn !w-full btn-neutral animate__animated"
        data-animate="animate__bounceIn">Contactar por Whatsapp</a
      >
    </div>
  </div>
  <a
    target="_blank"
    rel="noopener noreferrer"
    href="https://maps.app.goo.gl/LbozAFjGe4kxjRuZA"
    class="md:indicator group"
  >
    <span
      class="hidden md:block group-hover:animate-bounce font-bold indicator-item indicator-top indicator-start badge badge-neutral"
      >Haz click</span
    >

    <Image
      src={gmapsImg}
      alt="Mapa con la ubicación del despacho de abogados Sergio Cruz Chacon"
      class="w-[698px] md:place-items-center md:grid"
    />
  </a>
</div>
