---
import PhoneCallIcon from "src/icons/material-symbols-call.astro";

const { DATA } = Astro.props;
---

<div
  id="navbar"
  class="navbar py-4 px-4 md:px-16 bg-base-100/90 backdrop-blur-xl shadow-sm sticky top-0 z-50 justify-between"
>
  <div class="">
    <a href="/" class="flex flex-col font-title">
      <span class="text-3xl leading-[25px] text-center text-primary">
        SCRUZ
      </span>
      <span class="text-lg text-center leading-4 block"> ABOGADOS </span>
    </a>
  </div>
  <div class="flex gap-16 items-center">
    <div class="flex-none md:block hidden">
      <ul class="menu menu-horizontal menu-md px-1">
        {
          DATA.NAVBAR.menu.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <a
      class="btn btn-sm md:btn-md btn-neutral"
      target="_blank"
      rel="noopener noreferrer"
      href="tel:+34 666 329 155"
    >
      Pide cita
      <PhoneCallIcon />
    </a>
  </div>
  <!-- 957 117 185 / 666 329 155 -->
</div>
