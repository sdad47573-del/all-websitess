---
import { PhoneCallIcon } from '@astro-icons';

const { DATA } = Astro.props;
---

<div
	id="navbar"
	class="navbar bg-base-100/90 sticky top-0 z-50 justify-between px-4 py-4 shadow-sm backdrop-blur-xl md:px-16"
>
	<div class="">
		<a href="/" class="font-title flex flex-col">
			<span class="text-primary text-center text-3xl leading-[25px]"> SCRUZ </span>
			<span class="block text-center text-lg leading-4"> ABOGADOS </span>
		</a>
	</div>
	<div class="flex items-center gap-16">
		<div class="hidden flex-none md:block">
			<ul class="menu menu-horizontal menu-md px-1">
				{
					DATA.NAVBAR.menu.map(({ label, href }) => (
						<li>
							<a href={href}>{label}</a>
						</li>
					))
				}
			</ul>
		</div>
		<a
			class="btn btn-sm md:btn-md btn-neutral"
			target="_blank"
			rel="noopener noreferrer"
			href="tel:+34 666 329 155"
		>
			Pide cita
			<PhoneCallIcon />
		</a>
	</div>
	<!-- 957 117 185 / 666 329 155 -->
</div>
