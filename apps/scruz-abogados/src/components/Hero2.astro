---
import HeroBgImg from '@assets/hero-bg.png';
import HeroPjImg from '@assets/hero-pj.png';

import { getImage, Image } from '@astro-components';

import { twJoin } from 'tailwind-merge';
import { DATA } from '../data/data';

const optimized = await getImage({
	src: HeroBgImg,
	format: 'webp',
});
---

<div
	class="relative overflow-hidden bg-gradient-to-br from-blue-600 via-purple-600 to-blue-800"
>
	<!-- Overlay con gradiente -->
	<div class="absolute inset-0 bg-gradient-to-br from-blue-600/90 via-purple-600/90 to-blue-800/90" aria-hidden="true"></div>

	<!-- Patrón de fondo decorativo -->
	<div
		class="absolute inset-0 opacity-10 bg-top bg-repeat"
		style={`background-image: url(${optimized.src});`}
		aria-hidden="true"
	></div>

	<!-- Elementos decorativos flotantes -->
	<div class="absolute top-20 left-10 w-72 h-72 bg-purple-500/20 rounded-full blur-3xl animate-float" aria-hidden="true"></div>
	<div class="absolute bottom-20 right-10 w-96 h-96 bg-blue-500/20 rounded-full blur-3xl animate-float" style="animation-delay: 2s;" aria-hidden="true"></div>

	<Image
		src={HeroPjImg}
		alt="Abogado Sergio Cruz Chacón"
		class="absolute right-[-125px] bottom-0 hidden h-[90%] w-auto object-contain md:block lg:right-0 xl:right-[10%] opacity-90"
		loading="eager"
		decoding="async"
		fetchpriority="high"
	/>

	<div class="flex flex-col justify-between relative z-10">
		<!-- Versión móvil -->
		<div class="relative h-[60vh] overflow-hidden md:hidden">
			<div class="h-full bg-gradient-to-b from-transparent to-blue-900/50">
				<div class="p-4 text-start md:max-w-md lg:max-w-none">
					<p class="text-white/90 text-lg mb-2 animate-fade-in-up">Despacho de abogados en Málaga</p>
					<p class="font-title text-4xl font-bold text-white mb-4 animate-fade-in-up" style="animation-delay: 0.2s;">Sergio Cruz Chacón</p>
				</div>
				<Image
					src={HeroPjImg}
					alt="Abogado Sergio Cruz Chacón"
					class="h-full place-self-center object-cover object-top opacity-90"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
			</div>
			<div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-blue-900" aria-hidden="true"></div>
		</div>
	</div>

	<!-- Contenido principal -->
	<div
		class="z-10 mx-auto flex w-full flex-col gap-6 p-6 px-4 pb-32 text-center sm:px-6 md:px-10 md:pt-20 md:pb-40 lg:max-w-7xl lg:px-8 relative"
	>
		<!-- Tarjeta de presentación con glassmorphism -->
		<div class="glass rounded-2xl p-6 md:p-8 text-start md:max-w-2xl lg:max-w-none shadow-strong backdrop-blur-xl bg-white/10 border border-white/20 animate-scale-in">
			<p class="text-white/90 hidden text-lg md:block mb-2 font-medium">Despacho de abogados en Málaga</p>
			<p class="font-title hidden text-5xl font-bold md:block mb-4 text-white">Sergio Cruz Chacón</p>
			<h1 class="text-2xl md:text-3xl font-bold text-white mb-3">Asesoramiento legal para particulares y empresas en toda Andalucía.</h1>
			<p class="text-white/90 text-lg">
				Más de 20 años ofreciendo soluciones jurídicas eficaces en las áreas civil, penal, laboral y
				mercantil.
			</p>
		</div>

		<!-- Servicios destacados con diseño mejorado -->
		<div
			class="mt-10 grid grid-cols-1 justify-items-center gap-8 !pt-0 sm:grid-cols-2 md:w-fit md:grid-cols-1 lg:grid-cols-2"
		>
			{
				DATA.heroServices.map(({ title, img, description }, idx) => (
					<div
						class={twJoin(
							'group flex w-full max-w-sm flex-col items-center justify-between gap-4 p-6 rounded-2xl glass hover-lift hover-glow transition-all duration-300 backdrop-blur-xl bg-white/10 border border-white/20 shadow-soft',
							idx % 2 === 0 ? 'lg:justify-self-end' : 'lg:justify-self-start',
						)}
					>
						<div class="flex flex-col items-center gap-3">
							<figure class="size-14 p-3 rounded-xl bg-white/20 group-hover:bg-white/30 transition-all duration-300 group-hover:scale-110">
								<Image
									src={img}
									alt={`Representación de ${title.toLowerCase()}`}
									class="w-full h-full object-contain"
									loading="lazy"
									decoding="async"
								/>
							</figure>
							<h3 class="card-title text-center text-white text-xl font-bold">{title}</h3>
							<p class="text-center text-white/90">{description}</p>
						</div>
					</div>
				))
			}
		</div>

		<!-- Botones de acción mejorados -->
		<div
			class="flex flex-col justify-center gap-4 sm:flex-row md:flex-col lg:ml-14 lg:flex-row lg:justify-start mt-8"
		>
			<a
				href="/servicios"
				class="btn btn-lg sm:btn-wide bg-white text-blue-600 hover:bg-white/90 border-0 shadow-strong hover:shadow-xl hover:scale-105 transition-all duration-300 font-semibold"
			>
				Ver todos los servicios
			</a>
			<a
				href="/trayectoria"
				class="btn btn-lg sm:btn-wide glass border-white/30 text-white hover:bg-white/20 hover:border-white/50 shadow-soft hover:shadow-strong hover:scale-105 transition-all duration-300 font-semibold"
			>
				Ver trayectoria
			</a>
		</div>
	</div>
</div>

