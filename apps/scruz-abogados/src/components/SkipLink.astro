---
/**
 * Skip-to-content link (WCAG 2.1 — Bypass Blocks, criterion 2.4.1).
 * Invisible hasta que recibe foco por teclado, momento en que se
 * hace visible y permite saltar la navegación al contenido principal.
 *
 * Requiere que el destino (`/main` o el id configurado) exista.
 * CustomLayout ya renderiza <main id="main"> por defecto.
 */
export interface Props {
	target?: string;
	label?: string;
}

const { target = '#main', label = 'Saltar al contenido principal' } = Astro.props;
---

<a
	href={target}
	class="focus:bg-primary focus:text-primary-content focus:ring-primary sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:rounded-md focus:px-4 focus:py-2 focus:shadow-lg focus:outline-none focus:ring-2"
>
	{label}
</a>
