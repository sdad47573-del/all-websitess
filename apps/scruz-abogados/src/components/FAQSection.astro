---
import { Image } from "astro:assets";
import { twJoin } from "tailwind-merge";

const { DATA } = Astro.props;
---

<div class="container mx-auto py-12 px-4 flex flex-col md:flex-row gap-8">
  <div class="flex-2 flex flex-col">
    <h2 class="text-3xl font-bold pb-4 text-center">
      FAQ – Preguntas frecuentes
    </h2>
    {
      DATA.FAQ.questions.map(({ question, answer }, idx) => (
        <div
          class={twJoin(
            "collapse collapse-arrow bg-base-100 border border-base-300"
          )}
        >
          <input
            type="radio"
            name="my-accordion-2"
            id={question}
            checked={idx === 0 ? "checked" : ""}
          />
          <label for={question} class="collapse-title font-semibold">
            <h3>{question}</h3>
          </label>
          <div class="collapse-content text-sm">{answer}</div>
        </div>
      ))
    }
  </div>
  <div class="flex flex-1 justify-center">
    <Image
      class="w-full p-16 object-contain"
      src={DATA.FAQ.img}
      alt={DATA.FAQ.img.alt}
    />
  </div>
</div>
