---
import { Image } from 'astro:assets';
import { twJoin } from 'tailwind-merge';

const { DATA } = Astro.props;
---

<div class="container mx-auto flex flex-col gap-8 px-4 py-12 md:flex-row">
	<div class="flex flex-2 flex-col">
		<h2 class="pb-4 text-center text-3xl font-bold">FAQ – Preguntas frecuentes</h2>
		{
			DATA.FAQ.questions.map(({ question, answer }, idx) => (
				<div class={twJoin('collapse-arrow bg-base-100 border-base-300 collapse border')}>
					<input
						type="radio"
						name="my-accordion-2"
						id={question}
						checked={idx === 0 ? 'checked' : ''}
					/>
					<label for={question} class="collapse-title font-semibold">
						<h3>{question}</h3>
					</label>
					<div class="collapse-content text-sm">{answer}</div>
				</div>
			))
		}
	</div>
	<div class="flex flex-1 justify-center">
		<Image class="w-full object-contain p-16" src={DATA.FAQ.img} alt={DATA.FAQ.img.alt} />
	</div>
</div>
