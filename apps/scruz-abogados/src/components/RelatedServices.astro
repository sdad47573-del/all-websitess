---
// Bloque de enlaces internos contextuales: "Servicios relacionados" + "Más guías".
// El slug del artículo se deriva de la URL actual (/blog/<slug>/), de modo que
// renombrar un archivo mantiene los enlaces en sync sin tocar cada página.
//
// La segunda sección ("Más guías del blog") enlaza al índice /blog/ y a otros
// artículos — prioriza los de la misma categoría y completa con los más
// recientes. Refuerza el enlazado interno del hub sin editar cada post.
import { ArrowRight, FolderOpen } from '@lucide/astro';
import { BLOG_RELATED_SERVICES } from '../data/blogInternalLinks';
import { BLOG_POSTS } from '../data/BLOG_POSTS';
import { categoryHubHref } from '../data/BLOG_CATEGORIES';

const slug = Astro.url.pathname.split('/').filter(Boolean).pop() ?? '';
const related = BLOG_RELATED_SERVICES[slug] ?? [];

// Más guías: misma categoría primero, después los más recientes. Excluye el actual.
const current = BLOG_POSTS.find((p) => p.href.endsWith(`/${slug}/`));

// Hub de la categoría del artículo (si tiene página propia). Es el enlace que
// convierte cada guía en una entrada al hub de su área; sin él, los hubs solo
// recibirían enlaces del índice del blog y el clúster temático quedaría cojo.
const categoryHref = current ? categoryHubHref(current.category) : null;
const morePosts = BLOG_POSTS.filter((p) => !p.href.endsWith(`/${slug}/`))
	.sort((a, b) => {
		const aSame = current && a.category === current.category ? 0 : 1;
		const bSame = current && b.category === current.category ? 0 : 1;
		return aSame - bSame || (a.date < b.date ? 1 : -1);
	})
	.slice(0, 3);
---

{
	categoryHref && current && (
		<div class="reveal-pop mb-6">
			<a
				href={categoryHref}
				class="text-primary inline-flex items-center gap-2 font-semibold transition-colors hover:text-primary/80"
				data-discover="true"
			>
				<FolderOpen class="size-4 shrink-0" aria-hidden="true" />
				Más guías de {current.category}
			</a>
		</div>
	)
}
{
	related.length > 0 && (
		<div class="reveal-pop rounded-2xl border border-base-300 bg-base-200 p-6 sm:p-8">
			<h2 class="font-title mb-4 text-xl font-bold">Servicios relacionados</h2>
			<ul class="space-y-3">
				{related.map(({ path, label }) => (
					<li>
						<a
							href={`${path}/`}
							class="group inline-flex items-center gap-2 font-semibold text-primary transition-colors hover:text-primary/80"
						>
							<ArrowRight
								class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
							/>
							{label}
						</a>
					</li>
				))}
			</ul>
		</div>
	)
}
{
	morePosts.length > 0 && (
		<div class="reveal-pop rounded-2xl border border-base-300 bg-base-200 p-6 sm:p-8">
			<h2 class="font-title mb-4 text-xl font-bold">Más guías legales del blog</h2>
			<ul class="space-y-3">
				{morePosts.map((post) => (
					<li>
						<a
							href={post.href}
							class="group inline-flex items-center gap-2 font-semibold text-primary transition-colors hover:text-primary/80"
						>
							<ArrowRight
								class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
							/>
							{post.title}
						</a>
					</li>
				))}
				<li>
					<a
						href="/blog/"
						class="group inline-flex items-center gap-2 text-sm font-semibold text-gray-500 transition-colors hover:text-primary"
					>
						<ArrowRight
							class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
						/>
						Ver todas las guías del blog
					</a>
				</li>
				<li>
					<a
						href="/servicios/"
						class="group inline-flex items-center gap-2 text-sm font-semibold text-gray-500 transition-colors hover:text-primary"
					>
						<ArrowRight
							class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
						/>
						Ver todos los servicios del despacho
					</a>
				</li>
				<li>
					<a
						href="/faq/"
						class="group inline-flex items-center gap-2 text-sm font-semibold text-gray-500 transition-colors hover:text-primary"
					>
						<ArrowRight
							class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
						/>
						Preguntas frecuentes sobre el despacho
					</a>
				</li>
			</ul>
		</div>
	)
}