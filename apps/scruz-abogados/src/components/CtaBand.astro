---
/**
 * Banda azul de cierre de página: eyebrow + titular + entradilla + dos CTA.
 *
 * `trayectoria.astro` y `empresas.astro` tenían esta misma banda copiada a mano
 * (con las mismas clases y solo el copy y los enlaces distintos), así que
 * cualquier ajuste había que hacerlo dos veces y era fácil que se separaran.
 * Vive aquí para que compartan rejilla, anchos y espaciado de verdad.
 *
 * La cáscara (aire vertical y lateral) viene de la clase `.band` de index.css,
 * que es la que comparten todas las bandas azules del sitio.
 */
interface Cta {
	label: string;
	href: string;
	/** Enlace que sale del sitio (WhatsApp): abre en pestaña nueva con rel. */
	external?: boolean;
}

interface Props {
	eyebrow: string;
	title: string;
	description: string;
	primary: Cta;
	secondary: Cta;
}

const { eyebrow, title, description, primary, secondary } = Astro.props;
---

<section class="band band-primary bg-primary text-primary-content">
	{/* max-w-6xl: el mismo ancho de contenido que el resto de bandas azules. */}
	<div class="reveal mx-auto max-w-6xl text-center">
		<p class="eyebrow eyebrow--center mb-3 !text-white">{eyebrow}</p>
		<h2 class="font-title mb-6 text-3xl font-bold text-white md:text-4xl lg:text-5xl">{title}</h2>
		<p class="mx-auto mb-8 max-w-3xl text-xl text-blue-100">{description}</p>
		<div class="flex flex-col flex-wrap justify-center gap-4 sm:flex-row">
			<a
				class="text-primary cursor-pointer rounded-lg bg-white px-8 py-4 text-lg font-semibold whitespace-nowrap transition-colors hover:bg-blue-50"
				href={primary.href}
				target={primary.external ? '_blank' : undefined}
				rel={primary.external ? 'noopener noreferrer' : undefined}
				data-discover="true">{primary.label}</a
			><a
				class="hover:text-primary cursor-pointer rounded-lg border-2 border-white px-8 py-4 text-lg font-semibold whitespace-nowrap text-white transition-colors hover:bg-white"
				href={secondary.href}
				target={secondary.external ? '_blank' : undefined}
				rel={secondary.external ? 'noopener noreferrer' : undefined}
				data-discover="true">{secondary.label}</a
			>
		</div>
	</div>
</section>
