---
import { twJoin } from 'tailwind-merge';

const { city, isMain, province, description, address, zip, map } = Astro.props;
---

<div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
	<div class="">
		<div class={twJoin('rounded-xl bg-white p-8 shadow-lg', isMain && 'ring-primary ring-2')}>
			<h3 class="mb-2 flex gap-2 text-2xl font-bold text-gray-900">
				{city}
				{
					isMain && (
						<div class="bg-primary text-primary-content inline-block rounded-full px-3 py-1 text-sm font-semibold">
							Oficina Principal
						</div>
					)
				}
			</h3>
			<p class="mb-6 text-gray-600">{province}</p>
			<p class="mb-6 text-gray-700">{description}</p>
			<div class="mb-6 space-y-4">
				<div class="flex items-start space-x-3"></div>
				<div class="flex items-start space-x-3">
					<div class="mt-0.5 flex h-5 w-5 items-center justify-center">
						<i class="ri-map-pin-line text-primary"></i>
					</div>
					<div>
						<p class="font-medium text-gray-900">{address}</p>
						<p class="text-gray-600">{zip}</p>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="">
		<div class="h-80 overflow-hidden rounded-xl bg-gray-100 shadow-lg">
			<iframe
				src={map}
				width="100%"
				height="100%"
				allowfullscreen=""
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				title={city}
				style="border: 0px;"></iframe>
		</div>
	</div>
</div>
