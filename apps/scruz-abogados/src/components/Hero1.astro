---
import HeroImg from "../assets/hero.jpg";
import HeroBgImg from "../assets/hero-bg.png";
import HeroPjImg from "../assets/hero-pj.png";
// import HeroDesktopImg from "../assets/hhero-desktop.png";

import { getImage, Image } from "astro:assets";
import { twJoin } from "tailwind-merge";
import { DATA } from "src/data/data";

const optimized = await getImage({
  src: HeroBgImg,
  format: "webp",
});
---

<div
  class="relative bg-repeat bg-top overflow-hidden max-md:!bg-none"
  style={`background-image: url(${optimized.src});`}
>
  <!-- <siv
    src={HeroBgImg}
    alt=""
    class="h-60 md:h-full w-full absolute bg-cover bg-repeat hidden md:block object-top-right"
  /> -->
  <Image
    src={HeroPjImg}
    alt=""
    class="absolute hidden md:block bottom-0 xl:right-[10%] lg:right-0 right-[-125px] h-[90%] w-auto object-contain"
  />
  <div class="flex flex-col justify-between">
    <!-- <div class="container flex flex-col md:flex-row-reverse justify-between"> -->
    <div class="h-60 md:hidden relative">
      <Image src={HeroImg} alt="" class="h-full object-cover object-top" />
      <!-- <Image src={HeroImg} alt="" class="h-full object-cover object-top" /> -->
      <div
        class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-white"
      >
      </div>
    </div>

    <!-- class="flex flex-col p-4 gap-4 text-center z-10 w-full max-w-[720px] md:px-10 md:pt-16 md:pb-36" -->
    <div
      class="flex flex-col p-4 pb-32 gap-4 text-center z-10 w-full md:px-10 md:pt-16 md:pb-36 lg:max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
    >
      <!-- class="flex flex-col p-4 pb-32 gap-4 text-center z-10 w-full lg:max-w-[70%] xl:max-w-[60%] md:max-w-[60%] md:px-10 md:pt-16 md:pb-36" -->
      <div class="rounded-sm p-4 text-start md:max-w-md lg:max-w-none">
        <!-- <div class="bg-base-100/40 p-4"> -->
        <p class="text-lg text-secondarys">Despacho de abogados en Málaga</p>
        <p class="font-bold text-4xl font-title">Sergio Cruz Chacón</p>
        <h1 class="text-xl">
          Asesoramiento legal para particulares y empresas en toda Andalucía.
        </h1>
        <p>
          Más de 20 años ofreciendo soluciones jurídicas eficaces en las áreas
          civil, penal, laboral y mercantil.
        </p>
      </div>
      <!-- <div class="flex mt-10 flex-wrap gap-4 justify-center !pt-0"> -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2 mt-10 gap-8 justify-items-center !pt-0 md:w-fit"
      >
        {
          DATA.heroServices.map(({ title, img, description }, idx) => (
            <div
              class={twJoin(
                " flex flex-col justify-between gap-4 items-center w-72 ",
                idx % 2 === 0 ? "lg:justify-self-end" : "lg:justify-self-start"
              )}
            >
              <div class=" flex flex-col items-center gap-2 ">
                <figure class="size-11">
                  <Image
                    src={img}
                    alt={`Representación de ${title.toLowerCase()}`}
                    class="rounded-xl"
                  />
                </figure>
                <h3 class="text-center card-title">{title}</h3>
                <p class="text-center">{description} </p>
              </div>
            </div>
          ))
        }
      </div>
      <div
        class="flex flex-col sm:flex-row lg:flex-row md:flex-col gap-2 justify-center lg:justify-start lg:ml-14"
      >
        <a
          href="/servicios"
          class="btn btn-primary btn-lg mt-5 btn-block sm:btn-wide"
          >Ver todos los servicios</a
        >
        <a
          href="/trayectoria"
          class="btn btn-outline btn-neutral md:btn-wide lg:max-w-none lg:w-fit btn-lg mt-5"
          >Ver trayectoria</a
        >
      </div>
    </div>
  </div>
</div>
