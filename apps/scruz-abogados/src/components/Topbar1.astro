---
import { twJoin } from "tailwind-merge";

const currentPath = Astro.url.pathname;

const DATA = {
  phone: "+34 666 32 91 55",
  facebook: "#",
  instagram: "#",
  linkedin: "#",
  sections: [
    { name: "Inicio", href: "/" },
    { name: "Trayectoria", href: "/trayectoria/" },
    { name: "Servicios", href: "/servicios/" },
    { name: "Ubicaciones", href: "/ubicaciones/" },
    { name: "FAQ", href: "/FAQ/" },
    { name: "Empresas", href: "/empresas/" },
  ],
};
---

<div class="bg-accent text-accent-content">
  <!-- <div class="max-w-7xl mx-auto px-4 flex justify-between items-center gap-4"> -->
  <div
    class="mx-auto py-2 px-4 sm:px-6 lg:px-8 flex justify-between items-center gap-4"
  >
    <div class="flex items-center gap-2">
      <i class="ri-phone-fill"></i><span>Teléfono: </span><a
        href="tel:+34666329155"
        class="hover:text-emerald-200 transition-colors">+34 666 329 155</a
      >
    </div>
    <div class="flex gap-3">
      <a
        target="_blank"
        href="https://www.facebook.com/scruzabogados"
        class="hover:text-emerald-200 transition-colors"
      >
        <i class="ri-facebook-fill w-5 h-5 flex items-center justify-center">
        </i>
      </a>
      <a
        target="_blank"
        href="https://www.instagram.com/scruzabogados/"
        class="hover:text-emerald-200 transition-colors"
      >
        <i class="ri-instagram-line w-5 h-5 flex items-center justify-center">
        </i>
      </a>
      <a
        target="_blank"
        href="https://www.linkedin.com/in/sergio-cruz-chac%C3%B3n-75ba7a26"
        class="hover:text-emerald-200 transition-colors"
        ><i class="ri-linkedin-fill w-5 h-5 flex items-center justify-center"
        ></i></a
      >
    </div>
  </div>
</div>
<header class="bg-base-100/90 shadow-lg sticky backdrop-blur-xl top-0 z-50">
  <nav class="mx-auto py-2 px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="">
        <a href="/" class="flex flex-col font-title">
          <span class="text-3xl leading-[25px] text-center text-primary">
            SCRUZ
          </span>
          <span class="text-lg text-center leading-4 block"> ABOGADOS </span>
        </a>
      </div>

      <div class="hidden md:block ml-10 mr-2 overflow-x-auto">
        <div class="flex items-baseline space-x-4">
          {
            DATA.sections.map(({ name, href }) => {
              const isActive = currentPath === href;
              return (
                <a
                  class={twJoin(
                    "px-3 py-2 rounded-md text-sm font-medium whitespace-nowrap cursor-pointer transition-colors",
                    isActive
                      ? "bg-primary text-primary-content"
                      : "text-gray-700 hover:bg-blue-50 hover:text-primary"
                  )}
                  href={href}
                  data-discover="true"
                >
                  {name}
                </a>
              );
            })
          }
        </div>
      </div>
      <div class="hidden md:block whitespace-nowrap">
        <!-- <div class="hidden lg:block"> -->
        <a
          class="btn btn-primary px-4 py-0 btn-sm text-sm font-medium transition-colors"
          href="tel:+34666329155"
          data-discover="true"
        >
          Consulta Gratuita</a
        >
      </div>
      <div class="md:hidden">
        <button
          id="menu-toggle"
          class="inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-primary hover:bg-blue-50 cursor-pointer"
          ><div class="w-6 h-6 flex items-center justify-center">
            <i class="ri-menu-line text-xl"></i>
          </div></button
        >
      </div>
    </div>
  </nav>
  <div
    id="mobile-menu"
    class="md:hidden border-t border-base-300 p-4 z-40 absolute bg-base-100 shadow-lg w-full transition-all duration-300 ease-in-out opacity-0 -translate-y-4 pointer-events-none hidden"
  >
    <div class="flex flex-col items-baseline">
      {
        DATA.sections.map(({ name, href }) => {
          const isActive = currentPath === href;
          return (
            <a
              class={twJoin(
                "px-3 py-2 rounded-md text-sm font-medium whitespace-nowrap cursor-pointer transition-colors",
                isActive
                  ? "bg-primary text-primary-content"
                  : "text-gray-700 hover:bg-blue-50 hover:text-primary"
              )}
              href={href}
              data-discover="true"
            >
              {name}
            </a>
          );
        })
      }
    </div>
  </div>
</header><script>
  const toggleButton = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  const openMenu = () => {
    mobileMenu.classList.remove("hidden", "pointer-events-none");
    setTimeout(() => {
      mobileMenu.classList.remove("opacity-0", "-translate-y-4");
    }, 10);
  };

  const closeMenu = () => {
    mobileMenu.classList.add(
      "opacity-0",
      "-translate-y-4",
      "pointer-events-none"
    );
    setTimeout(() => {
      mobileMenu.classList.add("hidden");
    }, 300); // Igual a duration-300
  };

  toggleButton.addEventListener("click", (event) => {
    event.stopPropagation(); // Evita que el click cierre inmediatamente
    if (mobileMenu.classList.contains("hidden")) {
      openMenu();
    } else {
      closeMenu();
    }
  });

  // Cerrar menú si se hace click fuera
  document.addEventListener("click", (event) => {
    if (
      !mobileMenu.contains(event.target) &&
      !toggleButton.contains(event.target) &&
      !mobileMenu.classList.contains("hidden")
    ) {
      closeMenu();
    }
  });
</script>
