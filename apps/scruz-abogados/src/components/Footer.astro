---
import { Image } from "astro:assets";
import ciceronImg from '../assets/ciceron.webp";

const { DATA } = Astro.props;
---

<footer
  class="bg-linear-to-b from-white to-gray-300 pb-40 pt-40"
  transition:name="footer"
>
  <div
    class="flex flex-col md:flex-row md:mx-auto md:justify-center md:gap-9 md:pb-8"
  >
    <div class="flex items-center justify-center py-8 md:py-0">
      <Image src={DATA.footer.logo} alt={DATA.footer.logo.alt} />
    </div>
    <div class="flex gap-2 flex-col items-center pb-8 md:pb-0">
      {DATA.footer.menu.map(({ label, href }) => <a href={href}>{label}</a>)}
    </div>
    <div class="flex flex-col items-center pb-8 md:pb-0 px-4 md:px-0">
      <div class="chat chat-start">
        <div class="chat-image avatar">
          <div class="w-15 rounded-full">
            <Image alt="" src={ciceronImg} />
          </div>
        </div>
        <div class="chat-header">
          Marco Tulio Cicerón
          <time class="text-xs opacity-50">106 a. C. – 43 a. C.</time>
        </div>
        <div class="chat-bubble bg-base-100">
          Donde hay sociedad, hay derecho
        </div>
        <div class="chat-footer opacity-50">De legibus y De re publica</div>
      </div>
    </div>
  </div>

  <div class="flex flex-col md:flex-row md:justify-center items-center gap-2">
    {DATA.footer.legal.map(({ label, href }) => <a href={href}>{label}</a>)}
  </div>
  <a
    rel="noopener noreferrer"
    href="https://www.linkedin.com/in/jose-antonio-aguilar-granados/"
    target="_blank"
    class="mt-6 block text-center w-full">Desarrollado por Jose Aguilar</a
  >
  <p class="text-center pt-3 px-4">
    &copy; <span id="year">2025</span> – Todos los derechos reservados | DESPACHO
    DE ABOGADOS SCRUZ
  </p>
  <script>
    const yearElem = document.getElementById("year");
    if (yearElem) {
      yearElem.textContent = String(new Date().getFullYear());
    }
  </script>
</footer>
