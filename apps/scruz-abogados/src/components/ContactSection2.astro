---
import { Image } from '@astro-components';
import { MailIcon, MapIcon, PhoneIcon } from '@astro-icons';

const { gmapsImg } = Astro.props;
---

<div class="flex flex-col gap-6 p-6 md:flex-row md:justify-center md:gap-16 md:p-16">
	<!-- <div class="container mx-auto py-12 px-4 flex flex-col gap-4"> -->

	<!-- <div class="container mx-auto py-12 px-4 flex flex-col gap-4"> -->
	<div class="flex flex-col">
		<div class="flex flex-col gap-4 pb-10">
			<p class="text-3xl font-bold">Cuéntanos tu caso en confianza</p>
			<p>
				Estamos aquí para ayudarte. Solicita tu consulta gratuita y descubre cómo podemos defender
				tus derechos.
			</p>
		</div>
		<div>
			<!-- <h3 class="text-2xl font-bold text-gray-900 mb-6">
          Información de Contacto
        </h3> -->
			<div class="space-y-6">
				<a
					target="_blank"
					rel="noopener noreferrer"
					href="https://maps.app.goo.gl/LbozAFjGe4kxjRuZA"
					class="flex items-start"
				>
					<div class="badge badge-soft badge-primary mr-4 h-12 w-12">
						<i class="ri-map-pin-line text-xl"></i>
					</div><div>
						<h4 class="mb-1 font-semibold text-gray-900">Dirección</h4><p class="text-gray-600">
							Calle El Agua, 19, 1º Izq., 14900 Lucena, Córdoba
						</p>
					</div>
				</a>
				<a
					target="_blank"
					rel="noopener noreferrer"
					href="tel:+34 666 329 155"
					class="flex items-start"
				>
					<div class="badge badge-soft badge-primary mr-4 h-12 w-12">
						<i class="ri-phone-line text-xl"></i>
					</div><div>
						<h4 class="mb-1 font-semibold text-gray-900">Teléfono</h4><p class="text-gray-600">
							957 117 185 / 666 329 155
						</p>
					</div>
				</a>
				<a
					target="_blank"
					rel="noopener noreferrer"
					href="mailto:info@scruzabogados.es?subject=Asunto%20del%20email&body=Texto%20del%20mensaje"
					class="flex items-start"
				>
					<div class="badge badge-soft badge-primary mr-4 h-12 w-12">
						<i class="ri-mail-line text-xl"></i>
					</div><div>
						<h4 class="mb-1 font-semibold text-gray-900">Email</h4><p class="text-gray-600">
							info@scruzabogados.es
						</p>
					</div>
				</a>
				<div class="flex items-start">
					<div class="badge badge-soft badge-primary mr-4 h-12 w-12">
						<i class="ri-time-line text-xl"></i>
					</div>
					<div>
						<h4 class="mb-1 font-semibold text-gray-900">Horario</h4><p class="text-gray-600">
							Lunes a Viernes: 9:00 - 18:00
						</p>
					</div>
				</div>
			</div>
		</div>
