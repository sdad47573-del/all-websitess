---
import { RiIcon } from '@astro-icons';

// eslint-disable-next-line no-empty-pattern
const {} = Astro.props;
---

<div class="flex flex-col gap-6 p-6 md:flex-row md:justify-center md:gap-16 md:p-16">
	<div class="reveal flex flex-col">
		<div class="flex flex-col gap-4 pb-10">
			<h2 class="text-3xl font-bold">Cuéntanos tu caso en confianza</h2>
			<p>
				Estamos aquí para ayudarte. Solicita tu consulta gratuita y descubre cómo podemos defender
				tus derechos.
			</p>
		</div>
		<div>
			<div class="space-y-6" data-reveal-stagger>
				<a
					target="_blank"
					rel="noopener noreferrer"
					href="https://maps.app.goo.gl/LbozAFjGe4kxjRuZA"
					class="reveal flex items-start"
				>
					<div class="badge badge-soft badge-primary mr-4 h-12 w-12">
						<RiIcon name="mapPin" class="size-5" />
					</div><div>
						<h3 class="mb-1 font-semibold text-gray-900">Dirección</h3><p class="text-gray-600">
							Calle El Agua, 19, 1º Izq., 14900 Lucena, Córdoba
						</p>
					</div>
				</a>
				<a
					target="_blank"
					rel="noopener noreferrer"
					href="tel:+34957118195"
					class="reveal flex items-start"
				>
					<div class="badge badge-soft badge-primary mr-4 h-12 w-12">
						<RiIcon name="phone" class="size-5" />
					</div><div>
						<h3 class="mb-1 font-semibold text-gray-900">Teléfono</h3><p class="text-gray-600">
							957 118 195 / <span class="font-semibold">666 329 155</span>
						</p>
					</div>
				</a>
				<a
					target="_blank"
					rel="noopener noreferrer"
					href="mailto:info@scruzabogados.es?subject=Consulta%20legal"
					class="reveal flex items-start"
				>
					<div class="badge badge-soft badge-primary mr-4 h-12 w-12">
						<RiIcon name="mail" class="size-5" />
					</div><div>
						<h3 class="mb-1 font-semibold text-gray-900">Email</h3><p class="text-gray-600">
							info@scruzabogados.es
						</p>
					</div>
				</a>
				<div class="reveal flex items-start">
					<div class="badge badge-soft badge-primary mr-4 h-12 w-12">
						<RiIcon name="time" class="size-5" />
					</div>
					<div>
						<h3 class="mb-1 font-semibold text-gray-900">Horario</h3><p class="text-gray-600">
							Lunes a viernes: 9:00 - 18:00
						</p>
					</div>
				</div>
			</div>
		</div>
		<div class="reveal-pop mt-8 flex flex-col gap-3 sm:flex-row">
			<a
				class="btn btn-primary btn-lg gap-2 sm:flex-1"
				href="tel:+34666329155"
				aria-label="Llamar ahora al 666 329 155"
			>
				<RiIcon name="phoneFill" class="size-5 shrink-0" />
				Llamar ahora
			</a>
			<a
				class="btn btn-outline btn-neutral btn-lg gap-2 sm:flex-1"
				href="https://wa.me/34666329155?text=Hola%2C%20quisiera%20realizar%20una%20consulta%20legal%2C%20%C2%BFpodr%C3%ADamos%20agendar%20una%20cita%3F"
				target="_blank"
				rel="noopener noreferrer"
			>
				<RiIcon name="whatsapp" class="size-5 shrink-0" />
				WhatsApp
			</a>
		</div>
	</div>
	<div data-mapa-fachada style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
		<button type="button" data-cargar-mapa aria-label="Cargar mapa interactivo" style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.6rem;width:100%;height:100%;min-height:300px;padding:1.5rem;border:0;background-color:#e9e5db;background-image:linear-gradient(#d8d2c4 1px,transparent 1px),linear-gradient(90deg,#d8d2c4 1px,transparent 1px);background-size:28px 28px;color:#2c2622;font:inherit;cursor:pointer;">
			<span aria-hidden="true"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg></span>
			<strong style="font-size:1rem;">Cargar mapa interactivo</strong>
			<small style="opacity:0.65;">Se carga solo al pulsar</small>
		</button>
<iframe
	 data-src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6338.5021012658535!2d-4.487424716949463!3d37.40754059899947!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd6d7100463548d7%3A0x8ddd019c9af14c71!2sAbogado%20Sergio%20Cruz%20Chac%C3%B3n!5e0!3m2!1ses!2sus!4v1761566280602!5m2!1ses!2sus"
		width="100%"
		class="reveal-pop h-96 max-w-[698px] self-center"
		height="100%"
		allowfullscreen=""
		loading="lazy"
		referrerpolicy="no-referrer-when-downgrade"
		title="Mapa de Lucena"
		style="border: 0px;"></iframe>
	</div>
</div>

<script>
// mapa-fachada: la URL del iframe vive en data-src y solo se asigna al pulsar (ahorra ~1MB de JS).
document.addEventListener('click', function (e) {
	var t = e.target && e.target.closest ? e.target.closest('[data-cargar-mapa]') : null;
	if (!t) return;
	var w = t.closest('[data-mapa-fachada]');
	if (!w || w.dataset.cargado) return;
	var f = w.querySelector('iframe');
	if (!f || !f.dataset.src || f.getAttribute('src')) return;
	w.dataset.cargado = '1';
	f.setAttribute('src', f.dataset.src);
	t.remove();
});
</script>
