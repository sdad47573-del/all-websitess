---
import { Image } from "astro:assets";
import MailIcon from "src/icons/MailIcon.astro";
import MapIcon from "src/icons/MapIcon.astro";
import PhoneIcon from "src/icons/PhoneIcon.astro";

const { gmapsImg } = Astro.props;
---

<div
  class="p-6 md:p-16 flex flex-col md:flex-row gap-6 md:gap-16 md:justify-center"
>
  <!-- <div class="container mx-auto py-12 px-4 flex flex-col gap-4"> -->

  <!-- <div class="container mx-auto py-12 px-4 flex flex-col gap-4"> -->
  <div class="flex flex-col">
    <div class="flex flex-col gap-4 pb-10">
      <p class="font-bold text-3xl">Cuéntanos tu caso en confianza</p>
      <p>
        Estamos aquí para ayudarte. Solicita tu consulta gratuita y descubre
        cómo podemos defender tus derechos.
      </p>
    </div>
    <div>
      <!-- <h3 class="text-2xl font-bold text-gray-900 mb-6">
          Información de Contacto
        </h3> -->
      <div class="space-y-6">
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://maps.app.goo.gl/LbozAFjGe4kxjRuZA"
          class="flex items-start"
        >
          <div class="w-12 h-12 mr-4 badge badge-soft badge-primary">
            <i class="ri-map-pin-line text-xl"></i>
          </div><div>
            <h4 class="font-semibold text-gray-900 mb-1">Dirección</h4><p
              class="text-gray-600"
            >
              Calle El Agua, 19, 1º Izq., 14900 Lucena, Córdoba
            </p>
          </div>
        </a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="tel:+34 666 329 155"
          class="flex items-start"
        >
          <div class="w-12 h-12 mr-4 badge badge-soft badge-primary">
            <i class="ri-phone-line text-xl"></i>
          </div><div>
            <h4 class="font-semibold text-gray-900 mb-1">Teléfono</h4><p
              class="text-gray-600"
            >
              957 117 185 / 666 329 155
            </p>
          </div>
        </a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="mailto:info@scruzabogados.es?subject=Asunto%20del%20email&body=Texto%20del%20mensaje"
          class="flex items-start"
        >
          <div class="w-12 h-12 mr-4 badge badge-soft badge-primary">
            <i class="ri-mail-line text-xl"></i>
          </div><div>
            <h4 class="font-semibold text-gray-900 mb-1">Email</h4><p
              class="text-gray-600"
            >
              info@scruzabogados.es
            </p>
          </div>
        </a>
        <div class="flex items-start">
          <div class="w-12 h-12 mr-4 badge badge-soft badge-primary">
            <i class="ri-time-line text-xl"></i>
          </div>
          <div>
            <h4 class="font-semibold text-gray-900 mb-1">Horario</h4><p
              class="text-gray-600"
            >
              Lunes a Viernes: 9:00 - 18:00
            </p>
          </div>
        </div>
      </div>
    </div>
    {
      // <div class="flex flex-col gap-7">
