---
const DATA = [
	{
		title: 'Fundación del Despacho',
		date: '2004',
		content: 'Inicio de actividad en Málaga, especializándose en Derecho Civil y de Familia.',
	},
	{
		title: 'Expansión a Córdoba',
		date: '2008',
		content: 'Apertura de oficina en Lucena para atender toda la provincia de Córdoba.',
	},
	{
		title: 'Incorporación Derecho Mercantil',
		date: '2015',
		content: 'Ampliación de servicios hacia empresas y derecho mercantil.',
	},
	{
		title: 'Oficina en Madrid',
		date: '2020',
		content: 'Expansión nacional con nueva sede en la capital.',
	},
	{
		title: 'Más de 20 años',
		date: '2024',
		content: 'Consolidación como referente en servicios jurídicos integrales.',
	},
];
---

<ul class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical mb-20">
	{
		DATA.map((item, idx) =>
			idx % 2 === 0 ? (
				<li>
					<div class="timeline-middle text-2xl">
						<i class="ri-focus-fill text-primary" />
					</div>
					<div class="timeline-start mb-10 flex w-full flex-col items-center md:items-end md:text-end">
						<div class="rounded-lg bg-white p-6 shadow-lg">
							<>
								<div class="text-primary mb-2 text-lg font-bold">{item.date}</div>
								<h3 class="mb-2 text-xl font-bold text-gray-900">{item.title}</h3>
								<p class="text-gray-600">{item.content}</p>
							</>
						</div>
					</div>
					<hr class="bg-blue-200" />
				</li>
			) : (
				<li>
					<hr class="bg-blue-200" />
					<div class="timeline-middle text-2xl">
						<i class="ri-focus-fill text-primary" />
					</div>
					<div class="timeline-end mb-10 flex w-full flex-col items-center md:items-start md:text-start">
						<div class="rounded-lg bg-white p-6 shadow-lg">
							<>
								<div class="text-primary mb-2 text-lg font-bold">{item.date}</div>
								<h3 class="mb-2 text-xl font-bold text-gray-900">{item.title}</h3>
								<p class="text-gray-600">{item.content}</p>
							</>
						</div>
					</div>
					<hr class="bg-blue-200" />
				</li>
			),
		)
	}
</ul>
