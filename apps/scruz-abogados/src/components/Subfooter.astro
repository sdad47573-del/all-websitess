---
import { DATA } from '../data/data';
---

<div class="bg-secondary text-secondary-content p-4 pb-20 md:px-16 md:pb-5">
	<div class="flex justify-center gap-4">
		{DATA.footer.legal.map(({ label, href }) => <a href={href}>{label}</a>)}
	</div>

	<!-- <a
      rel="noopener noreferrer"
      href="https://www.linkedin.com/in/jose-antonio-aguilar-granados/"
      target="_blank"
      class="mt-6 block text-center w-full">Desarrollado por Jose Aguilar</a
      > -->
	<p class="pt-3 text-center">
		&copy; <span id="year">2025</span> – Todos los derechos reservados | DESPACHO DE ABOGADOS SCRUZ
	</p>

	<script>
		const yearElem = document.getElementById('year');
		if (yearElem) {
			yearElem.textContent = String(new Date().getFullYear());
		}
	</script>
</div>
