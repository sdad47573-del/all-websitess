---
// Sección "Guías del blog" para páginas de servicio: muestra los artículos del
// blog que enlazan a este servicio (derivados de BLOG_RELATED_SERVICES, la
// fuente única), con título, categoría y tiempo de lectura.
// El slug del servicio se deriva de la URL actual (/derecho-civil/ → derecho-civil).
//
// Las guías relacionadas van SIEMPRE primero; si no llegan a tres, la rejilla se
// completa con otras guías del blog (misma categoría primero, después las más
// recientes). Sin ese relleno, páginas con un solo enlace entrante pintaban una
// tarjeta suelta en una rejilla de tres columnas (/servicios/, /trayectoria/,
// /abogados-en-lucena/, /seguros-agrarios/…).
import { ArrowRight, Clock, FileText } from '@lucide/astro';
import { BLOG_POSTS } from '../data/BLOG_POSTS';
import { SERVICE_BLOG_POSTS } from '../data/blogInternalLinks';

// Encabezado opcional: las páginas que no son fichas de servicio (por ejemplo
// el hub /ubicaciones/) ajustan el rótulo sin duplicar la sección.
interface Props {
	supertitle?: string;
	title?: string;
}

const { supertitle = 'Blog jurídico', title } = Astro.props as Props;

/** Mínimo de tarjetas para que la rejilla no quede coja en `lg` (3 columnas). */
const MIN_CARDS = 3;

// Ruta completa sin barras ('/empresas/derecho-laboral/' → 'empresas/derecho-laboral'),
// no solo el último segmento: las fichas hijas (/empresas/…/, /blog/…/) se
// registran en SERVICE_BLOG_POSTS con su ruta completa y con el último segmento
// solo se quedarían sin guías.
const serviceSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const related = (SERVICE_BLOG_POSTS[serviceSlug] ?? [])
	.map((href) => BLOG_POSTS.find((post) => post.href === href))
	.filter((post): post is NonNullable<typeof post> => Boolean(post));

const relatedHrefs = new Set(related.map((post) => post.href));
const primaryCategory = related[0]?.category;

// Relleno: BLOG_POSTS ya viene de más reciente a más antigua y `sort` es
// estable, así que basta con subir delante la misma categoría de la guía
// relacionada para conservar el orden cronológico dentro de cada grupo (misma
// regla que "Más guías legales del blog" en RelatedServices.astro).
const fillers = BLOG_POSTS.filter((post) => !relatedHrefs.has(post.href))
	.sort((a, b) => {
		const aSame = a.category === primaryCategory ? 0 : 1;
		const bSame = b.category === primaryCategory ? 0 : 1;
		return aSame - bSame;
	})
	.slice(0, Math.max(0, MIN_CARDS - related.length));

const cards = [...related.slice(0, MIN_CARDS), ...fillers];
// Relacionadas que no caben como tarjeta: siguen listadas como enlace debajo.
const rest = related.slice(MIN_CARDS);

// El rótulo solo dice "relacionadas con este servicio" cuando de verdad todas lo
// están; si hay relleno, se anuncia como lo que es: guías del blog jurídico.
const finalTitle =
	title ?? (fillers.length > 0 ? 'Guías del blog jurídico' : 'Guías relacionadas con este servicio');
---

{
	// El bloque sigue dependiendo de que la página tenga guías relacionadas: el
	// relleno completa la rejilla, no inventa una sección donde no toca.
	related.length > 0 && (
		<section class="bg-base-200 px-6 py-16 md:px-16 md:py-24">
			<div class="mx-auto max-w-6xl">
				<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
					<div class="reveal-pop max-w-2xl">
						<p class="eyebrow">{supertitle}</p>
						<h2 class="font-title text-3xl font-bold leading-tight md:text-4xl lg:text-5xl">
							{finalTitle}
						</h2>
					</div>
					<a
						href="/blog/"
						class="reveal-pop text-primary inline-flex items-center gap-2 font-semibold transition-colors hover:text-primary/80"
						data-discover="true"
					>
						Ver todas las guías <ArrowRight class="size-4" />
					</a>
				</div>

				<!--
					Dos columnas en tablet, tres solo desde `lg`. A 768 px el contenedor
					(max-w-6xl con px-16) deja 640 px: con tres columnas cada tarjeta caía a
					192 px y, con el p-8, el texto se quedaba en 126 px, así que los títulos
					largos rompían en 10 líneas y se desbordaban hasta +38 px ("los
					administradores de una…").
				-->
				<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
					{
						cards.map((post) => (								<a
								href={post.href}
								class="card-surface reveal-pop hover:-translate-y-1 flex flex-col rounded-2xl p-8"
								data-discover="true"
							>
								<div class="mb-6 flex items-center justify-between">
									<span class="text-primary inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-sm font-semibold">
										<FileText class="size-4" /> {post.category}
									</span>
								</div>
								<h3 class="font-title mb-3 flex-1 text-xl font-bold">{post.title}</h3>
								<p class="mb-6 text-base-content/70">{post.description}</p>
								<div class="mt-auto flex items-center justify-between border-t border-base-300 pt-4 text-sm text-base-content/60">
									<span class="inline-flex items-center gap-1"><Clock class="size-4" /> {post.readTime} lectura</span>
									<span class="inline-flex items-center gap-1">
										Leer guía <ArrowRight class="size-4" />
									</span>
								</div>
							</a>
						))
					}
				</div>

				{
					rest.length > 0 && (
						<ul class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
							{rest.map((post) => (
								<li>
									<a
										href={post.href}
										class="group inline-flex items-center gap-2 font-semibold text-primary transition-colors hover:text-primary/80"
										data-discover="true"
									>
										<ArrowRight
											class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
										/>
										{post.title}
									</a>
								</li>
							))}
						</ul>
					)
				}
			</div>
		</section>
	)
}