---
const { title, description, background } = Astro.props;
---

<section
	class="relative bg-cover bg-center bg-no-repeat py-24"
	style={`background-image: linear-gradient(rgba(74, 109, 158, 0.8),rgba(74, 109, 158, 0.6)), url(${background});`}
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="text-center text-white">
			<h1 class="mb-6 text-4xl font-bold md:text-5xl">{title}</h1><p
				class="mx-auto max-w-3xl text-xl"
			>
				{description}
			</p>
		</div>
	</div>
</section>
