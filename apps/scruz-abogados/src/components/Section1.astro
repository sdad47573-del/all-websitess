---
import { Image } from "astro:assets";

const { rellenoImg, title, description, titleList, list, buttonLabel } =
  Astro.props;
---

<div class="card lg:card-side bg-base-100 rounded-none">
  <div class="card-body px-6 md:p-16 overflow-hidden">
    <h2 class="card-title text-3xl pb-7">
      {title}
    </h2>
    <div class="flex flex-col gap-2">
      <p class="pb-4">
        {description}
      </p>
      <p
        class="font-bold opacity-80 animate__animated"
        data-animate="animate__backInLeft"
      >
        {titleList}
      </p>
      <ul class="flex flex-col gap-2 list-disc pl-4">
        {
          list.map(({ title, description }, idx) => (
            <li
              class={`animate__animated animate__fast animate__delay-${idx + 1}s`}
              data-animate={
                idx % 2 === 0 ? "animate__backInRight" : "animate__backInLeft"
              }
            >
              <h3>
                <span class="font-bold opacity-80">{title}</span> {description}
              </h3>
            </li>
          ))
        }
      </ul>
    </div>
    <a
      href="/servicios"
      class="btn btn-neutral mt-6
    animate__animated animate__delay-6s"
      data-animate="animate__bounceIn">{buttonLabel}</a
    >
  </div>
  <figure class="w-full md:w-[110%]">
    <Image
      src={rellenoImg}
      alt="Abogado en Lucena ofreciendo asesoramiento legal integral"
      loading="eager"
      decoding="async"
    />
  </figure>
</div>
