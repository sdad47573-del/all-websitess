---
import { Image } from 'astro:assets';

const { rellenoImg, title, description, titleList, list, buttonLabel } = Astro.props;
---

<div class="card lg:card-side bg-base-100 rounded-none">
	<div class="card-body overflow-hidden px-6 md:p-16">
		<h2 class="card-title pb-7 text-3xl">
			{title}
		</h2>
		<div class="flex flex-col gap-2">
			<p class="pb-4">
				{description}
			</p>
			<p class="animate__animated font-bold opacity-80" data-animate="animate__backInLeft">
				{titleList}
			</p>
			<ul class="flex list-disc flex-col gap-2 pl-4">
				{
					list.map(({ title, description }, idx) => (
						<li
							class={`animate__animated animate__fast animate__delay-${idx + 1}s`}
							data-animate={idx % 2 === 0 ? 'animate__backInRight' : 'animate__backInLeft'}
						>
							<h3>
								<span class="font-bold opacity-80">{title}</span> {description}
							</h3>
						</li>
					))
				}
			</ul>
		</div>
		<a
			href="/servicios"
			class="btn btn-neutral animate__animated animate__delay-6s mt-6"
			data-animate="animate__bounceIn">{buttonLabel}</a
		>
	</div>
	<figure class="w-full md:w-[110%]">
		<Image
			src={rellenoImg}
			alt="Abogado en Lucena ofreciendo asesoramiento legal integral"
			loading="eager"
			decoding="async"
		/>
	</figure>
</div>
