# Google Cloud OAuth 2.0 client for the local Search Console CLI.
# Never commit a real .env file or paste these values into the frontend.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=

# Defaults to the verified URL-prefix property used by this project.
GOOGLE_SEARCH_CONSOLE_PROPERTY=https://sergiocruzchacon.vercel.app/

# Must match the redirect URI registered in Google Cloud OAuth credentials.
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=http://127.0.0.1:43117/oauth2callback

# Optional. Defaults to the OS user config directory, outside this repository.
# GOOGLE_SEARCH_CONSOLE_TOKEN_FILE=

# Optional. Defaults to read-write scope so `sitemaps submit` works:
#   https://www.googleapis.com/auth/webmasters
# Set to https://www.googleapis.com/auth/webmasters.readonly for query-only use.
# GOOGLE_SEARCH_CONSOLE_SCOPE=https://www.googleapis.com/auth/webmasters
