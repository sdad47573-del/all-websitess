{
  "extends": "astro/tsconfigs/strict",
  "include": ["env.d.ts", ".astro/types.d.ts", "**/*"],
  "compilerOptions": {
    "types": ["astro/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./src/@assets/*"],
      "@astro-icons": ["./src/@astro-icons"],
      "@astro-icons/*": ["./src/@astro-icons/*"],
      "@astro-components": ["./src/@astro-components"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
