---
const business = {
	name: 'Restaurante La Rusticana',
	street: 'Carretera de Atamaría, 76',
	city: 'Cartagena',
	region: 'Murcia',
	postalCode: '30389',
	country: 'ES',
	phone: '+34 968 137 258',
	latitude: 37.6054947,
	longitude: -0.8093213,
	site: 'https://restaurante-la-rusticana.netlify.app',
};

const mapsUrl = 'https://www.google.com/maps/place/Restaurante+La+Rusticana/@37.6054947,-0.8093213,17z/data=!3m1!4b1!4m6!3m5!1s0xd633d12ce421f65:0xd16ddc797a6b3f51!8m2!3d37.6054947!4d-0.8093213!16s%2Fg%2F1tcxfk15?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34968137258';
const siteUrl = `${business.site}/`;
const description = 'Restaurante La Rusticana en Ctra. de Atamaría, 76 (La Manga Club, Cartagena). Cocina italiana y mediterránea junto al golf, con 4,0★. Teléfono 968 137 258 y fotos.';

const faqs = [
	{
		question: '¿Dónde está el Restaurante La Rusticana?',
		answer: 'El Restaurante La Rusticana se encuentra en Carretera de Atamaría, 76, 30389 Cartagena (Murcia), junto al campo de golf de La Manga Club. Abre las indicaciones de Google Maps para consultar el trayecto.',
	},
	{
		question: '¿Cuál es el teléfono de La Rusticana?',
		answer: 'El teléfono publicado del Restaurante La Rusticana es el 968 137 258. Llama directamente para reservar mesa, consultar disponibilidad y horario actualizado.',
	},
	{
		question: '¿Qué tipo de comida sirven?',
		answer: 'Cocina italiana y mediterránea: pizza, pasta y platos europeos, a un paso del golf de La Manga Club. La carta puede cambiar; consúltala directamente con el establecimiento.',
	},
	{
		question: '¿Cuál es el horario de apertura?',
		answer: 'El horario puede variar según el día y la temporada. Llama al 968 137 258 o revisa la ficha de Google Maps antes de ir para confirmar la apertura del día.',
	},
	{
		question: '¿Dónde puedo ver fotos del restaurante?',
		answer: 'En esta página tienes una galería con fotos de la ficha de La Rusticana en Google Maps, y puedes abrir la ficha completa para ver más fotos y las reseñas.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${siteUrl}#restaurant`,
	name: business.name,
	description,
	url: siteUrl,
	telephone: business.phone,
	servesCuisine: ['Italiana', 'Pizza', 'Mediterránea'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: business.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};

import { Image } from 'astro:assets';
import Galeria from '../components/Galeria.astro';
import heroImage from '../assets/fotos/restaurante-la-rusticana-apaisada-01.jpg';---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#572a1a" />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet" />
		<title>Restaurante La Rusticana en La Manga | Italiano junto al golf</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Restaurante La Rusticana · Italiano en La Manga Club" />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${business.site}/og.svg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Restaurante La Rusticana, italiano junto al golf" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.region" content="ES-MU" />
		<meta name="geo.placename" content="Cartagena" />
		<meta name="geo.position" content="37.6054947;-0.8093213" />
		<meta name="ICBM" content="37.6054947, -0.8093213" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante La Rusticana, inicio"><span class="brand-mark" aria-hidden="true">R</span><span>La Rusticana<small>Italiano · La Manga</small></span></a>
			<nav aria-label="Navegación principal"><a href="#restaurante">El restaurante</a><a href="#fotos">Fotos</a><a href="#visita">Cómo llegar</a></nav>
			<a class="header-call" href={phoneHref}>Llamar · 968 137 258</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>La Manga Club · Cartagena</span><i aria-hidden="true"></i> Italiano y mediterráneo</p>
					<h1>Italia<br />junto <em>al green.</em></h1>
					<p class="lede">La Rusticana es un restaurante italiano junto al campo de golf de La Manga Club. Pizza, pasta y cocina mediterránea en Ctra. de Atamaría, 76. Con 4,0★ en Google Maps.</p>
					<div class="actions"><a class="button button-gold" href={phoneHref}>Llamar al restaurante <span aria-hidden="true">↗</span></a><a class="button button-outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a></div>
					<div class="hero-details"><span>⌖ Atamaría, 76 · Junto al golf</span><span>✦ Pizza · pasta · mediterráneo</span></div>
				</div>
				<figure class="hero-photo">
					<Image src={heroImage} alt="Fotografía del Restaurante La Rusticana en La Manga Club, publicada en su ficha de Google Maps" widths={[640, 960, 1280]} sizes="(max-width: 720px) 100vw, 47vw" format="avif" quality={70} loading="eager" fetchpriority="high" decoding="async" />
					<figcaption>La Rusticana · La Manga</figcaption>
				</figure>
			</section>

			<div class="ticker" aria-label="Restaurante La Rusticana en La Manga"><span>Restaurante La Rusticana</span><b>✳</b><span>Cocina italiana</span><b>✳</b><span>La Manga Club</span><b>✳</b><span>Pizza y mediterráneo</span></div>

			<section class="intro section-wrap" id="restaurante"><div><p class="eyebrow eyebrow-dark">Junto al golf de La Manga</p><h2>Masa, horno<br /><em>y mediterráneo.</em></h2></div><div class="intro-copy"><p>El Restaurante La Rusticana está en Carretera de Atamaría, 76, a un paso del campo de golf de La Manga Club. Las guías lo describen como un italiano familiar de cocina mediterránea y europea, parada habitual antes o después del golf.</p><p>¿Vas a acercarte? Llama para reservar mesa y comprobar horario y carta. La información puede variar según el día.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Consultar la ficha y reseñas en Google Maps ↗</a></div></section>

			<section class="specialties section-wrap" aria-labelledby="specialties-title"><div class="section-heading"><p class="eyebrow eyebrow-dark">El plan: mesa italiana</p><h2 id="specialties-title">Una mesa para<br /><em>compartir al centro.</em></h2><p>Una forma sencilla de disfrutar de la cocina italiana junto al golf. Consulta la selección y disponibilidad directamente con La Rusticana.</p></div>
				<div class="special-grid">
					<article class="special-card"><span class="special-icon" aria-hidden="true">❋</span><span class="card-kicker">AL HORNO</span><h3>Pizza</h3><p>Pizzas de masa fina para compartir, al estilo italiano de siempre.</p></article>
					<article class="special-card card-olive"><span class="special-icon" aria-hidden="true">◉</span><span class="card-kicker">DE LA CASA</span><h3>Pasta y frescos</h3><p>Pasta y platos frescos de cocina mediterránea y europea.</p></article>
					<article class="special-card card-terracotta"><span class="special-icon" aria-hidden="true">♨</span><span class="card-kicker">JUNTO AL GOLF</span><h3>Terraza mediterránea</h3><p>El alto en el camino perfecto entre partido y partido de golf.</p></article>
				</div><p class="menu-note">Esta descripción se basa en guías públicas del establecimiento; no sustituye a la carta vigente. Consulta platos, alérgenos y precios directamente con el restaurante.</p>
			</section>

			<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">La Rusticana en Google Maps</p><h2>Abre la ficha.<br />Mira sus <em>fotos.</em></h2><p>Descubre las imágenes del restaurante en Google Maps y consulta las reseñas y datos publicados por el establecimiento y sus visitantes.</p><a class="button button-gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps <span aria-hidden="true">↗</span></a><p class="photo-note">Una selección de esas fotos, servida optimizada, en la galería de abajo.</p></div>
				<div class="map-photo"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Google del Restaurante La Rusticana, Atamaría, La Manga" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
					<noscript>
						<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
					</noscript>
				</div><a class="map-caption" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌖</span><span><b>Restaurante La Rusticana</b><small>Atamaría, 76 · Ver ficha y fotos ↗</small></span></a></div>
			</section>

			<section class="visit section-wrap" id="visita"><div class="visit-copy"><p class="eyebrow eyebrow-dark">A un paso del golf</p><h2>Nos encontramos<br /><em>en La Rusticana.</em></h2><p>El restaurante está en la carretera de Atamaría, junto al resort de golf de La Manga Club. Abre indicaciones para calcular la ruta y llama si necesitas confirmar el horario o reservar.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button button-dark" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 968 137 258</a></div></div>
				<div class="visit-card"><div class="visit-title"><span class="visit-icon" aria-hidden="true">⌖</span><div><p class="eyebrow eyebrow-dark">Ubicación y contacto</p><h3>La Manga Club</h3></div></div><dl><div><dt>Dirección</dt><dd>Carretera de Atamaría, 76<br />30389 Cartagena</dd></div><div><dt>Teléfono</dt><dd><a href={phoneHref}>968 137 258</a></dd></div><div><dt>Horario</dt><dd>Consulta la ficha o<br />confirma por teléfono</dd></div></dl><p class="visit-note">Parada ideal antes o después del golf. Llama antes de ir para confirmar la apertura.</p><a class="visit-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Abrir ficha de Google Maps ↗</a></div>
			</section>

			<section class="faq-section section-wrap" id="preguntas"><p class="eyebrow eyebrow-dark">Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
			<Galeria nombre="Restaurante La Rusticana" mapsUrl={mapsUrl} />
		</main>

		<footer class="footer"><div class="footer-top"><a class="brand footer-brand" href="#inicio"><span class="brand-mark" aria-hidden="true">R</span><span>La Rusticana<small>Italiano · La Manga</small></span></a><p>Pizza y mediterráneo<br />junto al golf.</p><nav aria-label="Enlaces del Restaurante La Rusticana"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={phoneHref}>968 137 258</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Restaurante La Rusticana · Cartagena</span><a href="/aviso-legal/">Aviso legal y privacidad</a> <a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> <span>Confirma horario, carta y disponibilidad con el establecimiento.</span></div>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>
		<a class="mobile-call" href={phoneHref}>Llamar <span>968 137 258</span></a>
	</body>
</html>

<style is:global>
	:root{font-family:'DM Sans',sans-serif;color:#2c231b;background:#f7f3e9;font-synthesis:none;text-rendering:optimizeLegibility;--wine:#572a1a;--wine-light:#7a4a28;--gold:#e0a458;--cream:#f7f3e9;--ink:#2c231b;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid #e0a458;outline-offset:4px}.skip-link{position:absolute;z-index:99;top:-60px;left:16px;padding:12px 16px;background:var(--gold);color:var(--wine)}.skip-link:focus{top:12px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:22px;background:var(--wine);color:#fcf8ef}.brand{display:flex;align-items:center;gap:11px;font-size:15px;font-weight:700}.brand small{display:block;margin-top:4px;color:#e1d4c5;font-size:9px;font-weight:500;letter-spacing:1.5px;text-transform:uppercase}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#e5c98c;font:700 23px var(--display)}.topbar nav{display:flex;gap:clamp(14px,2.5vw,32px);color:#f0e6dc;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#e5c98c}.header-call{padding:11px 17px;border:1px solid #ffffff55;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.05fr .95fr;min-height:560px;background:var(--wine);color:#fcf8ef;overflow:hidden}.hero-copy{padding:73px 4vw 64px 9vw;align-self:center}.eyebrow{margin:0 0 19px;color:#e0c78c;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase}.eyebrow i{display:inline-block;width:22px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.section-heading h2,.photo-copy h2,.visit h2,.faq-section h2{margin:0;font:600 clamp(39px,4.8vw,64px)/1.08 var(--display);letter-spacing:-1.2px}.hero h1 em,.intro h2 em,.section-heading h2 em,.photo-copy h2 em,.visit h2 em,.faq-section h2 em{color:var(--gold);font-style:italic}.lede{max-width:475px;margin:24px 0 0;color:#e9ded3;font-size:14px;line-height:1.85}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:27px}.button{display:inline-flex;min-height:47px;align-items:center;justify-content:center;gap:14px;padding:0 20px;border-radius:99px;font-size:12px;font-weight:700;transition:transform .18s ease}.button:hover{transform:translateY(-2px)}.button-gold{background:var(--gold);color:var(--wine)}.button-outline{border:1px solid #ffffff65;color:#fcf8ef}.hero-details{display:flex;flex-wrap:wrap;gap:12px 22px;margin-top:27px;padding-top:20px;border-top:1px solid #ffffff2a;color:#e1d3c5;font-size:10px}.hero-details span:first-child{color:#e8cc91}.hero-photo{position:relative;margin:0;min-height:560px;overflow:hidden;background:#2e1408}.hero-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-photo figcaption{position:absolute;right:12px;bottom:12px;padding:8px 14px;border-radius:99px;background:#000000aa;color:#fcf8ef;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase}.ticker{display:flex;min-height:54px;align-items:center;justify-content:center;gap:clamp(12px,4vw,52px);padding:10px 5vw;background:var(--gold);color:var(--wine);font:600 13px var(--display)}.ticker b{font-size:12px}.section-wrap{padding:88px 9vw}.intro{display:grid;grid-template-columns:1fr .85fr;gap:9%;align-items:center;background:var(--cream)}.eyebrow-dark{margin-bottom:16px;color:#8a7355}.intro h2,.section-heading h2,.visit h2,.faq-section h2{font-size:clamp(34px,4vw,50px);color:var(--wine)}.intro h2 em,.section-heading h2 em,.visit h2 em,.faq-section h2 em{color:#b0442a}.intro-copy p,.section-heading>p,.visit-copy>p:not(.eyebrow){color:#716760;font-size:14px;line-height:1.85}.intro-copy p{margin:0 0 14px}.text-link{display:inline-block;padding-bottom:4px;border-bottom:1px solid #b0442a;color:#7a4a28;font-size:12px;font-weight:700}.specialt