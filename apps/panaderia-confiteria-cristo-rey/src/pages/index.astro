---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import fachada from '../assets/fotos/panaderia-confiteria-cristo-rey-apaisada-01.jpg';
import vitrinaBolleria from '../assets/fotos/panaderia-confiteria-cristo-rey-apaisada-02.jpg';
import vitrinaTartas from '../assets/fotos/panaderia-confiteria-cristo-rey-apaisada-03.jpg';
import vitrinaDulces from '../assets/fotos/panaderia-confiteria-cristo-rey-apaisada-04.jpg';
import tartasBolleria from '../assets/fotos/panaderia-confiteria-cristo-rey-apaisada-05.jpg';
import fantasmas from '../assets/fotos/panaderia-confiteria-cristo-rey-vertical-06.jpg';
import tartaHojaldre from '../assets/fotos/panaderia-confiteria-cristo-rey-apaisada-07.jpg';
import vitrinaTrenzas from '../assets/fotos/panaderia-confiteria-cristo-rey-apaisada-08.jpg';
import tartaCumple from '../assets/fotos/panaderia-confiteria-cristo-rey-vista-9-09.jpg';
import escaparate from '../assets/fotos/panaderia-confiteria-cristo-rey-vertical-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Confitería Cristo Rey · Bailén-Miraflores, Málaga';
const description =
	'Panadería Confitería Cristo Rey, en la Rotonda de Suárez, 1 (Bailén-Miraflores, 29011 Málaga). Pan artesano, bollería, empanadas, dulces y pasteles, con cafetería. Abre todos los días de 8:00 a 22:00. Teléfono 635 38 40 85.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada de la Panadería Confitería Cristo Rey en la Rotonda de Suárez, con el rótulo negro y dorado y el escaparate iluminado',
	},
	{
		src: vitrinaBolleria,
		alt: 'Mostrador con bandejas de trenzas, napolitanas, palmeras y pastas de la panadería',
	},
	{
		src: vitrinaTartas,
		alt: 'Vitrina de tartas y pasteles con nata, chocolate y fruta',
	},
	{
		src: vitrinaDulces,
		alt: 'Vitrina de dulces con bombones, tartas y huevos de chocolate',
	},
	{
		src: tartasBolleria,
		alt: 'Tartas de cumpleaños y bandejas de bollería en el escaparate de la confitería',
	},
	{
		src: fantasmas,
		alt: 'Fantasmas de chocolate blanco y negro en el escaparate de Halloween',
	},
	{
		src: tartaHojaldre,
		alt: 'Tarta de hojaldre con relleno de mermelada y coco rallado sobre un plato rojo',
	},
	{
		src: vitrinaTrenzas,
		alt: 'Vitrina con tartas, pasteles y trenzas de bollería',
	},
	{
		src: tartaCumple,
		alt: 'Tarta de cumpleaños con las velas 53 y detalles de chocolate',
	},
	{
		src: escaparate,
		alt: 'Escaparate nocturno de la confitería decorado con globos y corazones rojos',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#cristo-rey`,
	name: BUSINESS.name,
	alternateName: ['Cristo Rey', 'Panadería Cristo Rey Málaga', 'Confitería Cristo Rey'],
	description:
		'Panadería y confitería en la Rotonda de Suárez, 1 (Bailén-Miraflores, 29011 Málaga). Pan artesano, bollería, empanadas, dulces y pasteles, con cafetería.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 635 38 40 85',
	currenciesAccepted: 'EUR',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '08:00',
			closes: '22:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"panaderia-confiteria-cristo-rey-apaisada-01.jpg": fachada,
	"panaderia-confiteria-cristo-rey-apaisada-02.jpg": vitrinaBolleria,
	"panaderia-confiteria-cristo-rey-apaisada-03.jpg": vitrinaTartas,
	"panaderia-confiteria-cristo-rey-apaisada-04.jpg": vitrinaDulces,
	"panaderia-confiteria-cristo-rey-apaisada-05.jpg": tartasBolleria,
	"panaderia-confiteria-cristo-rey-vertical-06.jpg": fantasmas,
	"panaderia-confiteria-cristo-rey-apaisada-07.jpg": tartaHojaldre,
	"panaderia-confiteria-cristo-rey-apaisada-08.jpg": vitrinaTrenzas,
	"panaderia-confiteria-cristo-rey-vista-9-09.jpg": tartaCumple,
	"panaderia-confiteria-cristo-rey-vertical-10.jpg": escaparate,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2a1c14" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Confitería Cristo Rey, panadería Málaga, confitería Bailén-Miraflores, pan artesano Málaga, empanadas Málaga, pasteles Málaga, cafetería Bailén-Miraflores, Rotonda de Suárez"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan artesano, bollería, empanadas, dulces y pasteles en la Rotonda de Suárez, 1, en Bailén-Miraflores (Málaga). Todos los días de 8:00 a 22:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de la Panadería Confitería Cristo Rey en la Rotonda de Suárez, Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2a1c14"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Cristo Rey"
			subtitle="Panadería · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografías de la ficha pública de Google Maps. Sin carta ni precios publicados por el establecimiento."
			ctaLabel="Llamar a Cristo Rey"
			navAriaLabel="Enlaces de la Panadería Confitería Cristo Rey"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34635384085?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20M%C3%A1laga." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Málaga"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
