---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import arrozNegro from '../assets/fotos/cafeteria-bar-molina-panoramica-10.jpg';
import fachada from '../assets/fotos/cafeteria-bar-molina-vertical-01.jpg';
import salmorejoCuenco from '../assets/fotos/cafeteria-bar-molina-vertical-02.jpg';
import salmorejoCazuela from '../assets/fotos/cafeteria-bar-molina-vertical-03.jpg';
import boquerones from '../assets/fotos/cafeteria-bar-molina-vertical-04.jpg';
import barra from '../assets/fotos/cafeteria-bar-molina-vertical-05.jpg';
import torreznos from '../assets/fotos/cafeteria-bar-molina-vista-6-06.jpg';
import tartaNata from '../assets/fotos/cafeteria-bar-molina-vertical-07.jpg';
import tartaChocolate from '../assets/fotos/cafeteria-bar-molina-apaisada-08.jpg';
import pescado from '../assets/fotos/cafeteria-bar-molina-vertical-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, RATING, SERVICIOS } from '../data/site';

const title = 'Cafetería-Bar Molina · comida casera y manchega en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: salmorejoCazuela,
		alt: 'Salmorejo servido en cazuela de barro sobre la mesa, con pan y botellas alrededor',
	},
	{
		src: salmorejoCuenco,
		alt: 'Cuenco de salmorejo con huevo y jamón picados por encima, en un plato blanco',
	},
	{
		src: boquerones,
		alt: 'Boquerones fritos en un plato blanco con ensalada, zanahoria y gajo de limón',
	},
	{
		src: barra,
		alt: 'Barra de madera con dos cañas de cerveza, una tapa de carne con pan y una cazuela de salmorejo',
	},
	{
		src: torreznos,
		alt: 'Plato de torreznos fritos, dorados y crujientes, con aceite en el fondo',
	},
	{
		src: pescado,
		alt: 'Rodaja de pescado a la plancha con ensalada, maíz, zanahoria y limón',
	},
	{
		src: tartaNata,
		alt: 'Tarta helada de nata y chocolate con nata montada y caramelo, en un plato blanco',
	},
	{
		src: tartaChocolate,
		alt: 'Porción de tarta de chocolate con salsa de chocolate caliente por encima',
	},
	{
		src: fachada,
		alt: 'Fachada de la Cafetería-Bar Molina en la calle Morería, con el rótulo y la barra junto a la puerta',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#cafeteria-bar-molina`,
	name: BUSINESS.name,
	alternateName: ['Bar Molina Ciudad Real', 'Cafetería Molina', 'Molina Morería'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina manchega', 'Cocina castellana', 'Comida casera', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '09:30',
			closes: '17:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17130f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Cafetería-Bar Molina Ciudad Real, bar Molina calle Morería, comida casera Ciudad Real, cocina manchega Ciudad Real, tapas centro Ciudad Real, salmorejo Ciudad Real, boquerones, arroz negro, bar 13002"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera y manchega en la calle Morería, 7, de Ciudad Real. Tapas, salmorejo, arroces y guisos, de 9:00 a 17:00 de lunes a sábado. 4,4 sobre 5 con 482 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Arroz negro con calamar de la Cafetería-Bar Molina"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17130f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[arrozNegro]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Comida casera y manchega"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Comida casera, <br /><em>de aquí.</em>"
				lede={`La Cafetería-Bar Molina está en la calle Morería, 7, en el centro de Ciudad Real. Comida casera y manchega —salmorejo, boquerones, torreznos, arroces y guisos— servida en la barra y en la mesa, de 9:00 a 17:00. La ficha de Google le da 4,4 sobre 5 con 482 reseñas.`}
				image={arrozNegro}
				imageAlt="Arroz negro con calamar y alioli servido en un plato hondo de la Cafetería-Bar Molina"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,4</b> en Google · 482 reseñas' },
					{
						label: 'Horario',
						html: '<b>9:00–17:00</b><br />Lunes a viernes · sábado 9:30–17:00 · domingo cerrado',
					},
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> mesa y encargos` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de la Cafetería-Bar Molina" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Una casa <br /><em>manchega.</em>"
				paragraphs={[
					'El Molina ocupa el bajo de un edificio de ladrillo en la calle Morería, 7, con el rótulo «Cafetería-Bar MOLINA» sobre la puerta y una barra alta junto a la entrada, en la misma acera del centro de Ciudad Real. Google lo clasifica como restaurante de cocina castellana y cafetería.',
					'La casa lo resume en su ficha con cuatro palabras: «Comida casera y manchega». Es lo que sale de la cocina y lo que se ve en las fotos del perfil: salmorejo con huevo y jamón, boquerones fritos, torreznos, arroz negro con calamar, pescado y carne a la plancha, y postres de tarta helada y chocolate.',
					'La barra es la otra mitad del negocio. Una de las reseñas lo dice así: «Excelente lugar para tomar el aperitivo acompañado de buena gente y buenas tapas». Otra apunta al trato: «Muy buenos chicos, amables y buena comida, para repetir mucho».',
					'El horario es de comidas: de 9:00 a 17:00 de lunes a viernes, el sábado desde las 9:30 y el domingo cerrado. La ficha marca acceso y asientos adaptados para sillas de ruedas, aclara que no hay aparcamiento adaptado y no publica web propia.',
				]}
				note="Los datos salen de la ficha pública de Google Maps, de las reseñas destacadas y de las fotos del perfil. La carta con precios no está publicada: si algo cambia, manda lo que digan en el mostrador o por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el bar en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Salmorejo, arroces <br /><em>y barra.</em>"
				description="Los platos que aparecen aquí son los que enseñan las fotos del perfil y los que nombran las reseñas. La carta cambia a diario y el local no la tiene publicada en Google."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Esta página no publica precios porque la ficha no los tiene: el establecimiento no ha colgado su carta. El plato del día, el precio de la ración y las opciones sin gluten se preguntan en el mostrador o en el 926 30 91 59."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nueve fotos <br /><em>de la mesa.</em>"
				description="Las fotografías del perfil de la Cafetería-Bar Molina en Google Maps: el salmorejo, los boquerones, los torreznos, la barra con las cañas, el arroz, el pescado y los postres."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a la <br /><em>Morería.</em>"
				addressLines={[
					BUSINESS.street,
					`Planta baja · ${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Castilla-La Mancha, España',
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: de 9:00 a 17:00 de lunes a viernes, el sábado de 9:30 a 17:00 y el domingo cerrado. No hay servicio de cenas. En festivos puede cambiar; llama antes si vas en día señalado."
				mapTitle="Mapa de la Cafetería-Bar Molina en la calle Morería 7, Ciudad Real"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Cafetería-Bar Molina"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. El local no publica web propia ni sistema de reservas, así que el teléfono es el canal directo para reservar mesa, preguntar por el menú del día o encargar una ración."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de la Cafetería-Bar Molina"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
