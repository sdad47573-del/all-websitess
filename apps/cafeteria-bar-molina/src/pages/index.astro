---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import arrozNegro from '../assets/fotos/cafeteria-bar-molina-panoramica-10.jpg';
import fachada from '../assets/fotos/cafeteria-bar-molina-vertical-01.jpg';
import salmorejoCuenco from '../assets/fotos/cafeteria-bar-molina-vertical-02.jpg';
import salmorejoCazuela from '../assets/fotos/cafeteria-bar-molina-vertical-03.jpg';
import boquerones from '../assets/fotos/cafeteria-bar-molina-vertical-04.jpg';
import barra from '../assets/fotos/cafeteria-bar-molina-vertical-05.jpg';
import torreznos from '../assets/fotos/cafeteria-bar-molina-vista-6-06.jpg';
import tartaNata from '../assets/fotos/cafeteria-bar-molina-vertical-07.jpg';
import tartaChocolate from '../assets/fotos/cafeteria-bar-molina-apaisada-08.jpg';
import pescado from '../assets/fotos/cafeteria-bar-molina-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	RATING,
	SERVICIOS,
} from '../data/site';

const title = 'Cafetería-Bar Molina · comida casera y manchega en Ciudad Real';
const description = BUSINESS.description;

const galeria = [
	{
		src: salmorejoCazuela,
		alt: 'Salmorejo servido en cazuela de barro sobre la mesa, con pan y botellas alrededor',
	},
	{
		src: salmorejoCuenco,
		alt: 'Cuenco de salmorejo con huevo y jamón picados por encima, en un plato blanco',
	},
	{
		src: boquerones,
		alt: 'Boquerones fritos en un plato blanco con ensalada, zanahoria y gajo de limón',
	},
	{
		src: barra,
		alt: 'Barra de madera con dos cañas de cerveza, una tapa de carne con pan y una cazuela de salmorejo',
	},
	{
		src: torreznos,
		alt: 'Plato de torreznos fritos, dorados y crujientes, con aceite en el fondo',
	},
	{
		src: pescado,
		alt: 'Rodaja de pescado a la plancha con ensalada, maíz, zanahoria y limón',
	},
	{
		src: tartaNata,
		alt: 'Tarta helada de nata y chocolate con nata montada y caramelo, en un plato blanco',
	},
	{
		src: tartaChocolate,
		alt: 'Porción de tarta de chocolate con salsa de chocolate caliente por encima',
	},
	{
		src: fachada,
		alt: 'Fachada de la Cafetería-Bar Molina en la calle Morería, con el rótulo y la barra junto a la puerta',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#cafeteria-bar-molina`,
	name: BUSINESS.name,
	alternateName: ['Bar Molina Ciudad Real', 'Cafetería Molina', 'Molina Morería'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina manchega', 'Cocina castellana', 'Comida casera', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Ciudad Real' },
		{ '@type': 'AdministrativeArea', name: 'Castilla-La Mancha' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.channel },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '17:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '09:30',
			closes: '17:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos adaptados', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"cafeteria-bar-molina-panoramica-10.jpg": arrozNegro,
	"cafeteria-bar-molina-vertical-03.jpg": salmorejoCazuela,
	"cafeteria-bar-molina-vertical-02.jpg": salmorejoCuenco,
	"cafeteria-bar-molina-vertical-04.jpg": boquerones,
	"cafeteria-bar-molina-vertical-05.jpg": barra,
	"cafeteria-bar-molina-vista-6-06.jpg": torreznos,
	"cafeteria-bar-molina-vertical-09.jpg": pescado,
	"cafeteria-bar-molina-vertical-07.jpg": tartaNata,
	"cafeteria-bar-molina-apaisada-08.jpg": tartaChocolate,
	"cafeteria-bar-molina-vertical-01.jpg": fachada,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#17130f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Cafetería-Bar Molina Ciudad Real, bar Molina calle Morería, comida casera Ciudad Real, cocina manchega Ciudad Real, tapas centro Ciudad Real, salmorejo Ciudad Real, boquerones, arroz negro, bar 13002"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera y manchega en la calle Morería, 7, de Ciudad Real. Tapas, salmorejo, arroces y guisos, de 9:00 a 17:00 de lunes a sábado. 4,4 sobre 5 con 482 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Arroz negro con calamar de la Cafetería-Bar Molina"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#17130f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-CM"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Ciudad Real"
			preload={[arrozNegro]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Comida casera y manchega"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de la Cafetería-Bar Molina"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
