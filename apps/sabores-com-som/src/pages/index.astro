---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fado from '../assets/fotos/sabores-com-som-apaisada-02.jpg';
import fachada from '../assets/fotos/sabores-com-som-vertical-01.jpg';
import polvo from '../assets/fotos/sabores-com-som-vertical-03.jpg';
import sala from '../assets/fotos/sabores-com-som-vertical-04.jpg';
import fruta from '../assets/fotos/sabores-com-som-vertical-05.jpg';
import mesa from '../assets/fotos/sabores-com-som-panoramica-06.jpg';
import azeitonas from '../assets/fotos/sabores-com-som-vertical-07.jpg';
import fadista from '../assets/fotos/sabores-com-som-apaisada-08.jpg';
import salada from '../assets/fotos/sabores-com-som-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Sabores com Som, restaurante en Setúbal (R. Cel. Guilherme Portugal, 19): cocina portuguesa, churrasco y espectáculos ao vivo los fines de semana. 4,5 en Google con 55 reseñas. Tel. 932 119 810.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada rosa de Sabores com Som en Setúbal, con el letreiro de madera y la pizarra del menú completo',
	},
	{
		src: sala,
		alt: 'Comedor de Sabores com Som con mesas de mantel de flores, platos de barro y vinilos en la pared',
	},
	{
		src: polvo,
		alt: 'Polvo grelhado con batatas a murro, coentros e pimento em travessa de barro de Sabores com Som',
	},
	{
		src: mesa,
		alt: 'Cesto de pão, azeitonas e louça de barro con el nombre Sabores com Som escrito a mano',
	},
	{
		src: azeitonas,
		alt: 'Azeitonas e entrada da casa servidas em louça de barro de Sabores com Som',
	},
	{
		src: fadista,
		alt: 'Fadista de negro a cantar com dois guitarristas entre as portas de colores do Sabores com Som',
	},
	{
		src: salada,
		alt: 'Ensalada de lechuga, zanahoria y naranja en un plato de barro de Sabores com Som',
	},
	{
		src: fruta,
		alt: 'Plato de fruta de temporada con piña, plátano y naranja en Sabores com Som',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['Sabores com Som Setúbal', 'Sabores com Som Café-Snack Bar'],
	slogan: 'Comida portuguesa com som',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 932 119 810',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Portuguesa', 'Churrasco', 'Cocina casera'],
	areaServed: [
		{ '@type': 'City', name: 'Setúbal' },
		{ '@type': 'AdministrativeArea', name: 'Península de Setúbal' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday'],
			opens: '12:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday'],
			opens: '18:30',
			closes: '22:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '12:00',
			closes: '15:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '18:00',
			closes: '22:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '12:00',
			closes: '19:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Música ao vivo', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Para mim dos melhores Restaurantes de Setúbal... comida top e ambiente top.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Um lugar de gente simpática e comida boa',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La cocina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Sabores com Som · Cocina portuguesa y música en Setúbal';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#123a5a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Sabores com Som, restaurante Setúbal, comer en Setúbal, cocina portuguesa Setúbal, churrasco Setúbal, música ao vivo Setúbal, fado Setúbal, R. Cel. Guilherme Portugal 19, 2910-422 Setúbal"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Sabores com Som · Cocina portuguesa y música en Setúbal"
			ogDescription="Comida portuguesa y churrasco en Setúbal, con espectáculos ao vivo los fines de semana. 4,5 en Google con 55 reseñas. Tel. 932 119 810."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fadista y guitarristas actuando entre las mesas de Sabores com Som, en Setúbal"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#123a5a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-15"
			postalCode={BUSINESS.postalCode}
			phone="+351932119810"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 932 119 810',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fado]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Cozinha portuguesa · Setúbal"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="R. Cel. Guilherme Portugal, 19 · Setúbal"
				title="Sabores<br />com som,<br /><em>en Setúbal.</em>"
				lede={`Sabores com Som es un restaurante de Setúbal con cocina portuguesa, churrasco y música ao vivo: los fines de semana suben al escenario artistas de distintos géneros, entre mesas de mantel y louça de barro. Abre de martes a domingo.`}
				image={fado}
				imageAlt="Fadista y dos guitarristas actuando entre las mesas con velas de Sabores com Som, en Setúbal"
				primaryCta={{ label: `Llamar ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Música ao vivo"
				facts={[
					{ label: 'Nota', html: '<b>4,5 en Google</b> con 55 reseñas' },
					{ label: 'Comidas', html: '<b>12:00 – 15:00</b>' },
					{ label: 'Cenas', html: '<b>18:00 – 22:30</b>' },
					{ label: 'Lunes', html: '<b>Cerrado</b>' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Sabores com Som" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Cocina portuguesa<br /><em>com som.</em>"
				paragraphs={[
					'En el número 19 de la Rua Coronel Guilherme Portugal, Sabores com Som es un restaurante de fachada rosa, letreiro de madera y pizarra en la puerta, que se presenta como café-snack bar y sirve, ante todo, cocina portuguesa. La pizarra de la entrada anuncia el menú completo del día: sardinhas, carapaus, dourada, robalo, peixe espada preto, grelhada mista, febras, entrecosto, entremeadas, picanha o bacalhau à casa.',
					'El nombre lo dice todo: aquí se come con música. El propio restaurante cuenta en su ficha que hay «boa música» durante el servicio y que «aos fins-de-semana temos espectáculos ao vivo de diferentes artistas e géneros». En las fotos del perfil se ve el escenario con las portas de colores pintadas, los guitarristas de guitarra portuguesa y clássica, la fadista de negro y las mesas con velas encendidas.',
					'La mesa se pone con louça de barro hecha para la casa, con el nombre escrito a mano: cesta de pão, azeitonas y entradas para partilhar, pratos de peixe y de brasa, salada de alface com laranja y fruta da estação para terminar. Un comedor pequeño, de paredes negras, manteles de flores y vinilos colgados, pensado para quedarse hasta el final del fado.',
				]}
				note="«Para mim dos melhores Restaurantes de Setúbal... comida top e ambiente top», dice una reseña. Otra lo resume así: «um lugar de gente simpática e comida boa»."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La mesa"
				title="Pescado, brasa<br /><em>y fado.</em>"
				description="La ficha de Google no publica carta, pero la pizarra de la entrada y las fotos del perfil sí cuentan qué se come: menú completo del día, churrasco y cocina portuguesa de la casa."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La pizarra que se ve en las fotos del perfil anuncia el menú completo entre 13 y 16 €. Sin carta publicada en Google, los platos del día, los precios y la disponibilidad se confirman llamando al 932 119 810."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La sala,<br />la mesa<br /><em>y el escenario.</em>"
				description="Estas fotografías proceden del perfil de Sabores com Som en Google Maps: la fachada rosa con la pizarra del menú, el comedor de manteles de flores, el fado ao vivo, la louça de barro de la casa y los platos que salen de su cocina."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="R. Cel. Guilherme Portugal, 19 · 2910-422 Setúbal"
				title="Ven a cenar<br /><em>com música.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Setúbal, Portugal',
				]}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Cierra los lunes. De martes a sábado sirve comidas de 12:00 a 15:00 y cenas hasta las 22:30 —el martes empieza a las 18:30 y el resto a las 18:00—. El domingo abre de 12:00 a 19:00. En festivos puede cambiar: llama antes."
				mapTitle="Mapa de Sabores com Som en la Rua Coronel Guilherme Portugal, 19, Setúbal"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Sabores com Som · Setúbal"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `+351 ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				reserveNote="Se reserva por teléfono, llamando al 932 119 810: no hay reserva online ni formulario en esta web. Para las noches con espectáculo y para grupos conviene avisar con antelación. La ficha de Google marca entrada accesible para sillas de ruedas."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>sentarse.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Sabores com Som"
			creditLabel="Creado por"
		/>
	</body>
</html>
