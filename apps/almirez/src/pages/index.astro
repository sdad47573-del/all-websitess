---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import vitrina from '../assets/fotos/almirez-apaisada-01.jpg';
import vitrinaAncha from '../assets/fotos/almirez-apaisada-04.jpg';
import tortilla from '../assets/fotos/almirez-apaisada-02.jpg';
import platoCuchara from '../assets/fotos/almirez-apaisada-03.jpg';
import ensaladas from '../assets/fotos/almirez-apaisada-06.jpg';
import encargo from '../assets/fotos/almirez-apaisada-07.jpg';
import albondigas from '../assets/fotos/almirez-apaisada-10.jpg';
import potajeTorrijas from '../assets/fotos/almirez-vertical-05.jpg';
import potaje from '../assets/fotos/almirez-vertical-08.jpg';
import migas from '../assets/fotos/almirez-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Almirez · Comida tradicional para llevar en Teatinos, Málaga';
const description = BUSINESS.description;

const galeria = [
	{
		src: tortilla,
		alt: 'Tortilla de patatas grande y dorada en una bandeja de aluminio, recién hecha sobre la mesa del obrador',
	},
	{
		src: platoCuchara,
		alt: 'Fiambrera abierta con un guiso de garbanzos, carne y chorizo, junto a un panecillo y los cubiertos',
	},
	{
		src: potaje,
		alt: 'Plato de potaje de garbanzos con carne, chorizo, patata y pimiento, con una flor de Pascua al fondo',
	},
	{
		src: potajeTorrijas,
		alt: 'Cuenco de potaje de garbanzos con acelgas y huevo cocido, con torrijas espolvoreadas de azúcar al lado',
	},
	{
		src: migas,
		alt: 'Plato de migas con pimientos verdes y torreznos, servido en un plato de porcelana blanca',
	},
	{
		src: albondigas,
		alt: 'Fiambrera con albóndigas en salsa de tomate y una ración de patatas fritas al lado',
	},
	{
		src: ensaladas,
		alt: 'Dos ensaladas en fiambrera con lechuga, piña, gambas, aceitunas, rábano y huevo',
	},
	{
		src: encargo,
		alt: 'Bandejas de mini bocadillos y empanadas para un encargo, con dos tortillas y empanadillas envasadas',
	},
	{
		src: vitrinaAncha,
		alt: 'Vitrina del local con empanadas, tartas, flanes en vasito, ensaladas y carteles de precios escritos a mano',
	},
];

const carta = [
	{
		title: 'Plato de cuchara',
		items: [
			{ name: 'Potaje de garbanzos', note: 'con acelgas y huevo, o con carne y chorizo' },
			{ name: 'Guisos del día', note: 'el plato de cuchara que el negocio anuncia a diario' },
			{ name: 'Bacalao con tomate', note: 'uno de los platos que citan las reseñas' },
			{ name: 'Espinacas con garbanzos', note: 'el otro plato de la misma reseña' },
		],
	},
	{
		title: 'Paellas, tortillas y migas',
		items: [
			{ name: 'Paellas', note: 'la ficha las anuncia por su nombre' },
			{ name: 'Tortilla de patatas', note: 'en bandeja, para llevar entera o por raciones' },
			{ name: 'Migas', note: 'con pimientos verdes y torreznos' },
			{ name: 'Empanadas y empanadillas', note: 'en la vitrina, junto a las tartas' },
		],
	},
	{
		title: 'Para completar',
		items: [
			{ name: 'Ensaladas', note: 'en fiambrera, con piña y gambas en la foto del local' },
			{ name: 'Albóndigas con patatas', note: 'en salsa de tomate, listas para llevar' },
			{ name: 'Gazpacho', note: 'lo que pide una de las reseñas destacadas' },
			{ name: 'Postres caseros, fruta y bebida', note: 'lo que anuncia la ficha del negocio' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#almirez`,
	name: BUSINESS.name,
	alternateName: ['Almirez', 'Almirez Málaga', 'Almirez Teatinos', 'Comida tradicional para llevar Málaga'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida tradicional', 'Cocina andaluza', 'Plato de cuchara'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Teatinos-Universidad, Málaga' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '15:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"almirez-apaisada-01.jpg": vitrina,
	"almirez-apaisada-02.jpg": tortilla,
	"almirez-apaisada-03.jpg": platoCuchara,
	"almirez-vertical-08.jpg": potaje,
	"almirez-vertical-05.jpg": potajeTorrijas,
	"almirez-vertical-09.jpg": migas,
	"almirez-apaisada-10.jpg": albondigas,
	"almirez-apaisada-06.jpg": ensaladas,
	"almirez-apaisada-07.jpg": encargo,
	"almirez-apaisada-04.jpg": vitrinaAncha,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1c1712" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Almirez Málaga, comida tradicional para llevar Málaga, plato de cuchara Teatinos, comida para llevar Teatinos Universidad, paellas para llevar Málaga, guisos caseros 29010, menús por encargo Málaga, Margarita Xirgu 4, comida casera Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida tradicional para llevar en la calle Margarita Xirgu 4, bajo A, Teatinos-Universidad. Plato de cuchara a diario, paellas, guisos y postres caseros. De 10:00 a 15:30; martes cerrado. Pedidos en el 644 67 80 99."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Almirez, comida tradicional para llevar en Teatinos, Málaga, con plato de cuchara y postres caseros"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1c1712"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Teatinos-Universidad, Málaga"
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Almirez"
			subtitle="Comida tradicional · Teatinos"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Almirez"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del local en Google Maps. Sin carta de precios publicada: confirma horario, disponibilidad y encargos antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Almirez"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
