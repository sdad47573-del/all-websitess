---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import vitrina from '../assets/fotos/almirez-apaisada-01.jpg';
import vitrinaAncha from '../assets/fotos/almirez-apaisada-04.jpg';
import tortilla from '../assets/fotos/almirez-apaisada-02.jpg';
import platoCuchara from '../assets/fotos/almirez-apaisada-03.jpg';
import ensaladas from '../assets/fotos/almirez-apaisada-06.jpg';
import encargo from '../assets/fotos/almirez-apaisada-07.jpg';
import albondigas from '../assets/fotos/almirez-apaisada-10.jpg';
import potajeTorrijas from '../assets/fotos/almirez-vertical-05.jpg';
import potaje from '../assets/fotos/almirez-vertical-08.jpg';
import migas from '../assets/fotos/almirez-vertical-09.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Almirez · Comida tradicional para llevar en Teatinos, Málaga';
const description = BUSINESS.description;

const galeria = [
	{
		src: tortilla,
		alt: 'Tortilla de patatas grande y dorada en una bandeja de aluminio, recién hecha sobre la mesa del obrador',
	},
	{
		src: platoCuchara,
		alt: 'Fiambrera abierta con un guiso de garbanzos, carne y chorizo, junto a un panecillo y los cubiertos',
	},
	{
		src: potaje,
		alt: 'Plato de potaje de garbanzos con carne, chorizo, patata y pimiento, con una flor de Pascua al fondo',
	},
	{
		src: potajeTorrijas,
		alt: 'Cuenco de potaje de garbanzos con acelgas y huevo cocido, con torrijas espolvoreadas de azúcar al lado',
	},
	{
		src: migas,
		alt: 'Plato de migas con pimientos verdes y torreznos, servido en un plato de porcelana blanca',
	},
	{
		src: albondigas,
		alt: 'Fiambrera con albóndigas en salsa de tomate y una ración de patatas fritas al lado',
	},
	{
		src: ensaladas,
		alt: 'Dos ensaladas en fiambrera con lechuga, piña, gambas, aceitunas, rábano y huevo',
	},
	{
		src: encargo,
		alt: 'Bandejas de mini bocadillos y empanadas para un encargo, con dos tortillas y empanadillas envasadas',
	},
	{
		src: vitrinaAncha,
		alt: 'Vitrina del local con empanadas, tartas, flanes en vasito, ensaladas y carteles de precios escritos a mano',
	},
];

const carta = [
	{
		title: 'Plato de cuchara',
		items: [
			{ name: 'Potaje de garbanzos', note: 'con acelgas y huevo, o con carne y chorizo' },
			{ name: 'Guisos del día', note: 'el plato de cuchara que el negocio anuncia a diario' },
			{ name: 'Bacalao con tomate', note: 'uno de los platos que citan las reseñas' },
			{ name: 'Espinacas con garbanzos', note: 'el otro plato de la misma reseña' },
		],
	},
	{
		title: 'Paellas, tortillas y migas',
		items: [
			{ name: 'Paellas', note: 'la ficha las anuncia por su nombre' },
			{ name: 'Tortilla de patatas', note: 'en bandeja, para llevar entera o por raciones' },
			{ name: 'Migas', note: 'con pimientos verdes y torreznos' },
			{ name: 'Empanadas y empanadillas', note: 'en la vitrina, junto a las tartas' },
		],
	},
	{
		title: 'Para completar',
		items: [
			{ name: 'Ensaladas', note: 'en fiambrera, con piña y gambas en la foto del local' },
			{ name: 'Albóndigas con patatas', note: 'en salsa de tomate, listas para llevar' },
			{ name: 'Gazpacho', note: 'lo que pide una de las reseñas destacadas' },
			{ name: 'Postres caseros, fruta y bebida', note: 'lo que anuncia la ficha del negocio' },
		],
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#almirez`,
	name: BUSINESS.name,
	alternateName: ['Almirez', 'Almirez Málaga', 'Almirez Teatinos', 'Comida tradicional para llevar Málaga'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Comida tradicional', 'Cocina andaluza', 'Plato de cuchara'],
	areaServed: { '@type': 'AdministrativeArea', name: 'Teatinos-Universidad, Málaga' },
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	takeaway: true,
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '10:00',
			closes: '15:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Acceso para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Reseñas', href: '#resenas' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1c1712" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;0,9..144,800;1,9..144,700&family=Nunito+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Almirez Málaga, comida tradicional para llevar Málaga, plato de cuchara Teatinos, comida para llevar Teatinos Universidad, paellas para llevar Málaga, guisos caseros 29010, menús por encargo Málaga, Margarita Xirgu 4, comida casera Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida tradicional para llevar en la calle Margarita Xirgu 4, bajo A, Teatinos-Universidad. Plato de cuchara a diario, paellas, guisos y postres caseros. De 10:00 a 15:30; martes cerrado. Pedidos en el 644 67 80 99."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Almirez, comida tradicional para llevar en Teatinos, Málaga, con plato de cuchara y postres caseros"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1c1712"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Teatinos-Universidad, Málaga"
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Almirez"
			subtitle="Comida tradicional · Teatinos"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.neighbourhood} · ${BUSINESS.city}`}
				title="Comida de cuchara, <br /><em>para llevar.</em>"
				lede="Almirez está en la calle Margarita Xirgu 4, bajo A, en Teatinos-Universidad, y lo cuenta así en su ficha: «Comida tradicional para llevar. Plato de cuchara a diario. Menús por encargo. Postres caseros». Abre de 10:00 a 15:30 todos los días menos el martes, y los pedidos se hacen en el 644 67 80 99."
				image={vitrina}
				imageAlt="Vitrina de Almirez con empanadas, tartas, flanes y ensaladas, y carteles de precios escritos a mano"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,6</b> en Google · 87 reseñas' },
					{ label: 'Horario', html: '<b>10:00–15:30</b><br />Martes cerrado · solo mediodía' },
					{ label: 'Pedidos', html: `<b>${BUSINESS.phone}</b> para llevar y por encargo` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Almirez" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El almirez <br /><em>de Teatinos.</em>"
				paragraphs={[
					'El local está en la calle Margarita Xirgu 4, bajo A, en pleno Teatinos-Universidad, a un paso de la zona universitaria de Málaga. Dentro, la vitrina ocupa el frente: empanadas, tartas y flanes en vasito arriba, y los platos del día en fiambreras debajo, cada uno con su cartel escrito a mano.',
					'El negocio lo resume en su propia ficha: «Comida tradicional para llevar. Plato de cuchara a diario. Menús por encargo. Postres caseros. Fruta y bebida. Paellas, guisos, tortillas, Migas, etc....». No hay mesas: se encarga en el mostrador, se calienta si hace falta y se recoge.',
					'Por las fotos del perfil pasa el recetario de siempre: potaje de garbanzos con acelgas y huevo, potaje con carne y chorizo, migas con pimientos, albóndigas con patatas, tortilla de patatas entera en bandeja, ensaladas en fiambrera y torrijas de postre. Y para los encargos, bandejas de mini bocadillos, empanadas y empanadillas.',
					'El horario es de mediodía y descansa el martes: de 10:00 a 15:30 el resto de la semana. Una de las reseñas que Google destaca cuenta que pidió «varias raciones y gazpacho», y otra que probó el bacalao con tomate y las espinacas con garbanzos.',
				]}
				note="La ficha no publica carta con precios ni web propia. Los platos de esta página salen de la descripción del negocio, de la categoría de Google, de las fotos de su perfil y de las reseñas destacadas: no hay importes que mostrar sin inventarlos."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver el local en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Guisos, paellas <br /><em>y migas.</em>"
				description="Sin precios publicados en la ficha, así que aquí va lo que el negocio declara, lo que se ve en sus fotos y lo que citan las reseñas: el plato de cuchara de cada día."
				cta={{ label: 'Ver la ficha en Google', href: MAPS.place }}
				groups={carta}
				note="Esta lista sale de la descripción del negocio, de las fotografías del perfil y de las reseñas destacadas. No hay carta ni precios públicos: el plato del día se confirma en el mostrador o llamando al 644 67 80 99."
			/>

			<section class="reviews section-pad" id="resenas" aria-labelledby="resenas-title">
				<div class="wrap">
					<p class="section-label"><span aria-hidden="true"></span> Reseñas de Google</p>
					<div class="reviews-head">
						<h2 id="resenas-title">Saben lo que <br /><em>hacen.</em></h2>
						<p>
							La ficha tiene 87 reseñas y una media de 4,6. Estas son tres de las que Google destaca,
							con la puntuación que les dio su autor.
						</p>
					</div>
					<div class="review-grid">
						{
							REVIEWS.map((review) => (
								<figure class="review-card">
									<p class="review-stars" aria-label={`${review.rating} sobre 5`}>
										{'★'.repeat(review.rating)}
										<span aria-hidden="true">{'★'.repeat(5 - review.rating)}</span>
									</p>
									<blockquote>{review.quote}</blockquote>
									<figcaption>Reseña publicada en Google Maps</figcaption>
								</figure>
							))
						}
					</div>
					<p class="review-note">
						Citas de las reseñas públicas del local, con la puntuación del autor. En la ficha de Google
						están todas, incluidas las que puntúan por debajo.
					</p>
				</div>
			</section>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nueve fotos <br /><em>del obrador.</em>"
				description="Del perfil del local: la tortilla en bandeja, el potaje, las migas, las albóndigas con patatas, las ensaladas, una bandeja de encargo y la vitrina con los platos del día."
				images={galeria}
				cta={{ label: 'Ver todas en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, avísanos y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · Teatinos`}
				title="A la hora <br /><em>del almuerzo.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'España']}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: de 10:00 a 15:30 de lunes a domingo, con el martes cerrado. Es servicio de mediodía, sin cenas. En festivos puede cambiar; llama antes si vas en día señalado."
				mapTitle="Mapa de Almirez en la calle Margarita Xirgu 4, Teatinos-Universidad, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Almirez"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Pedidos: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="Aquí se pide en el mostrador o por teléfono y se recoge: es comida para llevar, no hay servicio de mesa. Los menús por encargo se hablan con antelación en el 644 67 80 99. La ficha marca acceso para sillas de ruedas pero no aparcamiento adaptado, y no enlaza ninguna plataforma de reparto. Esta página no tramita pedidos."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>encargar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="Almirez"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Datos y fotografías tomados de la ficha y del perfil públicos del local en Google Maps. Sin carta de precios publicada: confirma horario, disponibilidad y encargos antes de pedir."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Almirez"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
