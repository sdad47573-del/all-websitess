---
import '../styles/global.css';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/fotos/rincon-gallego-egabrense-cabra-apaisada-06.jpg';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookUrl,
	faqSchema,
	faqs,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	openingHours,
	phoneHref,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'Restaurante Rincón Gallego Egabrense | Cocina gallega en Cabra, Córdoba';
const description =
	'Rincón Gallego Egabrense en Cabra (Córdoba): pulpo a la brasa, chuletón de rubia gallega, marisco de primera calidad y croquetas caseras. Terraza con braseros y patio interior. Av. Fuente del Río, 34 · Reserva: 679 51 11 65.';
const keywords =
	'Rincón Gallego Egabrense, restaurante Cabra Córdoba, cocina gallega en Córdoba, pulpo a la brasa, chuletón de rubia gallega, marisco Cabra, restaurante en Cabra, comer en la Subbética, Fuente del Río 34 Cabra, croquetas de carabinero, albariño';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#124a5a" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Cabra" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,600;1,400&family=Rubik:wght@400;500;600;700&family=Azeret+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de un pulpo para Restaurante Rincón Gallego Egabrense; no es una fotografía del establecimiento" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante Rincón Gallego Egabrense, inicio">
				<span class="brand-mark" aria-hidden="true">RG</span>
				<span class="brand-copy">Rincón Gallego <small>Cocina gallega · Cabra</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">El restaurante</a>
				<a href="#carta">La carta</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHref}><span aria-hidden="true">☎</span> 679 51 11 65</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Cabra · Subbética · Córdoba</p>
					<h1 id="hero-title"> Galicia entera<br /><em>en la Subbética.</em></h1>
					<p class="hero-intro">Rincón Gallego Egabrense trae a Cabra el producto gallego de primera: pulpo a la brasa, chuletón de rubia con 45 días de maduración, marisco que llega fresco cada día y una carta de albariños. Todo en un local con redes de pesca, patio interior y terraza con braseros.</p>
					<div class="hero-actions">
						<a class="button button-coral" href={phoneHref}>Reservar por teléfono <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encontrarás en</small><address>{business.streetAddress}<br />{business.postalCode} · Cabra</address></div>
						<div><small>Reservas</small><a href={phoneHref}>{business.phone}</a><br /><a href={mapsUrl} target="_blank" rel="noreferrer">Ficha en Google Maps ↗</a></div>
					</div>
				</div>
				<figure class="hero-art">
					<Image
						class="hero-photo"
						src={heroPhoto}
						alt="Pulpo a la brasa con parmentier, aceite de pimentón y aceitunas, la especialidad de la casa"
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 720px) 100vw, 46vw"
						format="avif"
						quality={70}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					<span class="hero-scrim" aria-hidden="true"></span>
					<div class="mar-tag" aria-hidden="true"><small>Producto de Galicia</small><strong>Pulpo a la brasa</strong><span>Marisco y rubia gallega</span></div>
					<figcaption class="art-caption"><strong>Rincón Gallego</strong>Egabrense</figcaption>
				</figure>
			</section>

			<div class="promise" aria-label="Información del Rincón Gallego Egabrense">
				<span>Cocina gallega</span><span>Pulpo a la brasa</span><span>Rubia gallega 45 días</span><span>Terraza con braseros</span>
			</div>

			<section class="section intro" id="casa" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Un rincón de Galicia en Cabra</p>
					<h2 id="intro-title">Producto de calidad,<br /><em>trato de casa.</em></h2>
				</div>
				<div class="intro-copy">
					<p>En la Avenida Fuente del Río, a las afueras de Cabra, el Rincón Gallego Egabrense es uno de los restaurantes mejor valorados de la Subbética. Su propuesta une la tradición gastronómica gallega con un toque creativo, siempre a partir de producto de calidad nacional y de proximidad.</p>
					<p>El local combina elementos rústicos con detalles marineros: paredes adornadas con redes de pesca y una distribución de mesas que permite conversar tranquilos. En invierno, la terraza se disfruta con braseros debajo de las mesas, y en el interior conviven salones cálidos con un patio interior.</p>
					<p class="source-note">La información de esta página procede de la ficha de Google Maps, de los perfiles oficiales del restaurante y de directorios gastronómicos. La carta y los horarios pueden cambiar: confirma antes de tu visita.</p>
				</div>
			</section>

			<section class="section carta" id="carta" aria-labelledby="carta-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Carta gallega</p>
						<h2 id="carta-title">Lo que pide<br /><em>la mesa.</em></h2>
					</div>
					<p>Una selección orientativa de los platos más mencionados por la clientela en reseñas y fuentes gastronómicas. No sustituye la carta vigente.</p>
				</div>
				<div class="carta-grid">
					{specialties.map((dish, index) => (
						<article class="carta-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<div class="carta-extra">
					<p><strong>Bebida:</strong> carta de vinos gallegos con albariños de referencia, que el equipo recomienda con conocimiento de causa. También cerveza fresca y tirada.</p>
					<p><strong>Menú del día:</strong> disponible entre semana y muy recomendado por los clientes habituales, con buena relación calidad-precio.</p>
					<p class="menu-note">Consulta la carta, el menú del día y los alérgenos con el restaurante. <a href={phoneHref}>Llama al 679 51 11 65</a>.</p>
				</div>
			</section>

			<Galeria
				id="fotos"
				nombre="Restaurante Rincón Gallego Egabrense"
				titulo="El Rincón, en fotos."
				intro="Fotos reales del local, de la terraza y de los platos, publicadas en la ficha de Google Maps. Para ver la colección completa, abre la ficha en Google Maps o los perfiles oficiales del restaurante."
				mapsUrl={mapsUrl}
			/>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14940 · Cabra, Córdoba</p>
					<h2 id="visit-title">Te esperamos<br /><em>en Cabra.</em></h2>
					<address>{business.streetAddress}<br />{business.postalCode} {business.locality}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Reservas y consultas</small><a href={phoneHref}>{business.phone}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Ubicación</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes y reseñas</small><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> · <a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a> · <a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHref}>Llamar y reservar</a>
					</div>
					<p class="hours-note">Se recomienda reservar los fines de semana, ya que el local se llena con facilidad. Los horarios pueden variar en festivos: llama antes de desplazarte.</p>
				</div>
				<div class="visit-side">
					<div class="hours-card">
						<h3>Horario orientativo</h3>
						<ul>
							{openingHours.map((slot) => (
								<li><span>{slot.day}</span><strong>{slot.hours}</strong></li>
							))}
						</ul>
					</div>
					<div class="map-card">
						<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa del Rincón Gallego Egabrense en Avenida Fuente del Río, Cabra" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
							<noscript>
								<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
							</noscript>
						</div>
						<div class="map-label"><div><strong>Rincón Gallego</strong><small>Av. Fuente del Río, 34 · Cabra</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
					</div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="Restaurante Rincón Gallego Egabrense, volver al inicio">
				<span class="brand-mark" aria-hidden="true">RG</span><span class="brand-copy">Rincón Gallego <small>Egabrense · Cabra</small></span>
			</a>
			<nav class="footer-nav" aria-label="Fuentes y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante Rincón Gallego Egabrense · Cabra (Córdoba). Consulta horarios, carta y alérgenos directamente con el establecimiento.</small>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</footer>
		<a class="mobile-call" href={phoneHref}>Reservar en Rincón Gallego <span>679 51 11 65</span></a>

						</body>
</html>


