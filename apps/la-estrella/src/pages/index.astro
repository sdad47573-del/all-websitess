---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import rotulo from '../assets/fotos/la-estrella-apaisada-01.jpg';
import asador from '../assets/fotos/la-estrella-vertical-02.jpg';
import pollos from '../assets/fotos/la-estrella-apaisada-03.jpg';
import horno from '../assets/fotos/la-estrella-vertical-05.jpg';
import bandeja from '../assets/fotos/la-estrella-apaisada-09.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Asador de Pollos La Estrella · Pollo asado en Triana, Sevilla';
const description = BUSINESS.description;

const galeria = [
	{
		src: rotulo,
		alt: 'El rótulo azul de Asador de Pollos La Estrella en la calle San Jacinto, con la estrella blanca y el balcón de forja encima',
	},
	{
		src: asador,
		alt: 'Un trabajador de La Estrella con delantal azul sosteniendo una brocheta de pollos recién asados ante el horno',
	},
	{
		src: pollos,
		alt: 'Tres pollos asados dorados en la bandeja del horno de La Estrella',
	},
	{
		src: horno,
		alt: 'El horno vertical de La Estrella con hileras de pollos asándose',
	},
	{
		src: bandeja,
		alt: 'Un trabajador de La Estrella con el pulgar levantado junto a una bandeja de pollo asado y el horno de fondo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#laestrella`,
	name: BUSINESS.name,
	alternateName: ['ASADOR DE POLLOS LA ESTRELLA', 'La Estrella Triana', 'Asador La Estrella Sevilla'],
	description:
		'Asador de pollos en la calle San Jacinto, 34, Triana (41010 Sevilla). Pollo asado, tortillas, aliños, patatas y ensaladilla.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34954340666',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado'],
	areaServed: [
		{ '@type': 'City', name: 'Sevilla' },
		{ '@type': 'AdministrativeArea', name: 'Triana' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Thursday'],
			opens: '12:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday'],
			opens: '12:30',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '12:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#14293a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Work+Sans:ital,wght@0,400..800;1,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador de Pollos La Estrella, pollo asado Triana, San Jacinto 34, pollo asado Sevilla, tortillas, aliños, patatas fritas, ensaladilla, asador La Estrella"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo asado, tortillas, aliños, patatas y ensaladilla en la calle San Jacinto, 34, en pleno Triana. 4,5 sobre 5 en Google."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tarjeta de Asador de Pollos La Estrella con su nombre en letra serif sobre fondo azul trianero"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#14293a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-SE"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Triana"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[rotulo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Estrella"
			subtitle="Asador de pollos · Triana"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. San Jacinto, 34 · Triana, Sevilla"
				title="Pollo asado <br /><em>en Triana.</em>"
				lede={`La Estrella es el asador de la calle San Jacinto, en pleno Triana. Sale pollo asado, tortillas, aliños, patatas fritas y ensaladilla, con raciones que las reseñas describen como generosas. Tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={rotulo}
				imageAlt="El rótulo azul de Asador de Pollos La Estrella en la calle San Jacinto, con la estrella blanca y el balcón de forja encima"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>12:30–16:00</b> · cenas viernes y sábado' },
					{ label: 'Dónde', html: '<b>Triana</b> · San Jacinto, 34' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Fotos de la ficha de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Pollo asado · tortillas · aliños"
			/>

			<LocalChips label="Lo que ofrece La Estrella" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un asador <br /><em>de Triana.</em>"
				paragraphs={[
					'La Estrella está en el número 34 de la calle San Jacinto, el eje del barrio de Triana. El rótulo azul con la estrella blanca cuelga sobre la acera, debajo de los balcones de forja, y se ve desde media calle.',
					'Dentro manda el horno: hileras de pollos girando sobre las bandejas, dorándose por igual. En las fotos de la ficha se ven los pollos recién sacados y a quien los atiende con el delantal azul y la brocheta en la mano.',
					'La ficha lo clasifica como pollería. Las reseñas cuentan lo que acompaña al pollo: tortillas, aliños, patatas fritas y ensaladilla. No publica la carta completa ni los precios, así que la mesa se termina de montar en el local.',
					'Google le da 4,5 sobre 5 con 244 reseñas. Una habla de «raciones generosas» y de patatas fritas «deliciosas»; otra califica los pollos de «sabrosos y muy ricos»; y hay una crítica con retranca sobre la ensaladilla de gambas.',
				]}
				note="La ficha no publica carta, precios, página web ni redes sociales. Los platos de esta página son los que nombran la categoría y las reseñas de Google, consultadas en octubre de 2026."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Del horno a la mesa</p>
					<h2 id="highlights-title">Pollo, raciones <br /><em>y Triana.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Pollo asado <br /><em>y sus acompañamientos.</em>"
				description="La ficha de Google no publica carta ni precios. Esto es lo que nombran la categoría y las reseñas del perfil."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La ficha no publica precios. Los platos de esta lista son los que aparecen en la categoría y en las reseñas del perfil de Google, consultadas en octubre de 2026. La disponibilidad y los precios se confirman por teléfono o en el local."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El rótulo, el horno <br /><em>y los pollos.</em>"
				description="Cinco fotografías del perfil de Asador de Pollos La Estrella en Google Maps: el rótulo de San Jacinto, el horno y los pollos recién asados."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,5 sobre 5, <em>con 244 reseñas.</em></h2>
						<p>
							La valoración que publica Google en octubre de 2026 es de 4,5 con 244 opiniones. Las
							tres reseñas que muestra la ficha hablan del pollo, de las raciones y de las patatas;
							aquí se reproducen tal cual, también la que se queda en dos estrellas.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,5</strong>
						<span>★★★★★</span>
						<small>244 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En San Jacinto, <br /><em>pleno Triana.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, BUSINESS.district]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: mediodía de lunes a domingo con el miércoles cerrado, de 12:30 a 16:00 (el sábado desde las 12:00 y el domingo desde las 11:00). Viernes y sábado abre también de 20:00 a 23:00. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Asador de Pollos La Estrella en la calle San Jacinto, 34, Triana, Sevilla"
				mapEmbedUrl={MAPS.embed}
				mapLabel="C. San Jacinto, 34"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos por teléfono: la ficha no publica reparto a domicilio ni pedidos online; el único canal que aparece es el 954 34 06 66. En accesibilidad la ficha marca que no hay aparcamiento adaptado ni asientos adaptados para sillas de ruedas, así que conviene llamar antes si lo necesitas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>ir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a La Estrella"
			navAriaLabel="Enlaces de La Estrella"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
