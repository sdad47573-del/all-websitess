---
import '../styles/global.css';
import {
	business,
	camperoBase,
	directionsUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneDisplay,
	phoneHrefs,
	structuredData,
} from '../lib/business';

const title = 'La Campería | Camperos malagueños en Teatinos, Málaga';
const description =
	'La Campería, bar de camperos malagueños en Calle Andrómeda, 15, Teatinos-Universidad (Málaga). Camperos, barra de bar y terraza en el barrio universitario. Llama y ven a por el tuyo.';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#14372c" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="geo.region" content="ES-MA" />
		<meta name="geo.placename" content="Teatinos, Málaga" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Karla:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="business.business" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
			<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
			<meta property="og:image" content="https://la-camperia-malaga.vercel.app/og.png" />
		<meta property="og:image:type" content="image/svg+xml" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="La Campería, inicio">
				<span class="brand-mark" aria-hidden="true">LC</span>
				<span class="brand-label">LA CAMPERÍA <small>CAMPEROS MALAGUEÑOS · TEATINOS</small></span>
			</a>
			<nav aria-label="Navegación principal"><a href="#campero">El campero</a><a href="#visitanos">Visítanos</a></nav>
			<a class="header-action" href={`tel:${phoneHrefs[0]}`}><span aria-hidden="true">☎</span> Llamar</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true">✦</span> BAR DE CAMPEROS · TEATINOS-UNIVERSIDAD · MÁLAGA</p>
					<h1 id="hero-title">El campero<br /><em>malagueño</em><br />de barrio.</h1>
					<p class="hero-intro">Un campero bien hecho, una barra de siempre y terraza para sentarse a la sombra. En plena Calle Andrómeda, en Teatinos, donde el barrio universitario se toma su bocadillo en serio.</p>
					<div class="hero-actions">
						<a class="button button-green" href={`tel:${phoneHrefs[0]}`}><span aria-hidden="true">☎</span> Llamar y encargar</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<div class="hero-datos">
					<div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.district}<br />{business.postalCode} {business.city}</address></div>
					<div><small>TELÉFONO</small><a href={`tel:${phoneHrefs[0]}`}>{phoneDisplay}</a></div>
					<div><small>EN LA FICHA</small><a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a><span>Con terraza</span></div>
				</div>
			</section>

			<div class="band" aria-hidden="true">
				<span>CAMPEROS</span><i></i><span>BARRA DE BAR</span><i></i><span>TERRAZA</span><i></i><span>TEATINOS</span><i></i><span>MÁLAGA</span>
			</div>

			<section class="campero-section" id="campero" aria-labelledby="campero-title">
				<p class="section-label"><span>01 /</span> QUÉ ES UN CAMPERO</p>
				<div class="campero-head">
					<h2 id="campero-title">Un bocadillo que<br />es una <em>comida entera.</em></h2>
					<p class="campero-lead">Poca broma con el campero: en Málaga es el bocadillo de toda la vida, el que se pide a media tarde y te deja listo hasta la cena. Estas son las piezas del campero clásico.</p>
				</div>
				<ul class="campero-list">
					{camperoBase.map((part, index) => (
						<li class="campero-item">
							<span class="campero-num">{String(index + 1).padStart(2, '0')}</span>
							<strong>{part.name}</strong>
							<small>{part.note}</small>
						</li>
					))}
				</ul>
				<p class="campero-foot">Cada bar tiene su receta y su aliño, así que pregunta en la barra cómo lo hace La Campería y pide el tuyo a tu gusto.</p>
			</section>

			<section class="about-section" aria-labelledby="about-title">
				<p class="section-label"><span>02 /</span> LA CAMPERÍA</p>
				<div class="about-content">
					<h2 id="about-title">Bar de barrio<br />en <em>Teatinos.</em></h2>
					<div>
						<p>La Campería está en la Calle Andrómeda, 15, en pleno Teatinos-Universidad: una zona de facultades, pisos de estudiantes y vecinos de toda la vida. Un bar de los de siempre, donde se viene a picar algo y a arreglar el mundo en la barra.</p>
						<p>La ficha del local indica <strong>terraza</strong>, así que si el tiempo acompaña se puede comer al aire libre. Para llevar o reservar mesa, lo más rápido es una llamada.</p>
					</div>
				</div>
				<div class="about-footer">
					<span>CAMPEROS · BARRA · TERRAZA</span>
					<span>29010 TEATINOS, MÁLAGA</span>
					<span aria-hidden="true">✦</span>
				</div>
			</section>

			<section class="contact-section" id="visitanos" aria-labelledby="contact-title">
				<p class="section-label"><span>03 /</span> VISÍTANOS</p>
				<div class="contact-layout">
					<div class="contact-copy">
						<p class="contact-kicker">EN CALLE ANDRÓMEDA, 15</p>
						<h2 id="contact-title">Ven a por<br />tu <em>campero.</em></h2>
						<div class="contact-card">
							<div class="contact-row"><span aria-hidden="true">☎</span><div><small>TELÉFONO</small><a href={`tel:${phoneHrefs[0]}`}>{phoneDisplay}</a></div></div>
							<div class="contact-row"><span aria-hidden="true">⌖</span><div><small>DIRECCIÓN</small><address>{business.streetAddress}<br />{business.district}<br />{business.postalCode} {business.city}</address></div></div>
							<div class="contact-row"><span aria-hidden="true">✦</span><div><small>SERVICIO</small><p>Barra de bar y terraza. Pregunta por los camperos del día.</p></div></div>
						</div>
						<a class="button button-green" href={directionsUrl} target="_blank" rel="noreferrer">Abrir indicaciones <span aria-hidden="true">↗</span></a>
					</div>
					<div class="map-card">
						<div class="map-header"><span><i></i> CALLE ANDRÓMEDA, 15 · TEATINOS</span><a href={mapsUrl} target="_blank" rel="noreferrer">ABRIR MAPS ↗</a></div>
						<iframe title="Mapa de La Campería en Calle Andrómeda, 15, Teatinos, Málaga" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<div class="map-footer"><span aria-hidden="true">⌖</span><div><strong>{business.name}</strong><small>{business.streetAddress} · {business.district} · {business.city}</small></div><a href={directionsUrl} target="_blank" rel="noreferrer" aria-label="Cómo llegar a La Campería">↗</a></div>
					</div>
				</div>
				<div class="social-row"><span>ENCUÉNTRANOS TAMBIÉN EN</span><a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a><span>¿Tienes el teléfono a mano? Llama antes para llevar.</span></div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#inicio" aria-label="La Campería, volver al inicio"><span class="brand-mark">LC</span><span class="brand-label">LA CAMPERÍA <small>CAMPEROS MALAGUEÑOS · TEATINOS</small></span></a>
			<p>{business.streetAddress}<br />{business.district}<br />{business.postalCode} {business.city}<br /><a href={`tel:${phoneHrefs[0]}`}>{phoneDisplay}</a></p>
			<a class="footer-social" href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
			<small>© {new Date().getFullYear()} La Campería · Teatinos, Málaga &nbsp;·&nbsp; Consulta la carta y el horario en el local.</small>
		
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
</footer>
		<a class="phone-cta" href={`tel:${phoneHrefs[0]}`}><span aria-hidden="true">☎</span> Llamar y encargar <strong>{phoneDisplay}</strong></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						</body>
</html>
