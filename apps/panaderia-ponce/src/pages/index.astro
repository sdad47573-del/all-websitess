---
import '../styles/global.css';
import { Image } from 'astro:assets';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import tartas from '../assets/fotos/panaderia-ponce-apaisada-01.jpg';
import fachada from '../assets/fotos/panaderia-ponce-vertical-02.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Panadería Ponce · Pan artesanal en Málaga';
const description =
	'Panadería Ponce, en la calle Lepanto, 2 (Carretera de Cádiz, 29003 Málaga). Pan artesanal elaborado en el obrador, con más de 20 años de oficio. Abre todos los días desde las 6:00. Teléfono 951 24 32 68.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#ponce`,
	name: BUSINESS.name,
	alternateName: ['Ponce', 'Panadería Ponce Málaga', 'Boutique del Pan Ponce'],
	description:
		'Panadería con pan artesanal elaborado en el obrador y más de 20 años de oficio, en la calle Lepanto, 2 (Carretera de Cádiz, 29003 Málaga).',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 951 24 32 68',
	currenciesAccepted: 'EUR',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '06:00',
			closes: '14:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Sunday',
			opens: '06:00',
			closes: '14:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'La fachada', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1f4a3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zilla+Slab:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Public+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Ponce Málaga, pan artesanal Carretera de Cádiz, mollete integral Málaga, boutique del pan, panadería 29003, calle Lepanto"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pan artesanal elaborado en el obrador, con más de 20 años de oficio, en la calle Lepanto, 2 (Carretera de Cádiz, Málaga). Todos los días desde las 6:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tartas de encargo de la Panadería Ponce, en Málaga"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#1f4a3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[tartas]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Ponce"
			subtitle="Panadería · Confitería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<div class="band band-cream">
				<LocalHero
					eyebrow="C. Lepanto, 2 · Carretera de Cádiz, Málaga"
					title="Pan artesanal <br /><em>hecho en el obrador.</em>"
					lede={`Ponce lleva más de 20 años amasando y horneando en la calle Lepanto, 2. Pan artesanal elaborado en casa, un surtido amplio de panes y dulces —con el mollete integral que sus clientes destacan— y tartas de encargo. Tiene ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
					image={tartas}
					imageAlt="Dos tartas de Superpapá: una azul con el escudo de Superman y otra de chocolate con un balón"
					primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
					facts={[
						{ label: 'Nota', html: '<b>4,6</b> en Google · 53 reseñas' },
						{ label: 'Horario', html: '<b>6:00–14:30</b> de lunes a sábado' },
						{ label: 'Barrio', html: '<b>Carretera de Cádiz</b>, Málaga' },
					]}
					galleryHref={MAPS.place}
					photoCredit="Foto del perfil de Google Maps"
					galleryLinkLabel="Ver la ficha"
					tag="Más de 20 años de obrador"
				/>

				<LocalChips label="Lo que ofrece la Panadería Ponce" items={SERVICIOS} />
			</div>

			<div class="band band-kraft">
				<LocalAbout
					label="La casa"
					title="Un obrador <br /><em>de barrio.</em>"
					paragraphs={[
						'Ponce está en la calle Lepanto, 2, en Carretera de Cádiz, con los rótulos de «Panadería Ponce» y «Boutique del Pan · Confitería Ponce» sobre la persiana verde. Google la clasifica como panadería.',
						'El propio establecimiento lo resume en su ficha: «pan artesanal elaborado por nosotros con más de 20 años al servicio del consumidor». Las reseñas hablan de «un gran surtido y variedad, de panes y dulces» y destacan el mollete integral, que una clienta dice que «no lo encuentras en otro sitio».',
						'Abre todas las mañanas: de lunes a sábado de 6:00 a 14:30 y el domingo de 6:00 a 14:00. De accesibilidad, la ficha solo indica que no hay aparcamiento adaptado, así que esta página no afirma nada sobre la entrada.',
						'Esta página no publica carta ni precios: la ficha de Google no los recoge. Lo que se cuenta aquí sale de la ficha pública del establecimiento y de las dos fotografías de su perfil.',
					]}
					note="4,6 sobre 5 con 53 reseñas en Google. «Hay mucha variedad (el mollete integral no lo encuentras en otro sitio)»."
					links={[
						{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
						{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					]}
				/>
			</div>

			<div class="band band-cream">
				<LocalMenu
					eyebrow="El mostrador"
					title="Panes <br /><em>y dulces.</em>"
					description="La ficha no publica carta ni precios. Esto es lo que citan la descripción del establecimiento y las reseñas de Google."
					cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					groups={MENU}
					note="Sin precios publicados: la panadería no tiene web ni carta online en su ficha. Para saber qué hay cada día —y a qué precio—, lo mejor es llamar al 951 24 32 68 o pasarse por el mostrador."
				/>
			</div>

			<section class="band band-pine shore" id="galeria">
				<div class="wrap">
					<div class="shore-copy">
						<p class="section-label">
							<span aria-hidden="true"></span> La fachada en Google Maps
						</p>
						<h2>
							El rótulo <br />
							<em>de la esquina.</em>
						</h2>
						<p>
							La ficha de Ponce tiene dos fotografías: las tartas que abren esta página y esta de la
							calle Lepanto, tomada el día de una procesión. No hay más, y la web no enseña ninguna
							que no exista.
						</p>
						<a class="button button-primary" href={MAPS.place} target="_blank" rel="noreferrer">
							Ver la ficha en Google Maps <span aria-hidden="true">↗</span>
						</a>
						<p class="shore-note">
							Imagen alojada en esta página y procedente del perfil del establecimiento en Google
							Maps. Si el titular lo pide, se retira.
						</p>
					</div>
					<figure class="shore-figure">
						<Image
							src={fachada}
							alt="Fachada de la panadería con los rótulos de Panadería Ponce y Boutique del Pan durante una procesión"
							widths={[420, 640, 820, 1000]}
							sizes="(max-width: 860px) 92vw, 34rem"
							format="avif"
							quality={68}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>
							· La calle Lepanto, el día de la procesión · Foto del perfil de Google Maps
						</figcaption>
					</figure>
				</div>
			</section>

			<div class="band band-cream">
				<LocalVisit
					eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
					title="A primera hora, <br /><em>en Lepanto.</em>"
					addressLines={[
						BUSINESS.street,
						BUSINESS.district,
						`${BUSINESS.postalCode} ${BUSINESS.city}`,
					]}
					hours={HOURS}
					hoursCaption="Horario"
					hoursNote="Horario publicado en la ficha de Google: de lunes a sábado hasta las 14:30 y el domingo hasta las 14:00, siempre desde las 6:00. En festivos puede cambiar; la propia ficha ya avisa de ello para el 1 de noviembre."
					mapTitle="Mapa de la Panadería Ponce en la calle Lepanto, 2, Málaga"
					mapEmbedUrl={MAPS.embed}
					mapLabel="Ponce · Carretera de Cádiz"
					mapHref={MAPS.place}
					links={[
						{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
						{ label: 'Cómo llegar', href: MAPS.directions, external: true },
						{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					]}
					contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
					reserveNote="No hay web propia ni pedidos online: se atiende en el mostrador y por teléfono. De accesibilidad, la ficha solo indica que no hay aparcamiento adaptado."
				/>
			</div>

			<div class="band band-kraft-soft">
				<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pasar.</em>" />
			</div>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografías de la ficha pública de Google Maps. Sin carta ni precios publicados por el establecimiento."
			ctaLabel="Llamar a Ponce"
			navAriaLabel="Enlaces de la Panadería Ponce"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
