---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/bar-restaurante-7-vidas-vertical-03.jpg';
import comedor from '../assets/fotos/bar-restaurante-7-vidas-apaisada-01.jpg';
import bravas from '../assets/fotos/bar-restaurante-7-vidas-vertical-06.jpg';
import calamares from '../assets/fotos/bar-restaurante-7-vidas-apaisada-05.jpg';
import cremaet from '../assets/fotos/bar-restaurante-7-vidas-apaisada-02.jpg';
import pueblo from '../assets/fotos/bar-restaurante-7-vidas-apaisada-04.jpg';
import moteros from '../assets/fotos/bar-restaurante-7-vidas-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const description = BUSINESS.description;

const galeria = [
	{
		src: comedor,
		alt: 'Comedor de 7 Vidas con mesas de mantel naranja, sillas de madera y ventanal a la calle',
	},
	{
		src: bravas,
		alt: 'Patatas bravas en cazuela de barro con alioli y pimentón en la terraza de 7 Vidas',
	},
	{
		src: calamares,
		alt: 'Ración de calamares a la romana con limón servida en 7 Vidas',
	},
	{
		src: cremaet,
		alt: 'Cremaet servido en vaso sobre plato blanco en 7 Vidas, Algimia de Almonacid',
	},
	{
		src: pueblo,
		alt: 'Vista de Algimia de Almonacid entre montañas, desde el mirador de la carretera',
	},
	{
		src: moteros,
		alt: 'Ruta de motos parada a la puerta de 7 Vidas, en la calle Latoneros de Algimia de Almonacid',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': ['Restaurant', 'BarOrPub'],
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['7 Vidas', 'Bar 7 Vidas', 'Restaurante 7 Vidas Algimia'],
	slogan: BUSINESS.tagline,
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 695 85 88 36',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Casera', 'Tapas'],
	areaServed: [
		{ '@type': 'City', name: 'Algimia de Almonacid' },
		{ '@type': 'AdministrativeArea', name: 'Alto Palancia' },
		{ '@type': 'AdministrativeArea', name: 'Castellón' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '23:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday', 'Sunday'],
			opens: '08:00',
			closes: '24:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Terraza en la calle',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const title = '7 Vidas · Bar restaurante en Algimia de Almonacid';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f4a3a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Bar Restaurante 7 Vidas, 7 Vidas Algimia de Almonacid, bar Algimia de Almonacid, restaurante Alto Palancia, menú del día Sierra de Espadán, terraza Algimia, bar de pueblo Castellón"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="7 Vidas · El bar de Algimia de Almonacid"
			ogDescription="Menús, bocadillos, bravas y cremaet en el Alto Palancia, con terraza en la calle y el comedor abierto a la sierra. Abre todos los días."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Bar Restaurante 7 Vidas con su terraza en la calle, en Algimia de Almonacid"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2f4a3a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-VC"
			postalCode={BUSINESS.postalCode}
			phone="+34695858836"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.region}`}
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'España',
				phone: '+34 695 85 88 36',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Bar restaurante · Algimia de Almonacid"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Latoneros, 21 · Algimia de Almonacid · Alto Palancia"
				title="El bar del pueblo,<br /><em>en plena Sierra de Espadán.</em>"
				lede="7 Vidas es el bar restaurante de la calle Latoneros, en el centro de Algimia de Almonacid: terraza en la acera, comedor con vistas a la sierra y una barra que abre todos los días, de la primera hora al cierre."
				image={fachada}
				imageAlt="Fachada de Bar Restaurante 7 Vidas con su terraza en la calle, en Algimia de Almonacid"
				primaryCta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Bar · Menús · Terraza"
				facts={[
					{ label: 'Nota', html: '<b>4,0 en Google</b> con 349 reseñas' },
					{ label: 'Horario', html: '<b>9:00 – 23:00</b> de lunes a viernes' },
					{ label: 'Fin de semana', html: '<b>8:00 – 24:00</b> sábado y domingo' },
					{ label: 'Terraza', html: '<b>En la calle</b>, con mesas fuera' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece 7 Vidas" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="El bar de todo el año<br /><em>en Algimia.</em>"
				paragraphs={[
					'El 7 Vidas está en la calle Latoneros, 21, en el centro de Algimia de Almonacid, un pueblo pequeño del Alto Palancia en la vertiente occidental del Parque Natural de la Sierra de Espadán. Es el bar de referencia del casco urbano: el sitio donde se desayuna, se almuerza y se come el menú del día.',
					'El local se reformó hace unos años y quedó un comedor amplio, con mesas de mantel naranja, sillas de madera y ventanales a la calle. La ficha de Google lo describe como bar, pub y restaurante de cocina española, y marca entrada y aseo adaptados para sillas de ruedas.',
					'Fuera, la terraza ocupa la acera con mesas y sillas de metal. Los fines de semana el pueblo se llena de gente de ruta y la calle se convierte en aparcamiento de motos: en una de las fotos del perfil aparece una expedición entera parada a la puerta. La barra trabaja el almuerzo, las tapas y el café de después.',
				]}
				note={`«${REVIEWS[0]}», resume una reseña de Google. Otra lo dice más corto: «${REVIEWS[1]}». Con 349 reseñas, la nota media es un 4 sobre 5.`}
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del bar', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La mesa"
				title="Bravas, bocadillos<br /><em>y menú del día.</em>"
				description="La ficha de Google no publica la carta con precios. Estos son los platos que aparecen en las fotos del perfil y en las reseñas del local."
				cta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="El menú del día cambia según lo que haya ese día y se consulta en la barra. Si vais en grupo, llama antes al 695 85 88 36 para avisar y reservar mesa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="El comedor,<br />la terraza<br /><em>y la mesa.</em>"
				description="Estas fotografías proceden del perfil de 7 Vidas en Google Maps: el comedor, las bravas, los calamares, el cremaet, el pueblo desde la carretera y una ruta de motos a la puerta."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del bar en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="C. Latoneros, 21 · 12414 Algimia de Almonacid · Castellón"
				title="En el centro<br /><em>del pueblo.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Castellón · Comunitat Valenciana']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="De lunes a viernes abre de 9:00 a 23:00; sábados y domingos, de 8:00 a 24:00. No cierra ningún día, aunque en festivos conviene confirmar por teléfono."
				mapTitle="Mapa de Bar Restaurante 7 Vidas en la calle Latoneros, 21, Algimia de Almonacid"
				mapEmbedUrl={MAPS.embed}
				mapLabel="7 Vidas · Algimia de Almonacid"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="Se reserva por teléfono, en el 695 85 88 36. La ficha marca acceso y aseo adaptados para sillas de ruedas, y hay terraza en la calle. Si vienes de ruta por la Sierra de Espadán, el bar está en el mismo casco del pueblo."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a 7 Vidas"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
