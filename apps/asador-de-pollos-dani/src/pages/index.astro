---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/asador-de-pollos-dani-apaisada-01.jpg';
import bocadillo from '../assets/fotos/asador-de-pollos-dani-vertical-02.jpg';

import { BUSINESS, FAQ, HIGHLIGHTS, HORARIO, HORARIO_AVISO, MAPS, MENU, RATING, RESENAS, SERVICIOS } from '../data/site';

const title = 'Asador de Pollos Dani · Pollo asado y comida a domicilio en Málaga';
const description =
	'Asador de Pollos Dani, en Av. Escritor Antonio Soler, 13 (Puerto de la Torre, 29010 Málaga). Pollos asados, camperos, croquetas y ensaladas, con comida a domicilio.';

const galeria = [
	{
		src: bocadillo,
		alt: 'Un campero de Asador de Pollos Dani con lomo, queso, lechuga y mayonesa, partido por la mitad',
	},
	{
		src: fachada,
		alt: 'La fachada de piedra de Asador de Pollos Dani con el rótulo, el dibujo del pollo y el teléfono de pedidos',
	},
];

const menuSchema = {
	'@type': 'Menu',
	name: 'Carta de Asador de Pollos Dani',
	inLanguage: 'es-ES',
	hasMenuSection: MENU.map((group) => ({
		'@type': 'MenuSection',
		name: group.title,
		hasMenuItem: group.items.map((item) => ({
			'@type': 'MenuItem',
			name: item.name,
			description: item.note,
		})),
	})),
};

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#dani`,
	name: BUSINESS.name,
	alternateName: ['ASADOR DE POLLOS DANI', 'Asador Dani Puerto de la Torre', 'Asador de Pollos Dani Málaga'],
	description:
		'Asador de pollos con comida a domicilio en la avenida Escritor Antonio Soler, 13, Puerto de la Torre (29010 Málaga). Pollos asados, camperos, croquetas y ensaladas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34722765990',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Pollo asado', 'Bocadillos', 'Comida a domicilio'],
	hasTakeaway: true,
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Puerto de la Torre' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.district,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	hasMenu: menuSchema,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '16:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday', 'Sunday'],
			opens: '20:30',
			closes: '23:30',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#191411" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Manrope:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Asador de Pollos Dani, pollo asado Puerto de la Torre, comida a domicilio Málaga, camperos nocturnos, croquetas, ensaladas, Escritor Antonio Soler, asador Dani"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollos asados, camperos, croquetas y ensaladas con comida a domicilio en la avenida Escritor Antonio Soler, 13, Puerto de la Torre."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="La fachada de Asador de Pollos Dani con su rótulo y el dibujo del pollo"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#191411"
			street={BUSINESS.street}
			city={BUSINESS.district}
			region={BUSINESS.region}
			geoRegion="ES-MA"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Puerto de la Torre"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.district,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Asador Dani"
			subtitle="Pollo asado · Puerto de la Torre"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Av. Escritor Antonio Soler, 13 · Puerto de la Torre, Málaga"
				title="Pollo asado <br /><em>y camperos.</em>"
				lede={`Asador de Pollos Dani es un asador de barrio con comida a domicilio en Puerto de la Torre. El pollo asado es la casa, y junto a él salen los camperos, las croquetas y las ensaladas que repiten las reseñas. Abre al mediodía casi toda la semana y suma cenas de viernes a domingo. Tiene ${RATING.label} sobre 5 en Google con ${RATING.count} reseñas.`}
				image={fachada}
				imageAlt="La fachada de piedra de Asador de Pollos Dani con el rótulo, el dibujo del pollo y el teléfono de pedidos"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: `<b>${RATING.label}</b> en Google · ${RATING.count} reseñas` },
					{ label: 'Horario', html: '<b>11:00–16:00</b> · cenas viernes a domingo' },
					{ label: 'Servicio', html: '<b>A domicilio</b> y para llevar' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Pollo asado · camperos · croquetas"
			/>

			<LocalChips label="Lo que ofrece Asador de Pollos Dani" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un asador <br /><em>de barrio.</em>"
				paragraphs={[
					'Asador de Pollos Dani está en la avenida Escritor Antonio Soler, 13, en Puerto de la Torre. La fachada de piedra, el rótulo rojo y el dibujo del pollo con el gorro de cocinero se ven desde la acera; junto a la puerta, el cartel anuncia «Comida para llevar · Pedidos: 722 76 59 90».',
					'Google lo clasifica como comida a domicilio. Las reseñas dejan claro qué sale de la cocina: pollo asado, camperos nocturnos, croquetas y ensaladas. La ficha no publica carta ni precios.',
					'El horario es de mediodía casi toda la semana: de 11:00 a 16:00 de lunes a domingo, con el martes cerrado y el viernes empezando a las 11:00 y cerrando a las 15:30. Viernes, sábado y domingo abren además de 20:30 a 23:30.',
					'Google le da 4,9 sobre 5 con 29 reseñas. Una destaca «súper bueno el pollo y ensaladas, muy buena atención»; otra asegura que son «los mejores pollos asados»; y una tercera sentencia: «Buenísimo todo y las croquetas».',
				]}
				note="La ficha no publica página web, carta ni precios. Los platos de esta página son los que nombran las reseñas y lo que muestra la foto del perfil. El reparto y la disponibilidad se consultan por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver las fotos', href: '#galeria' },
				]}
			/>

			<section class="highlight-strip" aria-labelledby="highlights-title">
				<div class="wrap">
					<p class="section-label section-label-light"><span aria-hidden="true"></span> Lo que se asa</p>
					<h2 id="highlights-title">Pollo, camperos <br /><em>y croquetas.</em></h2>
					<ul class="highlights">
						{
							HIGHLIGHTS.map((item, index) => (
								<li>
									<span class="highlight-mark" aria-hidden="true">
										0{index + 1}
									</span>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<LocalMenu
				eyebrow="La carta"
				title="Pollo y camperos <br /><em>de la casa.</em>"
				description="La ficha de Google no publica carta ni precios. Esto es lo que nombran las reseñas y lo que aparece en la foto del perfil."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="La ficha no publica precios. Los platos de esta lista son los que aparecen en las reseñas del perfil de Google y en la foto del local, consultados en octubre de 2026. La disponibilidad y el reparto se confirman por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada <br /><em>y el campero.</em>"
				description="Las dos fotografías del perfil de Asador de Pollos Dani en Google Maps: la fachada del local y un campero con lomo, queso, lechuga y mayonesa."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dilo y la eliminamos."
			/>

			<section class="rating-section" aria-labelledby="rating-title">
				<div class="wrap rating-grid">
					<div class="rating-copy">
						<p class="section-label"><span aria-hidden="true"></span> La ficha de Google</p>
						<h2 id="rating-title">4,9 sobre 5, <em>con 29 reseñas.</em></h2>
						<p>
							La valoración que publica Google en octubre de 2026 es de 4,9 con 29 opiniones. Las
							reseñas destacadas hablan del pollo, de los camperos, de las croquetas, de las
							ensaladas y de la atención; aquí se reproducen tal como aparecen en la ficha.
						</p>
						<ul class="reviews">
							{
								RESENAS.map((resena) => (
									<li>
										<p>«{resena.texto}»</p>
										<span aria-label={`${resena.valor} de 5 estrellas`}>
											{'★'.repeat(resena.valor)}
											{'☆'.repeat(5 - resena.valor)} <small>Reseña publicada en Google</small>
										</span>
									</li>
								))
							}
						</ul>
						<a class="simple-link" href={MAPS.reviews} target="_blank" rel="noreferrer">
							Ver todas las reseñas <span aria-hidden="true">↗</span>
						</a>
					</div>
					<div class="rating-badge" aria-hidden="true">
						<strong>4,9</strong>
						<span>★★★★★</span>
						<small>29 reseñas<br />en Google</small>
					</div>
				</div>
			</section>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
				title="En Puerto de la Torre, <br /><em>Antonio Soler.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HORARIO.map((row) => ({ day: row.dia, value: row.horas, closed: row.closed }))}
				hoursCaption="Horario"
				hoursNote={`Horario publicado en la ficha de Google: mediodía de lunes a domingo (martes cerrado), de 11:00 a 16:00, salvo el viernes que cierra a las 15:30. Cenas de 20:30 a 23:30 viernes, sábado y domingo. ${HORARIO_AVISO}`}
				mapTitle="Mapa de Asador de Pollos Dani en la avenida Escritor Antonio Soler, 13, Puerto de la Torre, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Av. Escritor Antonio Soler, 13"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
					{ label: 'Vista de la calle', href: MAPS.streetView, external: true },
				]}
				contactLink={{ label: `Llamar al ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				reserveNote="Pedidos por teléfono: la ficha no publica pedidos online. Google lo clasifica como comida a domicilio; el reparto, la zona y el importe mínimo se confirman llamando. La ficha no publica datos de accesibilidad, así que conviene preguntar antes si necesitas acceso para silla de ruedas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pedir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.district}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a Asador Dani"
			navAriaLabel="Enlaces de Asador de Pollos Dani"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
