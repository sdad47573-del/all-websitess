---
import '../styles/global.css';
import { business, legal, photos } from '../lib/business';
import { content } from '../lib/content';

/**
 * Marco de las páginas legales (aviso legal, privacidad y cookies). La LOPDGDD obliga a que
 * estén en español, así que no tienen versión inglesa: se accede siempre con `lang="es"`.
 */
interface Props {
	title: string;
	description: string;
	path: string;
	heading: string;
	updated?: string;
}

const { title, description, path, heading, updated = legal.lastUpdated } = Astro.props;
const page = content.es;
const canonical = `${business.site}${path}`;

// Las páginas legales no tenían datos estructurados: sin ellos Google no sabe que
// cuelgan de un restaurante concreto ni de dónde forman parte.
const webPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': `${canonical}#webpage`,
	url: canonical,
	name: title,
	description,
	inLanguage: 'es',
	isPartOf: { '@id': `${business.site}/#website` },
	about: { '@id': `${business.site}/#restaurante` },
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: business.name, item: `${business.site}/` },
		{ '@type': 'ListItem', position: 2, name: heading, item: canonical },
	],
};
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${business.site}/#website`,
	url: `${business.site}/`,
	name: business.name,
	inLanguage: 'es',
	publisher: { '@id': `${business.site}/#restaurante` },
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0e2a35" />
		<meta name="description" content={description} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(webPageSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">JC</span>
				<span class="brand-name">Juan Carmona<small>La Carihuela · Torremolinos</small></span>
			</a>
			<nav aria-label={page.legalNavLabel}>
				<a href="/aviso-legal/">Aviso legal</a>
				<a href="/privacidad/">Privacidad</a>
				<a href="/cookies/">Cookies</a>
			</nav>
			<div class="header-actions">
				<a class="language" href="/en/" lang="en">{page.languageLabel}</a>
			</div>
		</header>

		<main class="legal-main">
			<p class="section-label"><span aria-hidden="true">❋</span>{business.name}</p>
			<h1>{heading}</h1>
			<p class="legal-updated">Última actualización: {updated}</p>
			<slot />
		</main>

		<footer class="site-footer">
			<a class="brand" href="/" aria-label={`${business.name}, inicio`}>
				<span class="brand-mark" aria-hidden="true">JC</span>
				<span class="brand-name">Juan Carmona<small>La Carihuela · Torremolinos</small></span>
			</a>
			<p>{page.footerNote}<br />{business.streetAddress}, {business.neighborhood} · {business.postalCode}</p>
			<nav class="footer-legal-links" aria-label={page.legalNavLabel}>
				<a href="/aviso-legal/">Aviso legal</a>
				<a href="/privacidad/">Política de privacidad</a>
				<a href="/cookies/">Política de cookies</a>
			</nav>
		</footer>
	</body>
</html>