---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import heroImage from '../assets/fotos/restaurante-orotapia-apaisada-07.jpg';
import interior from '../assets/fotos/restaurante-orotapia-apaisada-01.jpg';
import chuletaFuera from '../assets/fotos/restaurante-orotapia-vertical-02.jpg';
import carpaccio from '../assets/fotos/restaurante-orotapia-vertical-03.jpg';
import chuletaCruda from '../assets/fotos/restaurante-orotapia-vertical-04.jpg';
import piedra from '../assets/fotos/restaurante-orotapia-vertical-05.jpg';
import tartaQueso from '../assets/fotos/restaurante-orotapia-apaisada-06.jpg';
import piedraMesa from '../assets/fotos/restaurante-orotapia-apaisada-08.jpg';
import vieiras from '../assets/fotos/restaurante-orotapia-apaisada-09.jpg';
import vieirasPizarra from '../assets/fotos/restaurante-orotapia-vertical-10.jpg';

const business = {
	name: 'Restaurante Orotapia',
	brand: 'Orotapia',
	tagline: 'Chuletas maduradas a la piedra en Oropesa del Mar',
	street: 'Carrer de Terol, 5',
	district: 'Oropesa del Mar',
	city: 'Oropesa del Mar',
	region: 'Comunitat Valenciana',
	postalCode: '12594',
	phone: '624 94 84 78',
	latitude: 40.0866261,
	longitude: 0.1434115,
	rating: 4.7,
	reviewsCount: 427,
	site: 'https://restaurante-orotapia.vercel.app',
};

// Identificadores públicos de la ficha de Google Maps del local.
const cid = '0x12a00567330cea6b:0x7bbd5a99cb2200e0';
const cidDecimal = '8916382453847949536';
const placeId = 'ChIJa-oMM2cFoBIR4AAiy5lavXs';

const mapsUrl =
	'https://www.google.com/maps/place/RESTAURANTE+OROTAPIA/@40.0866261,0.1434115,17z/data=!3m1!4b1!4m6!3m5!1s0x12a00567330cea6b:0x7bbd5a99cb2200e0!8m2!3d40.0866261!4d0.1434115!16s%2Fg%2F11tgd7l4jr?authuser=0&hl=es&entry=ttu';
const cidUrl = `https://www.google.com/maps?cid=${cidDecimal}`;
const reviewsUrl = `https://search.google.com/local/reviews?placeid=${placeId}&q=Restaurante+Orotapia&hl=es&gl=ES`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&hl=es&output=embed`;
const phoneHref = 'tel:+34624948478';

const description =
	'Restaurante Orotapia, parrilla de carnes en Oropesa del Mar (Castellón): chuletas maduradas que se sirven en pizarra y se terminan en la piedra caliente. Carrer de Terol, 5 · 12594. Viernes y sábado de 12:00 a 16:00. 4,7 en Google.';

const servicios = [
	'Parrilla',
	'Carnes asadas',
	'Chuletas maduradas',
	'Carne a la piedra',
	'Restaurante de carnes',
	'Entrantes para compartir',
	'Postres caseros',
	'Comida de mediodía',
	'Reservas por teléfono',
	'Asientos accesibles',
];

const grupos = [
	{
		title: 'La parrilla',
		items: [
			{
				name: 'Chuleta madurada a la piedra',
				note: 'la especialidad de la casa: llega en pizarra y se termina en la piedra caliente de la mesa',
			},
			{
				name: 'Carne a la piedra',
				note: 'se sirve cruda para que cada uno la haga a su punto',
			},
			{
				name: 'Carnes asadas a la parrilla',
				note: 'el otro pilar de la carta, junto a la chuleta',
			},
		],
	},
	{
		title: 'Para empezar',
		items: [
			{
				name: 'Croquetas de cecina y de jamón',
				note: 'las que los clientes recomiendan en las reseñas de Google',
			},
			{
				name: 'Vieiras gratinadas',
				note: 'servidas en su concha sobre pizarra, con sal en escamas',
			},
			{
				name: 'Entrantes para compartir',
				note: 'raciones pensadas para abrir la comida en el centro de la mesa',
			},
		],
	},
	{
		title: 'Para terminar',
		items: [
			{
				name: 'Tarta de queso con coco rallado',
				note: 'cremosa y terminada con coco, uno de los postres de la casa',
			},
			{
				name: 'Postre casero del día',
				note: 'varía; pregúntalo en el local',
			},
		],
	},
	{
		title: 'Bebidas',
		items: [
			{ name: 'Vino tinto de la casa', note: 'se sirve en copa junto a la carne' },
			{ name: 'Refrescos y cerveza' },
			{ name: 'Café y sobremesa' },
		],
	},
];

const galeria = [
	{
		src: interior,
		alt: 'Interior de Restaurante Orotapia con la barra, las mesas y el neón de la casa, en Oropesa del Mar',
	},
	{
		src: chuletaFuera,
		alt: 'Chuleta a la piedra de Restaurante Orotapia con copa de vino tinto en la mesa, Oropesa del Mar',
	},
	{
		src: carpaccio,
		alt: 'Carpaccio de ternera de Restaurante Orotapia bajo el neón de la casa, Oropesa del Mar',
	},
	{
		src: chuletaCruda,
		alt: 'Chuleta cruda con sal en escamas servida en plato de barro en Restaurante Orotapia, Oropesa del Mar',
	},
	{
		src: piedra,
		alt: 'Carne a la piedra terminándose sobre la piedra caliente en Restaurante Orotapia, Oropesa del Mar',
	},
	{
		src: tartaQueso,
		alt: 'Tarta de queso con coco rallado de Restaurante Orotapia, postre de la casa en Oropesa del Mar',
	},
	{
		src: piedraMesa,
		alt: 'Piedra caliente con la carne y la pizarra de Restaurante Orotapia en la mesa, Oropesa del Mar',
	},
	{
		src: vieiras,
		alt: 'Vieiras gratinadas en su concha con sal en escamas en Restaurante Orotapia, Oropesa del Mar',
	},
	{
		src: vieirasPizarra,
		alt: 'Vieiras de Restaurante Orotapia emplatadas en pizarra, cocina de parrilla en Oropesa del Mar',
	},
];

const faqs = [
	{
		q: '¿Dónde está Restaurante Orotapia?',
		a: 'En el Carrer de Terol, 5, 12594 Oropesa del Mar (Castellón), en la provincia de Castellón y a pocos minutos de la playa. Desde esta página puedes abrir Google Maps y trazar la ruta hasta la puerta con el botón «Cómo llegar».',
	},
	{
		q: '¿Qué días y a qué hora abre?',
		a: 'La ficha de Google marca servicio de mediodía los viernes y los sábados, de 12:00 a 16:00, y el resto de días cerrado. Al ser un horario tan corto, conviene confirmarlo por teléfono antes de desplazarse, sobre todo en temporada alta y en festivos.',
	},
	{
		q: '¿Qué es una chuleta madurada a la piedra?',
		a: 'Es la especialidad de la casa: carne de vacuno madurada durante semanas para concentrar sabor y ternura, que se sirve en pizarra y se termina en una piedra caliente puesta en la mesa. Así cada comensal decide el punto de la carne y el último bocado llega caliente.',
	},
	{
		q: '¿Hay que reservar mesa?',
		a: 'Con solo dos servicios a la semana y un comedor pequeño, lo más práctico es llamar al 624 94 84 78 y reservar. El teléfono es el canal de contacto publicado en la ficha del restaurante; no hay reserva online en esta web.',
	},
	{
		q: '¿Se puede ir con silla de ruedas?',
		a: 'La ficha de Google del restaurante indica que el local dispone de asientos adaptados para sillas de ruedas. Si necesitas una mesa concreta o más espacio, avisa al reservar por teléfono.',
	},
	{
		q: '¿Dónde puedo ver la carta y los precios?',
		a: 'Esta web no publica precios porque no hay carta oficial publicada: no se inventan importes ni platos. La carta del día y los precios se consultan en el local o por teléfono, y en la ficha de Google están las fotos y las reseñas de otros clientes.',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: 'Restaurante Orotapia',
	alternateName: ['Orotapia', 'RESTAURANTE OROTAPIA Oropesa del Mar'],
	slogan: business.tagline,
	description,
	url: `${business.site}/`,
	telephone: '+34 624 94 84 78',
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	acceptsReservations: 'True',
	servesCuisine: ['Parrilla', 'Carnes asadas', 'Chuletas maduradas', 'Cocina española'],
	areaServed: [
		{ '@type': 'City', name: 'Oropesa del Mar' },
		{ '@type': 'AdministrativeArea', name: 'Plana Alta' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	hasGoogleReviews: reviewsUrl,
	sameAs: [cidUrl],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google Place ID', value: placeId },
		{ '@type': 'PropertyValue', name: 'Google CID', value: cid },
	],
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday'], opens: '12:00', closes: '16:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos accesibles con silla de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Reservas por teléfono', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Carne madurada a la piedra', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: business.rating,
		reviewCount: business.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};

const nav = [
	{ label: 'El local', href: '#casa' },
	{ label: 'Qué pedir', href: '#carta' },
	{ label: 'Galería', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<title>Restaurante Orotapia · Chuletas maduradas en Oropesa</title>
		<meta name="theme-color" content="#14100e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,600&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={business.name}
			description={description}
			keywords="Restaurante Orotapia, Orotapia Oropesa del Mar, chuletas maduradas a la piedra, parrilla Oropesa del Mar, carne a la piedra Castellón, restaurante carnes ORPESA, comer en Oropesa del Mar, Carrer de Terol 5, restaurante Plana Alta, chuleta madurada Castellón, asador Oropesa"
			canonical={`${business.site}/`}
			site={business.site}
			ogTitle="Restaurante Orotapia · Chuletas maduradas a la piedra en Oropesa del Mar"
			ogDescription="Parrilla de carnes en Oropesa del Mar: chuletas maduradas que se sirven en pizarra y se terminan en la piedra caliente. Carrer de Terol, 5. Viernes y sábado, 12:00–16:00. 4,7 en Google."
			ogImage={`${business.site}/og.jpg`}
			ogImageAlt="Chuleta madurada a la piedra de Restaurante Orotapia, parrilla en Oropesa del Mar (Castellón)"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={business.name}
			themeColor="#14100e"
			street={business.street}
			city={business.city}
			region={business.region}
			geoRegion="ES-VC"
			postalCode={business.postalCode}
			phone={business.phone}
			latitude={business.latitude}
			longitude={business.longitude}
			placeName="Oropesa del Mar, Castellón"
			preload={[heroImage]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark="O"
			name={business.brand}
			subtitle="Parrilla · Oropesa del Mar"
			phone={business.phone}
			phoneHref={phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Oropesa del Mar · Castellón"
				title={piezas.portada.titulo}
				lede="Parrilla y carnes asadas en el Carrer de Terol, 5, a un paso de la playa de Oropesa del Mar. Chuletas maduradas durante semanas que se sirven en pizarra y se terminan en la piedra caliente de la mesa, con entrantes para compartir y postres de la casa."
				image={heroImage}
				imageAlt="Chuleta madurada a la piedra servida en pizarra en Restaurante Orotapia, Oropesa del Mar (Castellón)"
				primaryCta={{ label: 'Llamar 624 94 84 78', href: phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: mapsUrl, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,7</b> en Google (427 reseñas)' },
					{ label: 'Especialidad', html: 'Chuleta madurada a la piedra' },
					{ label: 'Horario', html: 'Viernes y sábado, 12:00–16:00' },
					{ label: 'Zona', html: 'Oropesa del Mar, Castellón' },
				]}
				galleryHref={mapsUrl}
			/>

			<LocalChips label="Qué ofrece Restaurante Orotapia" items={servicios} />

			<LocalAbout
				label="Una parrilla en el centro de Oropesa"
				title="Carne madurada,<br />piedra caliente<br /><em>y sobremesa larga.</em>"
				paragraphs={[
					'Restaurante Orotapia está en el Carrer de Terol, 5, en pleno casco de Oropesa del Mar y a unos minutos de la playa. Es un local de comedor pequeño y tranquilo, con paredes verdes, barra iluminada y un neón con el nombre de la casa que se ha convertido en la foto más repetida de su ficha de Google.',
					'La cocina va por un camino muy claro: la parrilla. La especialidad son las chuletas maduradas, carne que reposa semanas para concentrar sabor y que se sirve en pizarra para terminarla en la piedra caliente que traen a la mesa. Alrededor, entrantes para compartir, vieiras gratinadas y alguna sorpresa de cuchara como las croquetas de cecina y de jamón que repiten los clientes en las reseñas.',
					'El servicio es de mediodía y solo dos días a la semana, viernes y sábados de 12:00 a 16:00, así que la mesa se reserva por teléfono: el comedor es limitado y el día que abre se llena. Para cerrar, la tarta de queso con coco y el café de sobremesa.',
				]}
				note="La ficha de Google reúne 427 opiniones con una nota media de 4,7. Lo que más se repite: «la chuleta espectacular, mantequilla pura», «raciones generosas y servicio excelente» y el consejo de pedir las croquetas de cecina y de jamón. Oropesa del Mar es una localidad muy estacional, así que confirma horario y disponibilidad antes de venir fuera de temporada."
				links={[
					{ label: 'Leer reseñas en Google', href: reviewsUrl, external: true },
					{ label: 'Ficha del restaurante', href: cidUrl, external: true },
					{ label: 'Cómo llegar', href: directionsUrl, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="Lo más pedido"
				title="Qué pedir<br /><em>en Orotapia.</em>"
				description="Selección hecha a partir de la descripción de la ficha de Google («chuletas maduradas a la piedra»), de los platos que aparecen en sus fotos y de los que los clientes citan en las reseñas. La carta cambia, así que pregunta al reservar."
				cta={{ label: 'Reservar por teléfono', href: phoneHref }}
				groups={grupos}
				note="Esta web no publica precios: no hay carta oficial publicada y no se inventan importes. La carta del día y el precio de la carne se confirman en el local o por teléfono."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La carne,<br /><em>la piedra y la sala.</em>"
				description="Estas fotografías proceden del perfil de Restaurante Orotapia en Google Maps, con imágenes de la ficha y de sus clientes: la carne a la piedra, la chuleta en crudo, las vieiras, el postre y el comedor con su neón."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: mapsUrl }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Carrer de Terol, 5 · 12594 Oropesa del Mar"
				title="Nos vemos<br /><em>en Oropesa.</em>"
				addressLines={[
					business.street,
					business.district,
					`${business.postalCode} ${business.city}`,
					'Castellón, España',
				]}
				hours={[
					{ day: 'Lunes', value: 'Cerrado', closed: true },
					{ day: 'Martes', value: 'Cerrado', closed: true },
					{ day: 'Miércoles', value: 'Cerrado', closed: true },
					{ day: 'Jueves', value: 'Cerrado', closed: true },
					{ day: 'Viernes', value: '12:00 – 16:00' },
					{ day: 'Sábado', value: '12:00 – 16:00' },
					{ day: 'Domingo', value: 'Cerrado', closed: true },
				]}
				hoursNote="Horario publicado en la ficha de Google: solo viernes y sábado, servicio de mediodía. En festivos, puentes y temporada alta el horario puede ampliarse o cambiar, así que llama al 624 94 84 78 antes de ir."
				mapTitle="Mapa de Restaurante Orotapia en el Carrer de Terol, 5, Oropesa del Mar, Castellón"
				mapEmbedUrl={mapEmbedUrl}
				mapLabel="Restaurante Orotapia · Oropesa del Mar"
				mapHref={cidUrl}
				links={[
					{ label: 'Cómo llegar', href: directionsUrl, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: mapsUrl, external: true },
				]}
				contactLink={{ label: `+34 ${business.phone}`, href: phoneHref }}
				reserveNote="Reservas por teléfono, en el 624 94 84 78. No hay reserva online ni formulario en esta web. La ficha de Google indica asientos adaptados para sillas de ruedas; si necesitas una mesa concreta o más espacio, avisa al reservar."
			/>

			<LocalFaq items={faqs} />
		</main>

		<LocalFooter
			mark="O"
			name={business.name}
			address={`${business.street} · ${business.postalCode} ${business.city}`}
			links={[
				{ label: 'Google Maps ↗', href: mapsUrl, external: true },
				{ label: 'Reseñas ↗', href: reviewsUrl, external: true },
				{ label: business.phone, href: phoneHref },
			]}
			phone={business.phone}
			phoneHref={phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Orotapia"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
