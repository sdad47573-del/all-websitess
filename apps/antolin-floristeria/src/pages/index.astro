---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const business = {
	name: 'Antolín Floristería',
	listingName: 'ANTOLÍN FLORISTERÍA (Antigua Lunaflor Floristería)',
	city: 'Málaga',
	latitude: 36.7002512,
	longitude: -4.4449136,
	site: 'https://antolin-floristeria.vercel.app',
};
const mapsUrl =
	'https://www.google.com/maps/place/ANTOL%C3%8DN+FLORISTER%C3%8DA+(+Antigua+Lunaflor+Florister%C3%ADa)/@36.7002512,-4.4449136,17z/data=!3m1!4b1!4m6!3m5!1s0xd72f762ea8a81dd:0xd8914db4f2fa6f05!8m2!3d36.7002512!4d-4.4449136!16s%2Fg%2F11rkb6x00s';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const photos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const manifest = import.meta.glob<{ default: Record<string, { file: string; author?: string }> }>(
	'../assets/fotos/.maps-manifest.json',
	{ eager: true, import: 'default' },
);
const photoCredits = Object.values(manifest)[0] ?? {};
const gallery = Object.entries(photos)
	.map(([path, photo]) => {
		const filename = path.split('/').at(-1) ?? '';
		const credit = Object.values(photoCredits).find((entry) => entry.file === filename);
		return {
			image: photo.default,
			filename,
			author: credit?.author?.trim() || 'Autoría no indicada en Google Maps',
		};
	})
	.sort((a, b) => a.filename.localeCompare(b.filename));
const heroPhoto =
	gallery.find(
		({ filename }) => filename.includes('apaisada') || filename.includes('panoramica'),
	) ?? gallery[0];
const title = 'Antolín Floristería | Flores en Málaga';
const description =
	'Antolín Floristería, antes Lunaflor, en Málaga. Descubre fotografías del establecimiento, consulta su ubicación y cómo llegar.';
const schema = {
	'@context': 'https://schema.org',
	'@type': 'Florist',
	name: business.name,
	alternateName: business.listingName,
	description,
	url: `${business.site}/`,
	image: gallery.slice(0, 4).map(({ image }) => new URL(image.src, business.site).toString()),
	address: { '@type': 'PostalAddress', addressLocality: business.city, addressCountry: 'ES' },
	geo: { '@type': 'GeoCoordinates', latitude: business.latitude, longitude: business.longitude },
	hasMap: mapsUrl,
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#342d3b" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image:alt" content={`Fotografías de ${business.name} en Málaga`} />
		{heroPhoto && (
			<meta property="og:image" content={new URL(heroPhoto.image.src, business.site).toString()} />
		)}
		<meta name="twitter:card" content={heroPhoto ? 'summary_large_image' : 'summary'} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>
		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Antolín Floristería, inicio">
				<span class="brand-flower" aria-hidden="true">
					✿
				</span>
				<span>
					ANTOLÍN<small>FLORISTERÍA · MÁLAGA</small>
				</span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#esencia">La floristería</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Ubicación</a>
			</nav>
			<a class="header-cta" href={directionsUrl} target="_blank" rel="noopener noreferrer">
				Cómo llegar <span aria-hidden="true">↗</span>
			</a>
		</header>
		<main id="contenido">
			<section class="hero" id="inicio">
				<div class="hero-copy">
					<p class="eyebrow">
						<span></span> FLORES QUE CUENTAN HISTORIAS
					</p>
					<h1>
						Un jardín de
						<br />
						<em>ideas bonitas.</em>
					</h1>
					<p class="hero-lede">
						Conoce Antolín Floristería, anteriormente Lunaflor, en Málaga. Un espacio para descubrir
						flores, plantas y detalles especiales.
					</p>
					<div class="hero-actions">
						<a
							class="button button-light"
							href={directionsUrl}
							target="_blank"
							rel="noopener noreferrer"
						>
							Encuentra la tienda <span aria-hidden="true">↗</span>
						</a>
						<a class="text-link" href="#galeria">
							Explorar fotos <span aria-hidden="true">↓</span>
						</a>
					</div>
					<div class="hero-location">
						<span aria-hidden="true">⌖</span>
						<span>
							FLORISTERÍA ANTOLÍN<small>MÁLAGA · ANDALUCÍA</small>
						</span>
					</div>
				</div>
				<div class="hero-visual">
					{heroPhoto ? (
						<figure class="hero-photo">
							<Image
								src={heroPhoto.image}
								alt="Antolín Floristería, fotografía publicada en su ficha de Google Maps"
								widths={[600, 900, 1200]}
								sizes="(min-width: 900px) 48vw, 100vw"
								quality={82}
								loading="eager"
								fetchpriority="high"
							/>
							<figcaption>
								Flores para cada historia <span>✿</span>
							</figcaption>
						</figure>
					) : (
						<div class="hero-placeholder">
							<span aria-hidden="true">✿</span>
							<p>
								Un detalle que
								<br />
								florece.
							</p>
						</div>
					)}
					<div class="hero-stamp" aria-hidden="true">
						<span>FLORES</span>
						<b>✿</b>
						<span>CON ALMA</span>
					</div>
				</div>
				<div class="hero-baseline">
					<span>36.70025° N</span>
					<i></i>
					<span>4.44491° O</span>
					<i></i>
					<span>UN LUGAR PARA FLORECER</span>
				</div>
			</section>
			<section class="intro section-pad" id="esencia">
				<div class="section-kicker">
					<span>01</span>
					<i></i>
					<span>LA BELLEZA DE LO NATURAL</span>
				</div>
				<div class="intro-grid">
					<h2>
						Un pequeño gesto,
						<br />
						un gran <em>recuerdo.</em>
					</h2>
					<div class="intro-copy">
						<p>
							Las flores acompañan momentos, expresan cariño y llenan de vida cualquier rincón.
							Antolín Floristería —antigua Lunaflor— forma parte del paisaje floral de Málaga.
						</p>
						<p>
							Descubre su ubicación y las fotografías compartidas en la ficha pública del
							establecimiento.
						</p>
						<a class="inline-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
							Ver ficha de Antolín en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>
			<section class="gallery-section" id="galeria">
				<div class="gallery-head section-pad">
					<div>
						<div class="section-kicker">
							<span>02</span>
							<i></i>
							<span>UN VISTAZO A LA FLORISTERÍA</span>
						</div>
						<h2>
							Formas, color
							<br />y <em>naturaleza.</em>
						</h2>
					</div>
					<p>
						Una selección de fotografías publicadas en la ficha de Antolín Floristería en Google
						Maps.
					</p>
				</div>
				{gallery.length ? (
					<div class="gallery-grid">
						{gallery.map(({ image, author }, index) => (
							<figure class={`gallery-item gallery-item-${index % 4}`}>
								<Image
									src={image}
									alt={`Fotografía ${index + 1} de Antolín Floristería en Málaga, publicada en Google Maps`}
									widths={[360, 600, 900]}
									sizes="(min-width: 1100px) 30vw, (min-width: 700px) 46vw, 92vw"
									quality={78}
									loading="lazy"
								/>
								<figcaption>
									<span>ANTOLÍN FLORISTERÍA</span>
									<small>{author}</small>
								</figcaption>
							</figure>
						))}
					</div>
				) : (
					<div class="gallery-empty section-pad">
						<span aria-hidden="true">✿</span>
						<p>Visita la ficha de Google Maps para ver fotografías de la floristería.</p>
						<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
							Abrir ficha ↗
						</a>
					</div>
				)}
				<p class="gallery-credit">
					Fotografías de la ficha pública de Google Maps ·{' '}
					<a href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ver ficha completa ↗
					</a>
				</p>
			</section>
			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<div class="section-kicker">
						<span>03</span>
						<i></i>
						<span>ENCUÉNTRANOS</span>
					</div>
					<h2>
						Ven a descubrir
						<br />
						<em>Antolín.</em>
					</h2>
					<p>
						Consulta la ubicación de Antolín Floristería en Málaga y abre las indicaciones para
						llegar.
					</p>
					<a
						class="button button-dark"
						href={directionsUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						Cómo llegar <span aria-hidden="true">↗</span>
					</a>
					<a class="review-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">
						Ver la ficha del establecimiento
					</a>
				</div>
				<div class="map-card">
					<iframe
						title="Mapa de Antolín Floristería en Málaga"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
					<span class="map-tag">MÁLAGA · ANDALUCÍA</span>
				</div>
			</section>
		</main>
		<footer>
			<a class="brand footer-brand" href="#inicio">
				<span class="brand-flower" aria-hidden="true">
					✿
				</span>
				<span>
					ANTOLÍN<small>FLORISTERÍA · MÁLAGA</small>
				</span>
			</a>
			<p>Un jardín de ideas bonitas.</p>
			<span>© {new Date().getFullYear()} Antolín Floristería</span>
		</footer>
	</body>
</html>
