---
import '../styles/global.css';

const business = {
	name: 'La Mona Grill & Show',
	short: 'La Mona',
	street: 'Urb. La Atalaya 36',
	city: 'Conil de la Frontera',
	postalCode: '11140',
	phone: '+34 669 28 36 83',
	latitude: 36.2801549,
	longitude: -6.0927891,
	site: 'https://la-mona-grill-show.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/La+Mona+Grill+%26+Show/@36.2801549,-6.0927891,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c391e2d8176d7:0xabbed84619b491b2!8m2!3d36.2801549!4d-6.0927891!16s%2Fg%2F11rfqm5x4v?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=17&output=embed`;
const phoneHref = 'tel:+34669283683';

const specialties = [
	{
		kicker: 'A la brasa',
		title: 'Burgers gourmet',
		text: 'Hamburguesas gourmet a la brasa, reconocidas en Conil.',
	},
	{
		kicker: 'En vivo',
		title: 'Shows y música',
		text: 'Cenas con música, espectáculos y ambiente inmejorable.',
	},
	{
		kicker: 'Para cenar',
		title: 'Noches en La Atalaya',
		text: 'Las mejores burgers para cenar antes del show.',
	},
	{
		kicker: 'De tarde',
		title: 'Lun–jue 14–23',
		text: 'De lunes a jueves de 14:00 a 23:00, según sus redes.',
	},
	{
		kicker: 'Fin de semana',
		title: 'Horario extendido',
		text: 'Viernes y sábado con horario extendido: confirma el cierre en el 669 28 36 83.',
	},
	{
		kicker: 'Aviso',
		title: 'Sin carta publicada',
		text: 'No publicamos carta ni precios por falta de fuente verificable.',
	},
];

const gallery = [
	{ src: '/fotos/grill.svg', alt: 'Ilustración del grill — sustituye por foto propia' },
	{ src: '/fotos/burger.svg', alt: 'Ilustración de burgers — sustituye por foto propia' },
	{ src: '/fotos/show.svg', alt: 'Ilustración del show — sustituye por foto propia' },
	{ src: '/fotos/terraza.svg', alt: 'Ilustración de la terraza — sustituye por foto propia' },
	{ src: '/fotos/noche.svg', alt: 'Ilustración de la noche — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está La Mona?',
		a: 'En Urb. La Atalaya 36, Conil de la Frontera (Cádiz).',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De lunes a jueves de 14:00 a 23:00; viernes y sábado con horario extendido a confirmar en el 669 28 36 83.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Hamburguesas gourmet a la brasa. Confirma la carta del día en el local.',
	},
	{
		q: '¿Hay espectáculos?',
		a: 'Sí: grill con shows en vivo, música y ambiente. Consulta la programación en sus redes.',
	},
	{
		q: '¿Cómo llego?',
		a: 'En la Urb. La Atalaya de Conil. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'La Mona Grill & Show en Urb. La Atalaya 36, Conil: burgers gourmet a la brasa con shows en vivo. Lun–jue 14–23. Tel. 669 28 36 83.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 669 28 36 83',
	image: [`${business.site}/fotos/grill.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Americana', 'Española', 'Hamburguesas'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
			opens: '14:00',
			closes: '23:00',
		},
	],
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="La Mona Grill & Show: burgers a la brasa con shows en vivo en Urb. La Atalaya 36, Conil. Lun–jue 14–23. 669 28 36 83." />
		<meta name="keywords" content="La Mona Conil, burgers Conil, grill Conil, La Atalaya Conil, shows Conil" />
		<meta name="author" content="La Mona" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>La Mona | Grill & Show en Conil</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="La Mona · Burgers y show en Conil" />
		<meta property="og:description" content="Grill con shows en vivo en Urb. La Atalaya 36. Lun–jue 14–23." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/grill.svg`} />
		<meta property="og:image:alt" content="La Mona, Conil" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="La Mona · Grill en Conil" />
		<meta name="twitter:description" content="La Atalaya 36: burgers y show." />
		<meta name="twitter:image" content={`${business.site}/fotos/grill.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Conil de la Frontera" />
		<meta name="geo.position" content="36.2801549;-6.0927891" />
		<meta name="ICBM" content="36.2801549, -6.0927891" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="La Mona, inicio">
				<span class="brand-mark" aria-hidden="true">LM</span>
				<span class="brand-name">La Mona <small>Conil · Grill</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">El grill</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>669 28 36 83</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> La Atalaya 36 · Conil</p>
					<h1 id="hero-title">Brasa y show<br />cada <em>noche.</em></h1>
					<p class="hero-lede">
						Bar restaurante con shows en vivo en Conil: hamburguesas gourmet,
						música y ambiente para cenar.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 669 28 36 83</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>14–23</b> lun–jue</li>
						<li><b>Show</b> en vivo</li>
						<li>Burgers</li>
						<li>La Atalaya</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/fotos/grill.svg" alt="Ilustración de La Mona, Conil" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>La Atalaya 36 · Conil</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>14–23</b><span>Lun–jue</span></div>
					<div><b>Show</b><span>En vivo</span></div>
					<div><b>Grill</b><span>Burgers</span></div>
				</div>
				<ul class="services">
					<li>Burgers</li>
					<li>Grill</li>
					<li>Shows</li>
					<li>Música</li>
					<li>Cenas</li>
					<li>Reservas</li>
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> El grill</p>
				<div class="about-grid">
					<h2>Cena y espectáculo<br />en <em>La Atalaya.</em></h2>
					<div class="about-copy">
						<p>
							La Mona está en Urb. La Atalaya 36 (Conil de la Frontera),
							con coordenadas 36.2801549, -6.0927891.
						</p>
						<p>
							Grill con shows en vivo: las mejores burgers para cenar antes
							del espectáculo, con promos en cervezas según sus redes.
						</p>
						<p class="about-note">
							Lun–jue 14:00–23:00; vie y sáb horario extendido a confirmar
							en el 669 28 36 83.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de la brasa.</em></h2>
					</div>
					<p>
						Líneas generales de grill: burgers y show.
						Confirma la carta del día en el propio local.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>La brasa<br /><em>y el show.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del local.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> La Atalaya 36</p>
					<h2>Ven a cenar<br /><em>con show.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a jueves</th>
								<td>14:00 – 23:00</td>
							</tr>
							<tr>
								<th scope="row">Viernes y sábado</th>
								<td>Extendido: 669 28 36 83</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">Según sus redes. Confirma el cierre de fin de semana antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al grill ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 669 28 36 83</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de La Mona en La Atalaya 36, Conil" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> La Mona · Conil</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">LM</span>
				<p>La Mona<small>{business.street} · Conil</small></p>
			</div>
			<nav aria-label="Enlaces del grill">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} La Mona · Conil. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al grill <span>669 28 36 83</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
