---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';

const fotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/fotos/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
	{ eager: true },
);
const foto = (name: string) => fotos[`../assets/fotos/${name}`].default;

const business = {
	name: 'Restaurante Áncora',
	street: 'Calle El Fuerte, 8-11',
	district: 'Centro',
	city: 'Marbella',
	postalCode: '29602',
	phone: '666 18 78 55',
	latitude: 36.5079193,
	longitude: -4.8847968,
	site: 'https://restaurante-ancora.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+%C3%81ncora/@36.5079193,-4.8847968,17z/data=!3m1!4b1!4m6!3m5!1s0xd7327f8473f6297:0x5c5a834d48303bb0!8m2!3d36.5079193!4d-4.8847968!16s%2Fg%2F11b6tc12dg';
const reviewsUrl = 'https://search.google.com/local/reviews?placeid=ChIJl2I_R_gncw0RsDswSE2DWlw';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34666187855';
const instagramUrl = 'https://www.instagram.com/ancora_2014/';

const photos = {
	principal: foto('restaurante-ancora-marbella.jpg'),
	ambiente: foto('salon-interior-ancora-2.jpg'),
};

const galeria = [
	{
		src: foto('paella-restaurante-ancora.jpg'),
		w: 484,
		h: 645,
		alt: 'Paella de marisco del Restaurante Áncora en Marbella',
		caption: 'Paella de marisco',
	},
	{
		src: foto('paella-marisco-ancora.jpg'),
		w: 671,
		h: 645,
		alt: 'Arroz con marisco recién hecho en el Restaurante Áncora',
		caption: 'Arroz con marisco',
	},
	{
		src: foto('terraza-exterior-ancora-marbella.jpg'),
		w: 687,
		h: 645,
		alt: 'Terraza del Restaurante Áncora frente al paseo marítimo de Marbella',
		caption: 'Terraza frente al mar',
	},
	{
		src: foto('salon-interior-ancora-marbella.jpg'),
		w: 671,
		h: 645,
		alt: 'Salón interior del Restaurante Áncora en el centro de Marbella',
		caption: 'Salón interior',
	},
	{
		src: foto('lubina-ancora-marbella.jpg'),
		w: 524,
		h: 645,
		alt: 'Lubina de la bahía servida en el Restaurante Áncora',
		caption: 'Pescado fresco',
	},
	{
		src: foto('salmon-ancora-marbella.jpg'),
		w: 685,
		h: 645,
		alt: 'Salmón a la parrilla del Restaurante Áncora en Marbella',
		caption: 'Salmón a la parrilla',
	},
	{
		src: foto('ensalada-ancora-marbella.jpg'),
		w: 728,
		h: 645,
		alt: 'Ensalada de remolacha y queso de cabra del Restaurante Áncora',
		caption: 'Ensaladas y verduras',
	},
	{
		src: foto('decoracion-ancora.jpg'),
		w: 483,
		h: 645,
		alt: 'Detalle de la decoración marinera del Restaurante Áncora',
		caption: 'Decoración marinera',
	},
];

const servicios = [
	'Menú del día a mediodía',
	'Paella todos los días',
	'Pescado y marisco fresco',
	'Terraza frente al mar',
	'Opciones vegetarianas',
	'Pet friendly',
	'Accesible para sillas de ruedas',
	'Wifi y tarjetas',
];

const carta = [
	{
		title: 'Entrantes',
		intro: 'Para empezar, lo de siempre bien hecho.',
		platos: [
			{ nombre: 'Mejillones al vino' },
			{ nombre: 'Jamón ibérico' },
			{ nombre: 'Ensalada César' },
		],
	},
	{
		title: 'Arroces y parrilla',
		intro: 'La paella es el plato estrella; la parrilla, su rival.',
		platos: [
			{ nombre: 'Paella de marisco' },
			{ nombre: 'Salmón a la parrilla' },
			{ nombre: 'Solomillo de ternera' },
		],
	},
	{
		title: 'Postres caseros',
		intro: 'Los mousses se hacen en casa, cada día.',
		platos: [
			{ nombre: 'Mousse de queso' },
			{ nombre: 'Mousse de chocolate' },
			{ nombre: 'Café irlandés' },
		],
	},
	{
		title: 'Menú del día',
		intro: 'A mediodía, primero, segundo y postre.',
		platos: [
			{ nombre: 'Carne y pescado a elegir' },
			{ nombre: 'Postre casero incluido' },
			{ nombre: 'Precio orientativo' },
		],
	},
];

const faqs = [
	{
		q: '¿Dónde está el Restaurante Áncora?',
		a: 'En la calle El Fuerte, 8-11, en pleno centro de Marbella (29602), justo frente al Hotel El Fuerte y a un paso del paseo marítimo y de la playa. Desde el casco antiguo se llega andando en pocos minutos.',
	},
	{
		q: '¿Cuál es el horario del restaurante?',
		a: 'Abre de 13:00 a 23:00 lunes, jueves, viernes, sábado y domingo, con cocina continua. Cierra los martes y los miércoles. Los festivos suele abrir, pero conviene confirmar por teléfono.',
	},
	{
		q: '¿Tienen menú del día?',
		a: 'Sí, a mediodía sirven menú del día con primero, segundo y postre, con opciones de carne y de pescado. No se comparte entre adultos y existe menú infantil.',
	},
	{
		q: '¿Se puede reservar mesa?',
		a: 'Sí, reservando por teléfono en el 666 18 78 55. Los fines de semana se llena, así que reservar es lo más práctico. La paella suele agotarse pronto los sábados y domingos: si la queréis, llegar temprano.',
	},
	{
		q: '¿Qué se puede pedir en el Áncora?',
		a: 'Cocina mediterránea y española con toques portugueses: paella de marisco, arroces, lubina y salmón a la parrilla, entrecot, secreto ibérico, escalopines, mejillones al vino y postres caseros como el mousse de queso. También hay opciones vegetarianas.',
	},
	{
		q: '¿Es pet friendly y accesible?',
		a: 'Admite mascotas y es accesible para personas con movilidad reducida, con entrada a pie de calle. La terraza está climatizada, hay wifi, se aceptan tarjetas y hay aparcamientos públicos cerca del centro.',
	},
];

const description =
	'Paella de marisco, pescado fresco y menú del día frente al paseo marítimo de Marbella, junto al Hotel El Fuerte. Calle El Fuerte, 8-11. Reservas: 666 18 78 55.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 666 18 78 55',
	image: [`${business.site}${photos.principal.src}`, `${business.site}${photos.ambiente.src}`],
	priceRange: '10 € – 40 €',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, Tarjeta',
	servesCuisine: ['Mediterránea', 'Española', 'Marisco', 'Arroces'],
	acceptsReservations: 'True',
	petsAllowed: true,
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: '4.7',
		bestRating: '5',
		ratingCount: '837',
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '13:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Menú del día', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza climatizada', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Admite mascotas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Wifi', value: true },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0e3a4a" />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="Restaurante Áncora Marbella, restaurante centro Marbella, paella Marbella, marisco Marbella, arroces Marbella, menú del día Marbella, restaurante C/ El Fuerte, comer frente al mar Marbella, restaurante paseo marítimo Marbella, terraza centro Marbella"
		/>
		<meta name="author" content="Restaurante Áncora" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Outfit:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Restaurante Áncora | Paella y marisco en el centro de Marbella</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Restaurante Áncora · Paella y marisco frente al mar en Marbella" />
		<meta
			property="og:description"
			content="Paella de marisco, pescado fresco y menú del día junto al Hotel El Fuerte, en el centro de Marbella."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.principal.src}`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="1600" />
		<meta property="og:image:alt" content="Restaurante Áncora, restaurante mediterráneo en el centro de Marbella" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Restaurante Áncora · Paella y marisco en Marbella" />
		<meta
			name="twitter:description"
			content="Pescado fresco, paella y menú del día frente al paseo marítimo, en la calle El Fuerte de Marbella."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.principal.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Marbella" />
		<meta name="geo.position" content="36.5079193;-4.8847968" />
		<meta name="ICBM" content="36.5079193, -4.8847968" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Restaurante Áncora, inicio">
				<span class="brand-mark" aria-hidden="true">ÁN</span>
				<span class="brand-name">Áncora <small>Marbella · Centro histórico</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#casa">La casa</a>
				<a href="#carta">Carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>666 18 78 55</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Centro de Marbella · Frente al mar</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante mediterráneo en la calle El Fuerte, junto al Hotel El Fuerte y a un paso del
						paseo marítimo. Cocina de mercado con arroces todos los días, menú al mediodía y postres
						caseros, a precio de barrio en pleno centro de Marbella.
					</p>
					<div class="hero-actions">
						<a class="button button-coral" href={phoneHref}>Llamar 666 18 78 55</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<p class="hero-rating">
						<span class="star" aria-hidden="true">★</span>
						<strong>4,7</strong> de valoración media · más de 800 reseñas en Google
					</p>
					<ul class="hero-facts">
						<li>Abierto de 13:00 a 23:00 (cierra martes y miércoles)</li>
						<li>Menú del día a mediodía</li>
						<li>Paella de marisco todos los días</li>
						<li>Terraza climatizada y pet friendly</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.principal}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Fotografía del salón del Restaurante Áncora publicada en su ficha de Google Maps"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Servicios del local">
				<ul class="chips">
					{servicios.map((servicio) => <li>{servicio}</li>)}
				</ul>
			</section>

			<section class="about section-pad" id="casa">
				<p class="section-label"><span aria-hidden="true"></span> Un clásico del centro</p>
				<div class="about-grid">
					<h2>Comer bien<br />y a buen precio<br /><em>a pie de playa.</em></h2>
					<div class="about-copy">
						<p>
							El Áncora está en la calle El Fuerte, frente a la entrada del Hotel El Fuerte, en el
							tramo que une el casco antiguo con el paseo marítimo. Un local de trato familiar donde
							la paella de marisco manda, los pescados llegan frescos cada día y el menú del mediodía
							es el secreto mejor guardado de la zona.
						</p>
						<p>
							En carta hay arroces, lubina y salmón a la parrilla, entrecot, secreto ibérico y
							escalopines, con entrantes de toda la vida como los mejillones al vino. De postre,
							mousses de queso y de chocolate hechos en casa.
						</p>
						<p class="about-note">
							Lo que más se repite en las reseñas públicas: la relación calidad-precio, las raciones
							generosas y el trato cercano del equipo. También avisan de que el local es pequeño y
							los fines de semana se llena: reservar mesa y llegar pronto si vais detrás de la
							paella, que se agota.
						</p>
						<div class="about-links">
							<a class="simple-link" href={reviewsUrl} target="_blank" rel="noreferrer">
								Leer reseñas en Google <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">
								Instagram del local <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="menu section-pad" id="carta">
				<div class="menu-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Mediterránea, con acento portugués</p>
						<h2>Qué pedir<br />en <em>el Áncora.</em></h2>
					</div>
					<p>
						Una selección de la carta. La carta cambia con la temporada y el
						género del día: confirma disponibilidad y sugerencias cuando llames o vayas.
					</p>
				</div>
				<div class="menu-grid">
					{
						carta.map((bloque) => (
							<article class="menu-card">
								<h3>{bloque.title}</h3>
								<p>{bloque.intro}</p>
								<ul>
									{bloque.platos.map((plato) => (
										<li>
											<span>{plato.nombre}</span>
										</li>
									))}
								</ul>
							</article>
						))
					}
				</div>
				<p class="menu-note">
					Menú del día de martes a domingo a mediodía, con primero, segundo y postre, y menú infantil
					para los más pequeños.
				</p>
			</section>

			<section class="galeria section-pad" id="galeria">
				<p class="section-label"><span aria-hidden="true"></span> Fotos de la ficha de Google Maps</p>
				<h2>Se nos hace<br /><em>la boca agua.</em></h2>
				<div class="galeria-grid">
					{
						galeria.map((foto) => (
							<figure>
								<Image
									src={foto.src}
									alt={foto.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{foto.caption}</figcaption>
							</figure>
						))
					}
				</div>
				<p class="galeria-note">
					Fotografías publicadas en la ficha de Google Maps del restaurante. Hay más de doscientas
					fotos de clientes en la ficha completa.
				</p>
			</section>

			<section class="ambiente section-pad" id="ambiente">
				<div class="ambiente-grid">
					<div class="ambiente-copy">
						<p class="eyebrow"><span aria-hidden="true"></span> Terraza y salón</p>
						<h2>Un sitio para<br /><em>quedarse sobremesa.</em></h2>
						<p>
							Dentro, un salón acogedor con aire marinero; fuera, una terraza climatizada que permite
							comer a la orilla del paseo marítimo casi todo el año. El local es compacto y las mesas
							se juntan en las horas punta, así que hay ambiente garantizado.
						</p>
						<p>
							Al mediodía el tono es de menú y de sobremesa tranquila. Por la noche, el centro de
							Marbella se enciende a un minuto: ideal para cenar y seguir andando por el casco
							antiguo o la avenida del Mar.
						</p>
						<p class="about-note">
							Consejo de las reseñas: para grupos y fines de semana, reserva previa en el
							666 18 78 55. Los martes y miércoles el restaurante cierra.
						</p>
					</div>
					<figure class="ambiente-photo">
						<Image
							src={photos.ambiente}
							widths={[480, 720, 960, 1200]}
							sizes="(max-width: 980px) 92vw, 46vw"
							format="avif"
							quality={70}
							alt="Mesas del salón del Restaurante Áncora preparadas para el servicio"
							loading="lazy"
							decoding="async"
						/>
						<figcaption>
							Salón del restaurante · foto de Google Maps
							<a href={mapsUrl} target="_blank" rel="noreferrer">Ver ficha ↗</a>
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow dark"><span aria-hidden="true"></span> Calle El Fuerte, 8-11 · 29602 Marbella</p>
					<h2>Nos vemos<br /><em>junto al Fuerte.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.district} de Marbella<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr><th scope="row">Lunes</th><td>13:00 – 23:00</td></tr>
							<tr><th scope="row">Martes</th><td>Cerrado</td></tr>
							<tr><th scope="row">Miércoles</th><td>Cerrado</td></tr>
							<tr><th scope="row">Jueves a domingo</th><td>13:00 – 23:00</td></tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario orientativo según la ficha pública del local. Puede cambiar en festivos: una
						llamada evita sorpresas.
					</p>

					<div class="visit-links">
						<a class="button button-coral" href={phoneHref}>Reservar mesa</a>
						<a class="button button-outline" href={directionsUrl} target="_blank" rel="noreferrer">
