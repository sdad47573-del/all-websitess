---
import WhatsappFab from '../components/WhatsappFab.astro';
import * as datos from '../lib/business';
import '../styles/global.css';
import Galeria from '../components/Galeria.astro';
import {
	business,
	directionsUrl,
	facebookPhotosUrl,
	facebookUrl,
	faqSchema,
	faqs,
	instagramUrl,
	mapEmbedUrl,
	mapsUrl,
	phoneDisplays,
	phoneHrefs,
	restaurantSchema,
	specialties,
	tripadvisorUrl,
} from '../lib/business';

const title = 'Restaurante La Querencia | Cocina de mercado en Encinarejo de Córdoba';
const description =
	'Restaurante La Querencia en Encinarejo de Córdoba: carnes a la brasa, cocina de mercado y recetas tradicionales con un toque creativo. Reserva por teléfono.';
const keywords =
	'Restaurante La Querencia Encinarejo, restaurante Córdoba, carnes a la brasa Encinarejo, cocina de mercado Córdoba, C/ Félix Rodríguez de la Fuente 10, reservar La Querencia';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#30231f" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={business.name} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<meta name="geo.region" content="ES-CO" />
		<meta name="geo.placename" content="Encinarejo de Córdoba" />
		<meta name="geo.position" content={`${business.latitude};${business.longitude}`} />
		<meta name="ICBM" content={`${business.latitude}, ${business.longitude}`} />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/og.png`} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ilustración original de un plato de cocina para La Querencia; no es una fotografía del restaurante" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${business.site}/og.png`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="#inicio" aria-label="Restaurante La Querencia, inicio">
				<span class="brand-mark" aria-hidden="true">Q</span>
				<span class="brand-copy">La Querencia <small>Cocina de mercado · Encinarejo</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#cocina">La cocina</a>
				<a href="#historia">El restaurante</a>
				<a href="#fotos">Fotos</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="header-phone" href={phoneHrefs[0]}><span aria-hidden="true">☎</span> 957 47 65 84</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow eyebrow-light"><span aria-hidden="true"></span> Encinarejo de Córdoba · A un paso de Córdoba</p>
					<h1 id="hero-title">Cocina con raíz,<br /><em>un punto inesperado.</em></h1>
					<p class="hero-intro">En La Querencia, las recetas de siempre se encuentran con ideas nuevas: cocina de mercado, producto de temporada y platos para compartir alrededor de la mesa.</p>
					<div class="hero-actions">
						<a class="button button-wine" href={phoneHrefs[0]}>Llamar y reservar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline-light" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
					</div>
					<div class="hero-meta">
						<div><small>Nos encontrarás en</small><address>{business.streetAddress}<br />{business.postalCode} · Córdoba</address></div>
						<div><small>Reservas</small><a href={phoneHrefs[0]}>{phoneDisplays[0]}</a><br /><a href={phoneHrefs[1]}>{phoneDisplays[1]}</a></div>
					</div>
				</div>
				<div class="hero-art" role="img" aria-label="Ilustración original de un plato inspirado en la cocina de La Querencia; no es una fotografía del local">
					<span class="plate-dot" aria-hidden="true"></span><div class="plate" aria-hidden="true"><div class="dish"></div></div>
					<div class="art-caption"><strong>Tradición con otro aire</strong>Producto · temporada · brasa</div>
				</div>
			</section>

			<div class="promise" aria-label="Características de la cocina de La Querencia">
				<span>Cocina de mercado</span><span>Recetas con raíz</span><span>Carnes a la brasa</span><span>Postres caseros</span>
			</div>

			<section class="section intro" id="historia" aria-labelledby="intro-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> Restaurante en Encinarejo</p>
					<h2 id="intro-title">Un sitio para<br /><em>sentirse cerca.</em></h2>
				</div>
				<div class="intro-copy">
					<p>En una plaza tranquila de Encinarejo, La Querencia reúne una sala acogedora y terraza para disfrutar de una cocina de mercado con raíces tradicionales y un toque creativo. Una propuesta cercana para comer, cenar o celebrar alrededor de buenos platos.</p>
					<p>La carta puede ir de las carnes a la brasa a los platos para compartir, con sugerencias que cambian según temporada. Consulta las opciones del día y reserva, especialmente en fines de semana y festivos.</p>
					<p class="source-note">La dirección se ha contrastado con perfiles del negocio y directorios locales. La información de carta es orientativa: confirma platos, precios y alérgenos con el restaurante.</p>
				</div>
			</section>

			<section class="section menu-section" id="cocina" aria-labelledby="menu-title">
				<div class="section-heading">
					<div>
						<p class="section-label"><span aria-hidden="true"></span> Cocina de mercado · tradición creativa</p>
						<h2 id="menu-title">Sabores para<br /><em>volver a ellos.</em></h2>
					</div>
					<p>Una selección de platos mencionados en fuentes públicas y publicaciones del establecimiento. No es una carta oficial: la oferta y la disponibilidad cambian.</p>
				</div>
				<div class="menu-grid">
					{specialties.map((dish, index) => (
						<article class="menu-card">
							<small>0{index + 1} · {dish.category}</small>
							<h3>{dish.name}</h3>
							<p>{dish.description}</p>
						</article>
					))}
				</div>
				<p class="menu-note">Consulta disponibilidad, precios y alérgenos con el equipo. <a href={phoneHrefs[0]}>Llama para reservar</a>.</p>
			</section>

			<section class="section gallery" id="fotos" aria-labelledby="gallery-title">
				<p class="section-label"><span aria-hidden="true"></span> La Querencia en imágenes</p>
				<h2 id="gallery-title">Entra por<br /><em>la galería.</em></h2>
				<p class="gallery-copy">El enlace de Maps facilita acceso a la ficha pero no incluye URLs directas de las fotografías. Abre las galerías oficiales para ver las imágenes auténticas del local, sus platos y novedades.</p>
				<div class="gallery-grid">
					<a class="gallery-card" href={mapsUrl} target="_blank" rel="noreferrer" aria-label="Ver ficha y fotos de Restaurante La Querencia en Google Maps">
						<span class="gallery-tag">Ficha del restaurante</span><span class="gallery-title">Google Maps <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={instagramUrl} target="_blank" rel="noreferrer" aria-label="Ver las fotos y publicaciones del Instagram oficial de La Querencia">
						<span class="gallery-tag">Perfil oficial</span><span class="gallery-title">Instagram <span aria-hidden="true">↗</span></span>
					</a>
					<a class="gallery-card" href={facebookPhotosUrl} target="_blank" rel="noreferrer" aria-label="Ver fotos de la página oficial de Facebook de La Querencia">
						<span class="gallery-tag">Página oficial</span><span class="gallery-title">Facebook <span aria-hidden="true">↗</span></span>
					</a>
				</div>
				<p class="gallery-note">La ilustración de portada y las tarjetas son gráficos originales, no fotografías del restaurante. Las imágenes reales están enlazadas en los perfiles externos.</p>
			</section>

			<section class="section visit" id="visitanos" aria-labelledby="visit-title">
				<div>
					<p class="section-label"><span aria-hidden="true"></span> 14711 · Encinarejo de Córdoba</p>
					<h2 id="visit-title">Reserva tu mesa<br /><em>en La Querencia.</em></h2>
					<address>{business.streetAddress}<br />{business.locality}, {business.postalCode}<br />{business.province}</address>
					<div class="contact-list">
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Reservas · teléfono principal</small><a href={phoneHrefs[0]}>{phoneDisplays[0]}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">☎</span><div><small>Teléfono alternativo</small><a href={phoneHrefs[1]}>{phoneDisplays[1]}</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">⌖</span><div><small>Indicaciones</small><a href={mapsUrl} target="_blank" rel="noreferrer">Abrir ficha en Google Maps ↗</a></div></div>
						<div class="contact-row"><span class="contact-icon" aria-hidden="true">◎</span><div><small>Redes sociales oficiales</small><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a> · <a href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a></div></div>
					</div>
					<div class="visit-actions">
						<a class="button button-ink" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
						<a class="button button-outline" href={phoneHrefs[0]}>Llamar para reservar</a>
					</div>
					<p class="menu-note">El horario se actualiza en las redes del negocio. Confirma apertura y disponibilidad antes de venir.</p>
				</div>
				<div class="map-card">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Restaurante La Querencia en Encinarejo de Córdoba" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<div class="map-label"><div><strong>Restaurante La Querencia</strong><small>Encinarejo de Córdoba · Córdoba</small></div><a href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a></div>
				</div>
			</section>

			<section class="section faq" id="preguntas" aria-labelledby="faq-title">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2 id="faq-title">Antes de <em>venir.</em></h2>
				<div class="faq-grid">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.question}</summary>
							<p>{faq.answer}</p>
						</details>
					))}
				</div>
			</section>
			<Galeria nombre="Restaurante La Querencia" mapsUrl={mapsUrl} />
		</main>

		<footer class="site-footer">
			<a class="brand" href="#inicio" aria-label="La Querencia, volver al inicio">
				<span class="brand-mark" aria-hidden="true">Q</span><span class="brand-copy">Restaurante La Querencia <small>Encinarejo de Córdoba</small></span>
			</a>
			<nav class="footer-nav" aria-label="Perfiles y contacto">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={tripadvisorUrl} target="_blank" rel="noreferrer">Tripadvisor ↗</a>
				<a href={phoneHrefs[0]}>{phoneDisplays[0]}</a>
			</nav>
			<small>© {new Date().getFullYear()} Restaurante La Querencia · Encinarejo de Córdoba. Consulta carta y horarios en los canales oficiales.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>
		<a class="mobile-call" href={phoneHrefs[0]}>Llamar para reservar <span>957 47 65 84</span></a>
	<nav class="legal-links" aria-label="Información legal">
					<a href="/aviso-legal">Aviso legal</a>
					<a href="/aviso-legal#privacidad">Privacidad</a>
					<a href="/aviso-legal#cookies">Cookies</a>
				</nav>
						<WhatsappFab phone={datos.phoneHrefs[0]} name={datos.business?.name} />
						</body>
</html>


