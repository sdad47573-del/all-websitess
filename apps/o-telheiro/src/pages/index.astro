---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/o-telheiro-apaisada-07.jpg';
import sardinas from '../assets/fotos/o-telheiro-apaisada-02.jpg';
import pulpo from '../assets/fotos/o-telheiro-apaisada-03.jpg';
import costillas from '../assets/fotos/o-telheiro-apaisada-04.jpg';
import platoHuevo from '../assets/fotos/o-telheiro-vertical-01.jpg';
import banquete from '../assets/fotos/o-telheiro-vertical-05.jpg';
import mousse from '../assets/fotos/o-telheiro-vertical-06.jpg';
import ensalada from '../assets/fotos/o-telheiro-vertical-08.jpg';
import tarta from '../assets/fotos/o-telheiro-vertical-09.jpg';
import carne from '../assets/fotos/o-telheiro-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Restaurante O Telheiro, restaurante y snack-bar en la Estrada da Quinta de Matos 9 (2630-260 Arruda dos Vinhos): parrilla, pescado, platos de la casa y celebraciones. Abre de 8:30 a 19:00, domingo cerrado. 4,2 en Google con 219 reseñas. Tel. 918 870 783.';

const galeria = [
	{
		src: pulpo,
		alt: 'Pulpo asado con patata al horno, ajo laminado y perejil en O Telheiro',
	},
	{
		src: sardinas,
		alt: 'Sardinas asadas a la brasa con patata cocida en O Telheiro, Arruda dos Vinhos',
	},
	{
		src: costillas,
		alt: 'Costillas con alubias, arroz, col y zanahoria servidas en fuente en O Telheiro',
	},
	{
		src: platoHuevo,
		alt: 'Plato de O Telheiro con arroz, patatas fritas, ensalada y huevo frito, con vino tinto de la casa',
	},
	{
		src: carne,
		alt: 'Carne guisada con patatas y setas en salsa en O Telheiro',
	},
	{
		src: ensalada,
		alt: 'Ensalada de tomate y cebolla aliñada en fuente de acero en O Telheiro',
	},
	{
		src: mousse,
		alt: 'Mousse de frutos rojos con frambuesa servida en copa en O Telheiro',
	},
	{
		src: tarta,
		alt: 'Tarta de celebración con frutos rojos y el nombre del restaurante escrito en chocolate',
	},
	{
		src: banquete,
		alt: 'Comedor de O Telheiro preparado para un banquete, con mesas largas y servilletas amarillas',
	},
	{
		src: fachada,
		alt: 'Fachada de O Telheiro en Arruda dos Vinhos, con el cartel de restaurante y snack-bar',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['O Telheiro', 'O Telheiro Arruda dos Vinhos', 'Snack-Bar O Telheiro'],
	slogan: 'Parrilla y cocina de campo en Arruda dos Vinhos',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 918 870 783',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Portuguesa', 'Parrilla'],
	areaServed: [
		{ '@type': 'City', name: 'Arruda dos Vinhos' },
		{ '@type': 'AdministrativeArea', name: 'Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:30',
			closes: '19:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Entrada accesible para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos accesibles para sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La cocina', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'O Telheiro · Parrilla y snack-bar en Arruda dos Vinhos';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3a4a2c" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="O Telheiro Arruda dos Vinhos, restaurante Arruda dos Vinhos, snack-bar Arruda, parrilla Arruda dos Vinhos, sardinas asadas Arruda, pulpo Arruda dos Vinhos, Estrada da Quinta de Matos, restaurante Lisboa campo, banquetes Arruda dos Vinhos"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="O Telheiro · Parrilla y snack-bar en Arruda dos Vinhos"
			ogDescription="Sardinas asadas, pulpo con patata al horno y platos de la casa. De lunes a sábado de 8:30 a 19:00. 4,2 en Google con 219 reseñas. Tel. 918 870 783."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Sardinas asadas con patata cocida en Restaurante O Telheiro, Arruda dos Vinhos"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#3a4a2c"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351918870783"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 918 870 783',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[pulpo]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Parrilla y snack-bar · Arruda"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="Estrada da Quinta de Matos, 9 · Arruda dos Vinhos"
				title="La parrilla<br /><em>de Arruda.</em>"
				lede="O Telheiro es restaurante y snack-bar en la Estrada da Quinta de Matos, en Arruda dos Vinhos: sardinas y pulpo a la brasa, costillas con alubias y platos del día con arroz, patata y ensalada. Abre de 8:30 a 19:00, de lunes a sábado, y también prepara banquetes y celebraciones."
				image={pulpo}
				imageAlt="Pulpo asado con patata al horno, ajo laminado y perejil en O Telheiro"
				primaryCta={{ label: `Llamar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Parrilla"
				facts={[
					{ label: 'Nota', html: '<b>4,2 en Google</b> con 219 reseñas' },
					{ label: 'Horario', html: '<b>8:30 – 19:00</b>' },
					{ label: 'Domingo', html: '<b>Domingo cerrado</b>' },
					{ label: 'Celebraciones', html: '<b>Comedor para grupos</b>' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece O Telheiro" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Restaurante y snack-bar,<br /><em>de los de siempre.</em>"
				paragraphs={[
					'O Telheiro está en la Estrada da Quinta de Matos, 9, en Arruda dos Vinhos, en el distrito de Lisboa. Es una casa de campo con la fachada de siempre: toldos rojos, el cartel de «Restaurante • Snack-Bar O Telheiro» y aparcamiento a la puerta. Dentro, mesas de mantel y sillas de madera, y un comedor largo que se llena de grupos.',
					'La cocina va de la parrilla y del guiso de siempre: sardinas asadas con patata cocida, pulpo con patata al horno, aceite y ajo, costillas con alubias y arroz, y platos del día con huevo frito, patatas y ensalada. Se acompaña con el vino tinto de la casa, servido en jarra, que en Arruda dos Vinhos es tradición.',
					'Para terminar, mousse de frutos rojos y tartas por encargo. Las fotos del perfil muestran el comedor preparado para un banquete, con servilletas amarillas y mesas largas, y tartas personalizadas con el nombre del restaurante: aquí también se celebran cumpleaños y comidas de familia.',
				]}
				note="La ficha de Google no publica descripción del local ni web: solo dirección, teléfono, horario, categoría «Restaurante», nota de 4,2 con 219 reseñas y la accesibilidad. Todo lo que cuenta esta página sale de ahí y de las fotos del perfil."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La cocina"
				title="Sardinas,<br />pulpo y<br /><em>platos de la casa.</em>"
				description="La ficha no publica carta ni precios: estos platos salen de las fotos del perfil, con la parrilla, los guisos, la ensalada y los postres que sirve la casa."
				cta={{ label: `Reservar: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="O Telheiro no publica precios en Google y esta web no los inventa. La carta cambia con lo que haya ese día en la plaza, así que confirma platos y precio al llamar al 918 870 783. El comedor grande admite grupos y celebraciones con reserva previa."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La parrilla,<br />el comedor<br /><em>y las tartas.</em>"
				description="Estas fotografías proceden del perfil de O Telheiro en Google Maps: el pulpo y las sardinas de la parrilla, las costillas con alubias, los platos del día, la ensalada, la mousse, la tarta de celebración y el comedor preparado para un banquete."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="Estrada da Quinta de Matos, 9 · 2630-260 Arruda dos Vinhos"
				title="En Arruda dos Vinhos,<br /><em>de lunes a sábado.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Lisboa, Portugal']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="Abre de 8:30 a 19:00 de lunes a sábado; el domingo cierra. La ficha avisa de que el horario puede cambiar en festivos, así que llama antes si vas en día señalado."
				mapTitle="Mapa de O Telheiro en la Estrada da Quinta de Matos, 9, Arruda dos Vinhos"
				mapEmbedUrl={MAPS.embed}
				mapLabel="O Telheiro · Arruda dos Vinhos"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva por teléfono, en el 918 870 783. La ficha marca entrada, asientos, aseo y aparcamiento adaptados para sillas de ruedas. Para grupos y celebraciones, avisa con antelación: el comedor se prepara con mesas largas."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, platos y precios antes de la visita."
			ctaLabel="Llamar a O Telheiro"
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
		/>
	</body>
</html>
