---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import vitrina from '../assets/fotos/la-boutique-del-pollo-2-apaisada-01.jpg';
import adobados from '../assets/fotos/la-boutique-del-pollo-2-panoramica-02.jpg';
import tarjeta from '../assets/fotos/la-boutique-del-pollo-2-vista-03.jpg';
import mostrador from '../assets/fotos/la-boutique-del-pollo-2-panoramica-04.jpg';
import elaborados from '../assets/fotos/la-boutique-del-pollo-2-apaisada-05.jpg';
import pechugas from '../assets/fotos/la-boutique-del-pollo-2-panoramica-07.jpg';
import huevos from '../assets/fotos/la-boutique-del-pollo-2-apaisada-06.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HORARIO,
	HORARIO_AVISO,
	MAPS,
	MENU,
	RATING,
	RESENAS,
	SERVICIOS,
} from '../data/site';

const title = 'La Boutique del Pollo #2 · Pollería en Tetuán, Madrid';
const description = BUSINESS.description;

const galeria = [
	{
		src: vitrina,
		alt: 'La vitrina de La Boutique del Pollo #2 con pollos enteros, cuartos y carteles de oferta',
	},
	{
		src: adobados,
		alt: 'Bandejas de alitas y muslos de pollo adobados en la vitrina',
	},
	{
		src: mostrador,
		alt: 'El mostrador de La Boutique del Pollo #2 con pollos, conejos y bandejas de carne, con sus carteles de precio',
	},
	{
		src: elaborados,
		alt: 'Bandejas de elaborados: empanadas, croquetas, albóndigas, alitas y pollo asado',
	},
	{
		src: pechugas,
		alt: 'La vitrina con pechugas de pollo, bandejas de elaborados y huevos apilados',
	},
	{
		src: huevos,
		alt: 'La vitrina de La Boutique del Pollo #2 con pollos, huevos y elaborados',
	},
	{
		src: tarjeta,
		alt: 'La tarjeta de La Boutique del Pollo con el servicio a domicilio, los productos y los dos teléfonos',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Store',
	'@id': `${BUSINESS.siteUrl}/#laboutique`,
	name: BUSINESS.name,
	alternateName: ['LA BOUTIQUE DEL POLLO #2', 'La Boutique del Pollo Tetuán', 'Pollería Marqués de Viana'],
	description:
		'Pollería en la calle del Marqués de Viana, 4, Tetuán (28039 Madrid). Pollo fresco, pavos, aves, caza, conejos, huevos y elaborados, con servicio a domicilio a restaurantes y hogares.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34915791582',
	currenciesAccepted: 'EUR',
	priceRange: '€',
	areaServed: [
		{ '@type': 'City', name: 'Madrid' },
		{ '@type': 'AdministrativeArea', name: 'Tetuán' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: [`${BUSINESS.siteUrl}/og.jpg`],
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '14:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '17:30',
			closes: '20:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Saturday'],
			opens: '09:00',
			closes: '14:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: RATING.value,
		reviewCount: RATING.count,
		bestRating: 5,
		worstRating: 1,
	},
	review: RESENAS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.valor, bestRating: 5 },
		reviewBody: review.texto,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El surtido', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visitar', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"la-boutique-del-pollo-2-apaisada-01.jpg": vitrina,
	"la-boutique-del-pollo-2-panoramica-02.jpg": adobados,
	"la-boutique-del-pollo-2-panoramica-04.jpg": mostrador,
	"la-boutique-del-pollo-2-apaisada-05.jpg": elaborados,
	"la-boutique-del-pollo-2-panoramica-07.jpg": pechugas,
	"la-boutique-del-pollo-2-apaisada-06.jpg": huevos,
	"la-boutique-del-pollo-2-vista-03.jpg": tarjeta,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2a1517" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Jost:ital,wght@0,400..700;1,400..600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="La Boutique del Pollo 2, pollería Tetuán, pollo fresco Madrid, Marqués de Viana, huevos, conejos, caza, elaborados, servicio a domicilio restaurantes"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Pollo fresco, pavos, aves, caza, conejos, huevos y elaborados en la calle del Marqués de Viana, 4 (Tetuán, 28039 Madrid). Servicio a domicilio para restaurantes y hogares."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Tarjeta de La Boutique del Pollo #2 con su nombre sobre fondo rojo ladrillo"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2a1517"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-MD"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Tetuán"
			locale="es_ES"
			countryName="España"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: BUSINESS.country,
				phone: BUSINESS.phone,
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[vitrina]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="La Boutique del Pollo"
			subtitle="Pollería · Tetuán"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HORARIO}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name="La Boutique del Pollo #2"
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, horario y fotografías de la ficha pública de Google Maps, consultada en octubre de 2026. Confirma precios y horario antes de la visita."
			ctaLabel="Llamar a La Boutique del Pollo"
			navAriaLabel="Enlaces de La Boutique del Pollo #2"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
			creditNote="sur-digital.vercel.app"
		/>
	</body>
</html>
