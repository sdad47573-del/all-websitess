---
import '../styles/global.css';
import { Image } from 'astro:assets';
import fotoHero from '../assets/fotos/el-colorao-sanlucar-apaisada-01.jpg';
import foto1 from '../assets/fotos/el-colorao-sanlucar-vertical-02.jpg';
import foto2 from '../assets/fotos/el-colorao-sanlucar-cuadrada-03.jpg';
import foto3 from '../assets/fotos/el-colorao-sanlucar-apaisada-04.jpg';
import foto4 from '../assets/fotos/el-colorao-sanlucar-vertical-06.jpg';
import foto5 from '../assets/fotos/el-colorao-sanlucar-vertical-07.jpg';

const business = {
	name: 'El Colorao',
	street: 'C. Sargenta, 39',
	city: 'Sanlúcar de Barrameda',
	region: 'Andalucía',
	province: 'Cádiz',
	postalCode: '11540',
	phone: '+34 956 36 42 98',
	latitude: 36.7836573,
	longitude: -6.347002,
	site: 'https://el-colorao-sanlucar.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/El+Colorao/data=!4m7!3m6!1s0xd0dde20f2fd1861:0x19a9c43a24b0451a!8m2!3d36.7836573!4d-6.347002!16s%2Fg%2F1wyc5ldc!19sChIJYRj98iDeDQ0RGkWwJDrEqRk?authuser=0&hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34956364298';

const photos = {
	hero: fotoHero,
	foto1: foto1,
	foto2: foto2,
	foto3: foto3,
	foto4: foto4,
	foto5: foto5,
};

const specialties = [
	{
		kicker: 'Desde 1937',
		title: 'Pescaíto frito',
		text: 'La casa lo dice claro: desde 1937 dedicados al pescaíto frito. El plato que todos nombran y el motivo para repetir.',
	},
	{
		kicker: 'De la freidora',
		title: 'Chipirones',
		text: 'Chipirones entre lo más pedido junto al pescaíto. Fritura sanluqueña rápida y bien atendida, según sus clientes.',
	},
	{
		kicker: 'Para empezar',
		title: 'Ensaladilla y croquetas',
		text: 'Ensaladilla y croquetas para abrir: lo que piden quienes vienen a compartir antes del pescado.',
	},
	{
		kicker: 'Marisquería',
		title: 'Pescado y marisco',
		text: 'Restaurante y marisquería: pescado del día y producto de la costa. Pregunta por lo que haya entrado esa mañana.',
	},
	{
		kicker: 'Con cerveza',
		title: 'Para acompañar',
		text: 'Sus reseñas lo acompañan con una Cruzcampo bien fría. Local de barrio para comer sin prisas de viernes a domingo.',
	},
	{
		kicker: 'Solo fin de semana',
		title: 'Viernes a domingo',
		text: 'Abre viernes, sábado y domingo en dos turnos: 12:30–16:00 y 20:00–23:00. De lunes a jueves cerrado: llama antes de venir.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía de El Colorao publicada en su ficha de Google Maps (Sanlúcar de Barrameda)' },
	{ src: photos.foto2, alt: 'Interior de El Colorao, marisquería en la calle Sargenta, Sanlúcar' },
	{ src: photos.foto3, alt: 'Fotografía de El Colorao en Sanlúcar de Barrameda, desde Google Maps' },
	{ src: photos.foto4, alt: 'Imagen de El Colorao (Sanlúcar de Barrameda) subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Detalle de El Colorao según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está El Colorao?',
		a: 'En la calle Sargenta, 39, 11540 Sanlúcar de Barrameda (Cádiz). Coordenadas 36.7836573, -6.347002.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'De lunes a jueves cerrado. Viernes, sábado y domingo abre de 12:30 a 16:00 y de 20:00 a 23:00. Confirma festivos por teléfono.',
	},
	{
		q: '¿Cómo reservo mesa?',
		a: 'Llamando al 956 36 42 98. Abre solo de viernes a domingo y tiene más de 4.400 reseñas: para grupos conviene llamar con antelación.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Pescaíto frito (su especialidad desde 1937), chipirones, ensaladilla, croquetas y pescado y marisco del día como marisquería que es.',
	},
	{
		q: '¿Es accesible?',
		a: 'La ficha marca acceso, aseo y asientos adaptados para sillas de ruedas. Para necesidades concretas, llama antes al 956 36 42 98.',
	},
];

const images = [
	`${business.site}${photos.hero.src}`,
	`${business.site}${photos.foto1.src}`,
	`${business.site}${photos.foto2.src}`,
	`${business.site}${photos.foto3.src}`,
	`${business.site}${photos.foto4.src}`,
];

const description =
	'El Colorao en Sanlúcar de Barrameda (calle Sargenta, 39): pescaíto frito desde 1937, chipirones y marisco. Viernes a domingo. Reserva en el 956 36 42 98.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 956 36 42 98',
	image: images,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, tarjeta de crédito',
	servesCuisine: ['Española', 'Pescados y mariscos', 'Pescaíto frito', 'Andaluza'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: business.region,
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday', 'Sunday'], opens: '12:30', closes: '16:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday', 'Saturday', 'Sunday'], opens: '20:00', closes: '23:00' },
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Aseo adaptado', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Ideal para grupos', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.4,
		reviewCount: 4413,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1714" />
		<meta
			name="description"
			content="El Colorao en Sanlúcar de Barrameda: pescaíto frito desde 1937, chipirones y marisco en la calle Sargenta, 39. Reserva en el 956 36 42 98."
		/>
		<meta
			name="keywords"
			content="El Colorao Sanlúcar, marisquería calle Sargenta, pescaíto frito Sanlúcar, chipirones Sanlúcar, restaurante Sanlúcar de Barrameda"
		/>
		<meta name="author" content="El Colorao" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>El Colorao | Pescaíto frito desde 1937 en Sanlúcar</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="El Colorao · Pescaíto frito en Sanlúcar" />
		<meta
			property="og:description"
			content="Desde 1937 dedicados al pescaíto frito: chipirones, ensaladilla y marisco en la calle Sargenta, 39 (Sanlúcar). Viernes a domingo."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero.src}`} />
		<meta property="og:image:width" content={String(photos.hero.width)} />
		<meta property="og:image:height" content={String(photos.hero.height)} />
		<meta property="og:image:alt" content="El Colorao, marisquería en Sanlúcar de Barrameda" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content={business.region} />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="El Colorao · Pescaíto frito en Sanlúcar" />
		<meta
			name="twitter:description"
			content="Pescaíto frito desde 1937 en la calle Sargenta, 39 (Sanlúcar de Barrameda)."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero.src}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Sanlúcar de Barrameda" />
		<meta name="geo.position" content="36.7836573;-6.347002" />
		<meta name="ICBM" content="36.7836573, -6.347002" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="El Colorao, inicio">
				<span class="brand-mark" aria-hidden="true">C</span>
				<span class="brand-name">El Colorao <small>Sanlúcar · Sargenta</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#colorao">El Colorao</a>
				<a href="#especialidades">Especialidades</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>956 36 42 98</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle Sargenta · Sanlúcar</p>
					<h1 id="hero-title">Pescaíto frito<br />desde 1937<br /><em>en Sanlúcar.</em></h1>
					<p class="hero-lede">
						El Colorao en la calle Sargenta: restaurante y marisquería dedicado al pescaíto frito desde 1937.
						Chipirones, ensaladilla, croquetas y pescado del día, con trato atento y rápido.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>
							Reservar 956 36 42 98
						</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,4</b> en Google (4.413 reseñas)</li>
						<li>Pescaíto frito</li>
						<li>Marisquería</li>
						<li>Vie–Dom</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<Image
						src={photos.hero}
						widths={[480, 720, 960, 1200]}
						sizes="(max-width: 980px) 92vw, 46vw"
						format="avif"
						quality={70}
						alt="Fotografía de El Colorao publicada en su ficha de Google Maps (Sanlúcar de Barrameda)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,4</b><span>Google</span></div>
					<div><b>4.4k</b><span>Reseñas</span></div>
					<div><b>1937</b><span>Desde</span></div>
				</div>
				<ul class="services">
					<li>Pescaíto frito</li>
					<li>Marisquería</li>
					<li>Local accesible</li>
					<li>Grupos</li>
					<li>Reservas</li>
					<li>Fin de semana</li>
				</ul>
			</section>

			<section class="about section-pad" id="colorao">
				<p class="section-label"><span aria-hidden="true"></span> Un clásico en Sanlúcar</p>
				<div class="about-grid">
					<h2>Fritura sanluqueña<br />de viernes a domingo<br /><em>desde 1937.</em></h2>
					<div class="about-copy">
						<p>
							El Colorao está en la calle Sargenta, 39, 11540 Sanlúcar de Barrameda (Cádiz). Restaurante y
							marisquería que, en sus propias palabras, lleva desde 1937 dedicado al pescaíto frito.
						</p>
						<p>
							Lo que más citan sus clientes: pescaíto frito espectacular, chipirones, ensaladilla y croquetas,
							con camareros atentos y rápidos y cerveza bien fría. Un sitio para repetir.
						</p>
						<p class="about-note">
							Sobre el horario: la ficha de Google Maps marca de lunes a jueves cerrado y viernes, sábado y
							domingo de 12:30 a 16:00 y de 20:00 a 23:00. Si vienes en festivo, llama antes.
						</p>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Platos citados en la descripción del propio local y en las reseñas de sus clientes. La carta cambia
						según mercado, así que confirma disponibilidad al reservar.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>El Colorao<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps de El Colorao. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[320, 480, 640]}
									sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 30vw"
									format="avif"
									quality={65}
									loading="lazy"
									decoding="async"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres
					el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Calle Sargenta, 39</p>
					<h2>Ven de pescaíto<br /><em>a Sanlúcar.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.postalCode} {business.city} ({business.province}), España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Lunes a jueves</th>
								<td>Cerrado</td>
							</tr>
							<tr>
								<th scope="row">Viernes a domingo</th>
								<td>12:30 – 16:00 · 20:00 – 23:00</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario de la ficha de Google Maps. En festivos o puentes, llama antes de
						venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>
							Llamar 956 36 42 98
						</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 956 36 42 98</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe
							title="Mapa de El Colorao en la calle Sargenta, 39, Sanlúcar de Barrameda"
							src={mapEmbedUrl}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
						<noscript>
							<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
						</noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> El Colorao · Sanlúcar
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">C</span>
				<p>El Colorao<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} El Colorao · Sanlúcar de Barrameda. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>

			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;">
				<small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small>
			</p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al Colorao <span>956 36 42 98</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	</body>
</html>
