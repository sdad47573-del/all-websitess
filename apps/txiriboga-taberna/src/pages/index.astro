---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import solomillo from '../assets/fotos/txiriboga-taberna-vertical-01.jpg';
import fachada from '../assets/fotos/txiriboga-taberna-vertical-02.jpg';
import pulpo from '../assets/fotos/txiriboga-taberna-apaisada-03.jpg';
import mousse from '../assets/fotos/txiriboga-taberna-vertical-04.jpg';
import ensalada from '../assets/fotos/txiriboga-taberna-vertical-05.jpg';
import carne from '../assets/fotos/txiriboga-taberna-vertical-06.jpg';
import torrija from '../assets/fotos/txiriboga-taberna-vertical-07.jpg';
import pan from '../assets/fotos/txiriboga-taberna-vertical-08.jpg';
import pescado from '../assets/fotos/txiriboga-taberna-apaisada-09.jpg';
import guiso from '../assets/fotos/txiriboga-taberna-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Txiriboga Taberna, taberna y bar en Irazu Kalea, 6 (20170 Usurbil, Gipuzkoa). Cocina de producto local, carta, platos combinados y raciones, con pan hecho en casa. 4,5 sobre 5 en Google con 108 reseñas.';

const galeria = [
	{
		src: pan,
		alt: 'Panes caseros recién horneados sobre una rejilla',
	},
	{
		src: fachada,
		alt: 'Fachada de piedra de Txiriboga Taberna con el rótulo en la puerta y una barrica en la calle',
	},
	{
		src: torrija,
		alt: 'Torrija caramelizada con helado de chocolate',
	},
	{
		src: pescado,
		alt: 'Pescado al horno con patatas panadera en un plato blanco',
	},
	{
		src: carne,
		alt: 'Carne a la plancha con cebolla caramelizada y guindillas',
	},
	{
		src: solomillo,
		alt: 'Carne con setas y salsa en un plato blanco',
	},
	{
		src: mousse,
		alt: 'Mousse de chocolate en un tarro de cristal con galleta desmenuzada',
	},
	{
		src: guiso,
		alt: 'Carne en salsa con patatas fritas',
	},
	{
		src: ensalada,
		alt: 'Ensalada de lechuga con vinagreta y queso en un plato rectangular',
	},
	{
		src: pulpo,
		alt: 'Pulpo a la brasa con salsa y brotes en un plato blanco',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'BarOrPub',
	'@id': `${BUSINESS.siteUrl}/#txiriboga`,
	name: BUSINESS.name,
	alternateName: ['Txiriboga', 'Txiriboga Usurbil', 'Taberna Txiriboga', 'Bar Txiriboga'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: `+34 ${BUSINESS.phone}`,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Cocina de producto local', 'Platos combinados', 'Raciones'],
	areaServed: [
		{ '@type': 'City', name: 'Usurbil' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '11:00',
			closes: '23:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Txiriboga Taberna · Taberna y bar en Usurbil';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"txiriboga-taberna-apaisada-03.jpg": pulpo,
	"txiriboga-taberna-vertical-08.jpg": pan,
	"txiriboga-taberna-vertical-02.jpg": fachada,
	"txiriboga-taberna-vertical-07.jpg": torrija,
	"txiriboga-taberna-apaisada-09.jpg": pescado,
	"txiriboga-taberna-vertical-06.jpg": carne,
	"txiriboga-taberna-vertical-01.jpg": solomillo,
	"txiriboga-taberna-vertical-04.jpg": mousse,
	"txiriboga-taberna-apaisada-10.jpg": guiso,
	"txiriboga-taberna-vertical-05.jpg": ensalada,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2f3a2a" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Karla:wght@300..700&family=Young+Serif&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Txiriboga Taberna, Txiriboga Usurbil, taberna Usurbil, bar Usurbil, comer en Usurbil, platos combinados Usurbil, pintxos Usurbil, pan casero, restaurante Gipuzkoa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Taberna en Irazu Kalea, 6 (Usurbil). Cocina de producto local, carta, platos combinados y raciones, pan hecho en casa. 4,5 sobre 5 en Google con 108 reseñas."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Pulpo a la brasa con salsa y brotes en un plato blanco"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#2f3a2a"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Usurbil, Gipuzkoa"
			preload={[pulpo]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Txiriboga"
			subtitle="Taberna · Usurbil"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Txiriboga"
		/>
	</body>
</html>
