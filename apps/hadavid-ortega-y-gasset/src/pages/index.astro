---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/hadavid-ortega-y-gasset-vertical-01.jpg';
import segundaFoto from '../assets/fotos/hadavid-ortega-y-gasset-vertical-02.jpg';
import terceraFoto from '../assets/fotos/hadavid-ortega-y-gasset-vertical-03.jpg';
import panoramica from '../assets/fotos/hadavid-ortega-y-gasset-apaisada-04.jpg';
import { BUSINESS, FAQ, HIGHLIGHTS, HOURS, HOURS_NOTE, MAPS, MENU_GROUPS, SERVICIOS } from '../data/site';

const title = 'Hadavid Ortega y Gasset · Panadería en Málaga';
const description =
	'Hadavid Ortega y Gasset, panadería en Av. de José Ortega y Gasset, 111, Cruz de Humilladero, 29006 Málaga. Teléfono 632 94 79 21. Horario y cómo llegar.';
const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#hadavid-ortega-y-gasset`,
	name: BUSINESS.name,
	description: BUSINESS.description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34632947921',
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng },
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '08:30',
			closes: '21:00',
		},
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:30', closes: '15:00' },
	],
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};
const nav = [
	{ label: 'La panadería', href: '#casa' },
	{ label: 'Información', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];
const galeria = [
	{ src: fachada, alt: 'Fotografía vertical publicada en la ficha de Hadavid Ortega y Gasset en Google Maps' },
	{ src: segundaFoto, alt: 'Otra fotografía del perfil de Google Maps de la panadería Hadavid en Ortega y Gasset' },
	{ src: terceraFoto, alt: 'Imagen del establecimiento de Hadavid Ortega y Gasset descargada de Google Maps' },
	{ src: panoramica, alt: 'Fotografía apaisada del establecimiento, de la galería pública de Google Maps' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#2e1f15" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,300..700;1,300..600&family=Work+Sans:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Hadavid Ortega y Gasset, panadería Málaga, panadería Cruz de Humilladero, Ortega y Gasset 111, 29006"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Hadavid Ortega y Gasset, panadería en Cruz de Humilladero, Málaga. Dirección, horario, teléfono y fotografías de la ficha pública."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fotografía de Hadavid Ortega y Gasset en Málaga, procedente de su ficha de Google Maps"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#2e1f15"
			phone="+34632947921"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Panadería · Ortega y Gasset"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación de Hadavid Ortega y Gasset"
		/>
		<main id="contenido">
			<LocalHero
				eyebrow="Av. de José Ortega y Gasset, 111 · Málaga"
				title="Una panadería <br /><em>en el barrio.</em>"
				lede="Hadavid Ortega y Gasset es una panadería de la avenida de José Ortega y Gasset, en Cruz de Humilladero. Aquí tienes su ubicación, teléfono, horario publicado en Google Maps y fotos de la ficha de esta dirección."
				image={fachada}
				imageAlt="Foto de la ficha de Hadavid Ortega y Gasset en Google Maps"
				primaryCta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver ficha de Google Maps', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Reseñas', html: '<b>22</b> en Google' },
					{ label: 'Horario', html: '<b>L–V 8:30–21:00</b> · S 8:30–15:00' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b>` },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Panadería · Málaga"
			/>
			<LocalChips label="Hadavid Ortega y Gasset" items={SERVICIOS} />
			<LocalAbout
				label="La panadería"
				title="En la avenida <br /><em>Ortega y Gasset.</em>"
				paragraphs={[
					'Hadavid Ortega y Gasset está en el número 111 de la avenida, en Cruz de Humilladero, 29006 Málaga. La ficha pública de Google Maps identifica este local como panadería.',
					'En la ficha puedes consultar la ubicación, llamar al establecimiento, ver las reseñas y acceder a las fotografías publicadas para esta dirección.',
					'El horario mostrado por Google Maps es de lunes a viernes de 8:30 a 21:00, los sábados de 8:30 a 15:00 y los domingos cerrado. Los horarios y el surtido pueden cambiar; confirma por teléfono antes de ir.',
				]}
				note="Esta web corresponde a la ficha de Hadavid Ortega y Gasset, en Cruz de Humilladero; es un local distinto de Hadavid Teatinos."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>
			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow"><span aria-hidden="true"></span> Datos del establecimiento</p>
						<h2 id="three-title">Ubicación, horario <br /><em>y contacto.</em></h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>
			<LocalMenu
				eyebrow="La ficha de Google"
				title="Datos para <br /><em>tu visita.</em>"
				description="Una guía práctica con la información publicada para esta panadería. La ficha no muestra un catálogo completo ni precios."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note={`Para confirmar el horario y el surtido del día, llama al ${BUSINESS.phone}.`}
			/>
			<LocalGallery
				eyebrow="Imágenes del perfil"
				title="Fotos de <br /><em>esta dirección.</em>"
				description="Las cuatro imágenes descargables de la galería pública de Hadavid Ortega y Gasset en Google Maps."
				images={galeria}
				cta={{ label: 'Abrir la ficha de Google', href: MAPS.place }}
				note="Fotografías del perfil público de Google Maps correspondiente a Av. de José Ortega y Gasset, 111."
			/>
			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Ortega <br /><em>y Gasset.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google Maps"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa de Hadavid Ortega y Gasset en la avenida de José Ortega y Gasset, 111, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Hadavid · Ortega y Gasset"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha de Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="El horario puede cambiar en festivos. Para confirmar que está abierto y consultar el surtido, llama antes de desplazarte."
			/>
			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>
		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Dirección, teléfono, horario, reseñas y fotos consultados en la ficha pública de Google Maps en octubre de 2026. La información puede variar; confirma antes de ir."
			ctaLabel="Llamar a Hadavid Ortega y Gasset"
			navAriaLabel="Enlaces de Hadavid Ortega y Gasset"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
