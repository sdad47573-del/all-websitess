---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import janela from '../assets/fotos/flor-do-mundo-vertical-08.jpg';
import fachada from '../assets/fotos/flor-do-mundo-apaisada-01.jpg';
import esplanada from '../assets/fotos/flor-do-mundo-apaisada-09.jpg';
import vitrine from '../assets/fotos/flor-do-mundo-apaisada-06.jpg';
import frango from '../assets/fotos/flor-do-mundo-vertical-05.jpg';
import peixe from '../assets/fotos/flor-do-mundo-apaisada-03.jpg';
import polvo from '../assets/fotos/flor-do-mundo-apaisada-04.jpg';
import polvoArroz from '../assets/fotos/flor-do-mundo-vertical-10.jpg';
import ovos from '../assets/fotos/flor-do-mundo-vertical-07.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const description =
	'Flor do Mundo, pastelería y restaurante en la R. da Misericórdia 87, Chiado (Lisboa): cocina portuguesa, brunch y café de 7:00 a 24:00, de lunes a sábado. 4,4 en Google con 755 reseñas. Tel. 21 346 9589.';

const galeria = [
	{
		src: fachada,
		alt: 'Fachada negra de Flor do Mundo en la Rua da Misericórdia, con el letreiro de pastelería y restaurante',
	},
	{
		src: esplanada,
		alt: 'Terraza de Flor do Mundo en el Chiado, con clientes en las mesas junto a la fachada de azulejos',
	},
	{
		src: vitrine,
		alt: 'Vitrina de Flor do Mundo con pastéis de nata, tartas, bollería, fruta y bebidas',
	},
	{
		src: frango,
		alt: 'Frango piri-piri con patatas fritas, arroz y ensalada servido en Flor do Mundo',
	},
	{
		src: peixe,
		alt: 'Pescado grelhado con patatas a murro, ensalada y limón en Flor do Mundo',
	},
	{
		src: polvo,
		alt: 'Salada de pulpo con aceitunas, zanahoria y cilantro en Flor do Mundo, con cesto de pan',
	},
	{
		src: polvoArroz,
		alt: 'Pulpo asado con patatas y arroz de marisco servidos en Flor do Mundo',
	},
	{
		src: ovos,
		alt: 'Plato de la casa con salsa servido en un plato hondo en Flor do Mundo',
	},
];

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': ['Restaurant', 'CafeOrCoffeeShop'],
	'@id': `${BUSINESS.siteUrl}/#restaurante`,
	name: BUSINESS.name,
	alternateName: ['Flor do Mundo Chiado', 'Pastelaria Flor do Mundo', 'Flor do Mundo Lisboa'],
	slogan: 'Pastelería y restaurante en el Chiado, de la mañana a medianoche',
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+351 21 346 9589',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Portuguesa', 'Cafetería', 'Brunch'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Chiado' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '07:00',
			closes: '00:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos accesibles para personas en sillas de ruedas',
			value: true,
		},
		{ '@type': 'LocationFeatureSpecification', name: 'Terraza', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: [
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Fomos em 5 pessoas e a conta deu 56 €, com comida, bebida e uma sobremesa.',
		},
		{
			'@type': 'Review',
			reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5 },
			reviewBody: 'Comi meia porção de carne de porco à alentejana e estava delicioso!',
		},
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Flor do Mundo · Pastelería y restaurante en el Chiado';
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#241d19" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Flor do Mundo, Flor do Mundo Chiado, pastelaria Chiado, restaurante Chiado, comer en Chiado, cocina portuguesa Lisboa, brunch Lisboa, R. da Misericórdia 87, pasteles de nata Chiado, bacalhau à lagareiro Lisboa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle="Flor do Mundo · Pastelería y restaurante en el Chiado"
			ogDescription="Cocina portuguesa, vitrina de pasteles y café en la Rua da Misericórdia, de 7:00 a 24:00 de lunes a sábado. 4,4 en Google con 755 reseñas. Tel. 21 346 9589."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Flor do Mundo en la Rua da Misericórdia, en el Chiado de Lisboa"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#241d19"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone="+351213469589"
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName={`${BUSINESS.city}, ${BUSINESS.regionName}`}
			countryName="Portugal"
			contact={{
				street: BUSINESS.street,
				locality: BUSINESS.city,
				region: BUSINESS.region,
				postalCode: BUSINESS.postalCode,
				country: 'Portugal',
				phone: '+351 21 346 9589',
				latitude: BUSINESS.geo.lat,
				longitude: BUSINESS.geo.lng,
			}}
			preload={[janela]}
			schemas={[restaurantSchema, faqSchema]}
		/>
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			subtitle="Pastelería · Restaurante · Chiado"
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="R. da Misericórdia, 87 · Chiado, Lisboa"
				title="Una flor<br />en la Rua da<br /><em>Misericórdia.</em>"
				lede={`Flor do Mundo es pastelería y restaurante en pleno Chiado: cocina portuguesa todo el día, vitrina de pasteles y café desde las siete de la mañana hasta medianoche, de lunes a sábado.`}
				image={janela}
				imageAlt="Bacalhau à lagareiro con patatas y aceitunas en la ventana de Flor do Mundo, con la Rua da Misericórdia al fondo"
				primaryCta={{ label: `Llamar ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ver la ficha en Google Maps', href: MAPS.place, external: true }}
				tag="Chiado"
				facts={[
					{ label: 'Nota', html: '<b>4,4 en Google</b> con 755 reseñas' },
					{ label: 'Horario', html: '<b>7:00 – 24:00</b>' },
					{ label: 'De lunes a sábado', html: '<b>Domingo cerrado</b>' },
					{ label: 'Cocina', html: '<b>Abierta 10:00 – 00:00</b>' },
				]}
				galleryHref={MAPS.place}
			/>

			<LocalChips label="Qué ofrece Flor do Mundo" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Pastelería y restaurante<br /><em>en el Chiado.</em>"
				paragraphs={[
					'En el número 87 de la Rua da Misericórdia, entre el Chiado y el Bairro Alto, Flor do Mundo se presenta como pastelería y restaurante. La fachada negra, con el letreiro grande y el toldo de «Restaurante · Pastelaria», anuncia cocina abierta hasta medianoche: el mismo local sirve café y desayuno por la mañana, comida a mediodía y cena por la noche.',
					'Dentro está la vitrina de pasteles —pastéis de nata, tartas, bollería y fruta— y una cocina portuguesa de todos los días: frango piri-piri com batatas e arroz, peixe grelhado com batatas a murro, bacalhau à lagareiro, salada de polvo e arroz de marisco. En las fotos del perfil aparece servido en platos de aluminio, como en las tascas del barrio, con las ventanas del Chiado al fondo.',
					'En los cristales, dos carteles de la casa: «A arte da cerveja» y Ginja Serra da Estrela, de la que el local se anuncia como socio oficial. Las reseñas hablan de precio ajustado —«fomos em 5 pessoas e a conta deu 56 €, com comida, bebida e uma sobremesa»— y de platos como la carne de porco à alentejana.',
				]}
				note="«Comi meia porção de carne de porco à alentejana e estava delicioso», dice una reseña. Otra resume la cuenta: cinco personas, 56 € con comida, bebida y una sobremesa."
				links={[
					{ label: 'Leer reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ficha del restaurante', href: MAPS.cid, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="De la vitrina<br /><em>a la mesa.</em>"
				description="La ficha de Google no publica carta, pero las fotos del perfil y los carteles del local sí cuentan qué se come: pastelería y café, cocina portuguesa de tasca y platos de pescado y brasa."
				cta={{ label: `Preguntar por el menú: ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin carta publicada en Google: los platos del día, los precios y la disponibilidad se consultan en el local o llamando al 21 346 9589. Una reseña deja una referencia de precio: cinco personas, 56 € con comida, bebida y postre."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="La fachada,<br />la vitrina<br /><em>y los platos.</em>"
				description="Estas fotografías proceden del perfil de Flor do Mundo en Google Maps: la fachada de la Rua da Misericórdia, la terraza del Chiado, la vitrina de pasteles y los platos que salen de su cocina."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta web procedentes del perfil del restaurante en Google Maps. Si eres el titular y quieres retirar alguna, escríbenos y la quitamos."
			/>

			<LocalVisit
				eyebrow="R. da Misericórdia, 87 · 1200-284 Lisboa"
				title="En el Chiado,<br /><em>de la mañana a la noche.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Chiado, Portugal']}
				hoursCaption="Horario de la ficha de Google"
				hours={HOURS}
				hoursNote="De lunes a sábado, de 7:00 a 24:00, sin cerrar a mediodía. Domingo cerrado. El toldo de la fachada concreta que la cocina abre de 10:00 a 00:00. En festivos puede cambiar: llama antes."
				mapTitle="Mapa de Flor do Mundo en la Rua da Misericórdia, 87, Chiado (Lisboa)"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Flor do Mundo · Chiado"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `+351 ${BUSINESS.phoneDisplay}`, href: BUSINESS.phoneHref }}
				reserveNote="No hay reserva online: se reserva por teléfono, en el 21 346 9589. La ficha de Google marca asientos accesibles para personas en sillas de ruedas; para entrada y aseo adaptados conviene preguntar al llamar."
			/>

			<LocalFaq items={FAQ} title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: BUSINESS.phoneDisplay, href: BUSINESS.phoneHref },
			]}
			phone={BUSINESS.phoneDisplay}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del restaurante en Google Maps. Información elaborada a partir de fuentes públicas; confirma horarios, carta y precios antes de la visita."
			ctaLabel="Llamar a Flor do Mundo"
			creditLabel="Creado por"
		/>
	</body>
</html>
