---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import fachada from '../assets/fotos/carmar-restaurante-e-pastelaria-apaisada-01.jpg';
import peixeGrelhado from '../assets/fotos/carmar-restaurante-e-pastelaria-apaisada-02.jpg';
import bifeOvo from '../assets/fotos/carmar-restaurante-e-pastelaria-vertical-03.jpg';
import entrecosto from '../assets/fotos/carmar-restaurante-e-pastelaria-vertical-04.jpg';
import peixeAlho from '../assets/fotos/carmar-restaurante-e-pastelaria-apaisada-05.jpg';
import sala from '../assets/fotos/carmar-restaurante-e-pastelaria-vertical-06.jpg';
import ameijoas from '../assets/fotos/carmar-restaurante-e-pastelaria-apaisada-07.jpg';
import sopaMarisco from '../assets/fotos/carmar-restaurante-e-pastelaria-apaisada-08.jpg';
import legumes from '../assets/fotos/carmar-restaurante-e-pastelaria-vertical-09.jpg';
import rua from '../assets/fotos/carmar-restaurante-e-pastelaria-vertical-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICOS } from '../data/site';

const title = 'Restaurante e Pastelaria Carmar · Lisboa';
const description = BUSINESS.description;

const galeria = [
	{
		src: peixeGrelhado,
		alt: 'Peixe grelhado inteiro com batatas cozidas, salada, tomate e uma rodela de limão num prato branco',
	},
	{
		src: bifeOvo,
		alt: 'Bife com ovo a cavalo, batata frita, arroz, salada e limão num prato fundo de linhaça',
	},
	{
		src: peixeAlho,
		alt: 'Filete de peixe com cebola e alho dourados, batatas assadas e grelos salteados em azeite',
	},
	{
		src: entrecosto,
		alt: 'Entrecosto grelhado com salada, um prato de frango com salsicha e batata frita e arroz de feijão à mesa',
	},
	{
		src: ameijoas,
		alt: 'Amêijoas abertas em azeite e alho numa travessa de metal',
	},
	{
		src: sopaMarisco,
		alt: 'Sopa de marisco alaranjada com um camarão e quadrados de pão torrado numa tigela branca',
	},
	{
		src: sala,
		alt: 'Sala do Carmar com arcos de pedra, mesas de toalha branca, cadeiras de madeira, clientes e a vitrine da pastelaria ao fundo',
	},
	{
		src: legumes,
		alt: 'Legumes salteados com batata, cenoura, brócolos, feijão-verde e ervas num prato branco',
	},
	{
		src: rua,
		alt: 'Rua do Arco do Marquês de Alegrete com prédios amarelos, calçada portuguesa, motos estacionadas e os toldos do Carmar ao fundo',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#carmar`,
	name: BUSINESS.name,
	alternateName: ['Carmar', 'Restaurante Carmar', 'Pastelaria Carmar Lisboa'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Portuguesa'],
	areaServed: [
		{ '@type': 'City', name: 'Lisboa' },
		{ '@type': 'AdministrativeArea', name: 'Área Metropolitana de Lisboa' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [
				'Monday',
				'Tuesday',
				'Wednesday',
				'Thursday',
				'Friday',
				'Saturday',
				'Sunday',
			],
			opens: '07:00',
			closes: '22:00',
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'A casa', href: '#casa' },
	{ label: 'A mesa', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Perguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="pt">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1d4e6b" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400;1,9..144,600&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Restaurante e Pastelaria Carmar, Carmar Lisboa, restaurante Rua do Arco do Marquês de Alegrete, pastelaria Lisboa, restaurante português Lisboa, peixe grelhado Lisboa, comer em Lisboa"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Restaurante português e pastelaria na R. do Arco do Marquês de Alegrete 3, em Lisboa. Aberto todos os dias das 7:00 às 22:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada do Restaurante e Pastelaria Carmar, com os toldos e a fachada de azulejo"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#1d4e6b"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="PT-11"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Lisboa, Portugal"
			locale="pt_PT"
			countryName="Portugal"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Carmar"
			subtitle="Restaurante · Lisboa"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="início"
			navAriaLabel="Navegação principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow="R. do Arco do Marquês de Alegrete 3 · Lisboa"
				title="Restaurante e pastelaria <br /><em>em Lisboa.</em>"
				lede={`O Carmar é um restaurante português com pastelaria na R. do Arco do Marquês de Alegrete 3, em Lisboa. Abre todos os dias às 7:00 e fecha às 22:00, e a ficha de Google dá-lhe 3,4 sobre 5 com 48 críticas.`}
				image={fachada}
				imageAlt="Fachada do Restaurante e Pastelaria Carmar com três toldos, a fachada revestida de azulejo e a rua em calçada com carris de elétrico"
				primaryCta={{ label: 'Como chegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha e críticas no Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>3,4</b> no Google · 48 críticas' },
					{ label: 'Horário', html: '<b>7:00–22:00</b> todos os dias' },
					{ label: 'Telefone', html: `<b>${BUSINESS.phone}</b> contacto publicado` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto do perfil de Google Maps"
				galleryLinkLabel="Ver a galeria"
			/>

			<LocalChips label="O que encontras no Restaurante e Pastelaria Carmar" items={SERVICOS} />

			<LocalAbout
				label="A casa"
				title="Três toldos <br /><em>na mesma fachada.</em>"
				paragraphs={[
					'O Carmar ocupa o rés-do-chão de um prédio na R. do Arco do Marquês de Alegrete 3, em Lisboa (1100-240). A fachada está forrada de azulejo e reparte-se em três toldos: «Carmar», «Cafetaria» e «Restaurante».',
					'A Google classifica a casa como restaurante português e dá-lhe 3,4 sobre 5 com 48 críticas. Na ficha publica um telefone, o único canal de contacto: +351 918 602 622. Não indica site próprio, carta nem preços.',
					'As fotografias do perfil mostram uma sala de teto alto com arcos de pedra, mesas de toalha branca e cadeiras de madeira, e uma vitrine ao fundo. À mesa aparecem peixe grelhado com batata e salada, bife com ovo, entrecosto, amêijoas em azeite e sopa de marisco — a lona da entrada anuncia «Fresh Fish».',
					'O horário é contínuo: todos os dias, das 7:00 às 22:00. A ficha avisa que em feriados pode ser diferente, por isso vale a pena ligar antes de ir.',
				]}
				note="A informação vem da ficha pública de Google Maps e das fotografias do perfil da casa. A ficha não publica carta nem preços, por isso nenhum desses dados aparece aqui."
				links={[
					{ label: 'Ficha e críticas no Google', href: MAPS.reviews, external: true },
					{ label: 'Ver a casa no Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="A mesa"
				title="Peixe, carne <br /><em>e pastelaria.</em>"
				description="A ficha de Google não publica carta nem preços, e o restaurante não tem site próprio. O que segue são os pratos que aparecem nas fotografias do perfil da casa, além da categoria e do horário da ficha."
				cta={{ label: 'Ver fotos no Google Maps', href: MAPS.place }}
				groups={MENU}
				note="Não há carta publicada. Os pratos das fotografias são a única referência da cozinha e podem não corresponder à oferta do dia: confirma por telefone ou na ficha antes de contar com eles."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Nove fotografias <br /><em>da casa.</em>"
				description="As fotografias do perfil do Restaurante e Pastelaria Carmar em Google Maps: os pratos, a sala com os arcos de pedra e a rua onde fica o restaurante."
				images={galeria}
				cta={{ label: 'Ver tudo no Google Maps', href: MAPS.place }}
				note="Imagens alojadas nesta página e provenientes do perfil do estabelecimento em Google Maps. Se tens os direitos de alguma e queres retirá-la, diz-nos e apagamo-la."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Passa pelo <br /><em>Arco do Marquês.</em>"
				addressLines={[BUSINESS.street, `${BUSINESS.postalCode} ${BUSINESS.city}`, 'Lisboa, Portugal']}
				hours={HOURS}
				hoursCaption="Horário"
				hoursNote="Horário publicado na ficha de Google: todos os dias, das 7:00 às 22:00. A ficha assinala que em feriados pode ser diferente, por isso convém confirmá-lo antes de ir."
				mapTitle="Mapa do Restaurante e Pastelaria Carmar na R. do Arco do Marquês de Alegrete 3, Lisboa"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Carmar · Lisboa"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Como chegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Ligar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="O telefone é o único canal de contacto que publica a ficha. Não há reservas nem encomendas em linha: a casa não tem site próprio nem plataforma de reservas associada. A ficha também não indica informação sobre esplanada, take-away ou acessibilidade."
			/>

			<LocalFaq items={FAQ} eyebrow="Perguntas frequentes" title="Antes de <em>vir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Críticas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografias provenientes do perfil do estabelecimento em Google Maps. Informação elaborada a partir de fontes públicas; confirma horário e oferta antes da visita."
			ctaLabel="Ligar"
			navAriaLabel="Ligações do Restaurante e Pastelaria Carmar"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidade', href: '/aviso-legal#privacidade' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web criada por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
