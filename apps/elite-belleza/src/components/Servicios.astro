---
import { BUSINESS, SERVICIOS, VENTAJAS } from '../data/site';
---

<section id="servicios" class="bg-base-200 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">Servicios</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">
				Centro de estética en Centro
			</h2>
			<div class="astyle-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6 leading-relaxed">
				El estudio no publica carta ni precios, así que aquí no se inventan importes.
				Consulta la
				<a
					class="text-primary font-semibold"
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer">ficha de Google</a
				>
				y te confirman servicio y precio antes de empezar.
			</p>
		</div>

		<div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				SERVICIOS.map((servicio) => (
					<article class="etiqueta-astyle border-base-300 bg-base-100 group rounded-sm border p-6 transition-shadow hover:shadow-lg">
						<span class="bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-content flex size-12 items-center justify-center rounded-md transition-colors">
							<i class={`${servicio.icon} text-2xl`} />
						</span>
						<h3 class="mt-5 text-xl font-bold">{servicio.title}</h3>
						<p class="text-base-content/65 mt-2 text-sm leading-relaxed">{servicio.text}</p>
					</article>
				))
			}
		</div>

		<p class="mt-4 text-center text-sm">
			<a href="/servicios" class="text-primary font-semibold underline"
				>Ver todos los servicios</a
			>
		</p>

		<div class="mt-16">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="font-display text-3xl font-bold sm:text-4xl">Por qué elegirnos</h2>
				<div class="astyle-divider mx-auto mt-5 h-px w-32"></div>
			</div>
			<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{
					VENTAJAS.map((ventaja) => (
						<article class="border-base-300 bg-base-100 flex h-full gap-4 rounded-sm border p-6">
							<span class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-md">
								<i class={`${ventaja.icon} text-xl`} />
							</span>
							<div>
								<h3 class="text-lg font-bold">{ventaja.title}</h3>
								<p class="text-base-content/65 mt-1 text-sm leading-relaxed">{ventaja.text}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>

		<div
			class="border-base-300 bg-base-100 mt-14 grid gap-6 rounded-sm border p-8 lg:grid-cols-[1.4fr_1fr] lg:items-center"
		>
			<div>
				<h3 class="text-2xl font-bold">Cita a través de la ficha de Google</h3>
				<p class="text-base-content/70 mt-3 text-sm leading-relaxed">
					La cita se concierta por el canal que indique la ficha pública de el estudio.
					Te confirman servicio, precio y hora al momento.
				</p>
			</div>
			<div class="flex flex-wrap gap-3 lg:justify-end">
				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary gap-2 rounded-full"
				>
					<i class="ri-google-fill"></i> Ver la ficha
				</a>
				<a
					href={BUSINESS.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline gap-2 rounded-full"
				>
					<i class="ri-map-pin-line"></i> Cómo llegar
				</a>
			</div>
		</div>
	</div>
</section>
