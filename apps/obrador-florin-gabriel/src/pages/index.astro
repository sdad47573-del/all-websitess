---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import baguettes from '../assets/fotos/obrador-florin-gabriel-apaisada-05.jpg';
import bollos from '../assets/fotos/obrador-florin-gabriel-apaisada-06.jpg';
import tartaUnicornio from '../assets/fotos/obrador-florin-gabriel-vertical-01.jpg';
import pastelitos from '../assets/fotos/obrador-florin-gabriel-vertical-04.jpg';
import berlinas from '../assets/fotos/obrador-florin-gabriel-vertical-07.jpg';
import tartaFoto from '../assets/fotos/obrador-florin-gabriel-vertical-08.jpg';
import napolitanas from '../assets/fotos/obrador-florin-gabriel-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Obrador de Panadería y Pastelería Florin & Gabriel · Málaga';
const description =
	'OBRADOR de Panadería y Pastelería (Florin & Gabriel), en C. Carraca, 5, Loc 20 (Bailén-Miraflores, 29011 Málaga). Fabricación propia de pan, bollería y tartas para el público y la hostelería. Teléfono 667 32 81 16.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#florin-gabriel`,
	name: BUSINESS.name,
	alternateName: [
		'Florin & Gabriel',
		'Obrador Florin y Gabriel',
		'Obrador de Panadería y Pastelería Málaga',
	],
	description:
		'Obrador de panadería y pastelería con fabricación propia en C. Carraca, 5, local 20 (Bailén-Miraflores, 29011 Málaga). Venta al público y a la hostelería: pan, bollería y tartas personalizadas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34667328116',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '05:00',
			closes: '22:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El obrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: tartaUnicornio,
		alt: 'Tarta de cumpleaños decorada con un unicornio, arcoíris y el nombre Chloe',
	},
	{
		src: bollos,
		alt: 'Bandeja de bollos glaseados recién hechos en el obrador',
	},
	{
		src: napolitanas,
		alt: 'Napolitanas de chocolate con hilos de chocolate por encima',
	},
	{
		src: berlinas,
		alt: 'Berlinas bañadas en chocolate con nata rosa por encima',
	},
	{
		src: pastelitos,
		alt: 'Bandeja de pastelitos cuadrados en filas, listos para el mostrador',
	},
	{
		src: tartaFoto,
		alt: 'Tarta rectangular con una foto comestible y decoración de nata',
	},
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#163237" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,300..700;1,300..600&family=Source+Sans+3:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Obrador Florin y Gabriel, panadería Málaga, pastelería Bailén-Miraflores, pan al por mayor Málaga, tartas personalizadas, bollería hostelería, 29011"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Obrador con fabricación propia: pan, bollería y tartas personalizadas. Venta al público y a la hostelería en C. Carraca, 5, Málaga."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de baguettes recién hechas en el obrador Florin & Gabriel"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#163237"
			phone="+34667328116"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[baguettes]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Obrador · Panadería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Carraca, 5, Loc 20 · Bailén-Miraflores"
				title="Pan y pastelería <br /><em>de obrador.</em>"
				lede={`El obrador de Florin & Gabriel está en la calle Carraca, 5, local 20, en Bailén-Miraflores. Hacen pan, bollería y pastelería con fabricación propia, y venden tanto al público como al sector de la hostelería. En las fotos del perfil se ven baguettes, bollos glaseados, napolitanas, berlinas y tartas personalizadas con nombre o foto. ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 con ${BUSINESS.reviewsCount} reseñas en Google.`}
				image={baguettes}
				imageAlt="Bandeja de baguettes recién hechas en el obrador, sobre la mesa de acero"
				primaryCta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>3,7</b> en Google · 9 reseñas' },
					{ label: 'Horario', html: '<b>Todos los días</b> 5:00–22:30' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b>` },
				]}
				galleryHref={MAPS.streetView}
				photoCredit="Foto de la ficha de Google Maps"
				galleryLinkLabel="Ver la calle en Street View"
				tag="Pan · bollería · tartas"
			/>

			<LocalChips label="Lo que hay en el obrador" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Un obrador <br /><em>con horno propio.</em>"
				paragraphs={[
					'El OBRADOR de Panadería y Pastelería de Florin & Gabriel está en la calle Carraca, 5, local 20, en Bailén-Miraflores. La ficha lo define como obrador con fabricación propia: aquí se amasa, se hornea y se prepara la pastelería que después se vende.',
					'La ficha explica que venden al público y «principalmente» al sector de la hostelería, con precios competitivos, y que realizan «cualquier tipo de pan y bollería que se necesite», adaptándose a los gustos comerciales del cliente.',
					'En las fotos del perfil se ve el trabajo del obrador: bandejas de baguettes, bollos glaseados, napolitanas de chocolate, berlinas bañadas con nata, filas de pastelitos y tartas de chocolate. También hay tartas personalizadas, una con foto comestible y otra con decoración de unicornio y nombre.',
					'Abre todos los días de 5:00 a 22:30. La ficha no publica carta, precios ni página web, así que aquí no encontrarás importes: para encargos y condiciones de hostelería, la vía es el teléfono 667 32 81 16.',
				]}
				note="Sin carta ni precios publicados: el mostrador recoge solo lo que muestran las fotos del perfil y lo que explica la descripción de la ficha."
				links={[
					{ label: 'Ficha y fotos en Google', href: MAPS.place, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref },
				]}
			/>

			<section class="three section-pad" aria-labelledby="three-title">
				<div class="wrap">
					<div class="three-head">
						<p class="eyebrow">
							<span aria-hidden="true"></span> Tres cosas de la casa
						</p>
						<h2 id="three-title">
							Horno, obrador <br />
							<em>y hostelería.</em>
						</h2>
					</div>
					<div class="three-grid">
						{HIGHLIGHTS.map((item, index) => (
							<article class="three-card">
								<span class="three-num" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<LocalMenu
				eyebrow="El obrador"
				title="Lo que sale <br /><em>del horno.</em>"
				description="Sin carta ni precios publicados: esto es lo que muestran las fotos del local y lo que cuenta la ficha de Google."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU_GROUPS}
				note={`La ficha no recoge precios ni métodos de pago, así que esta web no publica importes. Para pan por encargo, tartas personalizadas o pedidos de hostelería, llama al ${BUSINESS.phone}.`}
			/>

			<LocalGallery
				eyebrow="Fotos"
				title="El obrador, <br /><em>por dentro.</em>"
				description="Seis fotos de la ficha de Google Maps: una tarta de unicornio, los bollos, las napolitanas, las berlinas, los pastelitos y una tarta con foto."
				images={galeria}
				cta={{ label: 'Ver todas en Google', href: MAPS.place }}
				note="Imágenes de la galería pública del establecimiento en Google Maps, consultada en octubre de 2026."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="En Carraca, <br /><em>local 20.</em>"
				addressLines={[
					BUSINESS.street,
					BUSINESS.district,
					`${BUSINESS.postalCode} ${BUSINESS.city}`,
				]}
				hours={HOURS}
				hoursCaption="Horario publicado en Google"
				hoursNote={HOURS_NOTE}
				mapTitle="Mapa del obrador de Panadería y Pastelería Florin & Gabriel en la calle Carraca, 5, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Florin & Gabriel · Carraca"
				mapHref={MAPS.place}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Llamar', href: BUSINESS.phoneHref },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: BUSINESS.phone, href: BUSINESS.phoneHref }}
				reserveNote="La ficha de Google indica acceso para sillas de ruedas y aparcamiento adaptado, pero no publica información sobre el mostrador o el aseo. Es un obrador: si vas a hacer un encargo, llama antes."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>entrar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar al obrador"
			navAriaLabel="Enlaces del obrador Florin & Gabriel"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
