---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import baguettes from '../assets/fotos/obrador-florin-gabriel-apaisada-05.jpg';
import bollos from '../assets/fotos/obrador-florin-gabriel-apaisada-06.jpg';
import tartaUnicornio from '../assets/fotos/obrador-florin-gabriel-vertical-01.jpg';
import pastelitos from '../assets/fotos/obrador-florin-gabriel-vertical-04.jpg';
import berlinas from '../assets/fotos/obrador-florin-gabriel-vertical-07.jpg';
import tartaFoto from '../assets/fotos/obrador-florin-gabriel-vertical-08.jpg';
import napolitanas from '../assets/fotos/obrador-florin-gabriel-vertical-09.jpg';

import {
	BUSINESS,
	FAQ,
	HIGHLIGHTS,
	HOURS,
	HOURS_NOTE,
	MAPS,
	MENU_GROUPS,
	SERVICIOS,
} from '../data/site';

const title = 'Obrador de Panadería y Pastelería Florin & Gabriel · Málaga';
const description =
	'OBRADOR de Panadería y Pastelería (Florin & Gabriel), en C. Carraca, 5, Loc 20 (Bailén-Miraflores, 29011 Málaga). Fabricación propia de pan, bollería y tartas para el público y la hostelería. Teléfono 667 32 81 16.';

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#florin-gabriel`,
	name: BUSINESS.name,
	alternateName: [
		'Florin & Gabriel',
		'Obrador Florin y Gabriel',
		'Obrador de Panadería y Pastelería Málaga',
	],
	description:
		'Obrador de panadería y pastelería con fabricación propia en C. Carraca, 5, local 20 (Bailén-Miraflores, 29011 Málaga). Venta al público y a la hostelería: pan, bollería y tartas personalizadas.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34667328116',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
			opens: '05:00',
			closes: '22:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El obrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
];

const galeria = [
	{
		src: tartaUnicornio,
		alt: 'Tarta de cumpleaños decorada con un unicornio, arcoíris y el nombre Chloe',
	},
	{
		src: bollos,
		alt: 'Bandeja de bollos glaseados recién hechos en el obrador',
	},
	{
		src: napolitanas,
		alt: 'Napolitanas de chocolate con hilos de chocolate por encima',
	},
	{
		src: berlinas,
		alt: 'Berlinas bañadas en chocolate con nata rosa por encima',
	},
	{
		src: pastelitos,
		alt: 'Bandeja de pastelitos cuadrados en filas, listos para el mostrador',
	},
	{
		src: tartaFoto,
		alt: 'Tarta rectangular con una foto comestible y decoración de nata',
	},
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"obrador-florin-gabriel-apaisada-05.jpg": baguettes,
	"obrador-florin-gabriel-vertical-01.jpg": tartaUnicornio,
	"obrador-florin-gabriel-apaisada-06.jpg": bollos,
	"obrador-florin-gabriel-vertical-09.jpg": napolitanas,
	"obrador-florin-gabriel-vertical-07.jpg": berlinas,
	"obrador-florin-gabriel-vertical-04.jpg": pastelitos,
	"obrador-florin-gabriel-vertical-08.jpg": tartaFoto,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#163237" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,300..700;1,300..600&family=Source+Sans+3:wght@300..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Obrador Florin y Gabriel, panadería Málaga, pastelería Bailén-Miraflores, pan al por mayor Málaga, tartas personalizadas, bollería hostelería, 29011"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Obrador con fabricación propia: pan, bollería y tartas personalizadas. Venta al público y a la hostelería en C. Carraca, 5, Málaga."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Bandeja de baguettes recién hechas en el obrador Florin & Gabriel"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#163237"
			phone="+34667328116"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[baguettes]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name={BUSINESS.shortName}
			subtitle="Obrador · Panadería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos, reseñas y fotos de la ficha pública de Google Maps, consultada en octubre de 2026. Horario y surtido pueden cambiar; confirma antes de ir."
			ctaLabel="Llamar al obrador"
			navAriaLabel="Enlaces del obrador Florin & Gabriel"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
