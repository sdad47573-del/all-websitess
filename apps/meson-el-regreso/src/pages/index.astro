---
import '../styles/global.css';

const business = {
	name: 'Mesón El Regreso',
	street: 'Plaza de San Juan de la Cruz, 1',
	building: 'Edificio Galaxia, local 7',
	district: 'Distrito Centro',
	city: 'Málaga',
	postalCode: '29007',
	phone: '+34 951 24 66 19',
	latitude: 36.7181532,
	longitude: -4.432477,
	site: 'https://meson-el-regreso.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Mes%C3%B3n+El+Regreso/@36.7181532,-4.432477,17z/data=!3m1!4b1!4m6!3m5!1s0xd72f73ce56222a9:0x78ee2b9ed9983df1!8m2!3d36.7181532!4d-4.432477!16s%2Fg%2F11lflfbnb2';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34951246619';
const instagramUrl = 'https://www.instagram.com/elregresorestaurante/';
const facebookUrl = 'https://www.facebook.com/ElRegresoRestaurante/';
const bookingUrl = 'https://www.thefork.es/restaurante/meson-el-regreso-r713090';

const photos = {
	hero: '/fotos/meson-el-regreso-malaga.jpg',
	foto1: '/fotos/meson-el-regreso-malaga-foto-1.jpg',
	foto2: '/fotos/meson-el-regreso-malaga-foto-2.jpg',
	foto3: '/fotos/meson-el-regreso-malaga-foto-3.jpg',
	foto4: '/fotos/meson-el-regreso-malaga-foto-4.jpg',
	foto5: '/fotos/meson-el-regreso-malaga-foto-5.jpg',
};

const specialties = [
	{
		kicker: 'Hechas en casa',
		title: 'Croquetas',
		text: 'De pollo, de gamba al pil pil y de jamón. Cremosas por dentro y crujientes por fuera, una de las cosas que más se repiten en las reseñas.',
	},
	{
		kicker: 'A la brasa',
		title: 'Carnes',
		text: 'Entrecot Black Angus, presa ibérica, solomillo de ternera y picana. El local se presenta como mesón español con carnes a la brasa.',
	},
	{
		kicker: 'Para compartir',
		title: 'Raciones y tapas',
		text: 'Huevos rotos, tartaleta de puerros y langostinos, ravioles con rabo de toro, alcachofas con bacon y dátiles o ensalada de cogollos con bonito.',
	},
	{
		kicker: 'Postres de la casa',
		title: 'Dulces caseros',
		text: 'Milhojas, tarta de trufa, tarta Kiev o rollo de merengue. Postres elaborados en el propio mesón.',
	},
	{
		kicker: 'Bocatas y tostas',
		title: 'Bocatas variados',
		text: 'Tosta de presa ibérica con cebolla caramelizada, tosta de salmón ahumado, mini hamburguesitas con jalapeños o hamburguesa de 200 g con bacon y cheddar.',
	},
	{
		kicker: 'Para empezar',
		title: 'Del Cantábrico y la huerta',
		text: 'Anchoas del Cantábrico con tomate y queso manchego, chistorra con patatas, ensaladas y platos de temporada.',
	},
];

const gallery = [
	{ src: photos.foto1, alt: 'Fotografía del Mesón El Regreso publicada en su ficha de Google Maps (Málaga)' },
	{ src: photos.foto2, alt: 'Fotografía del Mesón El Regreso, restaurante en la plaza de San Juan de la Cruz, Málaga' },
	{ src: photos.foto3, alt: 'Fotografía del Mesón El Regreso en el Distrito Centro de Málaga, desde Google Maps' },
	{ src: photos.foto4, alt: 'Imagen del Mesón El Regreso (Málaga) subida a su perfil de Google Maps' },
	{ src: photos.foto5, alt: 'Detalle del Mesón El Regreso en Málaga según las fotos de su ficha de Google Maps' },
];

const faqs = [
	{
		q: '¿Dónde está el Mesón El Regreso?',
		a: 'En la plaza de San Juan de la Cruz, 1 (Edificio Galaxia, local 7), en el Distrito Centro de Málaga, código postal 29007. Está a un paso del centro histórico y junto a los Jardines de Picasso.',
	},
	{
		q: '¿Cuál es el horario del Mesón El Regreso?',
		a: 'Abre de martes a sábado en dos turnos: de 12:15 a 16:30 y de 20:00 a 23:30. Los domingos y los lunes permanece cerrado. Conviene llamar antes de ir en festivos o puentes.',
	},
	{
		q: '¿Se puede reservar mesa?',
		a: 'Sí. Se puede reservar por teléfono en el 951 24 66 19 o a través de la ficha del restaurante en TheFork, que aparece enlazada en esta página.',
	},
	{
		q: '¿Qué se puede comer en el Mesón El Regreso?',
		a: 'Cocina española e internacional con más de 50 platos: tapas y raciones para compartir, croquetas caseras, carnes a la brasa como el entrecot Black Angus o la presa ibérica, platos de cuchara y postres hechos en casa. El precio medio orientativo ronda los 20-30 € por persona.',
	},
	{
		q: '¿Tiene terraza y es accesible?',
		a: 'Sí, cuenta con asientos al aire libre para el buen tiempo y está señalado como local accesible para sillas de ruedas. También dispone de WiFi y servicio para llevar.',
	},
];

const images = [
	`${business.site}${photos.hero}`,
	`${business.site}${photos.foto1}`,
	`${business.site}${photos.foto2}`,
	`${business.site}${photos.foto3}`,
	`${business.site}${photos.foto4}`,
];

const description =
	'Mesón tradicional en el Distrito Centro de Málaga: tapas, croquetas caseras, carnes a la brasa y postres de la casa. En la plaza de San Juan de la Cruz, 1 (Edificio Galaxia). Reserva en el 951 24 66 19.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 951 24 66 19',
	image: images,
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	paymentAccepted: 'Efectivo, tarjeta de crédito',
	servesCuisine: ['Cocina española', 'Carnes a la brasa', 'Mediterránea', 'Tapas'],
	areaServed: [{ '@type': 'City', name: business.city }],
	address: {
		'@type': 'PostalAddress',
		streetAddress: `${business.street} (${business.building})`,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [instagramUrl, facebookUrl],
	acceptsReservations: 'True',
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '12:15',
			closes: '16:30',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '20:00',
			closes: '23:30',
		},
	],
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Asientos al aire libre', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Accesible para sillas de ruedas', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'WiFi gratuito', value: true },
		{ '@type': 'LocationFeatureSpecification', name: 'Comida para llevar', value: true },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: 4.9,
		reviewCount: 1310,
		bestRating: 5,
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1b1714" />
		<meta
			name="description"
			content="Mesón El Regreso: tapas, croquetas caseras y carnes a la brasa en el centro de Málaga. Plaza San Juan de la Cruz, 1 (Edificio Galaxia). Reserva en el 951 24 66 19."
		/>
		<meta
			name="keywords"
			content="Mesón El Regreso Málaga, restaurante centro Málaga, carnes a la brasa Málaga, tapas Málaga centro, croquetas caseras Málaga, plaza San Juan de la Cruz, Edificio Galaxia, reservar mesa Málaga, churrasquería Málaga"
		/>
		<meta name="author" content="Mesón El Regreso" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Mesón El Regreso | Carnes a la brasa y tapas en Málaga</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Mesón El Regreso · Tapas y brasa en Málaga centro" />
		<meta
			property="og:description"
			content="Tapas, croquetas caseras y carnes a la brasa en la plaza de San Juan de la Cruz, 1 (Málaga). Martes a sábado, comidas y cenas."
		/>
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}${photos.hero}`} />
		<meta property="og:image:width" content="1600" />
		<meta property="og:image:height" content="1314" />
		<meta property="og:image:alt" content="Mesón El Regreso, restaurante en el centro de Málaga" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Mesón El Regreso · Tapas y brasa en Málaga centro" />
		<meta
			name="twitter:description"
			content="Tapas, croquetas caseras y carnes a la brasa en la plaza de San Juan de la Cruz, 1 (Málaga)."
		/>
		<meta name="twitter:image" content={`${business.site}${photos.hero}`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Mesón El Regreso, inicio">
				<span class="brand-mark" aria-hidden="true">R</span>
				<span class="brand-name">Mesón El Regreso <small>Málaga · Distrito Centro</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#meson">El mesón</a>
				<a href="#especialidades">Especialidades</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>951 24 66 19</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Distrito Centro · Málaga</p>
					<h1 id="hero-title">Carnes a la brasa<br />y cocina de siempre<br /><em>en Málaga.</em></h1>
					<p class="hero-lede">
						Mesón de barrio en la plaza de San Juan de la Cruz: tapas para compartir, croquetas caseras,
						brasa y postres hechos en la casa. Con terraza, servicio para llevar y reserva de mesa.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={bookingUrl} target="_blank" rel="noreferrer">
							Reservar mesa <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-ghost" href={phoneHref}>Llamar 951 24 66 19</a>
					</div>
					<ul class="hero-facts">
						<li><b>4,9</b> en Google (1.310 reseñas)</li>
						<li>Más de 50 platos</li>
						<li>Brasa y tapas</li>
						<li>Terraza</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img
						src={photos.hero}
						width="1600"
						height="1314"
						alt="Fotografía del Mesón El Regreso publicada en su ficha de Google Maps (Málaga centro)"
						fetchpriority="high"
						decoding="async"
					/>
					<figcaption>
						<span>Foto de la ficha de Google Maps</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver todas ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Valoraciones y servicios">
				<div class="ratings">
					<div><b>4,9</b><span>Google</span></div>
					<div><b>8,4</b><span>TheFork</span></div>
					<div><b>4,6</b><span>Tripadvisor</span></div>
				</div>
				<ul class="services">
					<li>Terraza</li>
					<li>Local accesible</li>
					<li>WiFi</li>
					<li>Para llevar</li>
					<li>Reservas</li>
					<li>Aparcamiento</li>
				</ul>
			</section>

			<section class="about section-pad" id="meson">
				<p class="section-label"><span aria-hidden="true"></span> Un mesón en el centro de Málaga</p>
				<div class="about-grid">
					<h2>Más de 50 platos<br />y brasa a la vista<br /><em>de lunes a sábado.</em></h2>
					<div class="about-copy">
						<p>
							El Mesón El Regreso está en la plaza de San Juan de la Cruz, 1, dentro del Edificio Galaxia
							(local 7), en el Distrito Centro de Málaga. Un mesón tradicional para comer o cenar sin moverte
							del centro, junto a los Jardines de Picasso.
						</p>
						<p>
							Su cocina mezcla lo de siempre con toques internacionales: tapas y raciones para compartir,
							croquetas elaboradas en casa, carnes a la brasa como el entrecot Black Angus o la presa ibérica,
							y postres caseros para terminar.
						</p>
						<p class="about-note">
							Sobre el horario y la disponibilidad: la ficha de Google Maps, confirmada por el propio
							establecimiento, marca los turnos de mediodía y noche de martes a sábado. Si vienes en festivo,
							llama antes para asegurar la mesa.
						</p>
						<div class="about-links">
							<a class="simple-link" href={instagramUrl} target="_blank" rel="noreferrer">
								Instagram del restaurante <span aria-hidden="true">↗</span>
							</a>
							<a class="simple-link" href={facebookUrl} target="_blank" rel="noreferrer">
								Facebook <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="especialidades">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su carta</p>
						<h2>Lo que más<br />se pide <em>en la mesa.</em></h2>
					</div>
					<p>
						Platos citados en la carta publicada por el propio restaurante y en las reseñas de sus clientes:
						tapas, brasa, bocatas y postres. La carta cambia, así que confirma disponibilidad y precios al
						reservar. El precio medio orientativo ronda los 20-30 € por persona.
					</p>
				</div>
				<div class="cards">
					{
						specialties.map((item) => (
							<article class="card">
								<span class="card-kicker">{item.kicker}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Fotos de Google Maps</p>
						<h2>El mesón<br /><em>por dentro.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas fotografías proceden de la ficha de Google Maps del Mesón El Regreso. En la ficha
							encontrarás la galería completa, con aportaciones de clientes, y las reseñas actualizadas.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">
							Ver la galería en Google Maps <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
				<div class="gallery-grid">
					{
						gallery.map((photo, index) => (
							<figure class:list={['shot', index === 0 && 'shot-wide']}>
								<img
									src={photo.src}
									alt={photo.alt}
									loading="lazy"
									decoding="async"
									width="1200"
									height="1600"
								/>
							</figure>
						))
					}
				</div>
				<p class="gallery-note">
					Fotografías alojadas en esta web procedentes de la ficha del restaurante en Google Maps. Si eres
					el titular y quieres retirar alguna, escríbenos.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Plaza San Juan de la Cruz, 1</p>
					<h2>Ven a comer<br /><em>al centro.</em></h2>
					<p class="address">
						{business.street}<br />
						{business.building}<br />
						{business.postalCode} {business.city}, España
					</p>

					<table class="hours">
						<caption>Horario</caption>
						<tbody>
							<tr>
								<th scope="row">Martes a sábado</th>
								<td>12:15 – 16:30 · 20:00 – 23:30</td>
							</tr>
							<tr>
								<th scope="row">Domingo y lunes</th>
								<td>Cerrado</td>
							</tr>
						</tbody>
					</table>
					<p class="hours-note">
						Horario confirmado por el establecimiento en Google Maps. En festivos o puentes, llama antes de
						venir.
					</p>

					<div class="visit-links">
						<a class="button button-ember" href={bookingUrl} target="_blank" rel="noreferrer">
							Reservar en TheFork <span aria-hidden="true">↗</span>
						</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">
							Cómo llegar <span aria-hidden="true">↗</span>
						</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 951 24 66 19</a>
				</div>

				<div class="map-frame">
					<iframe
						title="Mapa del Mesón El Regreso en la plaza de San Juan de la Cruz, 1, Málaga"
						src={mapEmbedUrl}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen></iframe>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer">
						<span aria-hidden="true">⌖</span> Mesón El Regreso · Málaga
					</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.q}</summary>
								<p>{faq.a}</p>
							</details>
						))
					}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">R</span>
				<p>Mesón El Regreso<small>{business.street} · {business.postalCode} {business.city}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>
				© {new Date().getFullYear()} Mesón El Regreso · Málaga. Fotografías procedentes de la ficha del
				restaurante en Google Maps.
			</small>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al mesón <span>951 24 66 19</span></a>
	</body>
</html>
