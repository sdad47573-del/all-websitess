---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import panes from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-05.jpg';
import mostrador from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-01.jpg';
import empanadas from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-02.jpg';
import tartaOreo from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-03.jpg';
import tartaFresas from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-04.jpg';
import tartaCumple from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-06.jpg';
import obrador from '../assets/fotos/panaderia-santa-ana-colombiana-vertical-07.jpg';
import horno from '../assets/fotos/panaderia-santa-ana-colombiana-vertical-08.jpg';
import tartaFruta from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-09.jpg';
import vitrina from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, REVIEWS, SERVICIOS } from '../data/site';

const title = 'Panadería Santa Ana Colombiana · Bailén-Miraflores, Málaga';
const description =
	'Panadería Santa Ana Colombiana, en C. Ibrahin, 1 (Bailén-Miraflores, 29010 Málaga). Pan del día, empanadas, tortas y pasabocas por encargo. Teléfono 952 39 24 93.';

const galeria = [
	{
		src: panes,
		alt: 'Cuatro hogazas de pan artesano de corteza dorada sobre una bandeja del obrador',
	},
	{
		src: mostrador,
		alt: 'Mostrador de la panadería con panes, tortas y dulces en vitrinas, y bebidas en la nevera',
	},
	{
		src: empanadas,
		alt: 'Empanadas colombianas de masa de maíz fritas en una bandeja metálica',
	},
	{
		src: tartaOreo,
		alt: 'Tarta de chocolate cubierta con galletas Oreo y virutas en el borde',
	},
	{
		src: tartaFresas,
		alt: 'Tarta de chocolate con fresas, nata y caramelos de colores',
	},
	{
		src: tartaCumple,
		alt: 'Tarta rosa de cumpleaños con fresas y el mensaje «Feliz Cumpleaños»',
	},
	{
		src: obrador,
		alt: 'Interior del obrador con el cartel de Panificadora Santa Ana, vitrinas de pan y el expositor de helados La Quindianita',
	},
	{
		src: horno,
		alt: 'Bandeja de panes redondos recién horneados y espolvoreados con harina dentro del horno',
	},
	{
		src: tartaFruta,
		alt: 'Tarta de fruta con melocotón, uva y fresa sobre crema, con borde de nata',
	},
	{
		src: vitrina,
		alt: 'Vitrina con hogazas de pan y panes envasados del obrador',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#santa-ana`,
	name: BUSINESS.name,
	alternateName: ['Santa Ana Colombiana', 'Panificadora Santa Ana', 'Panadería Santa Ana Málaga'],
	description:
		'Panadería colombiana y repostería en C. Ibrahin, 1 (Bailén-Miraflores, 29010 Málaga). Pan del día, empanadas, tartas y pasabocas por encargo.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 952 39 24 93',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '08:00',
			closes: '03:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const facts = [
	{ label: 'Nota', value: '4,5 / 5 · 27 reseñas' },
	{ label: 'Martes a sábado', value: '8:00–22:00' },
	{ label: 'Domingo', value: '8:00–3:00' },
	{ label: 'Lunes', value: 'Cerrado' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#15355f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Santa Ana Colombiana, panadería colombiana Málaga, repostería Bailén-Miraflores, tortas por encargo Málaga, empanadas colombianas Málaga, panadería C. Ibrahin, panadería 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería colombiana y repostería gourmet en Bailén-Miraflores: pan del día, empanadas, tartas y pasabocas por encargo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Hogazas de pan recién horneadas en la Panadería Santa Ana Colombiana"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#15355f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[panes]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Santa Ana"
			subtitle="Panadería · Repostería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalHero
				eyebrow="C. Ibrahin, 1 · Bailén-Miraflores, Málaga"
				title="Pan del horno, <br /><em>tortas para celebrar.</em>"
				lede={`Panadería colombiana y repostería gourmet en Bailén-Miraflores. Pan del día, empanadas, tartas y pasabocas por encargo. Abre de martes a domingo y cierra los lunes. Tiene ${BUSINESS.rating.toString().replace('.', ',')} sobre 5 en Google con ${BUSINESS.reviewsCount} reseñas.`}
				image={panes}
				imageAlt="Cuatro hogazas de pan artesano de corteza dorada sobre una bandeja del obrador"
				primaryCta={{ label: `Llamar ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>4,5</b> en Google · 27 reseñas' },
					{ label: 'Horario', html: '<b>Martes a domingo</b> · lunes cerrado' },
					{ label: 'Encargos', html: '<b>Tartas y pasabocas</b> para eventos' },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
				tag="Repostería gourmet"
			/>

			<section class="factbar" aria-label="Datos publicados en la ficha de Google">
				<ul class="wrap">
					{
						facts.map((fact) => (
							<li>
								<span>{fact.label}</span>
								<strong>{fact.value}</strong>
							</li>
						))
					}
				</ul>
			</section>

			<LocalChips label="Lo que ofrece la Panadería Santa Ana Colombiana" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Panadería colombiana <br /><em>y repostería.</em>"
				paragraphs={[
					'La Panadería Santa Ana Colombiana está en la calle Ibrahin, 1, en Bailén-Miraflores. En el obrador, el cartel de la casa se presenta como Panificadora Santa Ana · Phanor Herrera y anuncia panadería y repostería gourmet.',
					'En el mostrador se ven hogazas de pan, empanadas de masa de maíz, tartas de chocolate y de fruta, tartas de cumpleaños, helados de fruta La Quindianita y productos envasados. Las fotos del perfil de Google recogen el obrador, el horno y las vitrinas.',
					'El cartel anuncia tortas y pasabocas para eventos especiales. La ficha de Google no publica catálogo, precios ni plazos: los encargos se consultan en el teléfono que aparece en ese mismo cartel, el 665 72 07 62.',
					'Esta página no publica carta ni importes porque el establecimiento no los tiene publicados en Google. La dirección, el horario y la valoración son los de la ficha; los productos citados son los que se ven en las fotos y en el cartel del obrador.',
				]}
				note="4,5 sobre 5 con 27 reseñas en Google. Una de ellas: «Pan de calidad 100x100»."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="El mostrador"
				title="Del horno <br /><em>a la mesa.</em>"
				description="La ficha de Google no publica carta ni precios. Esta lista reúne lo que aparece en las fotografías del perfil y lo que anuncia el cartel del obrador."
				cta={{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref }}
				groups={MENU}
				note="Sin precios publicados: para encargar una tarta o consultar el surtido del día, llama al 952 39 24 93 o al 665 72 07 62, el teléfono que el cartel del obrador anuncia para encargos."
			/>

			<LocalGallery
				eyebrow="Fotos del perfil de Google Maps"
				title="Diez fotos <br /><em>del obrador.</em>"
				description="Las fotografías del perfil de Santa Ana en Google Maps: el pan recién horneado, el mostrador, las empanadas, las tartas y el expositor de helados."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y procedentes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="De martes <br /><em>a domingo.</em>"
				addressLines={[BUSINESS.street, BUSINESS.district, `${BUSINESS.postalCode} ${BUSINESS.city}`]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: martes a sábado de 8:00 a 22:00; domingo de 8:00 a 3:00; lunes cerrado. Para el domingo 1 de noviembre, Día de Todos los Santos, la ficha avisa de que el horario podría ser diferente."
				mapTitle="Mapa de la Panadería Santa Ana Colombiana en la calle Ibrahin, 1, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Santa Ana · Bailén-Miraflores"
				mapHref={MAPS.place}
				links={[
					{ label: `Llamar · ${BUSINESS.phone}`, href: BUSINESS.phoneHref, variant: 'primary' },
					{ label: 'Cómo llegar', href: MAPS.directions, external: true },
					{ label: 'Ficha en Google Maps', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Encargos · ${BUSINESS.orderPhone}`, href: BUSINESS.orderPhoneHref }}
				reserveNote="La ficha no publica web ni pedidos online. El teléfono de la ficha es el 952 39 24 93; el cartel del obrador anuncia el 665 72 07 62 para encargos de tartas y pasabocas."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>pasar.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografías de la ficha pública de Google Maps. Sin carta ni precios publicados por el establecimiento."
			ctaLabel="Llamar a Santa Ana"
			navAriaLabel="Enlaces de la Panadería Santa Ana Colombiana"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
