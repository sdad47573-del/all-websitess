---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import panes from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-05.jpg';
import mostrador from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-01.jpg';
import empanadas from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-02.jpg';
import tartaOreo from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-03.jpg';
import tartaFresas from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-04.jpg';
import tartaCumple from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-06.jpg';
import obrador from '../assets/fotos/panaderia-santa-ana-colombiana-vertical-07.jpg';
import horno from '../assets/fotos/panaderia-santa-ana-colombiana-vertical-08.jpg';
import tartaFruta from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-09.jpg';
import vitrina from '../assets/fotos/panaderia-santa-ana-colombiana-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const title = 'Panadería Santa Ana Colombiana · Bailén-Miraflores, Málaga';
const description =
	'Panadería Santa Ana Colombiana, en C. Ibrahin, 1 (Bailén-Miraflores, 29010 Málaga). Pan del día, empanadas, tortas y pasabocas por encargo. Teléfono 952 39 24 93.';

const galeria = [
	{
		src: panes,
		alt: 'Cuatro hogazas de pan artesano de corteza dorada sobre una bandeja del obrador',
	},
	{
		src: mostrador,
		alt: 'Mostrador de la panadería con panes, tortas y dulces en vitrinas, y bebidas en la nevera',
	},
	{
		src: empanadas,
		alt: 'Empanadas colombianas de masa de maíz fritas en una bandeja metálica',
	},
	{
		src: tartaOreo,
		alt: 'Tarta de chocolate cubierta con galletas Oreo y virutas en el borde',
	},
	{
		src: tartaFresas,
		alt: 'Tarta de chocolate con fresas, nata y caramelos de colores',
	},
	{
		src: tartaCumple,
		alt: 'Tarta rosa de cumpleaños con fresas y el mensaje «Feliz Cumpleaños»',
	},
	{
		src: obrador,
		alt: 'Interior del obrador con el cartel de Panificadora Santa Ana, vitrinas de pan y el expositor de helados La Quindianita',
	},
	{
		src: horno,
		alt: 'Bandeja de panes redondos recién horneados y espolvoreados con harina dentro del horno',
	},
	{
		src: tartaFruta,
		alt: 'Tarta de fruta con melocotón, uva y fresa sobre crema, con borde de nata',
	},
	{
		src: vitrina,
		alt: 'Vitrina con hogazas de pan y panes envasados del obrador',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Bakery',
	'@id': `${BUSINESS.siteUrl}/#santa-ana`,
	name: BUSINESS.name,
	alternateName: ['Santa Ana Colombiana', 'Panificadora Santa Ana', 'Panadería Santa Ana Málaga'],
	description:
		'Panadería colombiana y repostería en C. Ibrahin, 1 (Bailén-Miraflores, 29010 Málaga). Pan del día, empanadas, tartas y pasabocas por encargo.',
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: '+34 952 39 24 93',
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Provincia de Málaga' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
			opens: '08:00',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Sunday'],
			opens: '08:00',
			closes: '03:00',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aparcamiento adaptado para sillas de ruedas',
			value: false,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'El mostrador', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const facts = [
	{ label: 'Nota', value: '4,5 / 5 · 27 reseñas' },
	{ label: 'Martes a sábado', value: '8:00–22:00' },
	{ label: 'Domingo', value: '8:00–3:00' },
	{ label: 'Lunes', value: 'Cerrado' },
];

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"panaderia-santa-ana-colombiana-apaisada-05.jpg": panes,
	"panaderia-santa-ana-colombiana-apaisada-01.jpg": mostrador,
	"panaderia-santa-ana-colombiana-apaisada-02.jpg": empanadas,
	"panaderia-santa-ana-colombiana-apaisada-03.jpg": tartaOreo,
	"panaderia-santa-ana-colombiana-apaisada-04.jpg": tartaFresas,
	"panaderia-santa-ana-colombiana-apaisada-06.jpg": tartaCumple,
	"panaderia-santa-ana-colombiana-vertical-07.jpg": obrador,
	"panaderia-santa-ana-colombiana-vertical-08.jpg": horno,
	"panaderia-santa-ana-colombiana-apaisada-09.jpg": tartaFruta,
	"panaderia-santa-ana-colombiana-apaisada-10.jpg": vitrina,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#15355f" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Panadería Santa Ana Colombiana, panadería colombiana Málaga, repostería Bailén-Miraflores, tortas por encargo Málaga, empanadas colombianas Málaga, panadería C. Ibrahin, panadería 29010"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Panadería colombiana y repostería gourmet en Bailén-Miraflores: pan del día, empanadas, tartas y pasabocas por encargo."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Hogazas de pan recién horneadas en la Panadería Santa Ana Colombiana"
			ogImageWidth={1200}
			ogImageHeight={630}
			ogType="business.business"
			author={BUSINESS.name}
			themeColor="#15355f"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Málaga"
			locale="es_ES"
			countryName="España"
			preload={[panes]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Santa Ana"
			subtitle="Panadería · Repostería"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
				horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Cómo llegar ↗', href: MAPS.directions, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Datos y fotografías de la ficha pública de Google Maps. Sin carta ni precios publicados por el establecimiento."
			ctaLabel="Llamar a Santa Ana"
			navAriaLabel="Enlaces de la Panadería Santa Ana Colombiana"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Web creada por"
			creditName="Sur Digital"
			creditHref="https://sur-digital.vercel.app/"
		/>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
	/* Con otro botón flotante en la esquina (el de "cómo llegar"), el bloque se apila encima.
	   Ese botón se oculta a partir de lg, así que en escritorio no hace falta desplazar. */
	.contact-fabs.is-stacked { bottom: 5.75rem; }
	@media (max-width: 680px) { .contact-fabs.is-stacked { bottom: 6.25rem; } }
	@media (min-width: 1024px) { .contact-fabs.is-stacked { bottom: clamp(1rem, 4vw, 1.75rem); } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34952392493?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20M%C3%A1laga." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Málaga"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
