---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
} from '@astro-components';

import exterior from '../assets/fotos/especialidad-en-comidas-caseras-apaisada-01.jpg';
import fritura from '../assets/fotos/especialidad-en-comidas-caseras-apaisada-02.jpg';
import albondigas from '../assets/fotos/especialidad-en-comidas-caseras-apaisada-03.jpg';
import carnes from '../assets/fotos/especialidad-en-comidas-caseras-panoramica-04.jpg';
import mollete from '../assets/fotos/especialidad-en-comidas-caseras-vertical-05.jpg';
import mejillones from '../assets/fotos/especialidad-en-comidas-caseras-vertical-06.jpg';
import paella from '../assets/fotos/especialidad-en-comidas-caseras-vertical-08.jpg';
import mostrador from '../assets/fotos/especialidad-en-comidas-caseras-panoramica-09.jpg';
import interior from '../assets/fotos/especialidad-en-comidas-caseras-apaisada-10.jpg';

import { BUSINESS, FAQ, HOURS, MAPS, MENU, SERVICIOS } from '../data/site';

const title = 'Especialidad en Comidas Caseras · Cocina casera y tapeo en Málaga';
const description = BUSINESS.description;

const galeria = [
	{
		src: exterior,
		alt: 'Esquina del bar en la avenida de la Paloma 46, con el toldo verde, la terraza de veladores y el barrio al fondo',
	},
	{
		src: albondigas,
		alt: 'Albóndigas en salsa de tomate en un plato blanco, con pan y una caña de cerveza al lado',
	},
	{
		src: mollete,
		alt: 'Mollete abierto con carne mechada, junto a una ensaladilla rusa y un café con leche',
	},
	{
		src: mejillones,
		alt: 'Mejillones al vapor abiertos en corona sobre un plato blanco, con medio limón en el centro',
	},
	{
		src: carnes,
		alt: 'Bandejas del mostrador con carne guisada con cebolla y pimientos rojos con ajos',
	},
	{
		src: paella,
		alt: 'Paella amarilla en la paellera, con tiras de pimiento rojo por encima',
	},
	{
		src: mostrador,
		alt: 'Bandejas de albóndigas en salsa y salchichas en el mostrador caliente del bar',
	},
	{
		src: interior,
		alt: 'Interior del bar con la barra de mármol, las mesas de madera y el techo de vigas',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#comidas-caseras`,
	name: BUSINESS.fullName,
	alternateName: [
		'Especialidaden En Comidas Caseras',
		'Comidas Caseras Málaga',
		'Bar de comidas caseras Carretera de Cádiz',
	],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: BUSINESS.phone,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Casera', 'Andaluza', 'Tapeo', 'Pescado frito'],
	areaServed: [
		{ '@type': 'City', name: 'Málaga' },
		{ '@type': 'AdministrativeArea', name: 'Carretera de Cádiz' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.cid },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '08:00', closes: '23:59' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '08:00', closes: '23:59' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Wednesday', opens: '08:00', closes: '23:59' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Thursday', opens: '08:00', closes: '23:59' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '08:00', closes: '23:59' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '23:59' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '08:00', closes: '23:59' },
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	amenityFeature: [
		{ '@type': 'LocationFeatureSpecification', name: 'Aparcamiento adaptado', value: false },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La carta', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visita', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#1b1512" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,600&family=Work+Sans:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.fullName}
			description={description}
			keywords="Especialidad en Comidas Caseras, comida casera Málaga, bar de tapas Carretera de Cádiz, Av. de la Paloma 46, fritura de pescado Málaga, albóndigas Málaga, mollete Málaga, menú del día Málaga"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Comida casera y tapeo en la avenida de la Paloma 46, Carretera de Cádiz. Fritura de pescado, guisos, albóndigas y molletes. Abre todos los días de 8:00 a 24:00."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Plato de fritura de pescado con calamares, boquerones y limón en Especialidad en Comidas Caseras"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.fullName}
			themeColor="#1b1512"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-AN"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phoneHref}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Carretera de Cádiz, Málaga"
			preload={[fritura]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#conteudo">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Comidas Caseras"
			subtitle="Bar de tapas · Carretera de Cádiz"
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			nav={nav}
			homeLabel="inicio"
			navAriaLabel="Navegación principal"
		/>

		<main id="conteudo">
			<LocalHero
				eyebrow={`${BUSINESS.street} · ${BUSINESS.neighbourhood}`}
				title="Comida casera <br /><em>de barrio.</em>"
				lede={`En la avenida de la Paloma 46, un bar de los de siempre: fritura de pescado recién hecha, guisos de cuchara, albóndigas en salsa, molletes y tapas. Abre todos los días de 8:00 a 24:00 y la ficha de Google le da 3,9 sobre 5 con 69 reseñas.`}
				image={fritura}
				imageAlt="Fuente de fritura de pescado con boquerones, calamares y pescado enharinado, con medio limón"
				primaryCta={{ label: 'Cómo llegar', href: MAPS.directions }}
				secondaryCta={{ label: 'Ficha y reseñas en Google', href: MAPS.place, external: true }}
				facts={[
					{ label: 'Nota', html: '<b>3,9</b> en Google · 69 reseñas' },
					{ label: 'Horario', html: '<b>8:00–24:00</b><br />Todos los días' },
					{ label: 'Teléfono', html: `<b>${BUSINESS.phone}</b> mesa y encargos` },
				]}
				galleryHref={MAPS.place}
				photoCredit="Foto del perfil de Google Maps"
				galleryLinkLabel="Ver la galería"
			/>

			<LocalChips label="Señas de Especialidad en Comidas Caseras" items={SERVICIOS} />

			<LocalAbout
				label="La casa"
				title="Guisos, fritura <br /><em>y barra.</em>"
				paragraphs={[
					'El bar está en el número 46 de la avenida de la Paloma, en Carretera de Cádiz, con la terraza en la acera y el mostrador de los guisos al fondo. Google lo clasifica como restaurante y le da 3,9 sobre 5 con 69 reseñas.',
					'Aquí se viene a comer casero: la fritura de pescado recién hecha, las albóndigas en salsa, la carne guisada con cebolla y pimientos, el mollete con carne mechada, los mejillones al vapor o la paella que sale de la paellera. Platos de cuchara y de mostrador, sin más ceremonia que el pan y un café.',
					'La cocina lleva el nombre de Ana. Una de las reseñas de Google la llama «imprescindible, una artista de la cocina», y otra resume la casa en «comida casera, buen ambiente y servicio». Para el tapeo, la recomendación de otra reseña es clara: es «un buen sitio para ir abriendo boca».',
					'Abre todos los días de 8:00 a 24:00, así que vale igual para el desayuno, para la comida del mediodía, para la merienda o para una cerveza al final del día. La ficha avisa de que en festivos el horario puede cambiar.',
				]}
				note="La información sale de la ficha pública de Google Maps y de las fotografías del perfil del establecimiento. No hay web oficial ni carta con precios publicada: si algo cambia, manda lo que digan en el local o por teléfono."
				links={[
					{ label: 'Ficha y reseñas en Google', href: MAPS.reviews, external: true },
					{ label: 'Ver la casa en Google Maps', href: MAPS.place, external: true },
				]}
			/>

			<LocalMenu
				eyebrow="La carta"
				title="Fritura, guisos <br /><em>y molletes.</em>"
				description="La ficha no publica carta ni precios. Estos son los platos que se ven en las fotografías del perfil y los que repiten las reseñas de la casa."
				cta={{ label: 'Ver las fotos en Google Maps', href: MAPS.place }}
				groups={MENU}
				note="No hay carta oficial publicada ni precios del local, así que esta lista es orientativa: sirve para reconocer lo que se cocina aquí, no para cerrar una cuenta. Para saber el menú del día, llama al bar."
			/>

			<LocalGallery
				eyebrow="Fotos de Google Maps"
				title="Ocho fotos <br /><em>de la casa.</em>"
				description="Las fotografías del perfil de Especialidad en Comidas Caseras en Google Maps: la esquina del bar, la fritura, los guisos del mostrador y el interior."
				images={galeria}
				cta={{ label: 'Ver todo en Google Maps', href: MAPS.place }}
				note="Imágenes alojadas en esta página y provenientes del perfil del establecimiento en Google Maps. Si tienes los derechos de alguna y quieres retirarla, dínoslo y la borramos."
			/>

			<LocalVisit
				eyebrow={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
				title="Ven a la <br /><em>Paloma, 46.</em>"
				addressLines={[
					BUSINESS.street,
					`${BUSINESS.neighbourhood} · ${BUSINESS.postalCode} ${BUSINESS.city}`,
					'Málaga, España',
				]}
				hours={HOURS}
				hoursCaption="Horario"
				hoursNote="Horario publicado en la ficha de Google: todos los días de 8:00 a 24:00. En festivos puede cambiar; el día de Todos los Santos, por ejemplo, la ficha avisa de que el horario podría ser distinto."
				mapTitle="Mapa de Especialidad en Comidas Caseras en la avenida de la Paloma 46, Málaga"
				mapEmbedUrl={MAPS.embed}
				mapLabel="Paloma, 46 · Málaga"
				mapHref={MAPS.cid}
				links={[
					{ label: 'Cómo llegar', href: MAPS.directions, external: true, variant: 'primary' },
					{ label: 'Ficha de Google', href: MAPS.place, external: true },
				]}
				contactLink={{ label: `Llamar: ${BUSINESS.phone}`, href: `tel:${BUSINESS.phoneHref}` }}
				reserveNote="No hay reservas ni pedidos en línea en esta página. La ficha no publica un sistema de reservas ni una web propia, así que el teléfono es el canal directo para mesa, para encargar comida o para preguntar por el menú del día."
			/>

			<LocalFaq items={FAQ} eyebrow="Preguntas frecuentes" title="Antes de <em>venir.</em>" />
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.fullName}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={`tel:${BUSINESS.phoneHref}`}
			legal="Fotografías provenientes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario y carta antes de la visita."
			ctaLabel="Llamar"
			navAriaLabel="Enlaces de Especialidad en Comidas Caseras"
			legalLinks={[
				{ label: 'Aviso legal', href: '/aviso-legal' },
				{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
				{ label: 'Cookies', href: '/aviso-legal#cookies' },
			]}
			creditLabel="Creado por"
			creditName="Sur Digital · sur-digital.vercel.app"
			creditHref="https://sur-digital.vercel.app/"
		/>
	</body>
</html>
