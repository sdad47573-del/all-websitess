---
import { Image } from '@astro-components';
import { BUSINESS, IMAGES } from '../data/site';

const estrellas = [1, 2, 3, 4, 5];
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<section id="inicio" class="hero-gato relative overflow-hidden text-white">
	<div class="absolute inset-0">
		<Image
			src={IMAGES.fotoPortada}
			alt="Restaurante El Gato en Chipiona"
			widths={[640, 1100, 1600]}
			sizes="100vw"
			quality={74}
			loading="eager"
			fetchpriority="high"
			class="h-full w-full object-cover opacity-20"
		/>
		<div class="from-neutral/95 via-neutral/60 absolute inset-0 bg-gradient-to-r"></div>
	</div>

	<div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-28">
		<div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
			<div>
				<p class="text-accent inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.22em] uppercase">
					<span><i class="ri-map-pin-line"></i> Chipiona</span>
					<span class="text-white/50">Cádiz</span>
					<span class="text-white/50">·</span>
					<span class="text-white/50">Desde hace más de 50 años</span>
				</p>

				<h1 class="font-display mt-4 text-5xl leading-[1.02] font-bold sm:text-6xl lg:text-7xl" set:html={piezas.portada.titulo} />

				<p class="mt-5 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg">
					Desayunos de cachito, guisos de la zona, pescados y vino de barril. Un clásico de
					Chipiona que también guarda un museo fotográfico entre sus mesas.
				</p>

				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="badge badge-lg gap-2 border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold text-white"
					>
						<span class="text-accent tracking-tight" aria-hidden="true">
							{
								estrellas.map((n) => (
									<i class={n <= Math.round(BUSINESS.rating) ? 'ri-star-fill' : 'ri-star-line'} />
								))
							}
						</span>
						{BUSINESS.rating.toString().replace('.', ',')} · {BUSINESS.reviewCount} reseñas en Google
					</a>
				</div>

				<div class="mt-8 flex flex-wrap gap-3">
					<a href={BUSINESS.phoneHref} class="btn btn-accent btn-lg gap-2 rounded-full">
						<i class="ri-phone-line text-xl"></i>
						{BUSINESS.phone}
					</a>
					<a
						href={BUSINESS.googleMaps}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-lg gap-2 rounded-full border-white/35 bg-transparent text-white hover:border-white hover:bg-white hover:text-neutral"
					>
						<i class="ri-google-fill"></i>
						Ver ficha de Google
					</a>
				</div>

				<dl class="mt-10 grid gap-x-6 gap-y-5 border-t border-white/15 pt-7 sm:grid-cols-3">
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Mediodía</dt>
						<dd class="mt-1 text-base font-bold">9:00 – 17:00</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Noche</dt>
						<dd class="mt-1 text-base font-bold">20:30 – 24:00</dd>
					</div>
					<div>
						<dt class="text-[0.65rem] tracking-[0.18em] text-white/50 uppercase">Dónde</dt>
						<dd class="mt-1 text-base font-bold">C. Pez Espada, 9</dd>
						<dd class="text-xs text-white/55">11550 Chipiona</dd>
					</div>
				</dl>
			</div>

			<figure class="relative mx-auto w-full max-w-md lg:max-w-none">
				<div class="border-accent/40 absolute -inset-2 rotate-2 rounded-lg border"></div>
				<div class="relative grid grid-cols-5 gap-3">
					<div class="col-span-3 overflow-hidden rounded-lg shadow-2xl">
						<Image
							src={IMAGES.fotoInterior}
							alt="Interior de Restaurante El Gato"
							widths={[360, 620]}
							sizes="(min-width: 1024px) 22vw, 55vw"
							quality={85}
							loading="eager"
							class="foto-calida aspect-[3/4] w-full object-cover"
						/>
					</div>
					<div class="col-span-2 flex flex-col gap-3">
						<div class="overflow-hidden rounded-lg shadow-xl">
							<Image
								src={IMAGES.fotoApaisada}
								alt="Ambiente en Restaurante El Gato"
								widths={[260, 440]}
								sizes="(min-width: 1024px) 15vw, 38vw"
								quality={85}
								loading="lazy"
								class="foto-calida aspect-square w-full object-cover"
							/>
						</div>
						<div class="sello-gato bg-primary/85 flex flex-1 flex-col justify-center rounded-full px-3 py-6 text-center">
							<span class="text-accent font-display text-2xl leading-none font-bold">+50</span>
							<span class="mt-2 text-[0.6rem] leading-tight tracking-[0.14em] text-white/65 uppercase">
								años en Chipiona
							</span>
						</div>
					</div>
				</div>
				<figcaption class="text-accent-content bg-accent mt-5 inline-block rounded-full px-4 py-2 text-xs font-bold shadow-lg">
					Museo fotográfico único en Chipiona
				</figcaption>
			</figure>
		</div>
	</div>

	<div class="cenefa-gato relative h-1.5 w-full"></div>
</section>
