---
import '../styles/global.css';
import {
	LocalAbout,
	LocalChips,
	LocalFaq,
	LocalFooter,
	LocalGallery,
	LocalHero,
	LocalMenu,
	LocalSeo,
	LocalTopbar,
	LocalVisit,
	LocalSecciones,
} from '@astro-components';

import carne from '../assets/fotos/tolaita-apaisada-01.jpg';
import pollo from '../assets/fotos/tolaita-vertical-02.jpg';
import cafe from '../assets/fotos/tolaita-vertical-03.jpg';
import vistas from '../assets/fotos/tolaita-apaisada-04.jpg';
import pista from '../assets/fotos/tolaita-apaisada-05.jpg';
import bacalao from '../assets/fotos/tolaita-vertical-06.jpg';
import combinado from '../assets/fotos/tolaita-apaisada-07.jpg';
import porche from '../assets/fotos/tolaita-apaisada-08.jpg';
import bacalaoDetalle from '../assets/fotos/tolaita-vertical-09.jpg';
import fachada from '../assets/fotos/tolaita-apaisada-10.jpg';

import {
	BUSINESS,
	FAQ,
	HOURS,
	MAPS,
	MENU,
	REVIEWS,
	SERVICIOS,
} from '../data/site';

const description =
	'Tolaita, bar restaurante en Rafael Pikabea Hiribidea, 11, Elizalde (Gipuzkoa). Platos combinados, risotto y terraza, con 4,6 sobre 5 en Google. Teléfono 943 01 47 02.';

const galeria = [
	{
		src: carne,
		alt: 'Carne guisada desmenuzada sobre una cama de lechuga y tomate en un plato blanco',
	},
	{
		src: pollo,
		alt: 'Pollo asado con patatas fritas y ensalada en un plato combinado de Tolaita',
	},
	{
		src: cafe,
		alt: 'Café con leche en vaso sobre la mesa de la terraza de Tolaita',
	},
	{
		src: vistas,
		alt: 'Vistas desde la terraza de Tolaita al campo de fútbol y las casas de Elizalde',
	},
	{
		src: pista,
		alt: 'Explanada y pista deportiva junto a la terraza de Tolaita',
	},
	{
		src: bacalao,
		alt: 'Bacalao con pimientos y cebolla frita en salsa de tomate',
	},
	{
		src: combinado,
		alt: 'Plato combinado con huevos fritos, jamón y patatas fritas en Tolaita',
	},
	{
		src: porche,
		alt: 'Porche de la terraza de Tolaita con bancos y vistas a la zona de juegos',
	},
	{
		src: bacalaoDetalle,
		alt: 'Lomo de bacalao con pimientos verdes y cebolla crujiente en salsa roja',
	},
	{
		src: fachada,
		alt: 'Fachada de Tolaita Ostatua en los soportales de Rafael Pikabea Hiribidea',
	},
];

const bizSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${BUSINESS.siteUrl}/#tolaita`,
	name: BUSINESS.name,
	alternateName: ['Tolaita Ostatua', 'Bar Tolaita', 'Restaurante Tolaita', 'Tolaita Elizalde'],
	description,
	url: `${BUSINESS.siteUrl}/`,
	sameAs: [MAPS.place],
	telephone: `+34 ${BUSINESS.phone}`,
	currenciesAccepted: 'EUR',
	servesCuisine: ['Platos combinados', 'Cocina de bar'],
	areaServed: [
		{ '@type': 'City', name: 'Elizalde' },
		{ '@type': 'AdministrativeArea', name: 'Gipuzkoa' },
		{ '@type': 'AdministrativeArea', name: 'País Vasco' },
	],
	address: {
		'@type': 'PostalAddress',
		streetAddress: BUSINESS.street,
		addressLocality: BUSINESS.city,
		addressRegion: BUSINESS.region,
		postalCode: BUSINESS.postalCode,
		addressCountry: BUSINESS.country,
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: BUSINESS.geo.lat,
		longitude: BUSINESS.geo.lng,
	},
	hasMap: MAPS.place,
	image: `${BUSINESS.siteUrl}/og.jpg`,
	identifier: [
		{ '@type': 'PropertyValue', name: 'Google CID', value: BUSINESS.featureId },
		{ '@type': 'PropertyValue', name: 'Place ID', value: BUSINESS.placeId },
	],
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Sunday'],
			opens: '09:00',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Wednesday', 'Thursday'],
			opens: '09:00',
			closes: '22:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Friday', 'Saturday'],
			opens: '09:00',
			closes: '23:30',
		},
	],
	amenityFeature: [
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Acceso para sillas de ruedas',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Aseo adaptado',
			value: true,
		},
		{
			'@type': 'LocationFeatureSpecification',
			name: 'Asientos adaptados',
			value: true,
		},
	],
	aggregateRating: {
		'@type': 'AggregateRating',
		ratingValue: BUSINESS.rating,
		reviewCount: BUSINESS.reviewsCount,
		bestRating: 5,
	},
	review: REVIEWS.map((review) => ({
		'@type': 'Review',
		reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
		reviewBody: review.text,
	})),
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${BUSINESS.siteUrl}/#faq`,
	mainEntity: FAQ.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const nav = [
	{ label: 'La casa', href: '#casa' },
	{ label: 'La barra', href: '#carta' },
	{ label: 'Fotos', href: '#galeria' },
	{ label: 'Visítanos', href: '#visitanos' },
	{ label: 'Preguntas', href: '#preguntas' },
];

const title = 'Tolaita · Bar restaurante y terraza en Elizalde (Gipuzkoa)';

import secciones from '../data/secciones.json';

const piezas = secciones.secciones;
const fotos = {
	"tolaita-apaisada-10.jpg": fachada,
	"tolaita-apaisada-01.jpg": carne,
	"tolaita-vertical-02.jpg": pollo,
	"tolaita-vertical-03.jpg": cafe,
	"tolaita-apaisada-04.jpg": vistas,
	"tolaita-apaisada-05.jpg": pista,
	"tolaita-vertical-06.jpg": bacalao,
	"tolaita-apaisada-07.jpg": combinado,
	"tolaita-apaisada-08.jpg": porche,
	"tolaita-vertical-09.jpg": bacalaoDetalle,
};
---

<!doctype html>
<html lang="es">
	<head>
		<title>{title}</title>
		<meta name="theme-color" content="#3f4a2e" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700&family=Gloock&display=swap"
			rel="stylesheet"
		/>
		<LocalSeo
			name={BUSINESS.name}
			description={description}
			keywords="Tolaita, Tolaita Ostatua, bar restaurante Elizalde, comer en Elizalde, platos combinados Elizalde, bar con terraza Gipuzkoa, Tolaita Rafael Pikabea Hiribidea"
			canonical={`${BUSINESS.siteUrl}/`}
			site={BUSINESS.siteUrl}
			ogTitle={title}
			ogDescription="Bar restaurante en Rafael Pikabea Hiribidea, 11 (Elizalde). Platos combinados, risotto y terraza, con 4,6 sobre 5 en Google. Teléfono 943 01 47 02."
			ogImage={`${BUSINESS.siteUrl}/og.jpg`}
			ogImageAlt="Fachada de Tolaita Ostatua en los soportales de Elizalde"
			ogImageWidth={1200}
			ogImageHeight={630}
			author={BUSINESS.name}
			themeColor="#3f4a2e"
			street={BUSINESS.street}
			city={BUSINESS.city}
			region={BUSINESS.region}
			geoRegion="ES-PV"
			postalCode={BUSINESS.postalCode}
			phone={BUSINESS.phone}
			latitude={BUSINESS.geo.lat}
			longitude={BUSINESS.geo.lng}
			placeName="Elizalde, Gipuzkoa"
			preload={[fachada]}
			schemas={[bizSchema, faqSchema]}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<LocalTopbar
			mark={BUSINESS.mark}
			name="Tolaita"
			subtitle="Bar jatetxea · Elizalde"
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			nav={nav}
		/>

		<main id="contenido">
			<LocalSecciones
				secciones={piezas}
				fotos={fotos}
				negocio={{
					name: BUSINESS.name,
					street: BUSINESS.street,
					district: BUSINESS.district ?? '',
					postalCode: BUSINESS.postalCode,
					city: BUSINESS.city,
				}}
								horario={HOURS}
				mapas={MAPS}
			/>
		</main>

		<LocalFooter
			mark={BUSINESS.mark}
			name={BUSINESS.name}
			address={`${BUSINESS.street} · ${BUSINESS.postalCode} ${BUSINESS.city}`}
			links={[
				{ label: 'Google Maps ↗', href: MAPS.place, external: true },
				{ label: 'Reseñas ↗', href: MAPS.reviews, external: true },
				{ label: 'Aviso legal', href: '/aviso-legal' },
			]}
			phone={BUSINESS.phone}
			phoneHref={BUSINESS.phoneHref}
			legal="Fotografías procedentes del perfil del establecimiento en Google Maps. Información elaborada a partir de fuentes públicas; confirma horario, carta y precios antes de la visita."
			ctaLabel="Llamar a Tolaita"
		/>
	</body>
</html>
