---
const business = {
	name: 'Restaurante El Campillo desde 1976',
	street: 'Carretera Íllora de Casanueva, 89',
	city: 'Zujaira',
	region: 'Granada',
	postalCode: '18291',
	country: 'ES',
	phone: '+34 625 38 99 79',
	latitude: 37.2554724,
	longitude: -3.8013063,
	site: 'https://restaurante-el-campillo-desde-1976.vercel.app',
};
const mapsUrl = 'https://www.google.com/maps/place/Restaurante+El+Campillo+desde+1976/@37.2554724,-3.8013063,17z/data=!3m1!4b1!4m6!3m5!1s0xd6dff6b05f5d8d9:0xf9e6b885ab2f8c2f!8m2!3d37.2554724!4d-3.8013063!16s%2Fg%2F11g9q8ltt9?hl=es';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&hl=es&output=embed`;
const phoneHref = 'tel:+34625389979';
const siteUrl = `${business.site}/`;
const description = 'Restaurante El Campillo desde 1976 en Zujaira, Granada: cocina tradicional, pescado frito, tapas y torrija. Consulta ubicación, teléfono, horario orientativo y fotos de Google Maps.';
const hours = [
	{ day: 'Lunes', value: 'Cerrado' },
	{ day: 'Martes', value: '19:00–23:00' },
	{ day: 'Miércoles', value: '19:00–23:00' },
	{ day: 'Jueves', value: '19:00–23:00' },
	{ day: 'Viernes', value: '19:00–01:00' },
	{ day: 'Sábado', value: '12:00–18:00' },
	{ day: 'Domingo', value: 'Cerrado' },
];
const faqs = [
	{ question: '¿Dónde está Restaurante El Campillo desde 1976?', answer: 'Está en la Carretera Íllora de Casanueva, 89, 18291 Zujaira, Granada. Abre las indicaciones de Google Maps para consultar el recorrido.' },
	{ question: '¿Cuál es el teléfono para reservar?', answer: 'El número publicado para reservas y consultas es el 625 38 99 79. Llama para confirmar disponibilidad y horario.' },
	{ question: '¿Qué platos destacan?', answer: 'Las opiniones públicas destacan el pescado frito, las tapas, el solomillo y la torrija. La carta y disponibilidad pueden cambiar; consulta directamente con el restaurante.' },
	{ question: '¿Cuál es el horario?', answer: 'El horario que publican algunos directorios es orientativo y puede variar en festivos. Confírmalo por teléfono antes de desplazarte.' },
	{ question: '¿Dónde puedo ver fotos del mesón?', answer: 'Abre la ficha de El Campillo en Google Maps desde esta página para consultar fotos y reseñas recientes.' },
];
const restaurantSchema = {
	'@context': 'https://schema.org', '@type': 'Restaurant', '@id': `${siteUrl}#restaurant`,
	openingHoursSpecification: [
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Friday'], opens: '19:00', closes: '01:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '12:00', closes: '18:00' },
		{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday'], opens: '19:00', closes: '23:00' },
	],
	acceptsReservations: true,
	name: business.name, description, url: siteUrl, telephone: business.phone,
	servesCuisine: ['Cocina tradicional', 'Cocina española', 'Tapas'],
	address: { '@type': 'PostalAddress', streetAddress: business.street, addressLocality: business.city, addressRegion: business.region, postalCode: business.postalCode, addressCountry: business.country },
	geo: { '@type': 'GeoCoordinates', latitude: business.latitude, longitude: business.longitude },
	hasMap: mapsUrl,
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---
<!doctype html>
<html lang="es">
<head>
	<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="description" content={description} /><meta name="robots" content="index, follow, max-image-preview:large" />
	<meta name="theme-color" content="#392a23" /><link rel="canonical" href={siteUrl} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />
	<title>Restaurante El Campillo desde 1976 | Zujaira, Granada</title>
	<meta property="og:type" content="restaurant.restaurant" /><meta property="og:locale" content="es_ES" /><meta property="og:site_name" content={business.name} />
	<meta property="og:title" content="El Campillo desde 1976 · Cocina tradicional en Zujaira" /><meta property="og:description" content={description} />
	<meta property="og:url" content={siteUrl} /><meta property="og:image" content={`${business.site}/og.svg`} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content="Restaurante El Campillo desde 1976, cocina tradicional en Zujaira" /><meta name="twitter:card" content="summary_large_image" />
	<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} /><script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.region" content="ES-GR" />
		<meta name="geo.placename" content="Zujaira" />
		<meta name="geo.position" content="37.2554724;-3.8013063" />
		<meta name="ICBM" content="37.2554724, -3.8013063" />
	</head>
<body>
	<a class="skip" href="#contenido">Saltar al contenido</a>
	<header class="topbar"><a class="brand" href="#inicio"><span class="mark">C</span><span>El Campillo<small>Desde 1976 · Zujaira</small></span></a><nav aria-label="Navegación"><a href="#meson">El mesón</a><a href="#cocina">La cocina</a><a href="#fotos">Fotos</a><a href="#visita">Cómo llegar</a></nav><a class="call-top" href={phoneHref}>Reservas · 625 38 99 79</a></header>
	<main id="contenido">
		<section class="hero" id="inicio"><div class="hero-copy"><p class="eyebrow">Zujaira · Granada <i></i> Una casa con historia</p><h1 set:html={piezas.portada.titulo} /><p class="lede">Desde 1976, El Campillo es una parada para disfrutar de la cocina tradicional en Zujaira. Tapas, pescado frito y recetas caseras en un ambiente cercano; llama para reservar y consultar la carta.</p><div class="actions"><a class="button gold" href={phoneHref}>Llamar para reservar ↗</a><a class="button outline" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar ↗</a></div><div class="details"><span>⌖ Carretera Íllora de Casanueva, 89</span><span>✦ Cocina tradicional · tapas</span></div></div><div class="hero-art" role="img" aria-label="Ilustración original de mesa rústica andaluza con platos tradicionales"><div class="sun"></div><div class="hill hill-back"></div><div class="hill hill-front"></div><div class="tree tree-one"></div><div class="tree tree-two"></div><div class="table"></div><div class="plate"><i class="fish"></i><i class="tomato"></i><i class="greens"></i><i class="lemon"></i></div><div class="label">Zujaira<br /><b>desde 1976</b></div><span class="spark">✦</span></div></section>
		<div class="ticker"><span>Cocina tradicional</span><b>✳</b><span>Pescado frito</span><b>✳</b><span>Tapas y raciones</span><b>✳</b><span>Torrija casera</span></div>
		<section class="intro section" id="meson"><div><p class="eyebrow dark">Una mesa con solera</p><h2>Tradición que<br /><em>se comparte.</em></h2></div><div class="intro-copy"><p>Restaurante El Campillo desde 1976 está en Zujaira, en la carretera de Íllora a Casanueva. Su nombre recuerda una larga trayectoria en la hostelería de la comarca y una cocina de inspiración tradicional.</p><p>Consulta su ficha y opiniones, o llama para preguntar por la carta y reservar mesa.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver opiniones y fotos en Google Maps ↗</a></div></section>
		<section class="food section" id="cocina"><div class="heading"><p class="eyebrow dark">Sabores de la casa</p><h2>Platos para volver<br /><em>a la mesa.</em></h2><p>Una selección de platos mencionados por visitantes y fuentes gastronómicas. La oferta puede cambiar según el día.</p></div><div class="cards"><article><span>✦</span><small>DEL MAR</small><h3>Pescado frito</h3><p>Una de las especialidades más citadas en las opiniones del restaurante.</p></article><article class="olive"><span>♨</span><small>RECETAS CASERAS</small><h3>Tapas y solomillo</h3><p>Tapas tradicionales y propuestas de carne para disfrutar sin prisa.</p></article><article class="clay"><span>❋</span><small>ALGO DULCE</small><h3>Torrija</h3><p>Un postre muy recomendado por quienes han visitado El Campillo.</p></article></div><p class="note">Consulta disponibilidad, ingredientes, alérgenos y precios directamente con el establecimiento.</p></section>
		<section class="photo-section" id="fotos"><div class="photo-copy"><p class="eyebrow">El Campillo en Google Maps</p><h2>Descubre sus fotos<br />y el <em>ambiente.</em></h2><p>Entra en la ficha de Google Maps para ver imágenes del local y sus platos, leer reseñas y consultar la información más reciente.</p><a class="button gold" href={mapsUrl} target="_blank" rel="noopener noreferrer">Ver fotos en Google Maps ↗</a><p class="photo-note">Las fotos se consultan en su ficha original; no se descargan ni alojan en esta web.</p></div><div class="map"><div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
<iframe title="Mapa de Google de Restaurante El Campillo desde 1976 en Zujaira" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
			<noscript>
				<p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p>
			</noscript>
		</div><a class="map-card" href={mapsUrl} target="_blank" rel="noopener noreferrer"><b>Restaurante El Campillo desde 1976</b><small>Zujaira · Ver ficha y fotos ↗</small></a></div></section>
		<section class="visit section" id="visita"><div class="visit-copy"><p class="eyebrow dark">Te esperamos en Zujaira</p><h2>Una escapada<br /><em>con buen sabor.</em></h2><p>Planifica tu visita a El Campillo y confirma la apertura antes de salir. Los horarios publicados son orientativos y pueden cambiar en festivos.</p><address>{business.street}<br />{business.postalCode} {business.city}, {business.region}</address><div class="actions"><a class="button dark-button" href={directionsUrl} target="_blank" rel="noopener noreferrer">Abrir indicaciones ↗</a><a class="text-link" href={phoneHref}>Llamar · 625 38 99 79</a></div></div><div class="info-card"><p class="eyebrow dark">Ubicación, reservas y horario</p><h3>Información para tu visita</h3><dl><div><dt>Dirección</dt><dd>Carretera Íllora de Casanueva, 89<br />18291 Zujaira (Granada)</dd></div><div><dt>Teléfono</dt><dd><a href={phoneHref}>625 38 99 79</a></dd></div>{hours.map(({ day, value }) => <div><dt>{day}</dt><dd>{value}</dd></div>)}</dl><p class="note">Horario orientativo según directorios públicos. Confirma por teléfono, especialmente en días festivos.</p><a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">Consultar ficha en Google Maps ↗</a></div></section>
		<section class="faq section" id="preguntas"><p class="eyebrow dark">Preguntas frecuentes</p><h2>Antes de <em>venir.</em></h2><div class="faq-list">{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
	</main>
	<footer class="footer"><div class="footer-top"><a class="brand" href="#inicio"><span class="mark">C</span><span>El Campillo<small>Desde 1976 · Zujaira</small></span></a><p>Cocina tradicional<br />en la comarca granadina.</p><nav aria-label="Enlaces de El Campillo"><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps ↗</a><a href={phoneHref}>625 38 99 79</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Restaurante El Campillo desde 1976</span><a href="/aviso-legal/">Aviso legal y privacidad</a> <a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a> <span>Confirma carta y horario con el restaurante.</span></div>
		<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
	</footer><a class="mobile-call" href={phoneHref}>Reservar <span>625 38 99 79</span></a>
</body>
</html>
<style is:global>
:root{font-family:'DM Sans',sans-serif;color:#382f2a;background:#f8f4eb;font-synthesis:none;text-rendering:optimizeLegibility;--brown:#392a23;--gold:#d8b36e;--cream:#f8f4eb;--green:#59694c;--display:'Playfair Display',Georgia,serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:80px}body{margin:0;min-width:320px}a{color:inherit;text-decoration:none}a:focus-visible,summary:focus-visible{outline:3px solid var(--gold);outline-offset:4px}.skip{position:absolute;top:-60px;left:16px;padding:12px;background:var(--gold)}.skip:focus{top:10px}.topbar{height:78px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;gap:20px;background:var(--brown);color:#fcf8ef}.brand{display:flex;align-items:center;gap:11px;font-weight:700}.brand small{display:block;margin-top:4px;color:#ded3c5;font-size:9px;font-weight:500;letter-spacing:1.3px;text-transform:uppercase}.mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--gold);border-radius:50%;color:#ead19a;font:700 23px var(--display)}.topbar nav,.footer nav{display:flex;gap:22px;font-size:12px}.topbar nav a:hover,.footer a:hover{color:#ead19a}.call-top{padding:11px 16px;border:1px solid #ffffff55;border-radius:99px;font-size:11px;font-weight:700}.hero{display:grid;grid-template-columns:1.06fr .94fr;min-height:550px;background:var(--brown);color:#fcf8ef;overflow:hidden}.hero-copy{align-self:center;padding:65px 4vw 58px 9vw}.eyebrow{margin:0 0 18px;color:#e4ca91;font-size:10px;font-weight:700;letter-spacing:1.7px;text-transform:uppercase}.eyebrow i{display:inline-block;width:20px;height:1px;margin:0 8px 3px;background:currentColor}.hero h1,.intro h2,.heading h2,.photo-copy h2,.visit h2,.faq h2{margin:0;font:600 clamp(38px,4.8vw,62px)/1.08 var(--display);letter-spacing:-1px}.hero h1 em,.intro h2 em,.heading h2 em,.photo-copy h2 em,.visit h2 em,.faq h2 em{color:var(--gold);font-style:italic}.lede{max-width:470px;margin:22px 0 0;color:#e5dcd1;font-size:14px;line-height:1.85}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:25px}.button{display:inline-flex;min-height:46px;align-items:center;justify-content:center;gap:12px;padding:0 19px;border-radius:99px;font-size:12px;font-weight:700;transition:transform .18s}.button:hover{transform:translateY(-2px)}.gold{background:var(--gold);color:var(--brown)}.outline{border:1px solid #ffffff70}.dark-button{background:var(--brown);color:#fff}.details{display:flex;flex-wrap:wrap;gap:12px 20px;margin-top:25px;padding-top:18px;border-top:1px solid #ffffff2c;color:#e4d8c9;font-size:10px}.details span:first-child{color:#ead19a}.hero-art{position:relative;min-height:550px;overflow:hidden;background:linear-gradient(180deg,#d7b783 0%,#bd9567 52%,#78805c 53%,#536448 100%)}.sun{position:absolute;top:10%;right:17%;width:94px;height:94px;border-radius:50%;background:#f1d890;box-shadow:0 0 48px #f1d89088}.hill{position:absolute;right:-8%;left:-8%;height:42%;clip-path:polygon(0 80%,18% 53%,31% 66%,49% 20%,64% 58%,80% 25%,100% 60%,100% 100%,0 100%)}.hill-back{bottom:35%;background:#9b9872}.hill-front{bottom:25%;height:34%;clip-path:polygon(0 39%,18% 63%,38% 20%,54% 63%,74% 28%,100% 62%,100% 100%,0 100%);background:#6d8059}.tree{position:absolute;z-index:1;bottom:27%;width:0;height:0;border-right:24px solid transparent;border-bottom:102px solid #40583d;border-left:24px solid transparent}.tree:after{position:absolute;top:78px;left:-4px;width:8px;height:38px;background:#74543a;content:''}.tree-one{left:12%;transform:scale(.85)}.tree-two{right:13%;transform:scale(1.2)}.table{position:absolute;right:-12%;bottom:-16%;left:-12%;height:45%;border-radius:50% 50% 0 0;background:#644332;box-shadow:0 -9px 24px #2b211c66}.plate{position:absolute;z-index:2;bottom:12%;left:27%;width:min(260px,55%);aspect-ratio:1;border:13px solid #fff9ed;border-radius:50%;background:#e8dfcc;box-shadow:0 15px 30px #30251e77;transform:rotate(-8deg)}.fish{position:absolute;top:28%;left:18%;width:58%;height:20%;bor