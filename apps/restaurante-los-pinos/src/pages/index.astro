---
import '../styles/global.css';

const business = {
	name: 'Restaurante Los Pinos',
	short: 'Los Pinos',
	street: 'Ctra. Caños de Meca, km 9,5',
	area: 'Zahora',
	city: 'Barbate',
	postalCode: '11159',
	phone: '+34 610 34 08 77',
	latitude: 36.2009395,
	longitude: -6.0353592,
	site: 'https://restaurante-los-pinos.vercel.app',
};

const mapsUrl =
	'https://www.google.com/maps/place/Restaurante+Los+Pinos/@36.2009395,-6.0353592,17z/data=!3m1!4b1!4m6!3m5!1s0xd0c472d9c7938d3:0xee642714ef3f0107!8m2!3d36.2009395!4d-6.0353592!16s%2Fg%2F11bwflvk_y?authuser=0&hl=es&entry=ttu';
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.latitude}%2C${business.longitude}`;
const mapEmbedUrl = `https://maps.google.com/maps?q=${business.latitude}%2C${business.longitude}&z=16&output=embed`;
const phoneHref = 'tel:+34610340877';
const facebookUrl = 'https://www.facebook.com/p/Restaurante-Los-PINOS-100065714313852/';

const specialties = [
	{
		kicker: 'Entre pinos',
		title: 'Sombra natural',
		text: 'Restaurante entre pinos en la carretera de Caños, con terraza a la sombra.',
	},
	{
		kicker: 'Cocina',
		title: 'Española y mediterránea',
		text: 'Cocina española de restaurante de costa, para comer sin prisas.',
	},
	{
		kicker: 'En ruta',
		title: 'Zahora y Caños',
		text: 'Base perfecta entre Zahora, Caños de Meca y el faro de Trafalgar.',
	},
	{
		kicker: 'En familia',
		title: 'Trato cercano',
		text: 'Ambiente familiar de venta de carretera, con clientela que repite.',
	},
	{
		kicker: 'Para reservar',
		title: 'Llama al 610 34 08 77',
		text: 'En temporada y fin de semana conviene reservar por teléfono.',
	},
	{
		kicker: 'Con coche',
		title: 'Fácil aparcar',
		text: 'En la misma carretera, parada natural entre Vejer, Zahora y Caños.',
	},
];

const gallery = [
	{ src: '/fotos/pinar.svg', alt: 'Ilustración del pinar — sustituye por foto propia' },
	{ src: '/fotos/restaurante.svg', alt: 'Ilustración del restaurante — sustituye por foto propia' },
	{ src: '/fotos/cocina.svg', alt: 'Ilustración de cocina española — sustituye por foto propia' },
	{ src: '/fotos/terraza.svg', alt: 'Ilustración de la terraza — sustituye por foto propia' },
	{ src: '/fotos/mar.svg', alt: 'Ilustración de Zahora y Trafalgar — sustituye por foto propia' },
];

const faqs = [
	{
		q: '¿Dónde está Los Pinos?',
		a: 'En Ctra. Caños de Meca, km 9,5 (Zahora), 11159 Barbate (Cádiz), según su página oficial.',
	},
	{
		q: '¿Cuál es el horario?',
		a: 'No hay horario verificado publicado: confirma el horario vigente en el 610 34 08 77 antes de venir.',
	},
	{
		q: '¿Hay que reservar?',
		a: 'En temporada y fin de semana conviene reservar en el 610 34 08 77.',
	},
	{
		q: '¿Qué se puede comer?',
		a: 'Restaurante de cocina española entre Zahora y Caños. Confirma la carta del día en el propio local.',
	},
	{
		q: '¿Cómo llego?',
		a: 'Está en la misma carretera de Caños de Meca, km 9,5. Usa el botón «Cómo llegar» para abrir la ruta en Google Maps.',
	},
];

const description =
	'Restaurante Los Pinos: restaurante entre pinos en Ctra. Caños de Meca km 9,5, Zahora (Barbate). Cocina española cerca de Caños y Trafalgar. Tel. 610 34 08 77.';

const restaurantSchema = {
	'@context': 'https://schema.org',
	'@type': 'Restaurant',
	'@id': `${business.site}/#restaurante`,
	name: business.name,
	description,
	url: `${business.site}/`,
	telephone: '+34 610 34 08 77',
	image: [`${business.site}/fotos/restaurante.svg`],
	priceRange: '€€',
	currenciesAccepted: 'EUR',
	servesCuisine: ['Española', 'Mediterránea'],
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.street,
		addressLocality: business.city,
		addressRegion: 'Andalucía',
		postalCode: business.postalCode,
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: business.latitude,
		longitude: business.longitude,
	},
	hasMap: mapsUrl,
	sameAs: [facebookUrl],
	acceptsReservations: 'True',
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${business.site}/#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
import secciones from '../data/secciones.json';

const piezas = Object.fromEntries(secciones.secciones.map((seccion) => [seccion.id, seccion])) as Record<string, any>;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#16241c" />
		<meta name="description" content="Restaurante Los Pinos: restaurante entre pinos en Ctra. Caños km 9,5, Zahora (Barbate). Cocina española. 610 34 08 77." />
		<meta name="keywords" content="Restaurante Los Pinos, comer Zahora, restaurante Caños de Meca, Ctra Caños km 9 5, Trafalgar comer" />
		<meta name="author" content="Restaurante Los Pinos" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
		<link rel="canonical" href={`${business.site}/`} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,600&family=Karla:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>Los Pinos | Restaurante en Zahora, Barbate</title>
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content="Los Pinos · Restaurante entre pinos en Zahora" />
		<meta property="og:description" content="Cocina española en Ctra. Caños de Meca km 9,5, entre Zahora y Caños." />
		<meta property="og:url" content={`${business.site}/`} />
		<meta property="og:image" content={`${business.site}/fotos/restaurante.svg`} />
		<meta property="og:image:alt" content="Restaurante Los Pinos, Zahora, Barbate" />
		<meta property="og:street-address" content={business.street} />
		<meta property="og:locality" content={business.city} />
		<meta property="og:region" content="Andalucía" />
		<meta property="og:postal-code" content={business.postalCode} />
		<meta property="og:country-name" content="España" />
		<meta property="og:phone_number" content={business.phone} />
		<meta property="place:location:latitude" content={String(business.latitude)} />
		<meta property="place:location:longitude" content={String(business.longitude)} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Los Pinos · Restaurante en Zahora, Barbate" />
		<meta name="twitter:description" content="Entre pinos, en Ctra. Caños km 9,5. Cocina española." />
		<meta name="twitter:image" content={`${business.site}/fotos/restaurante.svg`} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(restaurantSchema)} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
		<meta name="geo.placename" content="Zahora, Barbate" />
		<meta name="geo.position" content="36.2009395;-6.0353592" />
		<meta name="ICBM" content="36.2009395, -6.0353592" />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>

		<header class="topbar">
			<a class="brand" href="#inicio" aria-label="Los Pinos, inicio">
				<span class="brand-mark" aria-hidden="true">LP</span>
				<span class="brand-name">Los Pinos <small>Zahora · Barbate</small></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#restaurante">El restaurante</a>
				<a href="#carta">La carta</a>
				<a href="#galeria">Galería</a>
				<a href="#visitanos">Visítanos</a>
			</nav>
			<a class="topbar-phone" href={phoneHref}>610 34 08 77</a>
		</header>

		<main id="contenido">
			<section class="hero" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Ctra. Caños km 9,5 · Zahora</p>
					<h1 id="hero-title" set:html={piezas.portada.titulo} />
					<p class="hero-lede">
						Restaurante Los Pinos: cocina española en la carretera de Caños de Meca,
						entre Zahora, Caños y el faro de Trafalgar.
					</p>
					<div class="hero-actions">
						<a class="button button-ember" href={phoneHref}>Llamar 610 34 08 77</a>
						<a class="button button-ghost" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<ul class="hero-facts">
						<li><b>Km 9,5</b> Ctra. Caños</li>
						<li>Cocina española</li>
						<li>Entre pinos</li>
						<li>Reservas por teléfono</li>
					</ul>
				</div>

				<figure class="hero-photo">
					<img src="/fotos/restaurante.svg" alt="Ilustración de Restaurante Los Pinos, Zahora, Barbate" fetchpriority="high" decoding="async" width="1200" height="800" />
					<figcaption>
						<span>Ctra. Caños km 9,5 · Zahora</span>
						<a href={mapsUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>
					</figcaption>
				</figure>
			</section>

			<section class="bands" aria-label="Datos y servicios">
				<div class="ratings">
					<div><b>9,5</b><span>Km Caños</span></div>
					<div><b>Zahora</b><span>Barbate</span></div>
					<div><b>Pinos</b><span>Entorno</span></div>
				</div>
				<ul class="services">
					<li>Terraza</li>
					<li>Cocina española</li>
					<li>Entre pinos</li>
					<li>Reservas</li>
					<li>Zahora</li>
					<li>Trafalgar</li>
				</ul>
			</section>

			<section class="about section-pad" id="restaurante">
				<p class="section-label"><span aria-hidden="true"></span> El restaurante</p>
				<div class="about-grid">
					<h2>Parada natural<br />en <em>Caños.</em></h2>
					<div class="about-copy">
						<p>
							Restaurante Los Pinos está en Ctra. Caños de Meca, km 9,5 (Zahora), 11159 Barbate,
							según su página oficial, con coordenadas 36.2009395, -6.0353592.
						</p>
						<p>
							Restaurante de cocina española en un entorno de pinos, parada natural en la ruta entre
							Vejer, Zahora, Caños de Meca y Trafalgar.
						</p>
						<p class="about-note">
							No publicamos horario por falta de fuente verificable: confirma el horario vigente
							en el 610 34 08 77 antes de venir, y reserva en temporada.
						</p>
						<div class="about-links">
							<a class="simple-link" href={facebookUrl} target="_blank" rel="noreferrer">Facebook del restaurante <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</div>
			</section>

			<section class="specialties section-pad" id="carta">
				<div class="specialties-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> De su casa</p>
						<h2>Lo que sale<br /><em>de cocina.</em></h2>
					</div>
					<p>
						Líneas generales: cocina de restaurante de costa. Confirma la carta del día
						en el propio restaurante.
					</p>
				</div>
				<div class="cards">
					{specialties.map((item) => (
						<article class="card">
							<span class="card-kicker">{item.kicker}</span>
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="gallery section-pad" id="galeria">
				<div class="gallery-head">
					<div>
						<p class="eyebrow dark"><span aria-hidden="true"></span> Galería</p>
						<h2>El pinar<br /><em>y la mesa.</em></h2>
					</div>
					<div class="gallery-cta">
						<p>
							Estas ilustraciones son marcadores de posición creados para la web. No usamos fotos de Google Maps
							por derechos de autor: sustitúyelas por fotos propias del restaurante.
						</p>
						<a class="button button-ink" href={mapsUrl} target="_blank" rel="noreferrer">Ver fotos en Google Maps ↗</a>
					</div>
				</div>
				<div class="gallery-grid">
					{gallery.map((photo, index) => (
						<figure class:list={['shot', index === 0 && 'shot-wide']}>
							<img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="800" height="800" />
						</figure>
					))}
				</div>
				<p class="gallery-note">
					Imágenes propias temporales en SVG. Para publicar, reemplaza los archivos de /public/fotos/ por fotografías
					del titular con sus textos alt correspondientes.
				</p>
			</section>

			<section class="visit section-pad" id="visitanos">
				<div class="visit-copy">
					<p class="eyebrow"><span aria-hidden="true"></span> Ctra. Caños de Meca, km 9,5</p>
					<h2>Ven a Zahora<br /><em>a comer.</em></h2>
					<p class="address">
						{business.street} ({business.area})<br />
						{business.postalCode} {business.city}, España
					</p>

					<p class="hours-note">Horario sin fuente verificable. Confirma en el 610 34 08 77 antes de venir.</p>

					<div class="visit-links">
						<a class="button button-ember" href={phoneHref}>Llamar al restaurante ↗</a>
						<a class="button button-line" href={directionsUrl} target="_blank" rel="noreferrer">Cómo llegar ↗</a>
					</div>
					<a class="phone-link" href={phoneHref}>+34 610 34 08 77</a>
				</div>

				<div class="map-frame">
					<div style="position:relative;width:100%;min-height:300px;overflow:hidden;border-radius:inherit;">
						<iframe title="Mapa de Los Pinos en Ctra. Caños km 9,5, Zahora" src={mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
						<noscript><p style="margin:0;padding:1rem;text-align:center;"><a href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps ↗</a></p></noscript>
					</div>
					<a class="map-label" href={mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">⌖</span> Los Pinos · Zahora</a>
				</div>
			</section>

			<section class="faq section-pad" id="preguntas">
				<p class="section-label"><span aria-hidden="true"></span> Preguntas frecuentes</p>
				<h2>Antes de <em>venir.</em></h2>
				<div class="faq-list">
					{faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))}
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">LP</span>
				<p>Los Pinos<small>{business.street} · {business.area}</small></p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				<a href={mapsUrl} target="_blank" rel="noreferrer">Google Maps ↗</a>
				<a href={facebookUrl} target="_blank" rel="noreferrer">Facebook ↗</a>
				<a href={phoneHref}>{business.phone}</a>
			</nav>
			<small>© {new Date().getFullYear()} Los Pinos · Zahora, Barbate. Ilustraciones propias temporales, pendientes de fotos del local.</small>
			<p style="font-size: 0.75rem; opacity: 0.7; margin: 0.5rem 0 0;"><small>Web creada por <a href="https://sur-digital.vercel.app/" rel="noopener">Sur Digital</a></small></p>
		<nav class="sur-legal" aria-label="Información legal y créditos" style="box-sizing:border-box;flex:0 0 100%;width:100%;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.35rem 1.1rem;margin:1.2rem 0 0;padding:0 1.25rem;font-size:.8rem;line-height:1.7;text-align:center;opacity:.85">
			<a href="/aviso-legal" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Aviso legal</a>
			<a href="/aviso-legal#privacidad" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Privacidad</a>
			<a href="/aviso-legal#cookies" style="color:inherit;text-decoration:underline;text-underline-offset:2px">Cookies</a>
		</nav>
		</footer>

		<a class="mobile-call" href={phoneHref}>Llamar al restaurante <span>610 34 08 77</span></a>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
	<!-- contacto-rapido -->
<style>
	.contact-fabs { position: fixed; right: clamp(1rem, 4vw, 1.75rem); bottom: clamp(1rem, 4vw, 1.75rem); z-index: 60; display: flex; flex-direction: column; gap: 0.65rem; }
	.contact-fabs a { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; color: #fff; text-decoration: none; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24); transition: transform 0.18s ease; }
	.contact-fabs a:hover, .contact-fabs a:focus-visible { transform: scale(1.06); }
	.contact-fabs a:focus-visible { outline: 3px solid #1f1f1f; outline-offset: 3px; }
	.contact-fabs .fab-call { background: #c2410c; }
	.contact-fabs .fab-wa { background: #25d366; }
	.contact-fabs svg { width: 1.7rem; height: 1.7rem; }
	@media (prefers-reduced-motion: reduce) { .contact-fabs a { transition: none; } }
	/* En móvil casi todas estas webs llevan una barra de llamada o de menú abajo. El botón sube
	   siempre: si no hay barra queda algo más alto, y si la hay no se queda tapado. */
	@media (max-width: 680px) { .contact-fabs { bottom: 5rem; } }
</style>
<nav class="contact-fabs" aria-label="Contacto rápido">
	<a class="fab-wa" href="https://wa.me/34610340877?text=Hola%2C%20os%20escribo%20desde%20la%20web%20de%20Restaurante%20Los%20Pinos." target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a Restaurante Los Pinos"><svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 4a20 20 0 0 0-17.1 30.2L4 44l10.1-2.8A20 20 0 1 0 24 4Zm0 36.4a16.4 16.4 0 0 1-8.4-2.3l-.6-.4-6 1.7 1.6-5.9-.4-.6A16.4 16.4 0 1 1 24 40.4Zm9.1-12.3c-.5-.3-3-1.5-3.4-1.6-.5-.2-.8-.2-1.1.2-.3.5-1.3 1.6-1.6 2-.3.3-.6.4-1.1.1a13.4 13.4 0 0 1-3.9-2.4 14.7 14.7 0 0 1-2.7-3.4c-.3-.5 0-.8.2-1.1l.8-.9c.2-.3.3-.5.5-.9.1-.3 0-.6-.1-.9l-1.5-3.4c-.4-.9-.8-.8-1.1-.8h-1c-.3 0-.9.1-1.3.6-.5.5-1.7 1.7-1.7 4.1 0 2.4 1.8 4.7 2 5 .2.3 3.4 5.2 8.2 7.2 1.1.5 2 .8 2.7 1 1.2.4 2.2.3 3 .2.9-.1 2.9-1.2 3.3-2.3.4-1.1.4-2 .3-2.2-.1-.2-.4-.3-.9-.5Z"/></svg></a>
</nav>
	</body>
</html>
