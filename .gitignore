# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
# Ignore every .env variant, but keep the committed examples trackable.
.env
.env.*
!.env.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
out/
build
dist
dist-ssr

# Astro
.astro/

# Convex generated code (lives under apps/*/src/convex)
**/src/convex/_generated

# Storybook
storybook-static/

# Freebuff
.freebuff/

# Debug
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
bun-debug.log*
lerna-debug.log*
storybook.log

# Misc
.DS_Store
Thumbs.db
*.pem

# Editor directories and files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json

# Salida del proyecto unico de Vercel
dist-single

# Scratch de sesiones: capturas, comparaciones de HTML y scripts sueltos
.tmp-*
**/.tmp/
scripts/tmp-*
scripts/.tmp-*

# SQLite en modo WAL (se regenera solo)
*.sqlite-shm
*.sqlite-wal
