{
    "name": "@react-components",
    "version": "0.0.1",
    "description": "Shared React UI components",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "lint": "eslint . --ext .ts,.tsx",
        "test": "vitest",
        "test:ui": "vitest --ui --coverage --config vitest.unit.config.ts",
        "test:unit": "vitest run --config vitest.unit.config.ts",
        "test:watch": "vitest --config vitest.unit.config.ts",
        "test:coverage": "vitest run --coverage --config vitest.unit.config.ts",
        "storybook": "storybook dev -p 6006 --disable-telemetry",
        "build-storybook": "storybook build",
        "supabase:types": "node_modules/supabase/bin/supabase.exe gen types typescript --project-id krpizytigyzitqwtqzsp --schema public > src/types/supabase.ts",
        "typecheck": "tsc --noEmit",
        "build": "tsc"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "react-hook-form": "^7.68.0",
        "remixicon": "^4.7.0",
        "tailwind-merge": "^3.4.0",
        "toastify-js": "^1.12.0",
        "zod": "4.1.13"
    },
    "devDependencies": {
        "@storybook/react": "^10.1.8",
        "@storybook/react-vite": "^10.1.11",
        "@tailwindcss/vite": "^4.1.18",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@types/toastify-js": "^1.12.4",
        "@vitejs/plugin-react": "^5.1.2",
        "@vitest/coverage-v8": "^4.0.16",
        "@vitest/ui": "^4.0.16",
        "jsdom": "^27.4.0",
        "storybook": "^10.1.11",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.9.3",
        "vitest": "^4.0.16"
    },
    "peerDependencies": {
        "react": "*",
        "react-dom": "*"
    }
}