{
  "name": "@react-components",
  "version": "0.0.1",
  "description": "Shared React UI components",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "test:ui": "vitest --ui --coverage --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.unit.config.ts",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build",
    "supabase:types": "node_modules/supabase/bin/supabase.exe gen types typescript --project-id krpizytigyzitqwtqzsp --schema public > src/types/supabase.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "react-hook-form": "^7.89.0",
    "remixicon": "^4.9.1",
    "tailwind-merge": "^3.7.0",
    "toastify-js": "^1.12.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/toastify-js": "^1.12.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "jsdom": "^30.1.2",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  }
}
