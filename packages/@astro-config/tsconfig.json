{
	"compilerOptions": {
		"types": ["astro/client", "@astrojs/image/client"],
		"paths": {
			"@assets/*": ["../../packages/@assets/*"],
			"@astro-components": ["../../packages/@astro-components"]
		}
	}
	// No se declara "include"/"exclude" aquí: las rutas de un tsconfig heredado
	// se resuelven respecto a ESTE archivo, no al de la app, y el resultado es
	// que `astro check` no encuentra ficheros (0 files). Cada app declara los
	// suyos: "include": ["env.d.ts", ".astro/types.d.ts", "**/*"].
}
