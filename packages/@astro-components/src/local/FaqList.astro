---
/**
 * Lista simple de preguntas frecuentes: acordeón con la primera pregunta
 * abierta, sin enlace a la ficha de Google ni JSON-LD (eso lo cubre
 * `LocalFaqBlock`). Es la variante que repiten las webs cuyo bloque de FAQ va
 * sobre fondo suave y con borde superior.
 *
 * El contenido llega por props: las preguntas viven en el `data/site` de cada
 * app y el marcado y las clases son los mismos en todas ellas.
 */
export interface Props {
	items: { q: string; a: string }[];
	eyebrow?: string;
	title?: string;
	id?: string;
	/**
	 * `bordered` (por defecto) separa la sección con un borde superior;
	 * `plain` la deja sin borde y con `scroll-mt` para los enlaces internos.
	 */
	variant?: 'bordered' | 'plain';
	background?: 'base-100' | 'base-200';
	/**
	 * Titular: `primary` (por defecto) grande en el color de marca; `bold`, algo
	 * menor y en negrita sin color.
	 */
	emphasis?: 'primary' | 'bold';
	/** Redondeo de cada pregunta: `2xl` (por defecto), `xl` o `lg`. */
	radius?: '2xl' | 'xl' | 'lg';
	/** Abre la primera pregunta al cargar. */
	openFirst?: boolean;
}

const {
	items,
	eyebrow = 'Preguntas frecuentes',
	title = 'Antes de venir',
	id = 'faq',
	variant = 'bordered',
	background = 'base-200',
	emphasis = 'primary',
	radius = '2xl',
	openFirst = true,
} = Astro.props;
---

<section
	id={id}
	class:list={[
		background === 'base-100' ? 'bg-base-100' : 'bg-base-200',
		variant === 'bordered' ? 'border-base-300 border-t' : 'scroll-mt-20',
		'py-20 sm:py-24',
	]}
>
	<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<p class="text-secondary text-xs font-semibold tracking-[0.22em] uppercase">{eyebrow}</p>
			<h2
				class:list={[
					'font-display mt-3',
					emphasis === 'bold'
						? 'text-3xl font-bold sm:text-4xl'
						: 'text-primary text-4xl font-semibold sm:text-5xl',
				]}
			>
				{title}
			</h2>
		</div>

		<div class="mt-10 space-y-3">
			{
				items.map((item, index) => (
					<details
						class:list={[
							'border-base-300 bg-base-100 group border',
							radius === 'lg' ? 'rounded-lg' : radius === 'xl' ? 'rounded-xl' : 'rounded-2xl',
						]}
						open={openFirst && index === 0}
					>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left font-semibold">
							{item.q}
							<i class="ri-add-line text-secondary shrink-0 text-xl transition-transform group-open:rotate-45" />
						</summary>
						<p class="text-base-content/70 px-5 pb-5 text-sm leading-relaxed">{item.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
