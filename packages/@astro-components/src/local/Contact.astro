---
/**
 * Sección "Dónde estamos" de las webs de negocio local: horario, ficha de
 * Google, cómo llegar y mapa.
 *
 * El marcado y las clases son los mismos en toda esta familia; cada app pasa su
 * `BUSINESS`. Los textos se derivan de esos datos: solo cambian el detalle de
 * la introducción y de la dirección, que se eligen con `intro` y `address`.
 */
export interface Props {
	business: {
		name: string;
		city: string;
		street: string;
		postalCode: string;
		district: string;
		region: string;
		phone?: string;
		phoneHref?: string;
		hours: { days: string; hours: string }[];
		hoursNote: string;
		googleMaps: string;
		googleMapsEmbed: string;
	};
	eyebrow?: string;
	title?: string;
	id?: string;
	/**
	 * `city` (por defecto) solo nombra la ciudad; `street` añade la dirección y
	 * remite el teléfono a la ficha; `street-phone` enlaza el teléfono para
	 * reservar.
	 */
	intro?: 'city' | 'street' | 'street-phone';
	/** `district` (por defecto) o la dirección completa con calle y código postal. */
	address?: 'district' | 'street';
	hoursTitle?: string;
}

const {
	business,
	eyebrow = 'Visítanos',
	title = 'Dónde estamos',
	id = 'contacto',
	intro = 'city',
	address = 'district',
	hoursTitle = 'Horario y reserva',
} = Astro.props;

const introText =
	intro === 'street-phone'
		? `${business.name} está en ${business.street}, ${business.postalCode} ${business.city}. Llama al <a class="link" href="${business.phoneHref}">${business.phone}</a> para reservar.`
		: intro === 'street'
			? `${business.name} está en ${business.street}, ${business.postalCode} ${business.city}. La dirección exacta y el teléfono están en su ficha de Google Maps.`
			: `${business.name} está en ${business.city}. La dirección exacta aparece en su ficha de Google Maps.`;

const addressText =
	address === 'street'
		? `${business.street}, ${business.postalCode} ${business.district} (${business.region}). Ubicación en Google Maps.`
		: `${business.district}, ${business.region}. Ubicación en Google Maps.`;
---

<section id={id} class="bg-base-200 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">{eyebrow}</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">{title}</h2>
			<div class="astyle-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6" set:html={introText} />
		</div>

		<div class="mt-14 grid gap-8 lg:grid-cols-2">
			<div class="space-y-6">
				<div class="etiqueta-astyle border-base-300 bg-base-100 rounded-sm border p-7">
					<h3 class="text-xl font-semibold">{hoursTitle}</h3>
					<div class="mt-5 space-y-4 text-sm">
						{
							business.hours.map((tramo) => (
								<div class="border-base-300 flex items-baseline justify-between gap-4 border-b pb-3">
									<span class="font-semibold">{tramo.days}</span>
									<span class="text-base-content/70 text-right">{tramo.hours}</span>
								</div>
							))
						}
					</div>
					<p class="text-base-content/55 mt-4 text-xs leading-relaxed">{business.hoursNote}</p>
					<div class="mt-6 flex flex-wrap gap-3">
						<a
							href={business.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-primary gap-2 rounded-full"
						>
							<i class="ri-google-fill"></i> Ficha de Google
						</a>
					</div>
				</div>

				<div class="etiqueta-astyle border-base-300 bg-base-100 rounded-sm border p-7">
					<h3 class="text-xl font-semibold">Cómo llegar</h3>
					<p class="text-base-content/70 mt-4 text-sm leading-relaxed">{addressText}</p>
					<div class="mt-6 flex flex-wrap gap-3">
						<a
							href={business.googleMaps}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-outline gap-2 rounded-full"
						>
							<i class="ri-map-pin-line"></i> Cómo llegar
						</a>
					</div>
				</div>
			</div>

			<div class="etiqueta-astyle border-base-300 bg-base-100 overflow-hidden rounded-sm border">
				<iframe
					title={`Mapa de ${business.name} en Google Maps`}
					src={business.googleMapsEmbed}
					class="h-full min-h-[420px] w-full border-0"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"></iframe>
			</div>
		</div>
	</div>
</section>
