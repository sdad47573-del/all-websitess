---
/**
 * Tienda de catálogo para las webs de negocios locales.
 *
 * No cobra: el pedido se cierra por WhatsApp (o teléfono) con el mensaje ya
 * escrito. El carrito vive en localStorage, así que la página puede seguir
 * siendo estática y desplegarse en cualquier CDN.
 *
 * Los estilos van con `is:global` y prefijo `shop-` porque el carrito se pinta
 * desde JavaScript y los elementos creados no llevarían el atributo de scope
 * de Astro. La página de tienda no importa el CSS de la app, así que no hay
 * colisiones con el resto de la web.
 */
interface Producto {
	id: string;
	nombre: string;
	descripcion?: string;
	precio: number;
	imagen?: string;
	stock: number;
}

interface Props {
	name: string;
	title?: string;
	backHref?: string;
	currency?: string;
	pickup?: string;
	note?: string;
	phone?: string;
	products?: Producto[];
}

const {
	name,
	title = 'Tienda',
	backHref = '/',
	currency = 'EUR',
	pickup = '',
	note = '',
	phone = '',
	products = [],
} = Astro.props;

const money = (value: number) => {
	try {
		return new Intl.NumberFormat('es-ES', { style: 'currency', currency }).format(value);
	} catch {
		return `${value.toFixed(2)} ${currency}`;
	}
};

const cartProducts = products.map(({ id, nombre, precio, stock }) => ({ id, nombre, precio, stock }));
const config = { name, currency, phone, pickup };
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<div class="shop-shell">
	<header class="shop-head">
		<a class="shop-back" href={backHref}>← {name}</a>
		<span class="shop-kicker">Pedidos directos, sin comisiones</span>
	</header>

	<main class="shop-main">
		<div class="shop-intro">
			<h1>{title}</h1>
			{pickup && <p class="shop-pickup">{pickup}</p>}
			{note && <p class="shop-note">{note}</p>}
		</div>

		<div class="shop-layout">
			<section class="shop-grid" aria-label="Productos">
				{
					products.length === 0 && (
						<p class="shop-empty">Todavía no hay productos publicados.</p>
					)
				}
				{products.map((producto) => (
					<article class="shop-card">
						{producto.imagen ? (
							<img
								src={producto.imagen}
								alt={producto.nombre}
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div class="shop-noimg" aria-hidden="true">
								{producto.nombre.slice(0, 1).toUpperCase()}
							</div>
						)}
						<div class="shop-body">
							<h2>{producto.nombre}</h2>
							{producto.descripcion && <p class="shop-desc">{producto.descripcion}</p>}
							<div class="shop-row">
								<strong>{money(producto.precio)}</strong>
								{producto.stock === 0 ? (
									<span class="shop-stock out">Agotado</span>
								) : producto.stock <= 5 ? (
									<span class="shop-stock">Quedan {producto.stock}</span>
								) : null}
							</div>
							<button
								type="button"
								class="shop-add"
								data-add={producto.id}
								disabled={producto.stock === 0}
							>
								{producto.stock === 0 ? 'Sin stock' : 'Añadir al pedido'}
							</button>
						</div>
					</article>
				))}
			</section>

			<aside class="shop-cart" aria-label="Tu pedido">
				<h2>Tu pedido</h2>
				<p class="shop-cart-empty" data-cart-empty>La cesta está vacía.</p>
				<ul class="shop-cart-list" data-cart-list></ul>

				<div class="shop-total">
					<span>Total</span>
					<strong data-cart-total>{money(0)}</strong>
				</div>

				<a class="shop-order" data-order href="#" hidden>Pedir por WhatsApp</a>
				<button type="button" class="shop-clear" data-clear hidden>Vaciar cesta</button>

				<p class="shop-legal">
					El pedido se confirma en el chat. Esta página no cobra nada ni guarda datos
					personales.
				</p>
			</aside>
		</div>
	</main>
</div>

<script type="application/json" id="shop-products" set:html={json(cartProducts)} />
<script type="application/json" id="shop-config" set:html={json(config)} />

<script>
	const productsNode = document.getElementById('shop-products');
	const configNode = document.getElementById('shop-config');
	const list = document.querySelector('[data-cart-list]');
	const empty = document.querySelector('[data-cart-empty]');
	const total = document.querySelector('[data-cart-total]');
	const order = document.querySelector('[data-order]');
	const clear = document.querySelector('[data-clear]');

	if (list && empty && total && order && clear && productsNode && configNode) {
		const products = JSON.parse(productsNode.textContent || '[]') as Array<{
			id: string;
			nombre: string;
			precio: number;
			stock: number;
		}>;
		const config = JSON.parse(configNode.textContent || '{}') as {
			name?: string;
			currency?: string;
			phone?: string;
			pickup?: string;
		};

		const byId = new Map(products.map((product) => [product.id, product]));
		const key = `tienda:${location.pathname}`;
		const money = new Intl.NumberFormat('es-ES', {
			style: 'currency',
			currency: config.currency || 'EUR',
		});

		const read = (): Map<string, number> => {
			const cart = new Map<string, number>();
			try {
				const raw = JSON.parse(localStorage.getItem(key) || '{}') as Record<string, unknown>;
				for (const [id, amount] of Object.entries(raw)) {
					const product = byId.get(id);
					const quantity = Number(amount);
					if (product && Number.isInteger(quantity) && quantity > 0) {
						cart.set(id, Math.min(quantity, product.stock));
					}
				}
			} catch {
				/* modo privado o datos corruptos: se empieza con la cesta vacía */
			}
			return cart;
		};

		let cart = read();

		const save = () => {
			try {
				localStorage.setItem(key, JSON.stringify(Object.fromEntries(cart)));
			} catch {
				/* modo privado: el pedido funciona igual en esta visita */
			}
		};

		const sum = () => {
			let amount = 0;
			for (const [id, quantity] of cart) amount += (byId.get(id)?.precio ?? 0) * quantity;
			return amount;
		};

		const message = () => {
			const lines = [`Pedido en ${config.name || 'la tienda'}:`];
			for (const [id, quantity] of cart) {
				const product = byId.get(id);
				if (product) lines.push(`• ${quantity} × ${product.nombre} — ${money.format(product.precio * quantity)}`);
			}
			lines.push(`Total: ${money.format(sum())}`);
			if (config.pickup) lines.push(config.pickup);
			return lines.join('\n');
		};

		const render = () => {
			list.replaceChildren();

			for (const [id, quantity] of cart) {
				const product = byId.get(id);
				if (!product) continue;

				const line = document.createElement('li');
				line.className = 'shop-line';

				const name = document.createElement('span');
				name.className = 'shop-line-name';
				name.textContent = product.nombre;

				const controls = document.createElement('span');
				controls.className = 'shop-line-controls';

				const remove = document.createElement('button');
				remove.type = 'button';
				remove.dataset.dec = id;
				remove.textContent = '−';
				remove.setAttribute('aria-label', `Quitar uno de ${product.nombre}`);

				const amount = document.createElement('span');
				amount.textContent = String(quantity);

				const add = document.createElement('button');
				add.type = 'button';
				add.dataset.inc = id;
				add.textContent = '+';
				add.disabled = quantity >= product.stock;
				add.setAttribute('aria-label', `Añadir uno de ${product.nombre}`);

				controls.append(remove, amount, add);

				const price = document.createElement('span');
				price.className = 'shop-line-price';
				price.textContent = money.format(product.precio * quantity);

				line.append(name, controls, price);
				list.append(line);
			}

			empty.hidden = cart.size > 0;
			clear.hidden = cart.size === 0;
			total.textContent = money.format(sum());

			const digits = String(config.phone || '').replace(/\D/g, '');
			const canOrder = cart.size > 0 && digits.length >= 6;
			order.hidden = !canOrder;
			if (canOrder) order.href = `https://wa.me/${digits}?text=${encodeURIComponent(message())}`;

			save();
		};

		document.addEventListener('click', (event) => {
			const node = event.target instanceof Element ? event.target.closest('button') : null;
			if (!node) return;

			const add = node.getAttribute('data-add');
			const inc = node.getAttribute('data-inc');
			const dec = node.getAttribute('data-dec');

			if (node.hasAttribute('data-clear')) {
				cart = new Map();
			} else if (add) {
				const product = byId.get(add);
				if (product && product.stock > 0) {
					cart.set(add, Math.min((cart.get(add) ?? 0) + 1, product.stock));
				}
			} else if (inc) {
				const product = byId.get(inc);
				if (product) cart.set(inc, Math.min((cart.get(inc) ?? 0) + 1, product.stock));
			} else if (dec) {
				const next = (cart.get(dec) ?? 0) - 1;
				if (next <= 0) cart.delete(dec);
				else cart.set(dec, next);
			} else {
				return;
			}

			render();
		});

		render();
	}
</script>

<style is:global>
	.shop-shell {
		min-height: 100vh;
		background: #f7f5f0;
		color: #171614;
		font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
		line-height: 1.55;
	}

	.shop-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		max-width: 1080px;
		margin: 0 auto;
		padding: 18px 20px;
		border-bottom: 1px solid rgb(23 22 20 / 10%);
	}

	.shop-back {
		color: #171614;
		font-size: 13px;
		font-weight: 700;
		text-decoration: none;
	}

	.shop-back:hover {
		text-decoration: underline;
	}

	.shop-kicker {
		color: #6b665d;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.shop-main {
		max-width: 1080px;
		margin: 0 auto;
		padding: 32px 20px 64px;
	}

	.shop-intro h1 {
		margin: 0;
		font-size: clamp(2rem, 6vw, 3rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
	}

	.shop-pickup {
		margin: 10px 0 0;
		font-size: 13px;
		font-weight: 700;
		color: #0f5c46;
	}

	.shop-note {
		margin: 8px 0 0;
		max-width: 44rem;
		color: #5b564e;
		font-size: 14px;
	}

	.shop-layout {
		display: grid;
		gap: 20px;
		margin-top: 26px;
	}

	.shop-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
		gap: 14px;
		align-content: start;
	}

	.shop-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: #fff;
		border: 1px solid rgb(23 22 20 / 10%);
		border-radius: 12px;
	}

	.shop-card img,
	.shop-noimg {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		background: #e9e4da;
	}

	.shop-noimg {
		display: grid;
		place-items: center;
		color: #a29a8b;
		font-size: 2rem;
		font-weight: 800;
	}

	.shop-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 6px;
		padding: 14px;
	}

	.shop-body h2 {
		margin: 0;
		font-size: 16px;
		line-height: 1.3;
	}

	.shop-desc {
		margin: 0;
		color: #6b665d;
		font-size: 12.5px;
	}

	.shop-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		margin-top: auto;
	}

	.shop-row strong {
		font-size: 15px;
	}

	.shop-stock {
		color: #8a5a00;
		font-size: 11px;
		font-weight: 700;
	}

	.shop-stock.out {
		color: #b42318;
	}

	.shop-add {
		min-height: 38px;
		padding: 8px 12px;
		border: 0;
		border-radius: 8px;
		background: #171614;
		color: #fff;
		font: inherit;
		font-size: 12.5px;
		font-weight: 700;
		cursor: pointer;
	}

	.shop-add:hover:not(:disabled) {
		background: #0f5c46;
	}

	.shop-add:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	.shop-cart {
		align-self: start;
		padding: 18px;
		background: #fff;
		border: 1px solid rgb(23 22 20 / 10%);
		border-radius: 12px;
	}

	.shop-cart h2 {
		margin: 0 0 10px;
		font-size: 13px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #6b665d;
	}

	.shop-cart-empty {
		margin: 0;
		color: #6b665d;
		font-size: 13px;
	}

	.shop-cart-list {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.shop-line {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2px 10px;
		font-size: 13px;
	}

	.shop-line-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.shop-line-controls {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		grid-row: span 2;
	}

	.shop-line-controls button {
		width: 26px;
		height: 26px;
		padding: 0;
		border: 1px solid rgb(23 22 20 / 18%);
		border-radius: 6px;
		background: #f7f5f0;
		color: #171614;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}

	.shop-line-controls button:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}

	.shop-line-price {
		color: #171614;
		font-size: 12px;
		font-weight: 700;
	}

	.shop-total {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
		margin-top: 14px;
		padding-top: 12px;
		border-top: 1px solid rgb(23 22 20 / 12%);
		font-size: 13px;
	}

	.shop-total strong {
		font-size: 18px;
	}

	.shop-order {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		margin-top: 12px;
		padding: 10px 14px;
		border-radius: 9px;
		background: #128c7e;
		color: #fff;
		font-size: 13px;
		font-weight: 800;
		text-decoration: none;
	}

	.shop-order:hover {
		background: #0f7a6e;
	}

	.shop-clear {
		width: 100%;
		margin-top: 8px;
		padding: 8px;
		border: 0;
		background: transparent;
		color: #6b665d;
		font: inherit;
		font-size: 12px;
		text-decoration: underline;
		cursor: pointer;
	}

	.shop-legal {
		margin: 12px 0 0;
		color: #8a8479;
		font-size: 11px;
		line-height: 1.6;
	}

	.shop-empty {
		grid-column: 1 / -1;
		margin: 0;
		padding: 24px;
		background: #fff;
		border: 1px dashed rgb(23 22 20 / 20%);
		border-radius: 12px;
		color: #6b665d;
		font-size: 13px;
		text-align: center;
	}

	@media (min-width: 900px) {
		.shop-layout {
			grid-template-columns: minmax(0, 1fr) 300px;
			align-items: start;
		}

		.shop-cart {
			position: sticky;
			top: 18px;
		}
	}

	@media (prefers-color-scheme: dark) {
		.shop-shell {
			background: #121110;
			color: #f4f1ea;
		}

		.shop-head {
			border-bottom-color: rgb(244 241 234 / 12%);
		}

		.shop-back,
		.shop-body h2,
		.shop-line-price {
			color: #f4f1ea;
		}

		.shop-card,
		.shop-cart {
			background: #1c1a18;
			border-color: rgb(244 241 234 / 12%);
		}

		.shop-card img,
		.shop-noimg {
			background: #2a2724;
		}

		.shop-add {
			background: #f4f1ea;
			color: #171614;
		}

		.shop-line-controls button {
			background: #2a2724;
			border-color: rgb(244 241 234 / 18%);
			color: #f4f1ea;
		}

		.shop-total {
			border-top-color: rgb(244 241 234 / 14%);
		}
	}
</style>
