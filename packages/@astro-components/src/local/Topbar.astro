---
/**
 * Topbar.astro — Barra de navegación superior compartida.
 */
export interface Props {
	mark: string;
	name: string;
	subtitle: string;
	phone: string;
	phoneHref: string;
	nav: { label: string; href: string }[];
}

const { mark, name, subtitle, phone, phoneHref, nav } = Astro.props;
---

<header class="topbar">
	<div class="topbar-inner wrap">
		<a class="brand" href="#inicio" aria-label={`${name}, inicio`}>
			<span class="brand-mark" aria-hidden="true">{mark}</span>
			<span class="brand-name">
				{name}
				<small>{subtitle}</small>
			</span>
		</a>
		<nav aria-label="Navegación principal">
			{nav.map((item) => <a href={item.href}>{item.label}</a>)}
		</nav>
		<a class="topbar-phone" href={phoneHref}>{phone}</a>
	</div>
	<nav class="local-mobile-nav wrap" aria-label="Navegación móvil">
		{nav.map((item) => <a href={item.href}>{item.label}</a>)}
	</nav>
</header>

<style>
	.local-mobile-nav {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		overscroll-behavior-inline: contain;
		padding-block: 0 0.65rem;
		scrollbar-width: thin;
		-webkit-overflow-scrolling: touch;
	}

	.local-mobile-nav a {
		min-height: 44px;
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		padding-inline: 0.85rem;
		border: 1px solid currentColor;
		border-radius: 999px;
		text-decoration: none;
		font-size: 0.8rem;
	}

	@media (min-width: 981px) {
		.local-mobile-nav {
			display: none;
		}
	}
</style>
