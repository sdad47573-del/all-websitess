---
/**
 * Boton flotante "Como llegar" que en movil lleva a la ficha de Google Maps
 * del negocio. Se oculta a partir de lg, donde ya hay navegacion de sobra.
 */
export interface Props {
	/** Ficha del negocio en Google Maps. */
	href: string;
	businessName: string;
	label?: string;
}

const { href, businessName, label = 'Cómo llegar' } = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class="btn btn-primary btn-lg fixed right-4 bottom-4 z-40 gap-2 rounded-full shadow-xl lg:hidden"
	aria-label={`Ver la ficha de ${businessName} en Google Maps`}
>
	<i class="ri-map-pin-line text-xl" aria-hidden="true"></i>
	{label}
</a>
