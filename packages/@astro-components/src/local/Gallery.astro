---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
	eyebrow: string;
	title: string;
	description: string;
	images: { src: ImageMetadata; alt: string }[];
	cta: { label: string; href: string };
	note: string;
}

const { eyebrow, title, description, images, cta, note } = Astro.props;
---

<section class="gallery section-pad wrap" id="galeria">
	<div class="gallery-head">
		<div>
			<p class="eyebrow"><span aria-hidden="true"></span> {eyebrow}</p>
			<h2 set:html={title} />
		</div>
		<div>
			<p>{description}</p>
			<a class="button button-primary" href={cta.href} target="_blank" rel="noreferrer">
				{cta.label} <span aria-hidden="true">↗</span>
			</a>
		</div>
	</div>
	<div class="gallery-grid">
		{
			images.map((image) => (
				<figure class="shot">
					<Image
						src={image.src}
						alt={image.alt}
						widths={[320, 480, 640]}
						sizes="(max-width: 640px) 92vw, (max-width: 980px) 45vw, 23vw"
						format="avif"
						quality={65}
						loading="lazy"
						decoding="async"
					/>
				</figure>
			))
		}
	</div>
	<p class="gallery-note">{note}</p>
</section>
