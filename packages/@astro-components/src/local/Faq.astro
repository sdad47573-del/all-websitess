---
export interface Props {
	items: { q: string; a: string }[];
	eyebrow?: string;
	title?: string;
}

const { items, eyebrow = 'Preguntas frecuentes', title = 'Antes de <em>venir.</em>' } = Astro.props;
---

<section class="faq section-pad wrap" id="preguntas">
	<p class="section-label" data-campo="etiqueta"><span aria-hidden="true"></span> {eyebrow}</p>
	<h2 data-campo="titulo" set:html={title} />
	<div class="faq-list">
		{
			items.map((item) => (
				<details data-campo="pregunta">
					<summary data-campo="preguntaTexto">{item.q}</summary>
					<p data-campo="respuesta">{item.a}</p>
				</details>
			))
		}
	</div>
</section>
