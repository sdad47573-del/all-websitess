---
export interface Props {
	items: { q: string; a: string }[];
	eyebrow?: string;
	title?: string;
}

const { items, eyebrow = 'Preguntas frecuentes', title = 'Antes de <em>venir.</em>' } = Astro.props;
---

<section class="faq section-pad wrap" id="preguntas">
	<p class="section-label"><span aria-hidden="true"></span> {eyebrow}</p>
	<h2 set:html={title} />
	<div class="faq-list">
		{
			items.map((item) => (
				<details>
					<summary>{item.q}</summary>
					<p>{item.a}</p>
				</details>
			))
		}
	</div>
</section>
