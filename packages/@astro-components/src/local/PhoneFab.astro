---
/**
 * Boton flotante de llamada para movil: marca el telefono del negocio y lleva
 * al `tel:` que ya publica la web. Como `LocalMapFab`, se oculta a partir de
 * lg, donde la cabecera ya muestra el telefono.
 */
export interface Props {
	/** Telefono en formato `tel:`, por ejemplo `tel:+34957000000`. */
	href: string;
	/** Nombre del negocio, para el nombre accesible del enlace. */
	businessName: string;
	/** Telefono visible dentro del boton. */
	phone: string;
}

const { href, businessName, phone } = Astro.props;
---

<a
	href={href}
	class="btn btn-primary btn-lg fixed right-4 bottom-4 z-40 gap-2 rounded-full shadow-xl lg:hidden"
	aria-label={`Llamar a ${businessName} al ${phone}`}
>
	<i class="ri-phone-line text-xl" aria-hidden="true"></i>
	{phone}
</a>
