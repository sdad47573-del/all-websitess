---
export interface MenuGroup {
	title: string;
	items: { name: string; note: string }[];
}

export interface Props {
	eyebrow: string;
	title: string;
	description: string;
	cta: { label: string; href: string };
	groups: MenuGroup[];
	note: string;
}

const { eyebrow, title, description, cta, groups, note } = Astro.props;
---

<section class="menu section-pad" id="carta">
	<div class="wrap">
		<div class="menu-head">
			<div>
				<p class="eyebrow"><span aria-hidden="true"></span> {eyebrow}</p>
				<h2 set:html={title} />
			</div>
			<div>
				<p>{description}</p>
				<a class="button button-primary" href={cta.href}>{cta.label}</a>
			</div>
		</div>

		<div class="menu-groups">
			{
				groups.map((group) => (
					<div class="menu-group">
						<h3>{group.title}</h3>
						<ul class="dishes">
							{group.items.map((item) => (
								<li>
									<span class="dish">
										{item.name}
										<em>{item.note}</em>
									</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<p class="menu-note">{note}</p>
	</div>
</section>
