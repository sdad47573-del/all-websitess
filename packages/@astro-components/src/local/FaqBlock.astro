---
/**
 * Bloque de preguntas frecuentes en acordeon, con el enlace a la ficha de
 * Google del negocio y el JSON-LD de FAQPage cuando la app lo pasa.
 *
 * El texto de los titulos es el de esta familia de landings; el contenido de
 * las preguntas y el negocio llegan por props.
 */
export interface Props {
	items: { q: string; a: string }[];
	business: { name: string; googleMaps: string };
	/** Datos estructurados FAQPage ya construidos por la app. */
	schema?: object;
	eyebrow?: string;
	title?: string;
}

const {
	items,
	business,
	schema,
	eyebrow = 'Preguntas frecuentes',
	title = 'Lo que más nos preguntáis',
} = Astro.props;
---

<section id="faq" class="bg-base-100 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">
				{eyebrow}
			</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl">{title}</h2>
			<div class="astyle-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6">
				¿Te queda alguna duda? Consulta la ficha de
				<a
					class="text-primary font-semibold"
					href={business.googleMaps}
					target="_blank"
					rel="noopener noreferrer">{business.name} en Google</a
				>
				y te lo confirman al momento.
			</p>
		</div>
		<div class="mt-12 space-y-3">
			{
				items.map((item) => (
					<details class="collapse-arrow border-base-300 bg-base-200 collapse rounded-sm border">
						<summary class="collapse-title text-lg font-semibold">{item.q}</summary>
						<div class="collapse-content">
							<p class="text-base-content/75 text-sm leading-relaxed">{item.a}</p>
						</div>
					</details>
				))
			}
		</div>
	</div>
	{schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
</section>
