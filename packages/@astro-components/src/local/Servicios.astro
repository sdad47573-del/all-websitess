---
/**
 * Bloque de servicios de las landings de negocio local: rejilla de servicios,
 * lista de ventajas y tarjeta final de reserva.
 *
 * El marcado y las clases son los mismos en todas las webs de esta familia;
 * cada app pasa su contenido desde `data/site` y el negocio para el enlace a
 * la ficha de Google. Los textos por defecto son los de esta familia: se
 * pueden sobrescribir por props si una web necesita otros.
 */
export interface Props {
	business: { name: string; city: string; googleMaps: string };
	items: { icon: string; title: string; text: string }[];
	advantages: { icon: string; title: string; text: string }[];
	eyebrow?: string;
	/** Admite HTML: el título se pinta con `set:html`. */
	title?: string;
	advantagesTitle?: string;
	servicesLink?: { label: string; href: string } | null;
	ctaTitle?: string;
	ctaText?: string;
	ctaLabels?: { primary: string; secondary: string };
}

const {
	business,
	items,
	advantages,
	eyebrow = 'La casa',
	title = `Información del local en ${business.city}`,
	advantagesTitle = 'Por qué elegirnos',
	servicesLink = { label: 'Ver todos los servicios', href: '/servicios' },
	ctaTitle = 'Reserva y horario en Google',
	ctaText = 'Consulta la mesa y el horario en la ficha pública de Google. Te confirman servicio, precio y hora al momento.',
	ctaLabels = { primary: 'Ver la ficha', secondary: 'Cómo llegar' },
} = Astro.props;
---

<section id="servicios" class="bg-base-200 scroll-mt-20 py-20 sm:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center">
			<span class="text-primary text-xs font-semibold tracking-[0.2em] uppercase">{eyebrow}</span>
			<h2 class="font-display mt-3 text-3xl font-bold sm:text-4xl" set:html={title} />
			<div class="astyle-divider mx-auto mt-5 h-px w-32"></div>
			<p class="text-base-content/70 mt-6 leading-relaxed">
				Sin carta online: aquí no se inventan platos ni precios.
				Consulta la
				<a
					class="text-primary font-semibold"
					href={business.googleMaps}
					target="_blank"
					rel="noopener noreferrer">ficha de Google</a
				>
				y te confirman servicio y precio antes de empezar.
			</p>
		</div>

		<div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				items.map((servicio) => (
					<article class="etiqueta-astyle border-base-300 bg-base-100 group rounded-sm border p-6 transition-shadow hover:shadow-lg">
						<span class="bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-content flex size-12 items-center justify-center rounded-md transition-colors">
							<i class={`${servicio.icon} text-2xl`} />
						</span>
						<h3 class="mt-5 text-xl font-bold">{servicio.title}</h3>
						<p class="text-base-content/65 mt-2 text-sm leading-relaxed">{servicio.text}</p>
					</article>
				))
			}
		</div>

		{
			servicesLink && (
				<p class="mt-4 text-center text-sm">
					<a href={servicesLink.href} class="text-primary font-semibold underline">
						{servicesLink.label}
					</a>
				</p>
			)
		}

		<div class="mt-16">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="font-display text-3xl font-bold sm:text-4xl">{advantagesTitle}</h2>
				<div class="astyle-divider mx-auto mt-5 h-px w-32"></div>
			</div>
			<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{
					advantages.map((ventaja) => (
						<article class="border-base-300 bg-base-100 flex h-full gap-4 rounded-sm border p-6">
							<span class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-md">
								<i class={`${ventaja.icon} text-xl`} />
							</span>
							<div>
								<h3 class="text-lg font-bold">{ventaja.title}</h3>
								<p class="text-base-content/65 mt-1 text-sm leading-relaxed">{ventaja.text}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>

		<div
			class="border-base-300 bg-base-100 mt-14 grid gap-6 rounded-sm border p-8 lg:grid-cols-[1.4fr_1fr] lg:items-center"
		>
			<div>
				<h3 class="text-2xl font-bold">{ctaTitle}</h3>
				<p class="text-base-content/70 mt-3 text-sm leading-relaxed">{ctaText}</p>
			</div>
			<div class="flex flex-wrap gap-3 lg:justify-end">
				<a
					href={business.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-primary gap-2 rounded-full"
				>
					<i class="ri-google-fill"></i> {ctaLabels.primary}
				</a>
				<a
					href={business.googleMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-outline gap-2 rounded-full"
				>
					<i class="ri-map-pin-line"></i> {ctaLabels.secondary}
				</a>
			</div>
		</div>
	</div>
</section>
