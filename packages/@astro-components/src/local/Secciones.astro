---
import type { ImageMetadata } from 'astro';
import LocalAbout from './About.astro';
import LocalChips from './Chips.astro';
import LocalMenu from './Menu.astro';
import LocalFaq from './Faq.astro';
import LocalGallery from './Gallery.astro';
import LocalHero from './Hero.astro';
import LocalVisit from './Visit.astro';

interface Enlace {
	texto: string;
	href: string;
	externo?: boolean;
	primario?: boolean;
}

interface Seccion {
	id: string;
	tipo: string;
	visible?: boolean;
	etiqueta?: string;
	titulo?: string;
	texto?: string;
	nota?: string;
	notaHorario?: string;
	pieFoto?: string;
	distintivo?: string;
	mapaEtiqueta?: string;
	imagen?: string;
	imagenAlt?: string;
	boton?: Enlace;
	botonSecundario?: Enlace;
	enlaceGaleria?: Enlace;
	datos?: { etiqueta: string; html: string }[];
	parrafos?: string[];
	enlaces?: Enlace[];
	items?: { titulo: string; texto: string }[];
	fotos?: { imagen: string; alt: string }[];
	preguntas?: { pregunta: string; respuesta: string }[];
	chips?: string[];
	grupos?: { titulo: string; items: { nombre: string; nota: string; precio?: string }[] }[];
}

export interface SeccionNegocio {
	name: string;
	street: string;
	district: string;
	postalCode: string;
	city: string;
}

export interface SeccionHorario {
	day: string;
	value: string;
	closed?: boolean;
}

export interface SeccionMapas {
	place: string;
	directions: string;
	streetView: string;
	embed: string;
}

interface Props {
	secciones: Seccion[];
	fotos: Record<string, ImageMetadata>;
	/** Datos del negocio que no viven en secciones.json: dirección y mapa. */
	negocio: SeccionNegocio;
	horario?: SeccionHorario[];
	mapas: SeccionMapas;
}

const { secciones, fotos, negocio, horario = [], mapas } = Astro.props;

// Hay webs con el horario como {day,value} y otras como {dia,horas}: se iguala aquí.
const horas = (horario as Array<Record<string, unknown>>).map((hora) => ({
	day: String(hora.day ?? hora.dia ?? ""),
	value: String(hora.value ?? hora.horas ?? ""),
	closed: Boolean(hora.closed),
}));

// Los enlaces del JSON pueden apuntar a la ficha, a las indicaciones o a
// Street View con `maps:clave`; así el panel no obliga a pegar URLs enormes.
const destino = (href: string) =>
	href.startsWith('maps:') ? ((mapas as unknown as Record<string, string>)[href.slice(5)] ?? '#') : href;

const enlace = (item: Enlace) => ({
	label: item.texto,
	href: destino(item.href),
	external: item.externo ?? item.href.startsWith('maps:'),
});

const foto = (nombre?: string) =>
	(nombre ? fotos[nombre] : undefined) ?? Object.values(fotos)[0];

const visibles = secciones.filter((seccion) => seccion.visible !== false);
---

{
	visibles.map((seccion) => {
		switch (seccion.tipo) {
			case 'hero':
				return (
					<LocalHero
						eyebrow={seccion.etiqueta ?? ''}
						title={seccion.titulo ?? ''}
						lede={seccion.texto ?? ''}
						image={foto(seccion.imagen)}
						imageAlt={seccion.imagenAlt ?? ''}
						primaryCta={
							seccion.boton
								? enlace(seccion.boton)
								: { label: 'Cómo llegar', href: mapas.directions }
						}
						secondaryCta={
							seccion.botonSecundario
								? enlace(seccion.botonSecundario)
								: { label: 'Ficha y fotos en Google', href: mapas.place, external: true }
						}
						facts={(seccion.datos ?? []).map((dato) => ({
							label: dato.etiqueta,
							html: dato.html,
						}))}
						galleryHref={seccion.enlaceGaleria ? destino(seccion.enlaceGaleria.href) : mapas.streetView}
						photoCredit={seccion.pieFoto}
						galleryLinkLabel={seccion.enlaceGaleria?.texto}
						tag={seccion.distintivo}
					/>
				);

			case 'about':
				return (
					<LocalAbout
						label={seccion.etiqueta ?? ''}
						title={seccion.titulo ?? ''}
						paragraphs={seccion.parrafos ?? []}
						note={seccion.nota}
						links={(seccion.enlaces ?? []).map(enlace)}
					/>
				);

			case 'destacados':
				return (
					<section class="three section-pad" id={seccion.id} aria-labelledby={`${seccion.id}-title`}>
						<div class="wrap">
							<div class="three-head">
								<p class="eyebrow" data-campo="etiqueta">
									<span aria-hidden="true" /> {seccion.etiqueta}
								</p>
								<h2 id={`${seccion.id}-title`} data-campo="titulo" set:html={seccion.titulo} />
							</div>
							<div class="three-grid">
								{(seccion.items ?? []).map((item, index) => (
									<article class="three-card" data-campo="destacado">
										<span class="three-num" aria-hidden="true">
											{String(index + 1).padStart(2, '0')}
										</span>
										<h3 data-campo="itemTitulo">{item.titulo}</h3>
										<p data-campo="itemTexto">{item.texto}</p>
									</article>
								))}
							</div>
						</div>
					</section>
				);

			case 'galeria':
				return (
					<LocalGallery
						eyebrow={seccion.etiqueta ?? ''}
						title={seccion.titulo ?? ''}
						description={seccion.texto ?? ''}
						images={(seccion.fotos ?? []).map((item) => ({
							src: foto(item.imagen),
							alt: item.alt,
						}))}
						cta={
							seccion.boton
								? enlace(seccion.boton)
								: { label: 'Ver todas en Google', href: mapas.place }
						}
						note={seccion.nota ?? ''}
					/>
				);

			case 'visita':
				return (
					<LocalVisit
						eyebrow={seccion.etiqueta ?? ''}
						title={seccion.titulo ?? ''}
						addressLines={[
							negocio.street,
							`${negocio.district} · ${negocio.postalCode} ${negocio.city}`,
						]}
						hours={horas}
						hoursCaption="Horario no publicado en Google"
						hoursNote={seccion.notaHorario ?? ''}
						mapTitle={`Mapa de ${negocio.name} en ${negocio.district}, ${negocio.city}`}
						mapEmbedUrl={mapas.embed}
						mapLabel={seccion.mapaEtiqueta ?? `${negocio.name} · ${negocio.street}`}
						mapHref={mapas.place}
						links={(seccion.enlaces ?? []).map((item) => ({
							...enlace(item),
							variant: item.primario ? ('primary' as const) : ('ghost' as const),
						}))}
						contactLink={{ label: 'Ver la ficha en Google ↗', href: mapas.place, external: true }}
						reserveNote={seccion.nota ?? ''}
					/>
				);

			case 'faq':
				return (
					<LocalFaq
						eyebrow={seccion.etiqueta}
						title={seccion.titulo}
						items={(seccion.preguntas ?? []).map((item) => ({
							q: item.pregunta,
							a: item.respuesta,
						}))}
					/>
				);

			case 'chips':
				return (
					<LocalChips
						label={seccion.etiqueta ?? seccion.titulo ?? 'Señas'}
						items={seccion.chips ?? []}
					/>
				);

			case 'menu':
				return (
					<LocalMenu
						eyebrow={seccion.etiqueta ?? ''}
						title={seccion.titulo ?? ''}
						description={seccion.texto ?? ''}
						cta={
							seccion.boton
								? enlace(seccion.boton)
								: { label: 'Ver la carta', href: mapas.place }
						}
						groups={(seccion.grupos ?? []).map((grupo) => ({
							title: grupo.titulo,
							items: grupo.items.map((dish) => ({
								name: dish.nombre,
								note: dish.nota,
								price: dish.precio,
							})),
						}))}
						note={seccion.nota ?? ''}
					/>
				);

			case 'texto':
				return (
					<section class="about section-pad wrap" id={seccion.id}>
						<p class="section-label" data-campo="etiqueta">
							<span aria-hidden="true" /> {seccion.etiqueta}
						</p>
						<div class="about-grid">
							<h2 data-campo="titulo" set:html={seccion.titulo} />
							<div class="about-copy">
								{(seccion.parrafos ?? []).map((parrafo) => (
									<p data-campo="parrafo">{parrafo}</p>
								))}
								{(seccion.enlaces ?? []).length > 0 && (
									<div class="about-links">
										{(seccion.enlaces ?? []).map((item) => (
											<a
												class="simple-link"
												data-campo="enlace"
												href={destino(item.href)}
												target={item.externo ? '_blank' : undefined}
												rel={item.externo ? 'noreferrer' : undefined}
											>
												{item.texto} {item.externo && <span aria-hidden="true">↗</span>}
											</a>
										))}
									</div>
								)}
							</div>
						</div>
					</section>
				);

			case 'cta':
				return (
					<section class="about section-pad wrap" id={seccion.id}>
						<div class="about-grid">
							<h2 data-campo="titulo" set:html={seccion.titulo} />
							<div class="about-copy">
								<p data-campo="texto">{seccion.texto}</p>
								<div class="about-links">
									{seccion.boton && (
										<a
											class="button button-primary"
											data-campo="boton"
											href={destino(seccion.boton.href)}
											target={seccion.boton.externo ? '_blank' : undefined}
											rel={seccion.boton.externo ? 'noreferrer' : undefined}
										>
											{seccion.boton.texto}
										</a>
									)}
								</div>
							</div>
						</div>
					</section>
				);

			default:
				return null;
		}
	})
}
