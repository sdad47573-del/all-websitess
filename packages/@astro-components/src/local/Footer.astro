---
export interface Props {
	mark: string;
	name: string;
	address: string;
	links: { label: string; href: string; external?: boolean }[];
	phone: string;
	phoneHref: string;
	legal: string;
	ctaLabel: string;
	/** Permite traducir el pie en webs de otros idiomas sin tocar el resto. */
	navAriaLabel?: string;
	legalLinks?: { label: string; href: string }[];
	creditLabel?: string;
	creditName?: string;
	creditHref?: string;
}

const {
	mark,
	name,
	address,
	links,
	phone,
	phoneHref,
	legal,
	ctaLabel,
	navAriaLabel = 'Enlaces del restaurante',
	legalLinks = [
		{ label: 'Aviso legal', href: '/aviso-legal' },
		{ label: 'Privacidad', href: '/aviso-legal#privacidad' },
		{ label: 'Cookies', href: '/aviso-legal#cookies' },
	],
	creditLabel = 'Web creada por',
	creditName = 'Sur Digital',
	creditHref = 'https://sur-digital.vercel.app/',
} = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		<div class="footer-grid">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">{mark}</span>
				<p>
					{name}
					<small>{address}</small>
				</p>
			</div>
			<nav aria-label={navAriaLabel}>
				{
					links.map((link) => (
						<a
							href={link.href}
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noreferrer' : undefined}
						>
							{link.label}
						</a>
					))
				}
			</nav>
		</div>
		<small class="legal">
			© {year} {name} · {legal}
		</small>
		<nav class="legal-links" aria-label="Información legal">
			{
				legalLinks.map((link) => (
					<a href={link.href}>{link.label}</a>
				))
			}
		</nav>
		<p class="credit">
			<small>{creditLabel} <a href={creditHref} rel="noopener">{creditName}</a></small>
		</p>
	</div>
</footer>

{
	phone && (
		<a class="mobile-call" href={phoneHref}>{ctaLabel} <span>{phone}</span></a>
	)
}
