---
export interface Props {
	mark: string;
	name: string;
	address: string;
	links: { label: string; href: string; external?: boolean }[];
	phone: string;
	phoneHref: string;
	legal: string;
	ctaLabel: string;
}

const { mark, name, address, links, phone, phoneHref, legal, ctaLabel } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		<div class="footer-grid">
			<div class="footer-brand">
				<span class="brand-mark" aria-hidden="true">
					{mark}
				</span>
				<p>
					{name}
					<small>{address}</small>
				</p>
			</div>
			<nav aria-label="Enlaces del restaurante">
				{links.map((link) => (
					<a
						href={link.href}
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noreferrer' : undefined}
					>
						{link.label}
					</a>
				))}
			</nav>
		</div>
		<small class="legal">
			© {year} {name} · {legal}
		</small>
		<nav class="legal-links" aria-label="Información legal">
			<a href="/aviso-legal">Aviso legal</a>
			<a href="/aviso-legal#privacidad">Privacidad</a>
			<a href="/aviso-legal#cookies">Cookies</a>
		</nav>
		<p class="credit">
			<small>
				Web creada por{' '}
				<a href="https://sur-digital.vercel.app/" rel="noopener">
					Sur Digital · sur-digital.vercel.app
				</a>
			</small>
		</p>
	</div>
</footer>

<a class="mobile-call" href={phoneHref}>
	{ctaLabel} <span>{phone}</span>
</a>
