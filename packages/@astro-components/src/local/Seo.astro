---
/**
 * Seo.astro — Cabecera <head> compartida para las webs de negocios locales.
 *
 * Concentra todo lo que se repite en las cuatro apps de restaurantes: metadatos
 * base, Open Graph de tipo `restaurant.restaurant`, Twitter Card, metadatos
 * geográficos, JSON-LD y la precarga de la imagen principal.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { geoRegionCode } from './geo-codes';

export interface Props {
	name: string;
	description: string;
	keywords: string;
	canonical: string;
	site: string;
	ogTitle: string;
	ogDescription: string;
	ogImage: string;
	ogImageAlt: string;
	ogImageWidth: number;
	ogImageHeight: number;
	ogType?: string;
	author?: string;
	themeColor: string;
	street: string;
	city: string;
	region: string;
	/**
	 * Código ISO 3166-2 para `geo.region`. Solo hace falta si la web quiere
	 * precisar más que su propia `region` (por ejemplo el código de provincia
	 * cuando el negocio declara la comunidad). Si no se pasa o no es válido, se
	 * deriva de `region`.
	 */
	geoRegion?: string;
	postalCode: string;
	phone?: string;
	latitude: number;
	longitude: number;
	placeName: string;
	/** Metadatos OG de contacto de negocio, usados por Facebook e Instagram. */
	contact?: {
		street: string;
		locality: string;
		region: string;
		postalCode: string;
		country: string;
		phone: string;
		latitude: number;
		longitude: number;
	};
	/** Imágenes a precargar en el <head> (normalmente el hero). */
	preload?: ImageMetadata[];
	/** Datos estructurados adicionales (Restaurant, FAQPage…). */
	schemas: object[];
	/** Idioma del Open Graph (por defecto, español de España). */
	locale?: string;
	/** País del Open Graph (por defecto, España). */
	countryName?: string;
}

const {
	name,
	description,
	keywords,
	canonical,
	site,
	ogTitle,
	ogDescription,
	ogImage,
	ogImageAlt,
	ogImageWidth,
	ogImageHeight,
	ogType = 'restaurant.restaurant',
	author,
	themeColor,
	street,
	city,
	region,
	geoRegion,
	postalCode,
	phone,
	latitude,
	longitude,
	placeName,
	contact,
	preload = [],
	schemas,
	locale = 'es_ES',
	countryName = 'España',
} = Astro.props;

// El código de `geo.region` sale de la región del negocio: mejor omitirlo que
// anunciar una comunidad que no es la suya.
const regionCode = geoRegionCode(geoRegion) ?? geoRegionCode(region);

// El MIME del og:image sale de su extensión; si no se reconoce, mejor no declararlo.
const ogImageType = /\.(jpe?g|png|svg|webp|avif|gif)(\?|$)/i.exec(ogImage)?.[1]?.toLowerCase();
const OG_MIME: Record<string, string> = {
	jpg: 'image/jpeg',
	jpeg: 'image/jpeg',
	png: 'image/png',
	svg: 'image/svg+xml',
	webp: 'image/webp',
	avif: 'image/avif',
	gif: 'image/gif',
};

// Las imágenes importadas no traen `srcSet` hasta que se generan sus variantes,
// así que las producimos aquí para poder declararlas en el preload del hero.
const preloads = await Promise.all(
	preload.map(async (image) => {
		const optimized = await getImage({
			src: image,
			width: 1200,
			format: 'avif',
			quality: 70,
		});
		return { href: optimized.src };
	}),
);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
{author && <meta name="author" content={author} />}
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

{regionCode && <meta name="geo.region" content={regionCode} />}
<meta name="geo.placename" content={placeName} />
<meta name="geo.position" content={`${latitude};${longitude}`} />
<meta name="ICBM" content={`${latitude}, ${longitude}`} />

<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

{
	schemas.map((schema) => (
		<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
	))
}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content={name} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{ogImageType && OG_MIME[ogImageType] && <meta property="og:image:type" content={OG_MIME[ogImageType]} />}
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:street-address" content={street} />
<meta property="og:locality" content={city} />
<meta property="og:region" content={region} />
<meta property="og:postal-code" content={postalCode} />
<meta property="og:country-name" content={countryName} />
{phone && <meta property="og:phone_number" content={phone} />}
<meta property="place:location:latitude" content={String(latitude)} />
<meta property="place:location:longitude" content={String(longitude)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{
	contact && (
		<Fragment>
			<meta property="business:contact_data:street_address" content={contact.street} />
			<meta property="business:contact_data:locality" content={contact.locality} />
			<meta property="business:contact_data:region" content={contact.region} />
			<meta property="business:contact_data:postal_code" content={contact.postalCode} />
			<meta property="business:contact_data:country_name" content={contact.country} />
			<meta property="business:contact_data:phone" content={contact.phone} />
			<meta property="business:contact_data:latitude" content={String(contact.latitude)} />
			<meta property="business:contact_data:longitude" content={String(contact.longitude)} />
		</Fragment>
	)
}

<!-- Precarga de la imagen principal para acelerar el LCP -->
{preloads.map((image) => <link rel="preload" as="image" href={image.href} fetchpriority="high" />)}
