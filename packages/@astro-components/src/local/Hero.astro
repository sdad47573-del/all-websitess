---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
	eyebrow: string;
	title: string;
	lede: string;
	image: ImageMetadata;
	imageAlt: string;
	primaryCta: { label: string; href: string };
	secondaryCta: { label: string; href: string; external?: boolean };
	facts: { label: string; html: string }[];
	galleryHref: string;
	/** Permite traducir el pie de foto en webs de otros idiomas. */
	photoCredit?: string;
	galleryLinkLabel?: string;
	/** Etiqueta opcional sobre la foto (precio del día, cartel…). Cada web la estiliza. */
	tag?: string;
}

const {
	eyebrow,
	title,
	lede,
	image,
	imageAlt,
	primaryCta,
	secondaryCta,
	facts,
	galleryHref,
	photoCredit = 'Foto de la ficha de Google Maps',
	galleryLinkLabel = 'Ver la galería',
	tag,
} =
	Astro.props;
---

<section class="hero wrap" id="inicio" aria-labelledby="hero-title">
	<div class="hero-copy">
		<p class="eyebrow" data-campo="etiqueta"><span aria-hidden="true"></span> {eyebrow}</p>
		<h1 id="hero-title" data-campo="titulo" set:html={title} />
		<p class="hero-lede" data-campo="texto">{lede}</p>
		<div class="hero-actions">
			<a class="button button-primary" data-campo="boton" href={primaryCta.href}>{primaryCta.label}</a>
			<a
				class="button button-ghost"
				data-campo="botonSecundario"
				href={secondaryCta.href}
				target={secondaryCta.external ? '_blank' : undefined}
				rel={secondaryCta.external ? 'noreferrer' : undefined}
			>
				{secondaryCta.label} <span aria-hidden="true">↗</span>
			</a>
		</div>
		<ul class="hero-facts">
			{facts.map((fact) => <li data-campo="dato" set:html={fact.html} />)}
		</ul>
	</div>

	<figure class="hero-photo">
		<Image
			src={image}
			alt={imageAlt}
			widths={[480, 720, 960, 1200]}
			sizes="(max-width: 980px) 92vw, 46vw"
			format="avif"
			quality={70}
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
		{tag && <span class="hero-tag" data-campo="distintivo">{tag}</span>}
		<figcaption>
			<span data-campo="pieFoto">{photoCredit}</span>
			<a data-campo="galeriaEnlace" href={galleryHref} target="_blank" rel="noreferrer">{galleryLinkLabel} ↗</a>
		</figcaption>
	</figure>
</section>
