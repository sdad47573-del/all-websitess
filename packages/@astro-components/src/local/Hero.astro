---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
	eyebrow: string;
	title: string;
	lede: string;
	image: ImageMetadata;
	imageAlt: string;
	primaryCta: { label: string; href: string };
	secondaryCta: { label: string; href: string; external?: boolean };
	facts: { label: string; html: string }[];
	galleryHref: string;
}

const { eyebrow, title, lede, image, imageAlt, primaryCta, secondaryCta, facts, galleryHref } =
	Astro.props;
---

<section class="hero wrap" id="inicio" aria-labelledby="hero-title">
	<div class="hero-copy">
		<p class="eyebrow"><span aria-hidden="true"></span> {eyebrow}</p>
		<h1 id="hero-title" set:html={title} />
		<p class="hero-lede">{lede}</p>
		<div class="hero-actions">
			<a class="button button-primary" href={primaryCta.href}>{primaryCta.label}</a>
			<a
				class="button button-ghost"
				href={secondaryCta.href}
				target={secondaryCta.external ? '_blank' : undefined}
				rel={secondaryCta.external ? 'noreferrer' : undefined}
			>
				{secondaryCta.label} <span aria-hidden="true">↗</span>
			</a>
		</div>
		<ul class="hero-facts">
			{facts.map((fact) => <li set:html={fact.html} />)}
		</ul>
	</div>

	<figure class="hero-photo">
		<Image
			src={image}
			alt={imageAlt}
			widths={[480, 720, 960, 1200]}
			sizes="(max-width: 980px) 92vw, 46vw"
			format="avif"
			quality={70}
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
		<figcaption>
			<span>Foto de la ficha de Google Maps</span>
			<a href={galleryHref} target="_blank" rel="noreferrer">Ver la galería ↗</a>
		</figcaption>
	</figure>
</section>
