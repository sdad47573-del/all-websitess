---
/**
 * Rejilla de puntos fuertes (icono + titulo + texto) que va justo debajo del
 * hero en las landings de negocio local.
 *
 * El marcado y las clases son los mismos en todas las webs de esta familia;
 * lo unico que cambia es el contenido, que cada app pasa desde su data/site.
 */
export interface Props {
	items: { icon: string; title: string; text: string }[];
}

const { items } = Astro.props;
---

<section class="border-base-300 bg-base-200 border-b py-14">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				items.map((item) => (
					<div class="flex gap-4">
						<span class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-md">
							<i class={`${item.icon} text-xl`} />
						</span>
						<div>
							<h2 class="text-lg font-bold">{item.title}</h2>
							<p class="text-base-content/65 mt-1 text-sm leading-relaxed">{item.text}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
