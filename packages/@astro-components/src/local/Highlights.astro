---
/**
 * Rejilla de puntos fuertes (icono + titulo + texto) que va justo debajo del
 * hero en las landings de negocio local.
 *
 * El marcado y las clases son los mismos en todas las webs de esta familia;
 * lo unico que cambia es el contenido, que cada app pasa desde su data/site.
 * Las tres variantes que habia copiadas en las apps (padding, redondeo del
 * icono y color) se eligen por props, con los valores de siempre por defecto.
 */
export interface Props {
	items: { icon: string; title: string; text: string }[];
	/** `md` = py-14 (por defecto), `sm` = py-12. */
	padding?: 'md' | 'sm';
	/** Redondeo del icono: `md` (por defecto) o `full`. */
	shape?: 'md' | 'full';
	/** Color del icono: `primary` (por defecto) o `secondary`. */
	tone?: 'primary' | 'secondary';
}

const { items, padding = 'md', shape = 'md', tone = 'primary' } = Astro.props;

const iconTone = tone === 'secondary' ? 'bg-secondary/10 text-secondary' : 'bg-primary/10 text-primary';
const iconShape = shape === 'full' ? 'rounded-full' : 'rounded-md';
---

<section class:list={['border-base-300 bg-base-200 border-b', padding === 'sm' ? 'py-12' : 'py-14']}>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				items.map((item) => (
					<div class="flex gap-4">
						<span class:list={[iconTone, 'flex size-11 shrink-0 items-center justify-center', iconShape]}>
							<i class={`${item.icon} text-xl`} />
						</span>
						<div>
							<h2 class="text-lg font-bold">{item.title}</h2>
							<p class="text-base-content/65 mt-1 text-sm leading-relaxed">{item.text}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
