	<path
		fill="none"
		stroke="#000000"
		stroke-width="2"
		stroke-miterlimit="10"
		d="M19,41L12,59L18,59L28,41"
		style="stroke-dasharray: 46, 48; stroke-dashoffset: 0;"></path>
	<path
