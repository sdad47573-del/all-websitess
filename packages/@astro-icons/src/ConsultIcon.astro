	xmlns="http://www.w3.org/2000/svg"
	xmlns:xlink="http://www.w3.org/1999/xlink"
	x="0px"
	y="0px"
	width="100%"
	height="100%"
	viewBox="0 0 64 64"
	enable-background="new 0 0 64 64"
	xml:space="preserve"
>
	<path
		fill="none"
		stroke="#000000"
		stroke-width="2"
		stroke-miterlimit="10"
		d="M1,29L1,35L7,41L45.5,41L61,53L63,53L63,29L
	63,5L61,5L45.5,17L7,17L1,23Z"
