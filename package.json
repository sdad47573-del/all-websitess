{
  "name": "all-websites",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,astro}\"",
    "check-types": "turbo run check-types",
    "check:sites": "node scripts/check-site-content.mjs",
    "og:png": "node scripts/og-svg-to-png.mjs",
    "vercel:ignore": "node scripts/vercel-ignore-build.mjs",
    "vercel:sync": "node scripts/add-vercel-ignore-command.mjs",
    "check:vercel-ignore": "node scripts/check-vercel-ignore-command.mjs",
    "check:vercel-root": "node scripts/check-vercel-root-directory.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withastro/astro.git"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-regexp": "^3.3.1",
    "knip": "6.41.0",
    "only-allow": "^1.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.25",
    "tinyglobby": "^0.2.17",
    "turbo": "^2.11.7",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "zod": "^4.6.5",
    "@astrojs/sitemap": "3.7.4"
  }
}
