    "@biomejs/biome": "2.2.6",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^18.19.130",
    "esbuild": "0.25.5",
    "eslint": "^9.39.1",
    "eslint-plugin-regexp": "^2.10.0",
    "knip": "5.61.3",
    "only-allow": "^1.2.2",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "publint": "^0.3.15",
    "tinyglobby": "^0.2.15",
    "turbo": "^2.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1"
